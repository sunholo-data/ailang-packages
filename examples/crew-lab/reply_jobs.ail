module sunholo/crew_lab/reply_jobs
import std/list (map, filter, length, any, take, foldl, reverse)
import std/string (length as size)
import std/result (Result, Ok, Err)
import std/option (Option, Some, None)
import pkg/sunholo/content_library/library (Bundle, pickVariant)

-- Pure reply inbox. The crew member's decision is already committed when a job is
-- created; a job only carries the words. Nothing here reads files or processes.
-- Prefetch jobs are speculative wording for an offer the captain has not made yet.
export type Spec = {request:string, actor:string, about:string, label:string, signature:string, textRoll:float, prefetch:bool} deriving (Eq)
export type Status = Queued | Preparing | Ready | Failed | Cancelled deriving (Eq)
export type Job = {id:int, spec:Spec, status:Status, text:string, note:string, read:bool, calls:int} deriving (Eq)
export type Inbox = {jobs:[Job], next:int, concurrency:int} deriving (Eq)

export pure func liveLimit() -> int = 16
pure func historyLimit() -> int = 48

pure func live(j:Job) -> bool = j.status == Queued || j.status == Preparing

export pure func empty(concurrency:int) -> Inbox ! {}
ensures { result.concurrency >= 1 && result.concurrency <= 5 && length(result.jobs) == 0 } =
 {jobs:[], next:1, concurrency:if concurrency < 1 then 1 else if concurrency > 5 then 5 else concurrency}

export pure func liveCount(b:Inbox) -> int ! {}
ensures { result >= 0 && result <= length(b.jobs) } = length(filter(live, b.jobs))

export pure func preparing(b:Inbox) -> int ! {}
ensures { result >= 0 && result <= length(b.jobs) } = length(filter(\j. j.status == Preparing, b.jobs))

export pure func unread(b:Inbox) -> int ! {}
ensures { result >= 0 && result <= length(b.jobs) } = length(filter(\j. j.status == Ready && not j.read && not j.spec.prefetch, b.jobs))

-- One live job per signature: the same words are never fetched twice at once.
export pure func pendingFor(b:Inbox, signature:string) -> bool ! {} =
 any(\j. live(j) && j.spec.signature == signature, b.jobs)

-- Any job, finished or not, for these words: a failed prefetch is not retried.
export pure func known(b:Inbox, signature:string) -> bool ! {} =
 any(\j. j.spec.signature == signature, b.jobs)

-- Finished jobs beyond the history bound are dropped oldest first; live jobs stay.
pure func trim(jobs:[Job]) -> [Job] = {
 let done = filter(\j. not live(j), jobs);
 let excess = length(done) - historyLimit();
 if excess <= 0 then jobs else {
  let dropped = take(excess, done);
  filter(\j. live(j) || not any(\d. d.id == j.id, dropped), jobs)
 }
}

-- The captain made the offer a live prefetch was guessing: that job becomes the
-- reply (same id, worker and progress), now shown and with the decision's roll.
pure func adopt(b:Inbox, spec:Spec) -> Inbox =
 {jobs:map(\j. if live(j) && j.spec.prefetch && j.spec.signature == spec.signature then {j | spec:spec} else j, b.jobs), next:b.next, concurrency:b.concurrency}

export pure func enqueue(b:Inbox, spec:Spec) -> Result[Inbox, string] ! {}
requires { liveCount(b) <= liveLimit() }
ensures { match result {Err(_) => true, Ok(n) => liveCount(n) <= liveLimit() && (liveCount(n) == liveCount(b) + 1 && n.next == b.next + 1 || liveCount(n) == liveCount(b) && n.next == b.next)} } =
 if size(spec.signature) == 0 || size(spec.signature) > 32768 then Err("reply_signature")
 else if spec.textRoll < 0.0 || spec.textRoll >= 1.0 then Err("reply_roll")
 else if not spec.prefetch && any(\j. live(j) && j.spec.prefetch && j.spec.signature == spec.signature, b.jobs) then Ok(adopt(b, spec))
 else if pendingFor(b, spec.signature) then Err("reply_duplicate")
 else if liveCount(b) >= liveLimit() then Err("reply_queue_full")
 else Ok({jobs:trim(b.jobs ++ [{id:b.next, spec:spec, status:Queued, text:"", note:"", read:false, calls:0}]), next:b.next + 1, concurrency:b.concurrency})

-- Jobs to start now: oldest first, captain-facing replies before prefetches,
-- never more than the concurrency in flight.
export pure func dispatchable(b:Inbox) -> [Job] ! {}
ensures { length(result) + preparing(b) <= b.concurrency || length(result) == 0 } = {
 let room = b.concurrency - preparing(b);
 let queued = filter(\j. j.status == Queued, b.jobs);
 if room <= 0 then [] else take(room, filter(\j. not j.spec.prefetch, queued) ++ filter(\j. j.spec.prefetch, queued))
}

pure func setStatus(b:Inbox, id:int, from:Status, change:Job -> Job) -> Inbox =
 {jobs:map(\j. if j.id == id && j.status == from then change(j) else j, b.jobs), next:b.next, concurrency:b.concurrency}

export pure func started(b:Inbox, id:int) -> Inbox ! {}
ensures { liveCount(result) == liveCount(b) } = setStatus(b, id, Queued, \j. {j | status:Preparing})

-- A result applies only to a job still Preparing: duplicate, late (after cancel)
-- and unknown results leave the inbox unchanged.
export pure func complete(b:Inbox, id:int, outcome:Result[string, string], calls:int) -> Inbox ! {}
ensures { length(result.jobs) == length(b.jobs) && liveCount(result) >= liveCount(b) - 1 } =
 setStatus(b, id, Preparing, \j. match outcome {
  Ok(text) => {j | status:Ready, text:text, calls:calls},
  Err(e) => {j | status:Failed, note:e, calls:calls}
 })

-- A queued job that never started can be withdrawn (allowance refunded by caller).
export pure func withdraw(b:Inbox, id:int, reason:string) -> Inbox ! {} =
 setStatus(b, id, Queued, \j. {j | status:Cancelled, note:reason})

export pure func cancelAll(b:Inbox) -> Inbox ! {}
ensures { liveCount(result) == 0 } =
 {jobs:map(\j. if live(j) then {j | status:Cancelled, note:"watch ended"} else j, b.jobs), next:b.next, concurrency:b.concurrency}

export pure func markRead(b:Inbox) -> Inbox ! {}
ensures { unread(result) == 0 } =
 {jobs:map(\j. if j.status == Ready then {j | read:true} else j, b.jobs), next:b.next, concurrency:b.concurrency}

export pure func find(b:Inbox, id:int) -> Option[Job] ! {} = match filter(\j. j.id == id, b.jobs) {
 [] => None,
 j :: _ => Some(j)
}

-- Words for a ready bundle use the text roll reserved when the decision was made,
-- so the order in which workers finish cannot change what is shown.
export pure func wording(bundle:Bundle, label:string, roll:float) -> Result[string, string] ! {}
ensures { match result {Err(_) => true, Ok(t) => size(t) > 0} } = match pickVariant(bundle, label, roll) {
 Err(e) => Err(e),
 Ok(v) => if size(v.text) == 0 then Err("empty wording") else Ok(v.text)
}

export pure func statusLine(b:Inbox) -> string ! {}
ensures { result == "" || size(result) > 0 } = {
 let waiting = length(filter(\j. live(j) && not j.spec.prefetch, b.jobs));
 let fresh = unread(b);
 if waiting == 0 && fresh == 0 then "" else "Replies: ${show(waiting)} preparing, ${show(fresh)} new (r)"
}

pure func describe(j:Job) -> string =
 if j.status == Ready then "${j.spec.actor} on ${j.spec.about}:\n${j.text}"
 else if j.status == Failed then "${j.spec.actor} on ${j.spec.about}: personal words unavailable (${j.note}); the authored reply stands."
 else if j.status == Cancelled then "${j.spec.actor} on ${j.spec.about}: words not fetched (${j.note})."
 else "${j.spec.actor} on ${j.spec.about}: personal words being prepared…"

-- Replies view, newest first. Prefetches are not shown; they are not replies yet.
export pure func lines(b:Inbox) -> [string] ! {}
ensures { length(result) <= length(b.jobs) } =
 map(describe, reverse(filter(\j. not j.spec.prefetch, b.jobs)))

pure func spec(sig:string) -> Spec = {request:"reply-1", actor:"scientist", about:"Spire survey", label:"accept", signature:sig, textRoll:0.5, prefetch:false}
pure func fill(b:Inbox, n:int) -> Inbox = if n <= 0 then b else match enqueue(b, spec("sig-${show(n)}")) {Ok(x) => fill(x, n - 1), Err(_) => b}

test "enqueue bounds, duplicates and concurrency" {
 let b = fill(empty(3), 16);
 liveCount(b) == 16 && enqueue(b, spec("sig-new")) == Err("reply_queue_full") && enqueue(empty(3), spec("")) == Err("reply_signature") &&
 (match enqueue(empty(3), spec("a")) {Ok(x) => enqueue(x, spec("a")) == Err("reply_duplicate"), Err(_) => false}) &&
 length(dispatchable(b)) == 3 && empty(9).concurrency == 5 && empty(0).concurrency == 1
}
test "results apply once, only while preparing" {
 match enqueue(empty(3), spec("a")) {
  Err(_) => false,
  Ok(b) => {
   let early = complete(b, 1, Ok("too soon"), 1);
   let s = started(b, 1);
   let done = complete(s, 1, Ok("Glad to."), 1);
   let again = complete(done, 1, Ok("Other words"), 1);
   let late = complete(cancelAll(s), 1, Ok("late"), 1);
   early == b && unread(done) == 1 && again == done && (match find(late, 1) {Some(j) => j.status == Cancelled && j.text == "", None => false}) && unread(markRead(done)) == 0
  }
 }
}
test "an offer adopts the prefetch already fetching its words" {
 let p = spec("same");
 match enqueue(empty(3), {p | prefetch:true, textRoll:0.0}) {
  Err(_) => false,
  Ok(b) => match enqueue(started(b, 1), p) {
   Err(_) => false,
   Ok(c) => liveCount(c) == 1 && statusLine(c) == "Replies: 1 preparing, 0 new (r)" && (match find(complete(c, 1, Ok("words"), 1), 1) {Some(j) => not j.spec.prefetch && j.spec.textRoll == 0.5 && j.status == Ready, None => false})
  }
 }
}
test "replies come before prefetches" {
 let p = spec("p");
 match enqueue(empty(1), {p | prefetch:true}) {
  Err(_) => false,
  Ok(b) => match enqueue(b, spec("r")) {Err(_) => false, Ok(c) => match dispatchable(c) {[j] => j.spec.signature == "r", _ => false}}
 }
}
