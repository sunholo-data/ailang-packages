import std/result (Result, Ok, Err)
import std/option (Some, None)
import std/list (head, filter, map, length, contains, take, any, foldl)
import std/string (length as stringLength, stringToInt)
import std/json (Json, encode, decode, get, getString, jo, ja, kv, js, jint, jnum, jb)
import pkg/sunholo/content_library/library (Bundle, encodeBundle, starterBundle, nextRoll, pickLabel, pickVariant)
import pkg/sunholo/social_dynamics/model (Offered)
import pkg/sunholo/terminal_ui/ui (Dimensions, dimensions, screen, safeText)
import pkg/sunholo/crew_core/session (Request, lookupConversation, isConversation)
import pkg/sunholo/crew_core/session (start as startWith)
import ./watch_presenter (frame as watchFrame, recap as watchRecap)
import ./narrative (stock as watchStock, consequences as watchConsequences)
import pkg/sunholo/crew_core/scenario (Scenario, resourceName, scenarioHash)
