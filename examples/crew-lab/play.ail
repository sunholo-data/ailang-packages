export type HeardReply = {actor:string,text:string} deriving (Eq)
export type Run = { ui: PlayState, home: string, path: string, policy: Policy, policyBody: string, mode: string, remaining: int, lines: int, lastMessage: string, modern: bool, nav: Navigation, dimensions: Dimensions, ansi: bool, debug: bool, recent:[HeardReply], deferred:[Spec] }

export type Applied = { run: Run, failed: bool, message: string }

export type Reply = { command: string, seed: int, label: string, text: string, textRoll: float, metadata: Json }

pure func command(name: string, fields: [{ key: string, value: Json }]) -> string =
  encode(jo([kv("command", js(name))] ++ fields))

pure func envelope(seq: int, payload: Json) -> string =
  encode(jo([kv("version", jint(1)), kv("seq", jint(seq)), kv("payload", payload)]))

func waiting(r: Run,actor: string) -> () ! {IO} = if not r.modern then () else {
  let f = if isWatch(r.ui) && not r.debug then screen(r.dimensions,r.ansi,["HEARING YOUR CREW"],"The ${actor} is considering the assignment. Their response comes before your decision to start work.",["Please wait; your next choice follows."],0) else screen(r.dimensions, r.ansi, ["Stapledon's Voyage / crew reply", "Request recorded; awaiting crew reply."], "HEARING THE CREW\nLooking for a matching saved response. In live mode, a library miss may call AI within the allowance. No answer or consequence is committed yet.", ["Please wait; next decision follows."], 0)
  if r.ansi then print(f.text) else println(f.text)
  flush()
}

export pure func model() -> string = "z-ai/glm-5.3-flash"

export pure func selectReply(r: Request, policy: Policy, bundle: Bundle, seed: int) -> Result[Reply, string]
ensures { match result {
  Ok(p) => p.seed >= 1 && p.seed <= 2147483646 && stringLength(p.command) > 0,
  Err(_) => true
} } = match (weights(policy, r), nextRoll(seed)) {
  (Ok(ws), Ok(responseRoll)) => match (pickLabel(ws, responseRoll.roll), nextRoll(responseRoll.seed)) {
    (Ok(label), Ok(textRoll)) => match pickVariant(bundle, label, textRoll.roll) {
      Err(e) => Err(e),
      Ok(v) => match decode(encodeBundle(bundle)) {
        Err(e) => Err(e),
        Ok(encoded) => Ok({ command: command("answer", [kv("request", js(r.id)), kv("body", js(fixtureBody(r, label))), kv("roll", jnum(responseRoll.roll))]), seed: textRoll.seed, label: label, text: v.text, textRoll: textRoll.roll, metadata: jo([kv("weights", ja(map(\w. jo([kv("label", js(w.label)), kv("weight", jint(w.weight))]), ws))), kv("response_roll", jnum(responseRoll.roll)), kv("text_roll", jnum(textRoll.roll)), kv("selected_label", js(label)), kv("variant_id", js(v.id)), kv("bundle", encoded), kv("dialogue", js(v.text))]) })
      }
    },
    (Err(e), _) => Err(e),
    (_, Err(e)) => Err(e)
  },
  (Err(e), _) => Err(e),
  (_, Err(e)) => Err(e)
}

-- Opinion sampling remains unchanged. Only wording for the selected label may
-- avoid the same listener's last eight published replies. The stored bundle is
-- always the original validated bundle, never the filtered selection projection.
export pure func selectReplyRecent(r:Request,policy:Policy,bundle:Bundle,seed:int,recent:[string])->Result[Reply,string] ! {}
ensures {match result {Err(_)=>true,Ok(p)=>p.seed>=1 && p.seed<=2147483646 && stringLength(p.command)>0}} =
 if length(recent)>8 then Err("recent_reply_limit") else match (weights(policy,r),nextRoll(seed)) {
  (Ok(ws),Ok(responseRoll))=>match (pickLabel(ws,responseRoll.roll),nextRoll(responseRoll.seed)) {
   (Ok(label),Ok(textRoll))=>match pickVariant(bundle,label,textRoll.roll) {
    Err(e)=>Err(e),Ok(original)=>{
     let unseen=filter(\v. v.label==label && not contains(recent,v.text),bundle.variants);
     let filtered={bundle|variants:filter(\v. v.label!=label || not contains(recent,v.text),bundle.variants)};
     let exhausted=length(unseen)==0;
     match (if exhausted then Ok(original) else pickVariant(filtered,label,textRoll.roll)) {
      Err(e)=>Err(e),Ok(v)=>match decode(encodeBundle(bundle)) {
       Err(e)=>Err(e),Ok(encoded)=>Ok({command:command("answer",[kv("request",js(r.id)),kv("body",js(fixtureBody(r,label))),kv("roll",jnum(responseRoll.roll))]),seed:textRoll.seed,label:label,text:v.text,textRoll:textRoll.roll,metadata:jo([kv("weights",ja(map(\w. jo([kv("label",js(w.label)),kv("weight",jint(w.weight))]),ws))),kv("response_roll",jnum(responseRoll.roll)),kv("text_roll",jnum(textRoll.roll)),kv("selected_label",js(label)),kv("variant_id",js(v.id)),kv("bundle",encoded),kv("dialogue",js(v.text)),kv("recent_wording",jo([kv("policy",js("same-actor-same-label-v1")),kv("recent_text",ja(map(js,recent))),kv("unseen_variants",jint(length(unseen))),kv("exhausted_fallback",jb(exhausted)),kv("original_variant_id",js(original.id))]))])})
      }
     }
    }
   },(Err(e),_)=>Err(e),(_,Err(e))=>Err(e)
  },(Err(e),_)=>Err(e),(_,Err(e))=>Err(e)
 }

export pure func recentFor(recent:[HeardReply],actor:string)->[string] ! {}
ensures {length(result)<=length(recent)} = map(\p. p.text,filter(\p. p.actor==actor,recent))

export pure func rememberReply(recent:[HeardReply],actor:string,text:string,published:bool)->[HeardReply] ! {}
requires {length(recent)<=8}
ensures {length(result)<=8 && (published || result==recent)} =
 if not published then recent else take(8,[{actor:actor,text:text}] ++ recent)

pure func usage(fetch: Fetch) -> Json =
  jo([kv("source", js(fetch.source)), kv("calls", jint(fetch.calls)), kv("input_tokens", jint(fetch.inputTokens)), kv("output_tokens", jint(fetch.outputTokens)), kv("usage_known", jb(fetch.usageKnown))])

pure func watchRejection(sc: Scenario, trace: string) -> string = match decode(trace) {
 Err(_)=>"This action could not be completed. You can choose again.",
 Ok(j)=>match get(j,"error") {
  None=>"The advance stopped; earlier completed work is retained. Review Work before continuing.",
  Some(e)=>{
   let code=match getString(e,"code") {Some(x)=>x,None=>""};
   let detail=match getString(e,"detail") {Some(x)=>x,None=>""};
   if code == "insufficient_resource" then "Not enough available ${resourceName(sc,detail)}. Other work may be holding capacity. Review Work, advance existing jobs, or leave this offer open. Spent physical supplies do not return by waiting." else if code == "capacity_exceeded" then "That worker is occupied. Advance their current assignment or handle requested relief; this offer stays open." else "This action needs agreement, cooperation and available resources. Review the offer and your command style; you can choose again."
  }
 }
}

func commit(r: Run, c: string, seed: int, phase: string, target: string, nextId: int, metadata: Json, calls: int) -> Result[Applied, string] ! {FS} =
  match stage(r.ui, c, seed, phase, target, nextId) {
    Err(e) => Err(e),
    Ok(candidate) => {
      let payload = jo([kv("kind", js("host")), kv("host_input", js(c)), kv("host_output", js(candidate.trace)), kv("seed_before", jint(r.ui.seed)), kv("seed_after", jint(candidate.state.seed)), kv("metadata", metadata)])
      match appendRun(r.path, envelope(candidate.state.seq, payload)) {
        Err(e) => Err("Journal failed; prior Session and seed retained: ${e}"),
        Ok(_) => {
          let publication = publish(r.ui, candidate, true)
          Ok({ run: { r | ui: publication.state, remaining: r.remaining - calls }, failed: candidate.failed, message: if candidate.failed then if isWatch(r.ui) then watchRejection(r.ui.session.scenario,candidate.trace) else rejection(candidate.trace) else if isWatch(r.ui) && not r.debug then watchConsequences(r.ui.session, publication.state.session, c) else consequences(r.ui.session, publication.state.session, c) })
        }
      }
    }
  }

func noteFailure(r: Run, fetch: Fetch, error: string) -> Result[Run, string] ! {FS} =
  if r.ui.seq >= 10000 then Err("Journal command limit") else match appendRun(r.path, envelope(r.ui.seq + 1, jo([kv("kind", js("library_error")), kv("error", js(error)), kv("usage", usage(fetch)), kv("seed", jint(r.ui.seed))]))) {
    Err(e) => Err("Journal failed; stopping after attempted provider call: ${e}"),
    Ok(_) => Ok({ r | ui: { r.ui | seq: r.ui.seq + 1, phase: "response" }, remaining: r.remaining - fetch.calls })
  }

-- A live library miss commits the decision with the authored line at once; the
-- crew member's own words become a background job (same label and text roll).
pure func deferJob(r:Run,request:Request,reply:Reply,sig:string)->[Spec] = match shortSignature(sig,reply.label) {
 Err(_)=>[],
 Ok(short)=>[{request:request.id,actor:request.actor,about:match head(filter(\t. t.id==request.task,r.ui.session.state.tasks)) {None=>"their work",Some(t)=>projectName(r.ui.session.scenario,t.recipe)},label:reply.label,signature:short,textRoll:reply.textRoll,prefetch:false}]
}

pure func noted(source:string,a:Applied)->Applied =
 if source=="deferred" && not a.failed then {a|message:"${a.message}\n(Their own words are queued; r opens Replies.)"} else a

func respond(r: Run, explicitAuthored: bool) -> Result[Applied, string] ! {IO, FS, AI} =
  match head(filter(\q. q.id == r.ui.target, r.ui.session.pending)) {
    None => Err("No pending response"),
    Some(request) => {
      let sig = if isWatch(r.ui) then watchSignatureIn(r.ui.session.scenario,request,r.policyBody,model()) else signature(request, r.policyBody, model())
      waiting(r,request.actor)
      let fetch = if explicitAuthored then { outcome: starterBundle(sig, request.legal), source: "explicit-authored", calls: 0, inputTokens: 0, outputTokens: 0, usageKnown: true } else if isWatch(r.ui) && r.mode=="live" then match chooseReaction(r.policy,request,r.ui.seed) {
        Err(e)=>{outcome:Err(e),source:"error",calls:0,inputTokens:0,outputTokens:0,usageKnown:true},
        Ok(label)=>if cachedChosen(r.home,sig,label) then resolveChosen(r.home,sig,request.legal,label,model(),r.mode,r.remaining) else match starterBundle(sig,request.legal) {
          Err(e)=>{outcome:Err(e),source:"error",calls:0,inputTokens:0,outputTokens:0,usageKnown:true},
          Ok(b)=>{outcome:Ok(b),source:"deferred",calls:0,inputTokens:0,outputTokens:0,usageKnown:true}
        }
      } else resolve(r.home, sig, request.legal, model(), r.mode, r.remaining)
      match fetch.outcome {
        Err(e) => match noteFailure(r, fetch, e) {
          Err(j) => Err(j),
          Ok(n) => Ok({ run: n, failed: false, message: if isWatch(r.ui) && not r.debug then "The reply could not be used; retry or use an authored continuation." else "Library unavailable: ${e}. Request remains pending." })
        },
        Ok(rawBundle) => match (if isConversation(r.ui.session) && rawBundle.origin == "authored" then conversationStarter(request,sig) else Ok(rawBundle)) {
        Err(e)=>Err(e),Ok(bundle) => match (if isConversation(r.ui.session) then selectReplyRecent(request,r.policy,bundle,r.ui.seed,recentFor(r.recent,request.actor)) else selectReply(request, r.policy, bundle, r.ui.seed)) {
          Err(e) => match noteFailure(r, fetch, e) {
            Err(j) => Err(j),
            Ok(n) => Ok({ run: n, failed: false, message: if isWatch(r.ui) && not r.debug then "The reply could not be used; retry or use an authored continuation." else "Response unavailable: ${e}. Request remains pending." })
          },
          Ok(reply) => {
            let offered = anyOffered(r.ui, request.task)
            let hasConcern = isConversation(r.ui.session) && reply.label != "accept" && offered
            let nextPhase = if hasConcern then "conversation" else if offered then "start" else "main"
            match commit(r, reply.command, reply.seed, nextPhase, if offered then request.task else "", r.ui.nextId, jo([kv("selection", reply.metadata), kv("usage", usage(fetch))]), fetch.calls) {
              Err(e) => Err(e),
              Ok(applied) => Ok(noted(fetch.source,{ applied | run:{applied.run|recent:if isConversation(r.ui.session) then rememberReply(r.recent,request.actor,reply.text,not applied.failed) else r.recent,deferred:if fetch.source=="deferred" && not applied.failed then deferJob(r,request,reply,sig) else []}, message: if applied.failed then applied.message else if isWatch(r.ui) && not r.debug then if bundle.origin == "authored" && not isConversation(r.ui.session) then watchStock(r.ui.session.scenario,request,reply.label) else "${request.actor}: ${reply.text}" else "${dialogue(request.actor, reply.label, reply.text, fetch.source, bundle.origin)}${if isWatch(r.ui) && r.debug then "\nDevelopment selection: ${encode(reply.metadata)}" else ""}" }))
            }
          }
        }
        }
      }
    }
  }

pure func anyOffered(s: PlayState, task: string) -> bool = match head(filter(\t. t.id == task, s.session.state.tasks)) {
  Some(t) => t.status == Offered,
  None => false
}

func askProject(r: Run, task: string) -> Result[Applied, string] ! {IO, FS, AI} =
  match head(filter(\b. b.task == task, r.ui.session.bindings)) {
    None => Err("Unknown project"),
    Some(b) => {
      let id = "reply-${r.ui.nextId}"
      match commit(r, command("ask", [kv("actor", js(b.worker)), kv("task", js(task)), kv("id", js(id))]), r.ui.seed, "response", id, r.ui.nextId + 1, jo([]), 0) {
        Err(e) => Err(e),
        Ok(a) => if a.failed then Ok(a) else respond(a.run, false)
      }
    }
  }

func captainSpeech(r:Run,body:string)->Result[Applied,string] ! {IO,FS,AI} = match object(body) {
 Err(e)=>Err(e),Ok(j)=>match (getString(j,"issue"),getString(j,"text"),getString(j,"approach"),get(j,"tick"),get(j,"revision")) {
  (Some(issue),Some(words),Some(approach),Some(tick),Some(revision))=>{
   let id="captain-${r.ui.nextId}";
   let c=command("captain_reply",[kv("id",js(id)),kv("issue",js(issue)),kv("text",js(words)),kv("approach",js(approach)),kv("tick",tick),kv("revision",revision)]);
   match commit(r,c,r.ui.seed,"response","reconsider-${id}",r.ui.nextId+1,jo([kv("captain_text",js(words)),kv("confirmed_approach",js(approach)),kv("meaning",js("discussion only"))]),0) {
    Err(e)=>Err(e),Ok(a)=>if a.failed then Ok(a) else match respond(a.run,false) {Err(e)=>Err(e),Ok(answer)=>Ok({answer|message:"Captain: ${words}\n${answer.message}"})}
   }
  },_=>Err("Reply requires exact text and a confirmed approach")
 }
}

func act(r: Run, i: Intent) -> Result[Applied, string] ! {IO, FS, AI} = if i.kind == "offer" then {
  let id = "project-${r.ui.nextId}"
  match commit(r, command("offer", [kv("worker", js(i.worker)), kv("recipe", js(i.recipe)), kv("id", js(id))]), r.ui.seed, "main", "", r.ui.nextId + 1, jo([]), 0) {
    Err(e) => Err(e),
    Ok(a) => if a.failed then Ok(a) else askProject(a.run, id)
  }
} else if i.kind=="events" then Ok({run:{r|ui:{r.ui|phase:"events",target:""}},failed:false,message:"Choose a lab scenario report; receiving it does not advance time."}) else if i.kind=="lab_major" then {let id="report-${r.ui.nextId}";let result=commit(r,command("lab_major",[kv("id",js(id)),kv("kind",js(i.target))]),r.ui.seed,"main","",r.ui.nextId+1,jo([]),0);match result {Err(e)=>Err(e),Ok(a)=>if a.failed then Ok(a) else Ok({a|message:"The crew received the ${i.target} lab report. Temperament responds gradually on future turns; no work or resources changed."})}} else if i.kind == "conversation" then Ok({run:{r|ui:{r.ui|phase:"conversation",target:i.target}},failed:false,message:"Discuss this existing proposal; sending a reply does not start work."}) else if i.kind == "captain_reply" then captainSpeech(r,i.target) else if i.kind == "review_start" then Ok({ run: { r | ui: { r.ui | phase: "start", target: i.target } }, failed: false, message: "Review the existing offer; the crew agreement is unchanged." }) else if i.kind == "ask" then askProject(r, i.target) else if i.kind == "retry" || i.kind == "authored" then respond(r, i.kind == "authored") else if i.kind == "start" then commit(r, command("start_task", [kv("task", js(i.target))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "cancel" then commit(r, command("cancel_request", [kv("id", js(i.target))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "grant" || i.kind == "deny" then commit(r, command("resolve_relief", [kv("id", js(i.target)), kv("release", jb(i.kind == "grant"))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "advance" then commit(r, command("advance", [kv("tick", jint(r.ui.session.state.tick + 1)), kv("budget", jint(64))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "continue" then match r.ui.session.state.continuation {
  Some(t) => commit(r, command("advance", [kv("tick", jint(t.target)), kv("budget", jint(64))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0),
  None => Err("No pending advance")
} else if i.kind == "abort" then commit(r, command("abort", []), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "relief_choice" then Ok({ run: { r | ui: { r.ui | phase: "relief", target: i.target } }, failed: false, message: "" }) else if i.kind == "back" then Ok({ run: { r | ui: { r.ui | phase: "main", target: "" } }, failed: false, message: "" }) else if i.kind == "working" || i.kind == "offered" || i.kind == "reliefs" || i.kind == "assignments" || i.kind == "rests" then Ok({ run: { r | ui: { r.ui | phase: i.kind, target: "" } }, failed: false, message: "" }) else Err("Unknown captain action")












-- Trusted app adapters only: these reuse the same start/commit/respond/store
-- boundaries. UI-owned navigation never calls them. No second input owner.
func openWatchScenario(sc:Scenario,policyText:string,home:string,seed:int,policyChoice:string,mode:string,debug:bool,conversation:bool)->Result[Run,string] ! {FS,Env}
requires { stringLength(home)>0 && stringLength(home)<=4096 && seed>=1 && seed<=2147483646 && (mode=="live" || mode=="offline") }
ensures { match result {Err(_)=>true,Ok(r)=>r.ui.seed==seed && r.ui.seq==0 && isWatch(r.ui) && r.remaining>=0 && r.remaining<=8} } =
 match (if conversation then beginConversationWatchIn(sc,policyChoice,seed) else beginWatchIn(sc,policyChoice,seed),if policyText=="" then loadWatchPolicy(home) else match decodePolicy(policyText) {Ok(p)=>Ok({policy:p,body:policyText}),Err(e)=>Err("Invalid --policy: ${e}")}) {
  (Err(e),_)=>Err(e),(_,Err(e))=>Err(e),
  (Ok(ui),Ok(config))=>{
   let c=command("start",[kv("policy",js(ui.session.policy)),kv("scenario",js(if conversation then "watch-v3" else "watch-v2"))]);
   match startWith(sc,c) {Err(_)=>Err("Startup failed"),Ok(host)=>{
    let header=envelope(0,jo([kv("kind",js("start")),kv("host_input",js(c)),kv("host_output",js(host.trace)),kv("seed",jint(seed)),kv("policy_body",js(config.body)),kv("policy_hash",js(sha256Hex(config.body))),kv("scenario_hash",js(scenarioHash(sc))),kv("scenario",js(sc.canonical)),kv("model",js(model())),kv("mode",js(mode))]));
    match openRun(home,"${getPid()}-${seed}",header) {Err(e)=>Err("Run ownership/journal failed: ${e}"),Ok(path)=>Ok({ui:ui,home:home,path:path,policy:config.policy,policyBody:config.body,mode:mode,remaining:config.policy.callLimit,lines:0,lastMessage:"",modern:true,nav:initial(),dimensions:dimensions(80,24),ansi:false,debug:debug,recent:[],deferred:[]})}
   }}
  }
 }

export func openWatch(sc:Scenario,policyText:string,home:string,seed:int,policyChoice:string,mode:string,debug:bool)->Result[Run,string] ! {FS,Env}
requires {stringLength(home)>0 && stringLength(home)<=4096 && seed>=1 && seed<=2147483646 && (mode=="live" || mode=="offline")}
ensures {match result {Err(_)=>true,Ok(r)=>isWatch(r.ui) && not isConversation(r.ui.session)}} = openWatchScenario(sc,policyText,home,seed,policyChoice,mode,debug,false)

export func openConversationWatch(sc:Scenario,policyText:string,home:string,seed:int,policyChoice:string,mode:string,debug:bool)->Result[Run,string] ! {FS,Env}
requires {stringLength(home)>0 && stringLength(home)<=4096 && seed>=1 && seed<=2147483646 && (mode=="live" || mode=="offline")}
ensures {match result {Err(_)=>true,Ok(r)=>isWatch(r.ui) && isConversation(r.ui.session)}} = openWatchScenario(sc,policyText,home,seed,policyChoice,mode,debug,true)

export func applyWatch(r:Run,i:Intent)->Result[Applied,string] ! {IO,FS,AI}
requires { isWatch(r.ui) && r.remaining>=0 && r.remaining<=8 && (r.mode=="live" || r.mode=="offline") }
ensures { match result {Err(_)=>true,Ok(a)=>a.run.remaining<=r.remaining && a.run.remaining>=0 && a.run.path==r.path && a.run.ui.session.config.id==r.ui.session.config.id} } =
 match act({r|modern:false},i) {Err(e)=>Err(e),Ok(a)=>Ok({a|run:{a.run|modern:true}})}

export func closeWatch(r:Run)->Result[(),string] ! {FS}
requires { isWatch(r.ui) && r.ui.seq>=0 && r.ui.seq<=10000 }
ensures { match result {Ok(v)=>v==(),Err(_)=>true} } =
 appendRun(r.path,envelope(r.ui.seq+1,jo([kv("kind",js("quit")),kv("seed",jint(r.ui.seed))])))

-- Transport record for background words: never a host command, never replayed.
-- The allowance is settled here: a job that made no provider call is refunded.
export func noteWording(r:Run,job:int,request:string,source:string,calls:int,inputTokens:int,outputTokens:int,text:string,error:string)->Result[Run,string] ! {FS}
requires { isWatch(r.ui) && calls>=0 && calls<=1 }
ensures { match result {Err(_)=>true,Ok(n)=>n.ui.session==r.ui.session && n.ui.seed==r.ui.seed && n.ui.phase==r.ui.phase && n.remaining>=r.remaining} } =
 if r.ui.seq>=10000 then Err("Journal command limit") else match appendRun(r.path,envelope(r.ui.seq+1,jo([kv("kind",js("wording")),kv("job",jint(job)),kv("request",js(request)),kv("source",js(source)),kv("usage",jo([kv("calls",jint(calls)),kv("input_tokens",jint(inputTokens)),kv("output_tokens",jint(outputTokens))])),kv("text",js(text)),kv("error",js(error)),kv("seed",jint(r.ui.seed))]))) {
  Err(e)=>Err("Journal failed while recording background words: ${e}"),
  Ok(_)=>Ok({r|ui:{r.ui|seq:r.ui.seq+1},remaining:if calls==0 && r.remaining<r.policy.callLimit then r.remaining+1 else r.remaining})
 }

-- Prefetch. The session is pure, so offering a crew member their work and asking
-- them can be staged on a copy of the state exactly as act/askProject would:
-- same ids, seed and frozen request, hence the same reaction and signature.
-- Nothing is committed or journalled. base is the full-library signature.
export type Prediction = {spec:Spec, base:string} deriving (Eq)

pure func idle(r:Run,worker:string)->bool =
 not any(\t. (t.status==Working || t.status==Offered) && contains(t.participants,worker),r.ui.session.state.tasks)

export pure func predictOffer(r:Run,worker:string)->Result[Prediction,string] ! {}
ensures { match result {Err(_)=>true,Ok(p)=>p.spec.prefetch && p.spec.actor==worker} } = {
 let recipe="work_${worker}";
 let task="project-${r.ui.nextId}";
 if not workerRecipe(r.ui.session.scenario,worker,recipe) then Err("no work recipe") else match stage(r.ui,command("offer",[kv("worker",js(worker)),kv("recipe",js(recipe)),kv("id",js(task))]),r.ui.seed,"main","",r.ui.nextId+1) {
  Err(e)=>Err(e),Ok(offered)=>if offered.failed then Err("offer would fail") else {
   let s1=offered.state;
   let id="reply-${s1.nextId}";
   match stage(s1,command("ask",[kv("actor",js(worker)),kv("task",js(task)),kv("id",js(id))]),s1.seed,"response",id,s1.nextId+1) {
    Err(e)=>Err(e),Ok(asked)=>if asked.failed then Err("ask would fail") else match head(filter(\q. q.id==id,asked.state.session.pending)) {
     None=>Err("no request"),Some(request)=>{
      let base=watchSignatureIn(r.ui.session.scenario,request,r.policyBody,model());
      match chooseReaction(r.policy,request,asked.state.seed) {
       Err(e)=>Err(e),Ok(label)=>match shortSignature(base,label) {
        Err(e)=>Err(e),Ok(short)=>Ok({spec:{request:id,actor:worker,about:projectName(r.ui.session.scenario,recipe),label:label,signature:short,textRoll:0.0,prefetch:true},base:base})
       }
      }
     }
    }
   }
  }
 }
}

-- Up to n idle crew, in scenario order, while on the bridge or the work chooser.
export pure func prefetchCandidates(r:Run,n:int)->[Prediction] ! {}
ensures { length(result)<=5 } =
 if n<=0 || not isWatch(r.ui) || r.mode!="live" || (r.ui.phase!="main" && r.ui.phase!="assignments") || r.ui.session.state.continuation!=None then []
 else take(if n>5 then 5 else n,foldl(\acc w. if not idle(r,w) then acc else match predictOffer(r,w) {Ok(p)=>acc++[p],Err(_)=>acc},[],r.ui.session.scenario.workers))
