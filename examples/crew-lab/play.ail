module sunholo/crew_lab/play
import std/io (readLine, println, exit, print, flush)
import std/env (getArgs, getEnvOr, getPid, hasEnv)
import std/result (Result, Ok, Err)
import std/option (Some, None)
import std/list (head, filter, map)
import std/string (length as stringLength, stringToInt)
import std/json (Json, encode, decode, jo, ja, kv, js, jint, jnum, jb)
import pkg/sunholo/content_library/library (Bundle, encodeBundle, starterBundle, nextRoll, pickLabel, pickVariant)
import pkg/sunholo/social_dynamics/model (Offered)
import pkg/sunholo/terminal_ui/ui (Dimensions, dimensions, screen, safeText)
import ./journey_flow (Navigation, initial, options as journeyOptions, styleDefault, onboardingAllowed, navigation, remember)
import ./journey_presenter (frame, opening, indicatorChanges, journeyRecap)
import ./session (Request, start)
import ./reactions (Policy, weights, signature, fixtureBody)
import ./store (Fetch, loadPolicy, resolve, openRun, appendRun)
import ./presenter (briefing, policyBrief, seedBrief, dashboard, guidance, help, dialogue, rejection, consequences, recap)
import ./play_flow (PlayState, Stage, Intent, begin, seedNumber, parseArgs, menu, route, stage, publish, renderStatus, recover)

type Run = { ui: PlayState, home: string, path: string, policy: Policy, policyBody: string, mode: string, remaining: int, lines: int, lastMessage: string, modern: bool, nav: Navigation, dimensions: Dimensions, ansi: bool }

type Applied = { run: Run, failed: bool, message: string }

export type Reply = { command: string, seed: int, label: string, text: string, metadata: Json }

pure func command(name: string, fields: [{ key: string, value: Json }]) -> string =
  encode(jo([kv("command", js(name))] ++ fields))

pure func envelope(seq: int, payload: Json) -> string =
  encode(jo([kv("version", jint(1)), kv("seq", jint(seq)), kv("payload", payload)]))

pure func model() -> string = "z-ai/glm-5.3-flash"

export pure func selectReply(r: Request, policy: Policy, bundle: Bundle, seed: int) -> Result[Reply, string]
ensures { match result {
  Ok(p) => p.seed >= 1 && p.seed <= 2147483646 && stringLength(p.command) > 0,
  Err(_) => true
} } = match (weights(policy, r), nextRoll(seed)) {
  (Ok(ws), Ok(responseRoll)) => match (pickLabel(ws, responseRoll.roll), nextRoll(responseRoll.seed)) {
    (Ok(label), Ok(textRoll)) => match pickVariant(bundle, label, textRoll.roll) {
      Err(e) => Err(e),
      Ok(v) => match decode(encodeBundle(bundle)) {
        Err(e) => Err(e),
        Ok(encoded) => Ok({ command: command("answer", [kv("request", js(r.id)), kv("body", js(fixtureBody(r, label))), kv("roll", jnum(responseRoll.roll))]), seed: textRoll.seed, label: label, text: v.text, metadata: jo([kv("weights", ja(map(\w. jo([kv("label", js(w.label)), kv("weight", jint(w.weight))]), ws))), kv("response_roll", jnum(responseRoll.roll)), kv("text_roll", jnum(textRoll.roll)), kv("selected_label", js(label)), kv("variant_id", js(v.id)), kv("bundle", encoded), kv("dialogue", js(v.text))]) })
      }
    },
    (Err(e), _) => Err(e),
    (_, Err(e)) => Err(e)
  },
  (Err(e), _) => Err(e),
  (_, Err(e)) => Err(e)
}

pure func usage(fetch: Fetch) -> Json =
  jo([kv("source", js(fetch.source)), kv("calls", jint(fetch.calls)), kv("input_tokens", jint(fetch.inputTokens)), kv("output_tokens", jint(fetch.outputTokens)), kv("usage_known", jb(fetch.usageKnown))])

func commit(r: Run, c: string, seed: int, phase: string, target: string, nextId: int, metadata: Json, calls: int) -> Result[Applied, string] ! {FS} =
  match stage(r.ui, c, seed, phase, target, nextId) {
    Err(e) => Err(e),
    Ok(candidate) => {
      let payload = jo([kv("kind", js("host")), kv("host_input", js(c)), kv("host_output", js(candidate.trace)), kv("seed_before", jint(r.ui.seed)), kv("seed_after", jint(candidate.state.seed)), kv("metadata", metadata)])
      match appendRun(r.path, envelope(candidate.state.seq, payload)) {
        Err(e) => Err("Journal failed; prior Session and seed retained: ${e}"),
        Ok(_) => {
          let publication = publish(r.ui, candidate, true)
          Ok({ run: { r | ui: publication.state, remaining: r.remaining - calls }, failed: candidate.failed, message: if candidate.failed then rejection(candidate.trace) else consequences(r.ui.session, publication.state.session, c) })
        }
      }
    }
  }

func noteFailure(r: Run, fetch: Fetch, error: string) -> Result[Run, string] ! {FS} =
  if r.ui.seq >= 10000 then Err("Journal command limit") else match appendRun(r.path, envelope(r.ui.seq + 1, jo([kv("kind", js("library_error")), kv("error", js(error)), kv("usage", usage(fetch)), kv("seed", jint(r.ui.seed))]))) {
    Err(e) => Err("Journal failed; stopping after attempted provider call: ${e}"),
    Ok(_) => Ok({ r | ui: { r.ui | seq: r.ui.seq + 1, phase: "response" }, remaining: r.remaining - fetch.calls })
  }

func respond(r: Run, explicitAuthored: bool) -> Result[Applied, string] ! {IO, FS, AI} =
  match head(filter(\q. q.id == r.ui.target, r.ui.session.pending)) {
    None => Err("No pending response"),
    Some(request) => {
      let sig = signature(request, r.policyBody, model())
      waiting(r)
      let fetch = if explicitAuthored then { outcome: starterBundle(sig, request.legal), source: "explicit-authored", calls: 0, inputTokens: 0, outputTokens: 0, usageKnown: true } else resolve(r.home, sig, request.legal, model(), r.mode, r.remaining)
      match fetch.outcome {
        Err(e) => match noteFailure(r, fetch, e) {
          Err(j) => Err(j),
          Ok(n) => Ok({ run: n, failed: false, message: "Library unavailable: ${e}. Request remains pending." })
        },
        Ok(bundle) => match selectReply(request, r.policy, bundle, r.ui.seed) {
          Err(e) => match noteFailure(r, fetch, e) {
            Err(j) => Err(j),
            Ok(n) => Ok({ run: n, failed: false, message: "Response unavailable: ${e}. Request remains pending." })
          },
          Ok(reply) => {
            let offered = anyOffered(r.ui, request.task)
            match commit(r, reply.command, reply.seed, if offered then "start" else "main", if offered then request.task else "", r.ui.nextId, jo([kv("selection", reply.metadata), kv("usage", usage(fetch))]), fetch.calls) {
              Err(e) => Err(e),
              Ok(applied) => Ok({ applied | message: if applied.failed then applied.message else dialogue(request.actor, reply.label, reply.text, fetch.source, bundle.origin) })
            }
          }
        }
      }
    }
  }

pure func anyOffered(s: PlayState, task: string) -> bool = match head(filter(\t. t.id == task, s.session.state.tasks)) {
  Some(t) => t.status == Offered,
  None => false
}

func askProject(r: Run, task: string) -> Result[Applied, string] ! {IO, FS, AI} =
  match head(filter(\b. b.task == task, r.ui.session.bindings)) {
    None => Err("Unknown project"),
    Some(b) => {
      let id = "reply-${r.ui.nextId}"
      match commit(r, command("ask", [kv("actor", js(b.worker)), kv("task", js(task)), kv("id", js(id))]), r.ui.seed, "response", id, r.ui.nextId + 1, jo([]), 0) {
        Err(e) => Err(e),
        Ok(a) => if a.failed then Ok(a) else respond(a.run, false)
      }
    }
  }

func act(r: Run, i: Intent) -> Result[Applied, string] ! {IO, FS, AI} = if i.kind == "offer" then {
  let id = "project-${r.ui.nextId}"
  match commit(r, command("offer", [kv("worker", js(i.worker)), kv("recipe", js(i.recipe)), kv("id", js(id))]), r.ui.seed, "main", "", r.ui.nextId + 1, jo([]), 0) {
    Err(e) => Err(e),
    Ok(a) => if a.failed then Ok(a) else askProject(a.run, id)
  }
} else if i.kind == "review_start" then Ok({ run: { r | ui: { r.ui | phase: "start", target: i.target } }, failed: false, message: "Review the existing offer; the crew agreement is unchanged." }) else if i.kind == "ask" then askProject(r, i.target) else if i.kind == "retry" || i.kind == "authored" then respond(r, i.kind == "authored") else if i.kind == "start" then commit(r, command("start_task", [kv("task", js(i.target))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "cancel" then commit(r, command("cancel_request", [kv("id", js(i.target))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "grant" || i.kind == "deny" then commit(r, command("resolve_relief", [kv("id", js(i.target)), kv("release", jb(i.kind == "grant"))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "advance" then commit(r, command("advance", [kv("tick", jint(r.ui.session.state.tick + 1)), kv("budget", jint(64))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "continue" then match r.ui.session.state.continuation {
  Some(t) => commit(r, command("advance", [kv("tick", jint(t.target)), kv("budget", jint(64))]), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0),
  None => Err("No pending advance")
} else if i.kind == "abort" then commit(r, command("abort", []), r.ui.seed, "main", "", r.ui.nextId, jo([]), 0) else if i.kind == "relief_choice" then Ok({ run: { r | ui: { r.ui | phase: "relief", target: i.target } }, failed: false, message: "" }) else if i.kind == "back" then Ok({ run: { r | ui: { r.ui | phase: "main", target: "" } }, failed: false, message: "" }) else if i.kind == "working" || i.kind == "offered" || i.kind == "reliefs" then Ok({ run: { r | ui: { r.ui | phase: i.kind, target: "" } }, failed: false, message: "" }) else Err("Unknown captain action")

func status(r: Run) -> () ! {IO} {
  println(dashboard(r.ui.session, r.remaining))
  println(if r.mode == "offline" then "Dialogue: saved or stock wording / OFFLINE / no AI calls" else "Dialogue: LIVE / AI attempts remaining ${show(r.remaining)}")
}

func finish(r: Run) -> () ! {IO, FS} =
  match appendRun(r.path, envelope(r.ui.seq + 1, jo([kv("kind", js("quit")), kv("seed", jint(r.ui.seed))]))) {
    Err(e) => {
      println(if r.modern then safeText("Journal failed: ${e}") else "Journal failed: ${e}")
      exit(1)
    },
    Ok(_) => if r.modern then {
      println("")
      println(journeyRecap(r.ui, r.path))
    } else println(recap(r.ui.session, r.path))
  }

func loop(r: Run) -> () ! {IO, FS, AI} = if r.modern then journeyLoop(r) else {
  status(r)
  if r.lastMessage != "" then println(r.lastMessage) else ()
  println(guidance(r.ui.session, r.ui.phase, r.ui.target))
  println(menu(r.ui))
  let line = readLine()
  if line == "" then finish(r) else if r.lines >= 10000 || stringLength(line) > 65536 then {
    println("Input limit reached; previous committed journal retained")
    exit(1)
  } else match route(r.ui, line) {
    Err(e) => loop({ r | lines: r.lines + 1, lastMessage: e }),
    Ok(i) => if i.kind == "quit" then finish(r) else if i.kind == "status" then {
      loop({ r | lines: r.lines + 1 })
    } else if i.kind == "help" then {
      loop({ r | lines: r.lines + 1, lastMessage: help(r.ui.session, r.ui.phase, r.ui.target, r.mode, r.remaining) })
    } else match act({ r | lines: r.lines + 1 }, i) {
      Err(e) => {
        println(e)
        exit(1)
      },
      Ok(a) => if a.failed then {
        loop({ a.run | ui: recover(a.run.ui), lastMessage: "${a.message}\nAction not completed; returning to the bridge." })
      } else loop({ a.run | lastMessage: if a.message == "" then a.run.lastMessage else a.message })
    }
  }
}

func waiting(r: Run) -> () ! {IO} = if not r.modern then () else {
  let f = screen(r.dimensions, r.ansi, ["Stapledon's Voyage / crew reply", "Request recorded; awaiting crew reply."], "HEARING THE CREW\nLooking for a matching saved response. In live mode, a library miss may call AI within the allowance. No answer or consequence is committed yet.", ["Please wait; next decision follows."], 0)
  if r.ansi then print(f.text) else println(f.text)
  flush()
}

func journeyLoop(r: Run) -> () ! {IO, FS, AI} = {
  let f = frame(r.ui, r.nav, r.lastMessage, r.mode, r.remaining, r.path, r.dimensions, r.ansi)
  print(f.text)
  print("Choose > ")
  flush()
  let line = readLine()
  if not r.ansi then println("") else ()
  if line == "" then finish(r) else if r.lines >= 10000 || stringLength(line) > 65536 then {
    println("Input limit reached; previous committed journal retained")
    exit(1)
  } else {
    let nav = navigation(r.ui, { r.nav | page: f.page }, line)
    if nav.handled then journeyLoop({ r | nav: nav.nav, lines: r.lines + 1 }) else match route(r.ui, line) {
      Err(e) => journeyLoop({ r | lastMessage: e, nav: { r.nav | view: "bridge", page: 0 }, lines: r.lines + 1 }),
      Ok(i) => if i.kind == "quit" then finish(r) else match act({ r | lines: r.lines + 1 }, i) {
        Err(e) => {
          println(safeText(e))
          exit(1)
        },
        Ok(a) => {
          let detail = if a.run.ui.seq > r.ui.seq then indicatorChanges(r.ui.session, a.run.ui.session) else ""
          let message = if a.message == "" then a.run.lastMessage else "${a.message}${detail}"
          let published = a.run.ui.seq > r.ui.seq && a.message != ""
          let readNav = if published then remember(a.run.nav, message) else { a.run.nav | view: "bridge", page: 0 }
          journeyLoop({ a.run | ui: if a.failed then recover(a.run.ui) else a.run.ui, nav: readNav, lastMessage: if a.failed then "${message}\nAction not completed; you can choose again." else message })
        }
      }
    }
  }
}

func envNumber(name: string, fallback: int) -> int ! {Env} = match stringToInt(getEnvOr(name, "")) {
  Some(n) => n,
  None => fallback
}

func choosePolicy(mode: string, seed: int, d: Dimensions, ansi: bool, page: int, inputs: int) -> string ! {IO} = {
  let f = screen(d, ansi, ["Stapledon's Voyage / Bridge", "Before first hello / preparation 0/8", "Seed ${show(seed)}; reading costs no turns"], opening(mode, seed), ["1 Consent: crew must agree", "2 Orders: refusal may cost trust", "0 Quit /n Next /v Previous", "Key + Enter; blank line ends this run."], page)
  print(f.text)
  print("Choose > ")
  flush()
  let key = readLine()
  if not ansi then println("") else ()
  if not onboardingAllowed(inputs, stringLength(key)) then {
    println("Onboarding input limit reached; no game commands recorded.")
    exit(1)
  } else ()
  if key == "" || key == "0" then {
    println("Preparation not started. No game commands recorded.")
    exit(0);
    ""
  } else if key == "n" then choosePolicy(mode, seed, d, ansi, f.page + 1, inputs + 1) else if key == "v" then choosePolicy(mode, seed, d, ansi, if f.page <= 0 then 0 else f.page - 1, inputs + 1) else if key == "1" || key == "2" then key else {
    println("Choose 1 Consent or 2 Orders, or read n/v.")
    choosePolicy(mode, seed, d, ansi, f.page, inputs + 1)
  }
}

func launch(mode: string, modern: bool) -> () ! {IO, Env, FS, AI} = {
  let home = getEnvOr("HOME", "")
  let envDims = dimensions(envNumber("COLUMNS", 80), envNumber("LINES", 24))
  let flags = if modern then journeyOptions(getArgs(), envDims.columns, envDims.rows, styleDefault(getEnvOr("TERM", ""), hasEnv("NO_COLOR"))) else Ok({ args: getArgs(), columns: 80, rows: 28, ansi: false })
  match flags {
    Err(e) => {
      println(if modern then safeText(e) else e)
      exit(1)
    },
    Ok(f) => match parseArgs(f.args, "${home}/.ailang/crew-lab") {
      Err(e) => {
        println(if modern then safeText(e) else e)
        exit(1)
      },
      Ok(o) => {
        let d = dimensions(f.columns, f.rows)
        if modern then () else {
          println(briefing(mode))
          if o.hasSeed then println("Seed ${show(o.seed)}: the same seed, policy, library and choices repeat the variation.") else ()
          println(policyBrief())
        }
        let policyChoice = if modern then choosePolicy(mode, o.seed, d, f.ansi, 0, 0) else readLine()
        let seed = if o.hasSeed then Ok(o.seed) else {
          println(seedBrief())
          seedNumber(readLine())
        }
        match seed {
          Err(e) => {
            println(if modern then safeText(e) else e)
            exit(1)
          },
          Ok(seedValue) => match (begin(policyChoice, seedValue), loadPolicy(o.home)) {
            (Err(e), _) => {
              println(if modern then safeText(e) else e)
              exit(1)
            },
            (_, Err(e)) => {
              println(if modern then safeText(e) else e)
              exit(1)
            },
            (Ok(ui), Ok(config)) => {
              let c = command("start", [kv("policy", js(ui.session.policy))])
              match start(c) {
                Err(_) => {
                  println("Startup failed")
                  exit(1)
                },
                Ok(initialHost) => {
                  let header = envelope(0, jo([kv("kind", js("start")), kv("host_input", js(c)), kv("host_output", js(initialHost.trace)), kv("seed", jint(seedValue)), kv("policy_body", js(config.body)), kv("model", js(model())), kv("mode", js(mode))]))
                  match openRun(o.home, "${getPid()}-${seedValue}", header) {
                    Err(e) => {
                      println(if modern then safeText("Run ownership/journal failed: ${e}") else "Run ownership/journal failed: ${e}")
                      exit(1)
                    },
                    Ok(path) => {
                      if modern then () else println("Welcome to the bridge. Choose your next captain action.")
                      loop({ ui: ui, home: o.home, path: path, policy: config.policy, policyBody: config.body, mode: mode, remaining: config.policy.callLimit, lines: if o.hasSeed then 1 else 2, lastMessage: "", modern: modern, nav: initial(), dimensions: d, ansi: f.ansi })
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

-- CLI contracts state the unit-return interface only; installed integration tests
-- validate publication, usage and dialogue behaviour across these effects.
export func main() -> () ! {IO, Env, FS, AI}
ensures { result == () } = launch("live", false)

export func offline() -> () ! {IO, Env, FS, AI}
ensures { result == () } = launch("offline", false)

-- The public adapter accepts only supported dialogue modes. Effectful launch
-- behaviour is established by the installed CLI controls, not a unit-return proof.
export func launchJourney(mode: string) -> () ! {IO, Env, FS, AI}
requires { mode == "live" || mode == "offline" } = launch(mode, true)
