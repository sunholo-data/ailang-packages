module sunholo/crew_lab/recall_spike
import std/io (println)
import std/fs (readFileResult)
import std/env (getArgs)
import std/json (Json, decode, getString, getNumber, getStringArrayOrEmpty)
import std/list (map, filter, length, flatMap, sortBy, take, nth, mapE, forEachE, foldl, range, zip)
import std/string (split, join, length as size, substring)
import std/option (Option, Some, None)
import std/result (Ok, Err)
import std/math (floatToInt, intToFloat)
import std/embedding (cosine)
import ./memory (Entry, Hit, recall, echoes, margin, fixed2)

-- Spike: is local embedding good enough for crew memory? Reads the crew_sample/1
-- files from the Stapledon pack review (two wordings per moment), embeds every
-- line with a local Ollama model, and reports:
--  1. calibration: how alike two wordings of the same moment are, versus lines
--     from different moments, actors and scenarios;
--  2. echoes: same-actor lines from different moments that read as repeats;
--  3. recall: treating the six scenarios as consecutive chapters of one voyage,
--     the earlier line each crew member would be reminded of.
-- Usage: ailang run --caps IO,FS,Env --entry main recall_spike.ail MODEL FILE...
type Line = {moment:int, chapter:int, actor:string, project:string, reaction:string, variant:int, text:string}

pure func str(j:Json, k:string) -> string = match getString(j, k) {Some(s) => s, None => ""}

pure func linesOf(chapter:int, body:string) -> [Line] = {
 let rows = filter(\r. size(r) > 0, split(body, "\n"));
 flatMap(\i. match nth(rows, i) {
  None => [],
  Some(r) => match decode(r) {
   Err(_) => [],
   Ok(j) => {
    let ws = getStringArrayOrEmpty(j, "words");
    map(\v. {moment:chapter * 1000 + i, chapter:chapter, actor:str(j, "actor"), project:str(j, "project"), reaction:str(j, "reaction"), variant:v, text:match nth(ws, v) {Some(w) => w, None => ""}}, range(0, length(ws)))
   }
  }
 }, range(0, length(rows)))
}

func embed(model:string, prefix:string, text:string) -> [float] ! {IO} = _ollama_embed(model, "${prefix}${text}")

pure func median(xs:[float]) -> float = match nth(sortBy(\a b. if a < b then -1 else if a > b then 1 else 0, xs), length(xs) / 2) {Some(x) => x, None => 0.0}
pure func lo(xs:[float]) -> float = foldl(\a x. if x < a then x else a, 1.0, xs)
pure func hi(xs:[float]) -> float = foldl(\a x. if x > a then x else a, -1.0, xs)
pure func summary(name:string, xs:[float]) -> string = "${name}: n=${show(length(xs))} min ${fixed2(lo(xs))} median ${fixed2(median(xs))} max ${fixed2(hi(xs))}"
pure func above(xs:[float], t:float) -> int = length(filter(\x. x >= t, xs))
pure func share(xs:[float], t:float) -> string = "${show(above(xs, t))}/${show(length(xs))}"

type Pair = {a:Line, b:Line, score:float}
pure func pairs(ls:[(Line, [float])]) -> [Pair] = {
 let n = length(ls);
 flatMap(\i. flatMap(\k. match (nth(ls, i), nth(ls, k)) {
  (Some((a, va)), Some((b, vb))) => [{a:a, b:b, score:cosine(va, vb)}],
  _ => []
 }, range(i + 1, n)), range(0, n))
}

pure func clip(s:string) -> string = if size(s) > 110 then "${substring(s, 0, 107)}..." else s

-- calibration: four kinds of pair, then the thresholds that separate them.
pure func calibration(ps:[Pair]) -> [string] = {
 let para = map(\p. p.score, filter(\p. p.a.moment == p.b.moment, ps));
 let firsts = filter(\p. p.a.variant == 0 && p.b.variant == 0 && p.a.moment != p.b.moment, ps);
 let sameActor = map(\p. p.score, filter(\p. p.a.chapter == p.b.chapter && p.a.actor == p.b.actor, firsts));
 let otherActor = map(\p. p.score, filter(\p. p.a.chapter == p.b.chapter && p.a.actor != p.b.actor, firsts));
 let otherChapter = map(\p. p.score, filter(\p. p.a.chapter != p.b.chapter, firsts));
 [summary("same moment, two wordings  ", para), summary("same actor, other moment   ", sameActor), summary("same scenario, other actor ", otherActor), summary("other scenario             ", otherChapter)]
 ++ map(\t. "at >= ${fixed2(t)}: wordings ${share(para, t)}  same-actor ${share(sameActor, t)}  other-actor ${share(otherActor, t)}  other-scenario ${share(otherChapter, t)}", [0.80, 0.85, 0.90, 0.95])
}

pure func echoLines(ps:[Pair], t:float) -> [string] = {
 let hits = take(6, sortBy(\x y. if x.score > y.score then -1 else if x.score < y.score then 1 else 0, filter(\p. p.a.moment != p.b.moment && p.a.actor == p.b.actor && p.score >= t, ps)));
 ["same actor, different moments, cosine >= ${fixed2(t)}: ${show(length(filter(\p. p.a.moment != p.b.moment && p.a.actor == p.b.actor && p.score >= t, ps)))} pairs; strongest:"]
 ++ flatMap(\p. ["  ${fixed2(p.score)} ${p.a.actor} [${show(p.a.chapter)}:${p.a.project}] ${clip(p.a.text)}", "       [${show(p.b.chapter)}:${p.b.project}] ${clip(p.b.text)}"], hits)
}

func recallReport(model:string, ls:[Line], vs:[[float]]) -> [string] ! {IO} = {
 -- Memory: every first wording, as an Entry ticked by chapter.
 let entries = flatMap(\lv. match lv {(l, v) => if l.variant == 0 then [{id:l.moment, actor:l.actor, tick:l.chapter, text:"[${show(l.chapter)}:${l.project}] ${l.text}", vec:v}] else []}, zip(ls, vs));
 let asks = filter(\l. l.variant == 0 && l.chapter >= 2, ls);
 let out = mapE(\l. {
  let q = embed(model, "task: search result | query: ", "The ${l.actor} is asked: ${l.project}. They ${l.reaction}.");
  let hs = recall(entries, q, l.actor, l.chapter, 2, 0.0);
  match hs {
   [] => [],
   [h, ..._] => ["  ch${show(l.chapter)} ${l.actor} asked \"${l.project}\" (${l.reaction}) -> ${fixed2(h.score)} margin ${fixed2(margin(hs))}", "      recalls ${clip(h.entry.text)}"]
  }
 }, asks);
 flatMap(\x. x, out)
}

func run(model:string, prefix:string, files:[string]) -> () ! {IO, FS} = {
 let chapters = flatMap(\i. match nth(files, i) {
  None => [],
  Some(f) => match readFileResult(f) {Ok(b) => linesOf(i + 1, b), Err(e) => { println("skip ${f}: ${e}"); [] }}
 }, range(0, length(files)));
 let ls = filter(\l. size(l.text) > 0, chapters);
 println("== model ${model}, prefix \"${prefix}\", ${show(length(ls))} lines from ${show(length(files))} scenarios");
 let vs = mapE(\l. embed(model, prefix, l.text), ls);
 let ps = pairs(zip(ls, vs));
 println("-- 1. calibration");
 forEachE(\s. println(s), calibration(ps));
 println("-- 2. echoes");
 forEachE(\s. println(s), echoLines(ps, 0.90));
 if prefix == "" then () else {
  println("-- 3. recall (earlier chapters, same crew member)");
  forEachE(\s. println(s), recallReport(model, ls, vs));
  ()
 }
}

export func main() -> () ! {IO, FS, Env} = match getArgs() {
 [model, ...files] => {
  run(model, "", files);
  run(model, "title: none | text: ", files)
 },
 _ => println("usage: recall_spike MODEL FILE...")
}
