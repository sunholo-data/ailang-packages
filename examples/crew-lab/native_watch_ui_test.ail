module sunholo/crew_lab/native_watch_ui_test
import std/option (Some, None)
import std/list (head,length)
import ./session (offer,ask,complete)
import ./reactions (fixtureBody)
import std/result (Ok, Err)
import pkg/sunholo/terminal_ui/events (Input, Sized, NoInput, Finished, Cancelled, Next, Accept, Cancel, Character)
import ./play_flow (beginWatch,beginConversationWatch)
import ./native_watch_ui (initial, decision, update, choices,selected, Decision, Guide, Quit)

test "intro choices explain consent and authority before selecting" {
 let cs = choices(None);
 match cs { a::b::[] => a.key == "1" && b.key == "2" && a.preview == "Start requires the worker's agreement." && b.preview == "Start despite refusal; trust can fall.", _ => false }
}
test "tiny view cannot dispatch invisible Start or policy choices" {
 let u=initial(20,8,false);
 update(None,u,Input(Accept)).command==None && update(None,u,Input(Character("1"))).command==None && update(None,u,Input(Character("q"))).quit
}
test "invalid external dimensions normalize positive before calling viewport" {
 let u=initial(398,0-911,false);
 let r=update(None,u,Sized(0,0));
 u.dimensions.columns==160 && u.dimensions.rows==1 && r.ui.dimensions.columns==1 && r.ui.dimensions.rows==1
}
test "literal zero asks before quitting intro but returns from displayed proposal" {
 let u=initial(80,24,false);
 let intro=update(None,u,Input(Character("0")));
 match beginWatch("1",42) {Err(_)=>false,Ok(s)=>{
 let p={s|phase:"start",target:"proposal"};
 let before=decision(p,80,24,false);
 intro.command==None && intro.ui.view==Quit && not intro.quit && update(Some(p),before,Input(Character("0"))).command==Some("0") && update(Some(p),before,Input(Character("b"))).command==Some("0")
 }}
}
test "quit modal cannot dispatch domain numbers and preserves safe proposal default" {
 match beginWatch("2",73) {Err(_)=>false,Ok(s)=>{
 let p={s|phase:"start",target:"proposal"};
 let u={decision(p,80,24,false)|page:3};
 let q=update(Some(p),u,Input(Character("q")));
 let bad=update(Some(p),q.ui,Input(Character("1")));
 let back=update(Some(p),bad.ui,Input(Cancel));
 let chosen=update(Some(p),back.ui,Input(Accept));
 bad.command==None && bad.ui.view==Quit && back.ui.cursor==1 && back.ui.page==3 && chosen.command==Some("2")
 }}
}
test "idle is exact UI identity and emits no action" {
 let u = initial(80,24,false);
 let r = update(None,u,NoInput);
 r.ui == u && r.command == None && not r.quit
}
test "resize keeps current decision and cursor even below minimum" {
 let u = { initial(80,24,false) | cursor:1, page:4 };
 let r = update(None,u,Sized(20,8));
 r.ui.dimensions.columns == 20 && r.ui.dimensions.rows == 8 && r.ui.cursor == 1 && r.ui.page == 4 && r.command == None
}
test "arrows select and enter emits stable policy number" {
 let a = update(None,initial(80,24,false),Input(Next));
 let b = update(None,a.ui,Input(Accept));
 b.command == Some("2") && not b.quit
}
test "escape opens quit confirmation with keep playing selected" {
 let a = update(None,initial(80,24,false),Input(Cancel));
 let b = update(None,a.ui,Input(Accept));
 a.ui.view == Quit && b.ui.view != Quit && not b.quit && b.command == None
}
test "EOF and interruption end immediately while q asks before quitting" {
 let u = initial(40,16,true);
 update(None,u,Finished).quit && update(None,u,Cancelled).quit && not update(None,u,Input(Character("q"))).quit && update(None,u,Input(Character("q"))).ui.view == Quit
}
test "pending proposal defaults decide later and navigation emits no domain command" {
 match beginWatch("2",73) {
  Err(_) => false,
  Ok(s) => {
   let p = {s | phase:"start",target:"proposal"};
   let u = decision(p,80,24,false);
   let help = update(Some(p),u,Input(Character("h")));
   let back = update(Some(p),help.ui,Input(Cancel));
   let chosen = update(Some(p),back.ui,Input(Accept));
   u.cursor == 1 && help.ui.view == Guide && back.ui.view == Decision && chosen.command == Some("2")
  }
 }
}

test "reopening a concerned authority offer defaults to Decide later not Start" {
 match beginConversationWatch("2",34500) {Err(_)=>false,Ok(p)=>match offer(p.session,"medic","work_medic","diagnostics") {Err(_)=>false,Ok(o)=>match ask(o.session,"medic","diagnostics","medic-first") {Err(_)=>false,Ok(a)=>match head(a.session.pending) {None=>false,Some(r)=>match complete(a.session,r.id,fixtureBody(r,"concern"),0.0) {Err(_)=>false,Ok(c)=>{
 let reopened={p|session:c.session,phase:"start",target:"diagnostics"};
 let u=decision(reopened,40,16,false);
 (match selected(Some(reopened),u) {None=>false,Some(c)=>c.key=="2" && c.label=="Decide later"}) && update(Some(reopened),u,Input(Accept)).command==Some("2") && length(choices(Some(reopened)))==4
 }}}}}}
}
