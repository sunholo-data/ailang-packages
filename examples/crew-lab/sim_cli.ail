module sunholo/crew_lab/sim_cli
import std/io (println, exit)
import std/fs (readFileResult)
import std/env (getArgs)
import std/result (Result, Ok, Err)
import std/option (Option, Some, None)
import std/list (map, filter, foldl, length, head, any, range, sortBy, nth, flatMap, forEachE)
import std/string (join, split, stringToInt, trim)
import std/json (Json, JObject, JNumber, decode)
import std/math (intToFloat, floatToInt, floor)
import std/crypto (sha256Hex)
import pkg/sunholo/crew_core/scenario (Scenario, decodeScenario, scenarioHash)
import pkg/sunholo/crew_core/example (firstContactJson)
import pkg/sunholo/crew_core/policy (Policy, decodePolicy, watchPolicyBody)
import ./crew_sim (play, playArchived, playAuto, playAs, report, escalationKeys, populationFields)
import pkg/sunholo/crew_core/auto (Rule, Orders, decodeEscalation, advanceAuto, consentOrders, ordersOrders)
import pkg/sunholo/crew_core/session (start, untraced, encodeHostError)
import std/json (encode, jo, kv, js, jint)
import ./bubble (lintPack)
import ./claims (Claim, Verdict, decodeClaims, judge, line, captains)

export type Options = {scenario: string, policy: string, captain: string, first: int, last: int, turns: int, summary: string, check: string, bubble: bool, archive: int, auto: string, skip: int, cadence: int, profile: string, concerns: string} deriving (Eq)

pure func defaults() -> Options = {scenario: "", policy: "", captain: "consent", first: 1, last: 20, turns: 12, summary: "", check: "", bubble: false, archive: 0, auto: "", skip: 0, cadence: 1, profile: "", concerns: "escalate"}

pure func seedRange(text: string) -> Result[{first: int, last: int}, string] = match split(text, "..") {
 [a] => match stringToInt(a) { Some(n) => if n >= 1 && n <= 2147483646 then Ok({first: n, last: n}) else Err("seed out of range"), None => Err("--seeds takes N or A..B") },
 [a, b] => match (stringToInt(a), stringToInt(b)) {
  (Some(x), Some(y)) => if x >= 1 && y >= x && y <= 2147483646 && y - x < 100000 then Ok({first: x, last: y}) else Err("--seeds A..B needs 1 <= A <= B and at most 100000 seeds"),
  _ => Err("--seeds takes N or A..B")
 },
 _ => Err("--seeds takes N or A..B")
}

export pure func parse(xs: [string], o: Options) -> Result[Options, string]
ensures { match result { Ok(r) => r.first >= 1 && r.last >= r.first && r.turns >= 1 && r.turns <= 500, Err(_) => true } } = match xs {
 [] => if o.first >= 1 && o.last >= o.first && o.turns >= 1 && o.turns <= 500 then Ok(o) else Err("invalid options"),
 "--scenario" :: p :: rest => parse(rest, {o | scenario: p}),
 "--policy" :: p :: rest => parse(rest, {o | policy: p}),
 "--captain" :: c :: rest => if c == "consent" || c == "orders" || c == "random" then parse(rest, {o | captain: c}) else Err("--captain must be consent, orders or random"),
 "--seeds" :: r :: rest => match seedRange(r) { Ok(x) => parse(rest, {o | first: x.first, last: x.last}), Err(e) => Err(e) },
 "--turns" :: n :: rest => match stringToInt(n) { Some(t) => if t >= 1 && t <= 500 then parse(rest, {o | turns: t}) else Err("--turns must be 1..500"), None => Err("--turns must be a whole number") },
 "--summary" :: p :: rest => parse(rest, {o | summary: p}),
 "--check" :: p :: rest => parse(rest, {o | check: p}),
 "--bubble" :: rest => parse(rest, {o | bubble: true}),
 "--auto" :: p :: rest => parse(rest, {o | auto: p}),
 "--skip" :: n :: rest => match stringToInt(n) { Some(k) => if k >= 1 && k <= 100000 then parse(rest, {o | skip: k}) else Err("--skip must be 1..100000"), None => Err("--skip must be a whole number") },
 "--cadence" :: n :: rest => match stringToInt(n) { Some(k) => if k >= 1 && k <= 365 then parse(rest, {o | cadence: k}) else Err("--cadence must be 1..365"), None => Err("--cadence must be a whole number") },
 "--archive" :: n :: rest => match stringToInt(n) { Some(k) => if k >= 0 && k <= 10000 then parse(rest, {o | archive: k}) else Err("--archive must be 0..10000"), None => Err("--archive must be a whole number") },
 "--profile" :: v :: rest => if v == "v2" || v == "v3" then parse(rest, {o | profile: v}) else Err("--profile must be v2 or v3"),
 "--concerns" :: c :: rest => parse(rest, {o | concerns: c}),
 "--help" :: _ => Err("help"),
 x :: _ => Err("unknown argument ${x}")
}

pure func usage() -> string =
 "crew-sim: batch runs of the captain/crew host without AI.\n  crew-sim [--scenario FILE] [--policy FILE] [--captain consent|orders|random] [--seeds A..B] [--turns N] > runs.ndjson\n  crew-sim --summary runs.ndjson\n  crew-sim --check claims.json [--scenario FILE] [--policy FILE] [--seeds A..B] [--turns N]   (exit 1 if a claim fails)\n  crew-sim ... --auto escalation.json   (count crew_escalation/1 rules per run under the auto-captain; measure escalations.<rule>)\n  crew-sim --skip N [--cadence C] [--captain consent|orders] [--auto rules.json]   (the game's skip: one advanceAuto call)\n  crew-sim ... --archive N   (crew_core archiving: fold finished work older than N turns)\n  crew-sim ... --profile v2|v3   (host profile; v3, with conversations as the game runs, is the default with --auto or --skip)\n  crew-sim ... --concerns escalate|APPROACH   (the auto-captain standing order for open concerns; default escalate)\n  crew-sim --bubble --scenario FILE   (exit 1 unless it uses only the eight Stapledon bubble resources, with the right kinds)\nDefaults: the first-contact example ship, its authored response policy, consent, seeds 1..20, 12 turns. Runs of 60 turns take a few seconds per seed; longer runs slow down as finished work accumulates.\nOne JSON line per seed; the same inputs always give the same output."

func readOr(path: string, fallback: string) -> Result[string, string] ! {FS} =
 if path == "" then Ok(fallback) else match readFileResult(path) { Ok(b) => Ok(b), Err(e) => Err("cannot read ${path}: ${e}") }

-- ---------------------------------------------------------------- summary

type Sample = {path: string, value: float} deriving (Eq)

pure func leaves(prefix: string, j: Json) -> [Sample] = match j {
 JNumber(n) => [{path: prefix, value: n}],
 JObject(kvs) => flatMap(\p. leaves(if prefix == "" then p.key else "${prefix}.${p.key}", p.value), kvs),
 _ => []
}

pure func paths(xs: [Sample], seen: [string]) -> [string] = match xs {
 [] => seen,
 x :: rest => paths(rest, if any(\p. p == x.path, seen) then seen else seen ++ [x.path])
}

pure func at(sorted: [float], q: float) -> float = {
 let n = length(sorted);
 let pos = q * intToFloat(n - 1);
 let lo = floatIndex(pos);
 let frac = pos - intToFloat(lo);
 match (nth(sorted, lo), nth(sorted, if lo + 1 < n then lo + 1 else lo)) {
  (Some(a), Some(b)) => a + (b - a) * frac,
  _ => 0.0
 }
}

pure func floatIndex(x: float) -> int = floatToInt(floor(x))

pure func fmt(x: float) -> string = show(floor(x * 10.0 + 0.5) / 10.0)

export pure func summarise(lines: [string]) -> string
ensures { result != "" } = {
 let rows = flatMap(\l. match decode(l) { Ok(j) => [j], Err(_) => [] }, filter(\l. trim(l) != "", lines));
 let samples = flatMap(\j. leaves("", j), rows);
 let ps = filter(\p. p != "seed" && p != "turns", paths(samples, []));
 let header = "${show(length(rows))} runs. Median [25th..75th percentile] (min..max). No ranking: compare runs, not winners.";
 join("\n", header :: map(\p. {
  let vs = sortBy(\a b. if a < b then 0 - 1 else if a > b then 1 else 0, map(\s. s.value, filter(\s. s.path == p, samples)));
  "${p}: ${fmt(at(vs, 0.5))} [${fmt(at(vs, 0.25))}..${fmt(at(vs, 0.75))}] (${fmt(at(vs, 0.0))}..${fmt(at(vs, 1.0))})"
 }, ps))
}

-- ---------------------------------------------------------------- claims

-- Each captain the claims mention plays every seed once; each claim is judged
-- on its captain's crew_sim/1 lines. Pure: same inputs, same verdicts.
export pure func checkRuns(sc: Scenario, policy: Policy, pb: string, cs: [Claim], first: int, last: int, turns: int) -> Result[[Verdict], string]
ensures { match result { Ok(vs) => length(vs) == length(cs), Err(_) => true } } = checkArchived(sc, policy, pb, cs, first, last, turns, 0)

export pure func checkArchived(sc: Scenario, policy: Policy, pb: string, cs: [Claim], first: int, last: int, turns: int, archive: int) -> Result[[Verdict], string]
ensures { match result { Ok(vs) => length(vs) == length(cs), Err(_) => true } } = checkAuto(sc, policy, pb, cs, first, last, turns, archive, [])

export pure func checkAuto(sc: Scenario, policy: Policy, pb: string, cs: [Claim], first: int, last: int, turns: int, archive: int, rules: [Rule]) -> Result[[Verdict], string]
ensures { match result { Ok(vs) => length(vs) == length(cs), Err(_) => true } } = checkAs(sc, policy, pb, cs, first, last, turns, archive, rules, "v2", "escalate")

export pure func checkAs(sc: Scenario, policy: Policy, pb: string, cs: [Claim], first: int, last: int, turns: int, archive: int, rules: [Rule], profile: string, concerns: string) -> Result[[Verdict], string]
ensures { match result { Ok(vs) => length(vs) == length(cs), Err(_) => true } } = {
 let runs = map(\k. {captain: k, rows: map(\seed. match playAs(sc, policy, k, seed, turns, 0, archive, rules, profile, concerns) {
   Err(e) => Err(e),
   Ok(sim) => match decode(report(sim, seed, turns, scenarioHash(sc), sha256Hex(pb))) { Ok(j) => Ok(j), Err(e) => Err(e) }
  }, range(first, last + 1))}, captains(cs));
 match head(flatMap(\r. flatMap(\x. match x { Err(e) => [e], Ok(_) => [] }, r.rows), runs)) {
  Some(e) => Err(e),
  None => Ok(map(\c. judge(c, flatMap(\r. if r.captain == c.captain then flatMap(\x. match x { Ok(j) => [j], Err(_) => [] }, r.rows) else [], runs)), cs))
 }
}

-- ---------------------------------------------------------------- main

func checkMain(o: Options, sc: Scenario, policy: Policy, pb: string, rules: [Rule]) -> () ! {IO, FS} = match readFileResult(o.check) {
 Err(e) => { println("cannot read ${o.check}: ${e}"); exit(1) },
 Ok(body) => match decodeClaims(sc, body) {
  Err(e) => { println("invalid claims: ${e}"); exit(1) },
  Ok(cs) => match (if o.skip > 0 then checkSkip(o, sc, policy, cs, rules) else checkAs(sc, policy, pb, cs, o.first, o.last, o.turns, o.archive, rules, profileOf(o), o.concerns)) {
   Err(e) => { println("run failed: ${e}"); exit(1) },
   Ok(vs) => {
    forEachE(\v. println(line(v)), vs);
    let failing = length(filter(\v. not v.holds, vs));
    println("${show(length(vs) - failing)} of ${show(length(vs))} claims hold (seeds ${show(o.first)}..${show(o.last)}, ${if o.skip > 0 then "a skip of ${show(o.skip)} turns at cadence ${show(o.cadence)}" else "${show(o.turns)} turns"}).");
    if failing > 0 then exit(1) else ()
   }
  }
 }
}

-- --skip N: one advanceAuto call (the game's skip) from a fresh start under the
-- captain's preset orders at --cadence, stopping at the first escalation of
-- --auto rules. Prints where it stopped.
pure func preset(o: Options) -> Orders = { let base = if o.captain == "orders" then ordersOrders() else consentOrders(); {base | cadence: o.cadence, concerns: o.concerns} }

-- The host profile: --profile, else v3 (the game's) for auto-captain runs
-- with escalation rules or a skip, else v2 (crew_core 0.4.1).
export pure func profileOf(o: Options) -> string = if o.profile != "" then o.profile else if o.auto != "" || o.skip > 0 then "v3" else "v2"

-- One skip as a crew_skip/1 line: where it stopped, what the auto-captain
-- did, the escalation that stopped it (counted under escalations.<rule>, and
-- escalations.cohort:<id> for cohort rules) and, with cohorts, the
-- population measures.
export pure func skipRow(o: Options, sc: Scenario, policy: Policy, rules: [Rule], seed: int) -> Result[string, string] ! {}
ensures { match result { Ok(r) => r != "", Err(_) => true } } = match start(sc, "{\"command\":\"start\",\"policy\":\"${if o.captain == "orders" then "orders" else "consent"}\",\"scenario\":\"watch-${profileOf(o)}\"${if o.archive > 0 then ",\"keep\":${show(o.archive)}" else ""}}") {
 Err(e) => Err(encodeHostError(e)),
 Ok(st) => match advanceAuto(untraced(st.session), {seed: seed, agreed: [], raised: [], calls: 0}, policy, preset(o), rules, o.skip) {
  Err(e) => Err(encodeHostError(e)),
  Ok(a) => Ok(encode(jo([kv("schema", js("crew_skip/1")), kv("captain", js(o.captain)), kv("seed", jint(seed)), kv("cadence", jint(o.cadence)), kv("asked", jint(o.skip)), kv("turns", jint(a.turns)), kv("tick", jint(a.session.state.tick)), kv("decisions", jint(length(filter(\x. x.kind == "reply", a.log)))), kv("offers", jint(length(filter(\x. x.kind == "offer", a.log)))), kv("starts", jint(length(filter(\x. x.kind == "start", a.log)))), kv("refusals", jint(length(filter(\x. x.kind == "refusal", a.log)))), kv("errors", jint(length(filter(\x. x.kind == "error", a.log)))), kv("first_error", js(match head(filter(\x. x.kind == "error" || x.kind == "refusal", a.log)) { Some(x) => x.detail, None => "" })), kv("escalated", match a.escalated { Some(e) => jo([kv("rule", js(e.rule)), kv("actor", js(e.actor)), kv("tick", jint(e.tick)), kv("detail", js(e.detail))]), None => js("") }), kv("escalations", jo(match a.escalated { Some(e) => map(\k. kv(k, jint(1)), escalationKeys(e)), None => [] }))] ++ populationFields(a.session))))
 }
}

func skipMain(o: Options, sc: Scenario, policy: Policy, rules: [Rule]) -> () ! {IO} = forEachE(\seed. match skipRow(o, sc, policy, rules, seed) {
 Err(e) => println(e),
 Ok(r) => println(r)
}, range(o.first, o.last + 1))

-- Claims over skips (--check with --skip): each claimed captain skips once
-- per seed; an escalation a skip did not reach counts as 0.
export pure func checkSkip(o: Options, sc: Scenario, policy: Policy, cs: [Claim], rules: [Rule]) -> Result[[Verdict], string] ! {}
ensures { match result { Ok(vs) => length(vs) == length(cs), Err(_) => true } } = {
 let runs = map(\k. {captain: k, rows: map(\seed. match skipRow({o | captain: k}, sc, policy, rules, seed) { Err(e) => Err(e), Ok(r) => match decode(r) { Ok(j) => Ok(j), Err(e) => Err(e) } }, range(o.first, o.last + 1))}, captains(cs));
 match head(flatMap(\r. flatMap(\x. match x { Err(e) => [e], Ok(_) => [] }, r.rows), runs)) {
  Some(e) => Err(e),
  None => Ok(map(\c. judge(c, flatMap(\r. if r.captain == c.captain then flatMap(\x. match x { Ok(j) => [j], Err(_) => [] }, r.rows) else [], runs)), cs))
 }
}

func bubbleMain(sc: Scenario) -> () ! {IO} = match lintPack(sc) {
 [] => println("${sc.id}: bubble resources ok"),
 problems => { forEachE(\p. println("${sc.id}: ${p}"), problems); exit(1) }
}

export func main() -> () ! {IO, FS, Env} = match parse(getArgs(), defaults()) {
 Err("help") => println(usage()),
 Err(e) => { println("${e}\n\n${usage()}"); exit(2) },
 Ok(o) => if o.summary != "" then match readFileResult(o.summary) {
  Err(e) => { println("cannot read ${o.summary}: ${e}"); exit(1) },
  Ok(body) => println(summarise(split(body, "\n")))
 } else match (readOr(o.scenario, firstContactJson()), readOr(o.policy, watchPolicyBody())) {
  (Err(e), _) => { println(e); exit(1) },
  (_, Err(e)) => { println(e); exit(1) },
  (Ok(sb), Ok(pb)) => match (decodeScenario(sb), decodePolicy(pb), match readOr(o.auto, "{\"schema\":\"crew_escalation/1\",\"rules\":[]}") { Ok(b) => decodeEscalation(b), Err(e) => Err(e) }) {
   (Err(e), _, _) => { println("invalid scenario: ${e}"); exit(1) },
   (_, Err(e), _) => { println("invalid policy: ${e}"); exit(1) },
   (_, _, Err(e)) => { println("invalid escalation rules: ${e}"); exit(1) },
   (Ok(sc), Ok(policy), Ok(rules)) => if o.bubble then bubbleMain(sc) else if o.check != "" then checkMain(o, sc, policy, pb, rules) else if o.skip > 0 then skipMain(o, sc, policy, rules) else forEachE(\seed. match playAs(sc, policy, o.captain, seed, o.turns, 0, o.archive, rules, profileOf(o), o.concerns) {
     Err(e) => { println("{\"error\":\"${e}\"}"); exit(1) },
     Ok(sim) => println(report(sim, seed, o.turns, scenarioHash(sc), sha256Hex(pb)))
    }, range(o.first, o.last + 1))
  }
 }
}

test "arguments parse ranges and reject unknown flags" {
 match (parse(["--captain", "orders", "--seeds", "3..9", "--turns", "6"], defaults()), parse(["--seeds", "9..3"], defaults()), parse(["--captain", "mutiny"], defaults()), parse(["--wat"], defaults())) {
  (Ok(o), Err(_), Err(_), Err(_)) => o.captain == "orders" && o.first == 3 && o.last == 9 && o.turns == 6,
  _ => false
 }
}

test "summary reports median and spread per measure" {
 summarise(["{\"seed\":1,\"offers\":2}", "{\"seed\":2,\"offers\":4}", "{\"seed\":3,\"offers\":9}"]) == "3 runs. Median [25th..75th percentile] (min..max). No ranking: compare runs, not winners.\noffers: 4.0 [3.0..6.5] (2.0..9.0)"
}
