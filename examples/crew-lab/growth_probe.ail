module sunholo/crew_lab/growth_probe
import std/io (println)
import std/fs (readFileResult)
import std/env (getArgs)
import std/list (length, forEachE, filter, map, dedup, take)
import std/result (Ok, Err)
import std/string (stringToInt)
import std/option (Some, None)
import pkg/sunholo/crew_core/scenario (decodeScenario)
import pkg/sunholo/crew_core/example (firstContactJson)
import pkg/sunholo/crew_core/policy (decodePolicy, watchPolicyBody)
import pkg/sunholo/social_dynamics/wire (encodeState)
import std/string (length as size, startsWith, join)
import ./crew_sim (play, playArchived)

-- Spike: how a run's state grows with turns (what archiving must bound).
export func main() -> () ! {IO, FS, Env} = match getArgs() {
 [path, n] => match (if path == "default" then Ok("") else readFileResult(path), stringToInt(n)) {
  (Ok(body), Some(turns)) => match (decodeScenario(if path == "default" then firstContactJson() else body), decodePolicy(watchPolicyBody())) {
   (Ok(sc), Ok(p)) => match playArchived(sc, p, "consent", 1, turns, 0, 10) {
    Ok(sim) => { let s = sim.session; println("turns ${n}: tasks ${show(length(s.state.tasks))} evidence ${show(length(s.state.evidence))} knowledge ${show(length(s.state.knowledge))} accepted ${show(length(s.state.accepted))} reliefs ${show(length(s.state.reliefs))} bank ${show(length(s.bank))} reports ${show(length(s.reports))} bindings ${show(length(s.bindings))} state_bytes ${show(size(encodeState(s.state)))}"); println("  concern ids: ${join(" ", take(30, map(\e. "${e.id}<${join(",", e.causes)}>", filter(\e. e.kind == "concern", s.state.evidence))))}"); forEachE(\k. println("  kind ${k}: ${show(length(filter(\e. e.kind == k, s.state.evidence)))}"), dedup(map(\e. e.kind, s.state.evidence))); println("  event-* ${show(length(filter(\e. startsWith(e.id, "event-"), s.state.evidence)))}") },
    Err(e) => println(e)
   },
   _ => println("decode")
  },
  _ => println("args")
 },
 _ => println("usage: growth_probe SCENARIO TURNS")
}
