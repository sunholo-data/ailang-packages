module sunholo/crew_lab/viewer
import std/io (readLine, println, exit)
import std/result (Ok, Err)
import std/option (Some, None)
import std/list (map, filter, head, length)
import std/string (join, trim, repeat, startsWith, length as stringLength)
import std/json (decode, getString)
import pkg/sunholo/social_dynamics/model (State)
import ./session (Session, Output, Bank, start, input, encodeHostError)
import ./codec (encodeOutcome)
import ./terminal (begin, translate)

pure func value(s: State, actor: string, id: string) -> int = match head(filter(\a. a.id == actor, s.actors)) {
  None => 0,
  Some(a) => match head(filter(\v. v.id == id, a.indicators)) {
    None => 0,
    Some(v) => v.value
  }
}

pure func trust(s: State, actor: string) -> string =
  match head(filter(\r. r.from == actor && r.to == "captain" && r.dimension == "trust", s.relationships)) {
    None => "--",
    Some(r) => gauge(r.value)
  }

pure func gauge(n: int) -> string = {
  let bounded = if n < 0 then 0 else if n > 100 then 100 else n
  let filled = bounded / 10
  "[${repeat("#", filled)}${repeat("-", 10 - filled)}] ${show(n)}"
}

pure func crew(s: State, actor: string) -> string =
  "  ${actor}: fatigue ${gauge(value(s, actor, "fatigue"))}\n    readiness ${gauge(value(s, actor, "readiness"))} | observations ${gauge(value(s, actor, "observations"))}\n    trust -> captain ${trust(s, actor)}"

pure func command(line: string) -> string = match decode(line) {
  Err(_) => "invalid",
  Ok(j) => match getString(j, "command") {
    None => "invalid",
    Some(name) => name
  }
}

pure func render(o: Output, line: string) -> string = {
  let s = o.session
  let last = length(s.bank) - 1
  let choice = match head(filter(\b. b.request.id != "", if last < 0 then [] else lastBank(s.bank, last))) {
    None => "",
    Some(b) => if b.status == "cancelled" then "\n  Latest request: ${b.request.actor}/${b.request.task} cancelled" else "\n  Latest crew response: ${b.request.actor} -> ${b.selected} (${b.status}, roll ${show(b.roll)})"
  }
  let pending = if s.pending == [] then "" else join("", ["\n  Waiting: ", join("; ", map(\r. "${r.actor}/${r.task}: ${join(", ", r.legal)}", s.pending))])
  let resources = join("; ", map(\r. "${r.id}: available ${show(r.available)}, reserved ${show(r.reserved)}, used ${show(r.consumed)}", s.state.resources))
  let outcomes = if s.reports == [] then "" else join("", ["\n  Captain outcomes: ", join("; ", map(\r. "${r.worker}/${r.task}: ${encodeOutcome(r.code)}", s.reports))])
  "[turn ${show(s.state.tick)} | ${command(line)} | ${s.policy}]\n${crew(s.state, "scientist")}\n${crew(s.state, "engineer")}\n  ${resources}${pending}${choice}${outcomes}${if o.failed then "\n  BLOCKED: earlier completed boundaries retained" else ""}"
}

pure func lastBank(xs: [Bank], n: int) -> [Bank] = match xs {
  [] => [],
  b :: rest => if n == 0 then [b] else lastBank(rest, n - 1)
}

pure func help() -> string =
  "CREW LAB — offline captain/crew sandbox\nstart consent | start orders\noffer <id> <worker> <recipe>\nask <request> <actor> <task>\nreply <request> <choice> [confidence roll]  (manual synthetic reply)\nwork <task>\nadvance <tick> [budget]\nrelief <id> grant|deny\ndeliver <observer> <evidence> <id>\ncancel <request> | abort | status | help | quit\nWorkers: scientist, engineer. Recipes: observations, maintenance, rest_scientist, rest_engineer.\nAll responses are offline fixtures. Exact JSON commands are also accepted."

func loop(s: Session, count: int, recover: bool) -> () ! {IO} = {
  let raw = readLine()
  let line = trim(raw)
  if stringLength(raw) > 65536 then {println("ERROR: line limit");exit(1)} else if line == "" || line == "quit" then () else if count >= 10000 then {
    println("ERROR: command limit")
    exit(1)
  } else if line == "help" then {
    println(help())
    loop(s, count + 1, recover)
  } else if line == "status" then {
    println(render({ session: s, trace: "", failed: false }, "{\"command\":\"status\"}"))
    loop(s, count + 1, recover)
  } else match translate(s, raw) {
    Err(e) => {
      println("ERROR: ${e}")
      if recover then loop(s, count + 1, recover) else exit(1)
    },
    Ok(commandLine) => match input(s, commandLine) {
      Err(e) => {
        println("ERROR: ${encodeHostError(e)}")
        if recover then loop(s, count + 1, recover) else exit(1)
      },
      Ok(o) => {
        println(render(o, commandLine))
        if o.failed then exit(1) else loop(o.session, count + 1, recover)
      }
    }
  }
}

func boot(count: int) -> () ! {IO} = {
  let raw = readLine()
  let line = trim(raw)
  if stringLength(raw) > 65536 then {println("ERROR: line limit");exit(1)} else if line == "" || line == "quit" then () else if count >= 10000 then {
    println("ERROR: command limit")
    exit(1)
  } else if line == "help" then {
    println(help())
    boot(count + 1)
  } else match begin(raw) {
    Err(e) => {
      println("ERROR: ${e}")
      if not startsWith(line, "{") then boot(count + 1) else exit(1)
    },
    Ok(commandLine) => match start(commandLine) {
      Err(e) => {
        println("ERROR: ${encodeHostError(e)}")
        if not startsWith(line, "{") then boot(count + 1) else exit(1)
      },
      Ok(o) => {
        println(render(o, commandLine))
        loop(o.session, count + 1, not startsWith(line, "{"))
      }
    }
  }
}

export func main() -> () ! {IO} = {
  println(help())
  boot(0)
}
