module sunholo/crew_lab/crew_sim
import std/io (println, exit)
import std/fs (readFileResult)
import std/env (getArgs)
import std/result (Result, Ok, Err)
import std/option (Option, Some, None)
import std/list (map, filter, foldl, length, head, any, contains, range, sortBy, nth, flatMap)
import std/string (join, split, stringToInt, startsWith, substring, length as stringLength)
import std/json (Json, JObject, JNumber, JString, decode, encode, getString, getArray, jo, kv, js, jint, jnum, ja)
import std/math (intToFloat)
import std/crypto (sha256Hex)
import pkg/sunholo/social_dynamics/model (Task, Offered, Working, Completed)
import pkg/sunholo/content_library/library (nextRoll)
import pkg/sunholo/crew_core/scenario (Scenario, decodeScenario, scenarioHash)
import pkg/sunholo/crew_core/example (firstContactJson)
import pkg/sunholo/crew_core/session (Session, Request, Output, HostError, start, untraced, offer, ask, complete, startTask, resolve, input, cancel, encodeHostError)
import pkg/sunholo/crew_core/policy (Policy, decodePolicy, watchPolicyBody, authoredAnswer)

-- crew-sim: batch runs of the captain/crew host without AI, for tuning.
-- Each seed plays `turns` turns with one captain strategy; replies come from
-- the authored response policy (the same draw the offline watch uses). One
-- NDJSON line per seed. `--summary FILE` reports medians and spreads; it never
-- ranks strategies or scenarios.

export type Count = {id: string, value: int} deriving (Eq)
export type Tally = {replies: [Count], byCrew: [Count], offers: int, starts: int, refused: int, stockouts: int, reliefAsked: int, granted: int, denied: int, errors: int, why: [Count], refusals: [Count], short: [Count], low: [Count], zero: [Count], peaks: [Count], over: [Count]} deriving (Eq)
-- What a crew member was asked and how they reacted (authored), with their state
-- at the time; kept only when a caller asks (crew-sample), up to `keep`.
export type Heard = {request: Request, label: string, tick: int, fatigue: int, stress: int, morale: int} deriving (Eq)
export type Sim = {session: Session, seed: int, tally: Tally, captain: string, policy: Policy, scenario: Scenario, agreed: [string], heard: [Heard], keep: int} deriving (Eq)

-- Resources: `low` starts at each account's opening balance and keeps the
-- lowest available seen after work is assigned or after an advance; `zero` counts turns ending with none
-- available; `short` counts stockout refusals by resource.
pure func zero(sc: Scenario) -> Tally = {replies: [], byCrew: [], offers: 0, starts: 0, refused: 0, stockouts: 0, reliefAsked: 0, granted: 0, denied: 0, errors: 0, why: [], refusals: [], short: [], low: map(\r. {id: r.id, value: r.available}, sc.resources), zero: map(\r. {id: r.id, value: 0}, sc.resources), peaks: [], over: []}

-- After work is assigned (before the advance): lowers `low` only, so work
-- that reserves and completes within one advance still shows its draw.
pure func observeLow(sim: Sim) -> Sim = {
 let t = sim.tally;
 let rs = sim.session.state.resources;
 let avail = \id. match head(filter(\r. r.id == id, rs)) { Some(r) => r.available, None => 0 };
 withTally(sim, {t | low: map(\c. {id: c.id, value: if avail(c.id) < c.value then avail(c.id) else c.value}, t.low)})
}

-- After each advance: lowers `low` and counts a turn ending with none available.
-- Per crew member: the highest stress and fatigue reached ("w/stress",
-- "w/fatigue") and turns ending at or over the overextension threshold.
pure func raise(xs: [Count], id: string, v: int) -> [Count] = if any(\c. c.id == id, xs) then map(\c. if c.id == id && v > c.value then {c | value: v} else c, xs) else xs ++ [{id: id, value: v}]
pure func peaked(sim: Sim) -> Sim = {
 let t = sim.tally;
 let s = sim.session;
 let threshold = match head(sim.scenario.rules) { Some(r) => r.threshold, None => 101 };
 withTally(sim, {t | peaks: foldl(\acc w. raise(raise(acc, "${w}/stress", indicator(s, w, "stress")), "${w}/fatigue", indicator(s, w, "fatigue")), t.peaks, sim.scenario.workers),
  over: foldl(\acc w. if indicator(s, w, "stress") >= threshold then bump(acc, w) else acc, t.over, sim.scenario.workers)})
}

pure func observe(sim: Sim) -> Sim = peaked(observeTurn(sim))

pure func observeTurn(sim: Sim) -> Sim = {
 let t = sim.tally;
 let rs = sim.session.state.resources;
 let avail = \id. match head(filter(\r. r.id == id, rs)) { Some(r) => r.available, None => 0 };
 withTally(sim, {t | low: map(\c. {id: c.id, value: if avail(c.id) < c.value then avail(c.id) else c.value}, t.low), zero: map(\c. {id: c.id, value: c.value + (if avail(c.id) == 0 then 1 else 0)}, t.zero)})
}

pure func stockoutOf(text: string) -> string = match decode(text) {
 Ok(j) => if getString(j, "code") == Some("insufficient_resource") then match getString(j, "detail") { Some(d) => d, None => "" } else "",
 Err(_) => ""
}

pure func bump(xs: [Count], id: string) -> [Count] =
 if any(\c. c.id == id, xs) then map(\c. if c.id == id then {c | value: c.value + 1} else c, xs) else xs ++ [{id: id, value: 1}]

pure func withTally(sim: Sim, t: Tally) -> Sim = {sim | tally: t}
pure func failed(sim: Sim, why: string) -> Sim = { let t = sim.tally; withTally(sim, {t | errors: t.errors + 1, why: bump(t.why, why)}) }
pure func reason(e: HostError) -> string = substring(encodeHostError(e), 0, 70)
pure func countOffer(sim: Sim) -> Sim = { let t = sim.tally; withTally(sim, {t | offers: t.offers + 1}) }
pure func countStart(sim: Sim) -> Sim = { let t = sim.tally; withTally(sim, {t | starts: t.starts + 1}) }
pure func countRefusal(sim: Sim, why: string) -> Sim = { let t = sim.tally; withTally(sim, {t | refused: t.refused + 1, stockouts: t.stockouts + (if why == "insufficient_resource" then 1 else 0), refusals: bump(t.refusals, why)}) }
pure func countReply(sim: Sim, actor: string, label: string) -> Sim = { let t = sim.tally; withTally(sim, {t | replies: bump(t.replies, label), byCrew: bump(t.byCrew, "${actor}/reply/${label}")}) }
pure func countRelief(sim: Sim, actor: string) -> Sim = { let t = sim.tally; withTally(sim, {t | reliefAsked: t.reliefAsked + 1, byCrew: bump(t.byCrew, "${actor}/relief/asked")}) }
pure func countDecision(sim: Sim, actor: string, granted: bool) -> Sim = { let t = sim.tally; if granted then withTally(sim, {t | granted: t.granted + 1, byCrew: bump(t.byCrew, "${actor}/relief/granted")}) else withTally(sim, {t | denied: t.denied + 1, byCrew: bump(t.byCrew, "${actor}/relief/denied")}) }
pure func withSession(sim: Sim, s: Session) -> Sim = {sim | session: s}
pure func release(sim: Sim, id: string) -> Sim = match cancel(sim.session, id) { Ok(o) => {sim | session: o.session}, Err(_) => sim }
pure func remember(sim: Sim, task: string, label: string) -> Sim = if label == "accept" && not contains(sim.agreed, task) then {sim | agreed: sim.agreed ++ [task]} else sim

pure func indicator(s: Session, actor: string, id: string) -> int = match head(filter(\a. a.id == actor, s.state.actors)) {
 None => 0,
 Some(a) => match head(filter(\v. v.id == id, a.indicators)) { Some(v) => v.value, None => 0 }
}

pure func trust(s: Session, actor: string) -> int = match head(filter(\r. r.from == actor && r.to == s.scenario.captain && r.dimension == "trust", s.state.relationships)) {
 Some(r) => r.value, None => 0
}

pure func busy(s: Session, worker: string) -> bool = any(\t. (t.status == Offered || t.status == Working) && contains(t.participants, worker), s.state.tasks)

-- A seeded coin in [0, 1); returns the advanced seed with it.
pure func coin(sim: Sim) -> {sim: Sim, roll: float} = match nextRoll(sim.seed) {
 Ok(r) => {sim: {sim | seed: r.seed}, roll: r.roll},
 Err(_) => {sim: sim, roll: 0.5}
}

pure func workRecipe(sc: Scenario, worker: string) -> string = match head(filter(\o. o.text == worker && o.id != "rest_${worker}", sc.owners)) {
 Some(o) => o.id, None => "rest_${worker}"
}

pure func note(sim: Sim, r: Request, label: string, before: Session) -> Sim =
 if length(sim.heard) >= sim.keep then sim else {sim | heard: sim.heard ++ [{request: r, label: label, tick: before.state.tick, fatigue: indicator(before, r.actor, "fatigue"), stress: indicator(before, r.actor, "stress"), morale: indicator(before, r.actor, "morale")}]}

-- Ask `actor` about `task`; the authored policy chooses the reaction.
pure func hear(sim: Sim, actor: string, task: string, id: string) -> {sim: Sim, label: string} = match ask(sim.session, actor, task, id) {
 Err(e) => {sim: failed(sim, "ask: ${reason(e)}"), label: ""},
 Ok(a) => match head(filter(\q. q.id == id, a.session.pending)) {
  None => {sim: failed({sim | session: a.session}, "ask: no pending request"), label: ""},
  Some(request) => match authoredAnswer(sim.policy, request, sim.seed) {
   Err(e) => {sim: failed({sim | session: a.session}, "answer: ${e}"), label: ""},
   Ok(answer) => match complete(a.session, id, answer.body, answer.roll) {
    Err(e) => {sim: failed(release({sim | session: a.session, seed: answer.seed}, id), "complete: ${reason(e)}"), label: ""},
    Ok(c) => {sim: note(remember(countReply({sim | session: c.session, seed: answer.seed}, actor, answer.label), task, answer.label), request, answer.label, a.session), label: answer.label}
   }
  }
 }
}

pure func begin(sim: Sim, task: string) -> Sim = match startTask(sim.session, task) {
 Ok(o) => if o.failed then failed({sim | session: o.session}, "start: blocked") else countStart({sim | session: o.session}),
 Err(e) => {
  let text = encodeHostError(e);
  let counted = countRefusal(sim, refusalCode(text));
  let r = stockoutOf(text);
  if r == "" then counted else { let t = counted.tally; withTally(counted, {t | short: bump(t.short, r)}) }
 }
}

-- A closed set of refusal codes: the engine's code when present (e.g.
-- insufficient_resource), consent_required for the host's consent rule, else
-- host_error. crew_claims/1 validates refusal_reasons.<code> against this set.
export pure func refusalCodes() -> [string] ! {}
ensures { length(result) > 0 } = ["altered_duplicate", "capacity_exceeded", "clock_rewind", "expired", "insufficient_resource", "invalid_budget", "invalid_config", "invalid_continuation", "invalid_policy_effect", "invalid_schema", "invalid_transition", "numeric_overflow", "pending_advance", "stale_revision", "unauthorized", "unknown_id", "unseen_evidence", "unsupported_version", "consent_required", "host_error"]

pure func refusalCode(text: string) -> string = match decode(text) {
 Ok(j) => match getString(j, "code") {
  Some(c) => if contains(refusalCodes(), c) then c else "host_error",
  None => match getString(j, "host") { Some(h) => if h == "personal consent required" then "consent_required" else "host_error", None => "host_error" }
 },
 Err(_) => "host_error"
}

-- Captain strategies. consent: start only agreed work, grant relief.
-- orders: start whatever was offered, deny relief. random: seeded choices.
pure func wantsStart(sim: Sim, label: string) -> {sim: Sim, go: bool} =
 if sim.captain == "orders" then {sim: sim, go: true}
 else if sim.captain == "consent" then {sim: sim, go: label == "accept"}
 else { let c = coin(sim); {sim: c.sim, go: label == "accept" || c.roll < 0.5} }

pure func grants(sim: Sim) -> {sim: Sim, go: bool} =
 if sim.captain == "orders" then {sim: sim, go: false}
 else if sim.captain == "consent" then {sim: sim, go: true}
 else { let c = coin(sim); {sim: c.sim, go: c.roll < 0.5} }

pure func chooseRecipe(sim: Sim, worker: string) -> {sim: Sim, recipe: string} = {
 let tired = indicator(sim.session, worker, "fatigue") >= 70 || indicator(sim.session, worker, "stress") >= 75;
 if sim.captain == "random" then { let c = coin(sim); {sim: c.sim, recipe: if c.roll < 0.3 then "rest_${worker}" else workRecipe(sim.scenario, worker)} }
 else {sim: sim, recipe: if tired && sim.captain != "orders" then "rest_${worker}" else workRecipe(sim.scenario, worker)}
}

-- Offer each idle specialist work (or rest), hear them, decide whether to start.
pure func assign(sim: Sim, turn: int, worker: string) -> Sim =
 if busy(sim.session, worker) then sim else {
  let pick = chooseRecipe(sim, worker);
  let id = "t${show(turn)}-${worker}";
  match offer(pick.sim.session, worker, pick.recipe, id) {
   Err(e) => failed(pick.sim, "offer: ${reason(e)}"),
   Ok(o) => {
    let offered = countOffer(withSession(pick.sim, o.session));
    let heard = hear(offered, worker, id, "q-${id}");
    let decision = wantsStart(heard.sim, heard.label);
    if decision.go then begin(decision.sim, id) else decision.sim
   }
  }
 }

-- Re-ask about work still offered from an earlier turn.
pure func persuade(sim: Sim, turn: int, t: Task) -> Sim = if contains(sim.agreed, t.id) then begin(sim, t.id) else match head(t.participants) {
 None => sim,
 Some(worker) => {
  let heard = hear(sim, worker, t.id, "p${show(turn)}-${t.id}");
  let decision = wantsStart(heard.sim, heard.label);
  if decision.go then begin(decision.sim, t.id) else decision.sim
 }
}

-- Check in with working crew every other turn; relief requests get an answer.
pure func checkIn(sim: Sim, turn: int, t: Task) -> Sim = match head(t.participants) {
 None => sim,
 Some(worker) => if turn % 2 != 0 then sim else {
  let rid = "c${show(turn)}-${t.id}";
  let heard = hear(sim, worker, t.id, rid);
  if heard.label != "request_relief" then heard.sim else {
   let asked = countRelief(heard.sim, worker);
   let d = grants(asked);
   match resolve(d.sim.session, "relief-${rid}", d.go) {
    Err(e) => failed(d.sim, "relief: ${reason(e)}"),
    Ok(o) => countDecision(withSession(d.sim, o.session), worker, d.go)
   }
  }
 }
}

pure func advanceTo(sim: Sim, turn: int) -> Sim = match input(sim.session, "{\"command\":\"advance\",\"tick\":${show(turn)},\"budget\":64}") {
 Ok(o) => if o.failed then failed({sim | session: o.session}, "advance: blocked") else observe({sim | session: o.session}),
 Err(e) => failed(sim, "advance: ${reason(e)}")
}

pure func turnOf(sim: Sim, turn: int) -> Sim = {
 let offered = filter(\t. t.status == Offered, sim.session.state.tasks);
 let s1 = foldl(\acc t. persuade(acc, turn, t), sim, offered);
 let working = filter(\t. t.status == Working, s1.session.state.tasks);
 let s2 = foldl(\acc t. checkIn(acc, turn, t), s1, working);
 let s3 = foldl(\acc w. assign(acc, turn, w), s2, s2.scenario.workers);
 advanceTo(observeLow(s3), turn)
}

export pure func play(sc: Scenario, policy: Policy, captain: string, seed: int, turns: int) -> Result[Sim, string]
ensures { match result { Ok(sim) => sim.session.state.tick <= turns && sim.captain == captain && sim.heard == [], Err(_) => true } } = playKeeping(sc, policy, captain, seed, turns, 0)

export pure func playKeeping(sc: Scenario, policy: Policy, captain: string, seed: int, turns: int, keep: int) -> Result[Sim, string]
ensures { match result { Ok(sim) => sim.session.state.tick <= turns && length(sim.heard) <= (if keep < 0 then 0 else keep), Err(_) => true } } =
 if captain != "consent" && captain != "orders" && captain != "random" then Err("captain must be consent, orders or random")
 else if turns < 1 || turns > 500 then Err("turns must be 1..500")
 else match start(sc, "{\"command\":\"start\",\"policy\":\"${if captain == "orders" then "orders" else "consent"}\",\"scenario\":\"watch-v2\"}") {
  Err(e) => Err(encodeHostError(e)),
  Ok(o) => Ok(foldl(\acc turn. turnOf(acc, turn), {session: untraced(o.session), seed: seed, tally: zero(sc), captain: captain, policy: policy, scenario: sc, agreed: [], heard: [], keep: if keep < 0 then 0 else keep}, range(1, turns + 1)))
 }

pure func counts(xs: [Count]) -> Json = jo(map(\c. kv(c.id, jint(c.value)), xs))

-- crew_shortfall/1 bodies (crew_core): who was halted in an argument.
pure func haltedList(text: string) -> [string] = match decode(text) { Ok(j) => match getArray(j, "halted") { Some(xs) => flatMap(\x. match x { JString(w) => [w], _ => [] }, xs), None => [] }, Err(_) => [] }
pure func halted(text: string, w: string) -> bool = contains(haltedList(text), w)
pure func haltedCount(text: string) -> int = length(haltedList(text))
pure func regardMin(s: Session, w: string) -> int = foldl(\acc r. if r.from == w && r.dimension == "regard" && r.value < acc then r.value else acc, 100, s.state.relationships)

pure func countOf(xs: [Count], id: string) -> int = match head(filter(\c. c.id == id, xs)) { Some(c) => c.value, None => 0 }
pure func crewCount(t: Tally, key: string) -> int = match head(filter(\c. c.id == key, t.byCrew)) { Some(c) => c.value, None => 0 }
pure func crewReplies(t: Tally, w: string) -> Json = counts(flatMap(\c. if startsWith(c.id, "${w}/reply/") then [{id: substring(c.id, stringLength("${w}/reply/"), stringLength(c.id)), value: c.value}] else [], t.byCrew))

export pure func report(sim: Sim, seed: int, turns: int, scenarioHashText: string, policyHash: string) -> string
ensures { result != "" } = {
 let s = sim.session;
 let completed = map(\r. {id: r.id, value: length(filter(\t. t.recipe == r.id && t.status == Completed, s.state.tasks))}, sim.scenario.recipes);
 let crew = map(\w. kv(w, jo([kv("fatigue", jint(indicator(s, w, "fatigue"))), kv("stress", jint(indicator(s, w, "stress"))), kv("morale", jint(indicator(s, w, "morale"))), kv("readiness", jint(indicator(s, w, "readiness"))), kv("observations", jint(indicator(s, w, "observations"))), kv("trust", jint(trust(s, w))), kv("replies", crewReplies(sim.tally, w)), kv("relief_asked", jint(crewCount(sim.tally, "${w}/relief/asked"))), kv("relief_granted", jint(crewCount(sim.tally, "${w}/relief/granted"))), kv("relief_denied", jint(crewCount(sim.tally, "${w}/relief/denied"))), kv("peak_stress", jint(countOf(sim.tally.peaks, "${w}/stress"))), kv("peak_fatigue", jint(countOf(sim.tally.peaks, "${w}/fatigue"))), kv("overextended_turns", jint(countOf(sim.tally.over, w))), kv("halted", jint(length(filter(\e. startsWith(e.id, "sf-") && halted(e.text, w), s.state.evidence)))), kv("regard_min", jint(regardMin(s, w)))])), sim.scenario.workers);
 encode(jo([
  kv("schema", js("crew_sim/1")), kv("captain", js(sim.captain)), kv("seed", jint(seed)), kv("turns", jint(turns)), kv("tick", jint(s.state.tick)),
  kv("scenario", js(scenarioHashText)), kv("policy", js(policyHash)),
  kv("replies", counts(sim.tally.replies)),
  kv("offers", jint(sim.tally.offers)), kv("starts", jint(sim.tally.starts)), kv("refused", jint(sim.tally.refused)), kv("refusal_reasons", counts(sim.tally.refusals)), kv("stockouts", jint(sim.tally.stockouts)),
  kv("relief", jo([kv("asked", jint(sim.tally.reliefAsked)), kv("granted", jint(sim.tally.granted)), kv("denied", jint(sim.tally.denied))])),
  kv("completed", counts(filter(\c. c.value > 0, completed))),
  kv("crew", jo(crew)),
  kv("resources", jo(map(\r. kv(r.id, jo([kv("min", jint(countOf(sim.tally.low, r.id))), kv("zero_ticks", jint(countOf(sim.tally.zero, r.id))), kv("stockouts", jint(countOf(sim.tally.short, r.id))), kv("in", jint(r.transferredIn)), kv("out", jint(r.transferredOut))])), s.state.resources))),
  kv("shortfalls", jint(length(filter(\e. startsWith(e.id, "sf-"), s.state.evidence)))),
  kv("halts", jint(foldl(\acc e. acc + haltedCount(e.text), 0, filter(\e. startsWith(e.id, "sf-"), s.state.evidence)))),
  kv("errors", jint(sim.tally.errors)), kv("error_kinds", counts(sim.tally.why))
 ]))
}
