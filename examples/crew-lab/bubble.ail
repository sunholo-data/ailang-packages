module sunholo/crew_lab/bubble
import std/list (map, filter, length, any, contains, flatMap, head)
import std/option (Some, None)
import pkg/sunholo/crew_core/scenario (Scenario, resourceKind)

-- The eight bubble resources (stapledons-design features/next/bubble-resources.md
-- §6, canon D-69). Crew scenarios for Stapledon's Voyage use only these. Each
-- crew-scale unit is a fixed amount of a physical quantity, so the game's ship
-- ledger can hand a scenario its opening balances (allocate) and read back what
-- the crew used.
export type Bubble = {id: string, kind: string, unit: string, physical: string, per: int} deriving (Eq)

export pure func bubbleResources() -> [Bubble] ! {}
ensures { length(result) == 8 } = [
 {id: "mass", kind: "stock", unit: "10 kg block", physical: "kg", per: 10},
 {id: "water", kind: "stock", unit: "1 t", physical: "kg", per: 1000},
 {id: "power", kind: "capacity", unit: "50 kW of headroom", physical: "kW", per: 50},
 {id: "heat", kind: "capacity", unit: "50 kW of headroom", physical: "kW", per: 50},
 {id: "garden", kind: "capacity", unit: "100 m2 of lit beds", physical: "m2", per: 100},
 {id: "fabrication", kind: "capacity", unit: "one bay for one shift", physical: "bay-shifts", per: 1},
 {id: "compute", kind: "capacity", unit: "one Archive slot", physical: "slots", per: 1},
 {id: "signal", kind: "capacity", unit: "one antenna window", physical: "windows", per: 1}
]

-- One physical amount from the ship's ledger, in the resource's physical unit.
export type Amount = {id: string, value: int} deriving (Eq)

-- Opening crew units for a scenario: whole units, rounded down, for each
-- known resource in the ship state. Unknown ids and negative amounts give
-- nothing; the crew never sees part of a unit.
export pure func allocate(ship: [Amount]) -> [Amount] ! {}
ensures { length(result) <= length(ship) && not any(\a. a.value < 0, result) } =
 flatMap(\a. match head(filter(\b. b.id == a.id, bubbleResources())) {
  Some(b) => if a.value < 0 then [] else [{id: a.id, value: a.value / b.per}],
  None => []
 }, ship)

-- Problems with a scenario's resources, empty when it uses only the eight
-- with the right kinds.
export pure func lintPack(sc: Scenario) -> [string] ! {}
ensures { length(result) <= 2 * length(sc.resources) } =
 flatMap(\r. match head(filter(\b. b.id == r.id, bubbleResources())) {
  None => ["${r.id}: not one of the eight bubble resources"],
  Some(b) => if resourceKind(sc, r.id) == b.kind then [] else ["${r.id}: must be a ${b.kind}"]
 }, sc.resources)

test "allocate turns a ship ledger into whole crew units" {
 allocate([{id: "mass", value: 45}, {id: "water", value: 3500}, {id: "power", value: 149}, {id: "air", value: 9}, {id: "heat", value: 0 - 5}]) == [{id: "mass", value: 4}, {id: "water", value: 3}, {id: "power", value: 2}]
}
test "the eight are distinct, and only mass and water are stocks" {
 let ids = map(\b. b.id, bubbleResources());
 length(filter(\i. length(filter(\j. j == i, ids)) == 1, ids)) == 8 && map(\b. b.id, filter(\b. b.kind == "stock", bubbleResources())) == ["mass", "water"]
}
