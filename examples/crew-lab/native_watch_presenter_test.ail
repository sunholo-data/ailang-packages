module sunholo/crew_lab/native_watch_presenter_test
import std/result (Ok,Err)
import std/option (Some,None)
import std/list (any,length)
import std/string (contains,join)
import pkg/sunholo/terminal_ui/ui (cells)
import pkg/sunholo/terminal_ui/events (Input,Accept,Character)
import ./play_flow (beginWatch)
import ./native_watch_ui (initial,decision,editor,update,Ship,Guide,Editor,ReplyReview)
import ./native_watch_presenter (frame,elapsed)

pure func all[a](f:a->bool,xs:[a])->bool = not any(\x. not f(x),xs)

test "new captain sees teaching and both command style meanings at40x16" {
 let f = frame(None,initial(40,16,false),"",[],"offline",0,"journal",false,false);
 let text = join("\n",f.lines);
 length(f.lines) == 16 && all(\l. cells(l) <= 40,f.lines) && contains(text,"You are captain") && contains(text,"Five specialists") && contains(text,"requires") && contains(text,"despite refusal") && contains(text,"Enter") && not contains(f.text,"\u{1B}")
}
test "reading guide hides inactive Start and uses reading controls" {
 match beginWatch("2",61) {Err(_)=>false,Ok(s)=>{
 let p={s|phase:"start",target:"proposal"};
 let text=frame(Some(p),{decision(p,40,16,false)|view:Guide},"",[],"offline",0,"journal",false,false).text;
 contains(text,"return to pending decision") && not contains(text,"> 1 Start now") && not contains(text,"Enter acts")
 }}
}
test "elapsed quarters correctly represent three of four and six of eight" {elapsed(3,4,true)=="[###.] 3/4 turns" && elapsed(6,8,true)=="[###.] 6/8 turns"}
test "representative frame matrix fits every actual viewport" {
 all(\width. all(\height. {
 let f=frame(None,initial(width,height,false),"",[],"offline",0,"journal",false,false);
 length(f.lines)<=height && all(\l. cells(l)<=width,f.lines) && not contains(f.text,"\u{1B}")
 },[8,16,24,60]),[20,40,80,100,160])
}
test "all five specialists and named supplies fit bridge80x24" {
 match beginWatch("1",61) { Err(_)=>false,Ok(s)=>{
 let f = frame(Some(s),decision(s,80,24,false),"",[],"offline",0,"journal",false,false);
 let text = join("\n",f.lines);
 length(f.lines) == 24 && all(\l. cells(l)<=80,f.lines) && contains(text,"scientist") && contains(text,"engineer") && contains(text,"medic") && contains(text,"pilot") && contains(text,"diplomat") && contains(text,"Archive compute") && contains(text,"Replacement modules") && contains(text,"Diagnostic cartridges") && not contains(text,"fatigue") && not contains(text,"OCEAN")
 }}
}
test "tiny frame fits actual viewport and retains underlying UI" {
 let u=initial(20,8,true);
 let f=frame(None,u,"",[],"offline",0,"journal",false,false);
 length(f.lines)<=8 && all(\l. cells(l)<=20,f.lines) && contains(join("\n",f.lines),"Need 40 x 16")
}
test "ASCII ship diagram and elapsed bar are physical facts" {
 match beginWatch("2",61) {Err(_)=>false,Ok(s)=>{
 let f=frame(Some(s),{decision(s,80,24,true)|view:Ship},"",[],"offline",0,"journal",false,false);
 let text=join("\n",f.lines);
 contains(text,"BRIDGE") && contains(text,"COMMONS") && not contains(text,"─") && not contains(text,"█") && elapsed(2,4,true)=="[##..] 2/4 turns" && elapsed(0,0,true)=="[....] 0/0 turns"
 }}
}

test "tall bridge shows all actions even at the last selection" {
 match beginWatch("1",61) {Err(_)=>false,Ok(s)=>{
 let u={decision(s,80,40,false)|cursor:5};
 let f=frame(Some(s),u,"",[],"offline",0,"journal",false,false);
 let text=join("\n",f.lines);
 length(f.lines)==40 && all(\l. cells(l)<=80,f.lines) && contains(text,"1 Choose work") && contains(text,"2 Arrange rest") && contains(text,"5 Advance one turn") && contains(text,"6 Check in with working crew") && contains(text,"7 Review open offers") && contains(text,"> 8 Resolve a relief request") && contains(text,"Choices 1-6/6")
 }}
}
test "tall assignment menu shows five specialists and focused details" {
 match beginWatch("1",61) {Err(_)=>false,Ok(s)=>{
 let p={s|phase:"assignments"};
 let u={decision(p,100,30,false)|cursor:4};
 let text=frame(Some(p),u,"",[],"offline",0,"journal",false,false).text;
 contains(text,"1 scientist:") && contains(text,"2 engineer:") && contains(text,"3 medic:") && contains(text,"4 pilot:") && contains(text,"> 5 diplomat:") && contains(text,"Practise signals") && contains(text,"Choices 1-5/5")
 }}
}
test "compact menu tells captain which choices are outside the window" {
 match beginWatch("1",61) {Err(_)=>false,Ok(s)=>{
 let u={decision(s,40,16,false)|cursor:5};
 let f=frame(Some(s),u,"",[],"offline",0,"journal",false,false);
 length(f.lines)==16 && all(\l. cells(l)<=40,f.lines) && contains(f.text,"> 8 Resolve a relief request") && contains(f.text,"Choices 4-6/6")
 }}
}

test "editor and review frame matrix stays inside screen with long Unicode draft" {
 let u=editor(initial(80,30,false),"issue-test","qbh0 café 界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界","ask_advice",0,0);
 all(\width. all(\height. all(\view. {
 let f=frame(None,{u|dimensions:{columns:width,rows:height},view:view},"",[],"offline",0,"journal",false,false);
 length(f.lines)==height && all(\line. cells(line)<=width,f.lines)
 },[Editor,ReplyReview]),[16,30,40]),[40,80,100])
}

test "long reply review keeps changing declared approach visible at40x16" {
 let u=editor(initial(40,16,false),"issue-test","Give me your judgement on preparation and the unknown medical needs before we make any further promises, rather than assuming contact will go well.","ask_advice",0,0);
 let r=update(None,u,Input(Accept));
 let changed=update(None,r.ui,Input(Character("3")));
 let before=frame(None,r.ui,"",[],"offline",0,"",false,false).text;
 let after=frame(None,changed.ui,"",[],"offline",0,"",false,false).text;
 contains(before,"Approach: Ask for their judgement") && contains(after,"Approach: Discuss a staged approach") && contains(after,"PgUp/PgDn read words")
}
