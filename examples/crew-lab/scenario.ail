module sunholo/crew_lab/scenario
import std/result (Result, Ok, Err)
import std/list (map, any, filter, head, length)
import std/option (Some, None)
import pkg/sunholo/social_dynamics/model (Config, Actor, Resource, Policies, Principal, ActorPrincipal, State, Task, Authority, Allowed, Refused, Appraisal, Effect, IndicatorDelta, RelationshipDelta, Value)
import ./codec (decodeOutcome, outcomeDelta)

-- Experimental host tuning. Neither OCEAN nor these numbers assert a human model.
export pure func config(policy: string) -> Result[Config, string]
ensures { match result {
  Ok(c) => c.timeUnit == "turn" && c.version == 1,
  Err(_) => true
} } =
  if policy != "orders" && policy != "consent" then Err("policy") else Ok({ id: "crew-${policy}-v1", version: 1, session: "crew-${policy}", timeUnit: "turn", authorityId: "captain-cooperation-v1", appraisalId: "received-outcome-v1", limits: { actors: 3, tasks: 64, commitments: 64, reliefs: 64, evidence: 512, knowledge: 2048, accepted: 4096, operations: 16, effects: 16, text: 4096, wire: 65536 }, indicators: map(\id. { id: id, minimum: 0, maximum: 100 }, ["fatigue", "readiness", "observations", "trust"]), recipes: [{ id: "observations", duration: 4, allocation: 1, costs: [{ resource: "materials", reserve: 4, consume: 4 }], effects: [IndicatorDelta("scientist", "observations", 25), IndicatorDelta("scientist", "fatigue", 25), IndicatorDelta("scientist", "readiness", 0 - 5)] }, { id: "maintenance", duration: 3, allocation: 1, costs: [{ resource: "materials", reserve: 3, consume: 2 }], effects: [IndicatorDelta("engineer", "readiness", 20), IndicatorDelta("engineer", "fatigue", 10)] }, { id: "rest_scientist", duration: 2, allocation: 1, costs: [], effects: [IndicatorDelta("scientist", "fatigue", 0 - 15)] }, { id: "rest_engineer", duration: 2, allocation: 1, costs: [], effects: [IndicatorDelta("engineer", "fatigue", 0 - 15)] }], rules: [{ id: "overextended", actor: "scientist", indicator: "fatigue", above: true, threshold: 60, recovery: 40, duration: 2, cooldown: 3 }], evidence: [], knowledge: [], relationships: [{ from: "scientist", to: "captain", dimension: "trust", value: 50 }, { from: "engineer", to: "captain", dimension: "trust", value: 50 }] })

export pure func actors() -> [Actor]
ensures { result != [] } =
  [{ id: "captain", capacity: 1, attributes: [], values: [{ id: "mission", value: 80 }], indicators: values(10, 50) }, { id: "scientist", capacity: 1, attributes: ocean(80, 65, 40, 55, 60), values: [{ id: "curiosity", value: 80 }, { id: "autonomy", value: 75 }], indicators: values(45, 50) }, { id: "engineer", capacity: 1, attributes: ocean(45, 85, 35, 65, 40), values: [{ id: "reliability", value: 85 }, { id: "fairness", value: 70 }], indicators: values(30, 50) }]

pure func values(fatigue: int, readiness: int) -> [Value] =
  [{ id: "fatigue", value: fatigue }, { id: "readiness", value: readiness }, { id: "observations", value: 0 }, { id: "trust", value: 50 }]

pure func ocean(o: int, c: int, e: int, a: int, n: int) -> [Value] =
  [{ id: "openness", value: o }, { id: "conscientiousness", value: c }, { id: "extraversion", value: e }, { id: "agreeableness", value: a }, { id: "neuroticism", value: n }]

export pure func resources() -> [Resource]
ensures { length(result) == 1 } =
  [{ id: "materials", initial: 6, available: 6, reserved: 0, consumed: 0, transferredIn: 0, transferredOut: 0 }]

export pure func workerRecipe(worker: string, recipe: string) -> bool
ensures { result == (worker == "scientist" && (recipe == "observations" || recipe == "rest_scientist") || worker == "engineer" && (recipe == "maintenance" || recipe == "rest_engineer")) } =
  worker == "scientist" && (recipe == "observations" || recipe == "rest_scientist") || worker == "engineer" && (recipe == "maintenance" || recipe == "rest_engineer")

pure func authority(s: State, p: Principal, t: Task) -> Authority = match p {
  ActorPrincipal("captain") => if any(\worker. not any(\r. r.from == worker && r.to == "captain" && r.dimension == "trust" && r.value >= 20, s.relationships), t.participants) then Refused("cooperation floor") else Allowed,
  _ => Refused("captain assignment only")
}

pure func appraisal(a: Appraisal) -> [Effect] =
  if a.evidence.author != "captain" || a.evidence.kind != "concern" || not any(\id. any(\e. e.id == id && e.author == "captain" && e.kind == "task_offer", a.visible), a.evidence.causes) then [] else match decodeOutcome(a.evidence.text) {
    Err(_) => [],
    Ok(outcome) => match head(filter(\r. r.to == "captain" && r.dimension == "trust", a.relationships)) {
      None => [],
      Some(r) => {
        let delta = outcomeDelta(outcome)
        let boundedDelta = if r.value + delta < 0 then 0 - r.value else if r.value + delta > 100 then 100 - r.value else delta;
        [RelationshipDelta(a.observer.id, "captain", "trust", boundedDelta)]
      }
    }
  }

export pure func policies() -> Policies
ensures { result.authorityId == "captain-cooperation-v1" && result.appraisalId == "received-outcome-v1" } =
  { authorityId: "captain-cooperation-v1", appraisalId: "received-outcome-v1", authority: authority, appraisal: appraisal }

test "experimental recipe ownership" {
  workerRecipe("scientist", "observations") && not workerRecipe("engineer", "observations") && not workerRecipe("captain", "maintenance")
}

test "unknown policy rejected" {
  config("good") == Err("policy")
}
