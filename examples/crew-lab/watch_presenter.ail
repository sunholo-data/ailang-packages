module sunholo/crew_lab/watch_presenter
import std/list (map,filter,head,length)
import std/string (join,length as size)
import std/option (Some,None)
import pkg/sunholo/terminal_ui/ui (Screen,Dimensions,screen,safeText)
import pkg/sunholo/social_dynamics/model (Actor,Working,Completed,Offered,Stopped)
import ./play_flow (PlayState,menu)
import ./session (Session)
import ./journey_flow (Navigation)
import ./watch_scenario (projectName,purpose,workers)
import ./narrative (crew,supplies,costs,spendsSupplies,observation, fatigue, stress, morale)

export pure func guide(mode: string,remaining: int,path: string) -> string ! {}
ensures { size(result) > 0 } =
 "[ YOUR WATCH ]\nYou are preparing a strained crew for possible first contact. Five specialists have different priorities. There is no best score or required route.\n\n1 Choose work: read its purpose, duration and resources, then offer it. Hear the worker's reaction. Start reserves capacity and supplies; Leave keeps the offer open.\n2 Arrange rest: a two-turn assignment with no supplies. Recovery happens when rest completes.\n5 Advance: time passes for everyone working. People and equipment change at completion, not gradually.\n6 Check-in: hear someone already working. They may ask for relief; choose8 to grant or deny it.\n7 Offers: return to a decision you left open.\n\nArchive compute slots analyse Spire readings. They return when work completes or relief stops it. Replacement modules and diagnostic cartridges are finite: completion spends them, granted relief refunds their reservation. Waiting restores no spent stock. Even capped benefits still spend supplies.\n\nYour command style lasts this run: agreement requires the worker's consent; captain's authority permits starting despite refusal, but cooperation can suffer and resources/capacity still apply.\n\nReading Crew, Work, Log or this guide does not pass time. b returns to the current decision; n/v pages. Numbers choose actions; press Enter after a key. Blank input ends the run.\n\n${if mode == "offline" then "Saved dialogue or authored narrator summaries are used; no AI calls." else "New dialogue has ${remaining} attempts remaining. Saved dialogue needs no new call. The separate response-policy-watch-v2.json sets the limit (maximum8); choose authored continuation if it is exhausted."}\n\nEight turns mark a review, not arrival or a deadline. This watch does not simulate alien negotiations yet.\nJournal: ${path}\nA fresh launch starts a new crew. The response library persists."

pure func work(s: PlayState,debug: bool) -> string = {
 let tasks = join("\n\n",map(\t. {
  let progress = if t.status == Working then "Working: ${s.session.state.tick - t.started}/${t.due - t.started} turns" else if t.status == Completed then "Completed" else if t.status == Stopped then "Stopped" else "Offered; waiting for your Start decision";
  "[ ${projectName(t.recipe)} / ${join(", ",t.participants)} ]\n${progress}\n${purpose(t.recipe)}\n${costs(s.session,t.recipe)}\n${if debug then "Task ${t.id}; recipe ${t.recipe}" else "Supplies are spent on completion even when a benefit is already at its limit."}"
 },s.session.state.tasks));
 "[ RESOURCES ]\n${supplies(s.session)}\nCompute is reusable capacity; physical supplies are finite.\n\n${if tasks == "" then "No assignments offered. Choose work or rest to begin." else tasks}"
}
pure func footer(s: PlayState) -> [string] = {
 let choices = if s.phase == "main" then match s.session.state.continuation {Some(_)=>["1 Continue /2 Abort /0 Quit"],None=>["1 Choose work /2 Arrange rest","5 Advance /6 Check-in","7 Offers /8 Relief /0 Quit"]} else if s.phase == "start" then ["1 Start /2 Leave open /0 Back"] else if s.phase == "response" then ["1 Retry /2 Authored /3 Cancel /0 Quit"] else if s.phase == "relief" then ["1 Grant relief /2 Deny /0 Back"] else ["Choose a listed number /0 Back"];
 choices ++ ["c Crew w Work j Log h Guide b Bridge","n Next /v Previous; key + Enter"]
}
pure func indicator(a: Actor,id: string) -> int = match a.indicators {[]=>50,v::rest=>if v.id == id then v.value else indicator({a | indicators:rest},id)}
pure func shortFatigue(a: Actor) -> string = if indicator(a,"fatigue") < 25 then "rested" else if indicator(a,"fatigue") < 60 then "tired" else "exhausted"
pure func shortStress(a: Actor) -> string = if indicator(a,"stress") < 60 then "watchful" else "on edge"
pure func shortMorale(a: Actor) -> string = if indicator(a,"morale") < 30 then "discouraged" else if indicator(a,"morale") < 70 then "steady" else "in good spirits"
pure func bridge(s: PlayState,message: string) -> string = {
 let crewLines = join("\n",map(\a. "${a.id}: ${shortFatigue(a)}, ${shortStress(a)}, ${shortMorale(a)}",filter(\a. a.id != "captain",s.session.state.actors)));
 "${if s.session.state.tick >= 8 then "[ PREPARATION REVIEW ]\nReview what changed. You may continue; this is not arrival or a grade.\n" else ""}${if message == "" then "Start by choosing work or rest. Offering lets you hear the crew before committing." else "[ CONVERSATION / CONSEQUENCE ]\n${message}"}\n\n${supplies(s.session)}\n\n${crewLines}"
}
pure func choices(s: PlayState) -> string =
 if s.phase == "assignments" || s.phase == "rests" then join("\n\n",catalog(s,workers(),1)) else menu(s)
pure func catalog(s: PlayState,xs: [string],n: int) -> [string] = match xs {
 []=>[],worker::rest=>{
  let recipe = "${if s.phase == "rests" then "rest" else "work"}_${worker}";
  "${n}. ${projectName(recipe)} / ${worker}\n${purpose(recipe)}\n${costs(s.session,recipe)}${if spendsSupplies(s.session,recipe) then "\nSupplies spend on completion even at a benefit limit." else ""}" :: catalog(s,rest,n+1)
 }
}
export pure func frame(s: PlayState,nav: Navigation,message: string,mode: string,remaining: int,path: string,d: Dimensions,ansi: bool,debug: bool) -> Screen ! {}
ensures { result.pages >= 1 && result.page >= 0 && result.page < result.pages } = {
 let selector = s.phase == "assignments" || s.phase == "rests" || s.phase == "working" || s.phase == "offered" || s.phase == "reliefs";
 let context = if s.phase == "start" then match head(filter(\t. t.id == s.target,s.session.state.tasks)) {None=>"Offer unavailable",Some(t)=>"[ START: ${projectName(t.recipe)} ]\n${costs(s.session,t.recipe)}${if spendsSupplies(s.session,t.recipe) then "\nSupplies spend even at a benefit limit." else ""}\n"} else if s.phase == "response" then "[ CREW REPLY PENDING ]\nRetry may request new dialogue. Authored continuation uses no call.\n" else "";
 let body = if nav.view == "crew" then crew(s.session,debug) else if nav.view == "work" then work(s,debug) else if nav.view == "guide" then guide(mode,remaining,path) else if nav.view == "log" then "[ YOUR WATCH LOG ]\n${join("\n\n",nav.history)}" else if selector then "[ CHOOSE AN ASSIGNMENT ]\n${choices(s)}" else "${context}${bridge(s,message)}";
 screen(d,ansi,["VOYAGE / ${nav.view} / turn ${s.session.state.tick}","Before first hello / ${if s.session.policy == "consent" then "Ask for agreement" else "Captain's authority"}"],body,footer(s),nav.page)
}
export pure func recap(s: PlayState,path: string,debug: bool) -> string ! {}
ensures { size(result) > 0 } = safeText("END OF YOUR PREPARATION WATCH\n${s.session.state.tick} turns; ${length(filter(\t. t.status == Completed,s.session.state.tasks))} projects completed.\n${supplies(s.session)}\n\n${crew(s.session,debug)}\nJournal: ${path}\nNo arrival or grade is simulated. A fresh launch starts a new crew; the library persists.")
