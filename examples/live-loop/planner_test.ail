module sunholo/live_loop_lab/planner_test
import ./planner (State, Command, initial, apply, boundaryFrame, nextBoundary, ceilDiv, handle)
import std/result (Result, Ok, Err)
import std/option (Option, Some, None)
import std/string (contains)

pure func cmd(s: State, kind: string, id: string) -> Command = {id:id, kind:kind, epoch:s.epoch, expected:s.revision, track:1, base:0, now:0, ready:0, origin:48000, rate:48000, bpm:120, level:50, pan:0, muted:false, asset:"take-1", hash:"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", pendingId:"p", at:432000, applied:432000}
pure func value(r: Result[State,string]) -> State = match r { Ok(s) => s, Err(_) => initial() }
pure func started() -> State = { let s=initial(); value(apply(s,cmd(s,"configure","start"))) }
pure func prepared() -> State = { let s=started(); value(apply(s,{cmd(s,"prepare","p") | now:48001, ready:48001})) }
pure func bad(r: Result[State,string]) -> bool = match r { Err(_) => true, _ => false }

test "absolute boundary conversion covers exact and fractional cycles" {
  ceilDiv(0,7)==0 && ceilDiv(8,7)==2 && boundaryFrame(48000,120,48000,1)==432000
  && nextBoundary(48000,120,48000,48000)==48000 && nextBoundary(48000,120,48000,48001)==432000
  && nextBoundary(44100,137,100,309123)==618143
}
test "configure increments epoch and duplicate commands do not increment revision" {
  let s=initial(); let c=cmd(s,"configure","start"); let t=value(apply(s,c));
  t.running && t.epoch==1 && t.revision==1
  && bad(apply(t,c))
  && value(apply(t,{cmd(t,"parameter","x") | level:25})).revision==2
}
test "idempotence precedes revision check within the current epoch" {
  let s=started(); let c=cmd(s,"parameter","x"); let t=value(apply(s,c));
  match apply(t,c) { Ok(u) => u.epoch==t.epoch && u.revision==t.revision && u.seen==t.seen, _ => false }
}
test "stale revision invalid parameter stopped and forged state are rejected" {
  let s=started();
  bad(apply(s,{cmd(s,"parameter","a") | expected:0}))
  && bad(apply(s,{cmd(s,"parameter","a") | pan:101}))
  && bad(apply(initial(),cmd(initial(),"parameter","a")))
  && bad(apply({s | tracks:[]},cmd(s,"reset","a")))
}
test "prepare uses a future boundary and refuses a second pending revision" {
  let s=prepared();
  (match s.tracks { [t,_,_,_] => match t.pending { Some(p) => p.at==432000 && not p.scheduled && p.revision==1, _ => false }, _ => false })
  && bad(apply(s,cmd(s,"prepare","p2")))
}
test "late staging retains old track and refuses false activation" {
  let s=prepared();
  bad(apply(s,{cmd(s,"schedule","late") | now:431873}))
  && bad(apply(s,cmd(s,"activate","early")))
  && bad(apply(s,{cmd(s,"schedule","old") | pendingId:"old"}))
}
test "schedule then exact render acknowledgement activates once" {
  let s=prepared(); let t=value(apply(s,{cmd(s,"schedule","stage") | now:431872}));
  bad(apply(t,{cmd(t,"activate","wrong") | applied:432001}))
  && (match apply(t,{cmd(t,"activate","active") | now:432000}) { Ok(v) => match v.tracks { [a,_,_,_] => a.revision==1 && a.asset=="take-1" && (match a.pending { None=>true, _=>false }), _=>false }, _=>false })
}
test "reset rejects stale callbacks and clears pending state" {
  let s=prepared(); let t=value(apply(s,cmd(s,"reset","stop")));
  not t.running && t.epoch==s.epoch+1 && bad(apply(t,cmd(s,"schedule","late")))
}
test "JSON boundary rejects malformed missing schema fractional numbers and extra payload" {
  contains(handle("{}"),"unsupported schema") && contains(handle("{"),"invalid JSON")
  && contains(handle("{\"schema\":1.5,\"op\":\"init\"}"),"unsupported schema")
  && contains(handle("{\"schema\":1,\"op\":\"init\"}"),"\"ok\":true")
}
property "next boundary never precedes a bounded arbitrary threshold" {
  forall(n: int) => { let x=n%100000; let t=if x<0 then 0-x else x; nextBoundary(44100,137,100,t)>=t }
}
