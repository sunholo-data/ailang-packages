-- sunholo/decisions/decide — typed decisions from a System One model.
--
-- A System One model (TypeSafe Jev) is not an LLM: it takes a JSON `state`
-- plus typed `questions` and returns typed answers, each with a probability
-- distribution and (for Choice/Score) a calibrated `confidence`. This module
-- is the AILANG binding, in pure AILANG over std/net + std/json + std/env.
--
-- Transports (v0.3): an explicit `Transport` — nothing switches routes silently.
--   OpenRouter      POST https://openrouter.ai/api/alpha/decisions   bearer OPENROUTER_API_KEY
--                   model names like "typesafe/jev-1.13"; calls appear in OpenRouter
--                   Broadcast traces (our provider-side instrument) and carry usage.cost.
--   TypeSafeDirect  POST https://api.typesafe.ai/v1/systemone        bearer TYPESAFE_API_KEY
--                   model names "jev-latest" | "jev-preview" (GET /v1/models); the response
--                   carries no id and no cost (use listPriceUsd), and NO Broadcast trace exists.
-- Same request/response body on both. `decide` = OpenRouter (unchanged since 0.1);
-- `decideDirect` = TypeSafe direct; `decideVia` takes the transport explicitly.
--
-- Rules for consumers (design_docs/planned/m-ai-decide-system-one.md):
--   D4  No default threshold lives here. `gate` REQUIRES minConfidence and
--       returns a three-way Gate; a wrong variant is never "low confidence".
--   D6  The model is NON-DETERMINISTIC (identical calls: ±0.04 on the
--       distribution; argmax usually stable). Bank the whole Decision
--       (model, id, answers with distributions, usage) — never argmax alone.
--   Answer.confidence is meaningful only for a Decision whose `model` is a
--       System One model. parseAnswers is exported for replay of banked
--       bodies; it makes no provenance claim about what you feed it.
--
-- Limitations (v0.1): calls go through the Net effect, so they are bounded
-- by --net-timeout (30s default) but are NOT in the AI effect's budget or
-- `ailang trace` cost totals — OpenRouter Broadcast is the independent
-- record. Text only; English primary; 32k-token state ceiling.

module sunholo/decisions/decide

import std/json (Json, encode, decode, jo, ja, kv, js, jb, jnum, get, getString, getNumber, getInt, getObject, getArray, asObject, asNumber)
import std/net (httpRequest, NetError)
import std/env (getEnv)
import std/list (map, length)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/math (round, intToFloat, floatToInt)
import std/string (stringToInt, startsWith, endsWith)

-- ---------------------------------------------------------------- types

-- A typed question. Names mirror TypeSafe's three primitives.
export type Question =
  | Noul(string)                                     -- instructions -> P(yes)
  | Choice(string, [{ key: string, desc: string }])  -- instructions, options
  | Score(string, [string])                          -- instructions, ordered levels (index = level)

-- A typed answer. Distributions are ordered {key, p} records and are always
-- carried, never discarded. Score keys are the level index as a string.
export type Answer =
  | NoulA(float)
  | ChoiceA({ choice: string, confidence: float, probabilities: [{ key: string, p: float }] })
  | ScoreA({ score: float, confidence: float, probabilities: [{ key: string, p: float }] })

export type DecideError =
  | MissingKey(string)      -- OPENROUTER_API_KEY not set
  | Http(int, string)       -- non-2xx: status + body
  | Transport(string)       -- Net effect error (incl. the 30s deadline)
  | BadResponse(string)     -- 2xx but not the Decisions shape
  | MissingAnswer(string)   -- a question the response did not answer / a name you never asked
  | WrongVariant(string)    -- a helper applied to the wrong Answer constructor

-- One round trip's full result. `model`/`id` are the wire values (provenance);
-- cost_usd is OpenRouter's usage.cost (0.0 when the transport does not send one).
export type Decision = {
  model: string,
  id: string,
  answers: [{ name: string, answer: Answer }],
  input_tokens: int,
  output_tokens: int,
  cost_usd: float
}

-- The ONLY policy-shaped value here, and three-way on purpose: a wrong
-- variant is never reported as "not confident enough".
export type Gate =
  | Act(string)          -- confidence >= minConfidence: the label (ChoiceA) or the rounded level (ScoreA)
  | Escalate(float)      -- confidence <  minConfidence: carries the confidence for the caller's log
  | Ungateable(string)   -- NoulA has no confidence: threshold its probability directly

-- Transport: which wire the System One call goes over. Explicit on purpose —
-- the two differ in model naming, cost reporting and observability.
export type Transport =
  | OpenRouter        -- via OpenRouter: OPENROUTER_API_KEY, "typesafe/jev-1.13", Broadcast-traced, usage.cost on the wire
  | TypeSafeDirect    -- via api.typesafe.ai: TYPESAFE_API_KEY, "jev-latest" | "jev-preview", no trace, no cost on the wire

-- defaultModel: the current default model NAME for a transport (they differ).
export pure func defaultModel(t: Transport) -> string =
  match t { OpenRouter => "typesafe/jev-1.13", TypeSafeDirect => "jev-latest" }

-- listPriceUsd: the vendor's list price for a Decision when the wire carried
-- no cost (TypeSafe direct): $0.042 per 1M input tokens, output free
-- (openrouter.ai/typesafe/jev-1.13 and typesafe.ai pricing, 2026-09-18).
-- Prefer d.cost_usd when it is non-zero — that is what was actually billed.
export pure func listPriceUsd(d: Decision) -> float =
  if d.cost_usd > 0.0 then d.cost_usd else intToFloat(d.input_tokens) * 0.000000042

-- ---------------------------------------------------------------- request (pure)

func questionJson(q: Question) -> Json =
  match q {
    Noul(instr) => jo([kv("type", js("noul")), kv("instructions", js(instr))]),
    Choice(instr, opts) => jo([kv("type", js("choice")), kv("instructions", js(instr)),
                               kv("criteria", jo(map(\o. kv(o.key, js(o.desc)), opts)))]),
    Score(instr, levels) => jo([kv("type", js("score")), kv("instructions", js(instr)),
                                kv("criteria", ja(map(\l. js(l), levels)))])
  }

-- buildRequest: the exact Decisions body (OpenRouter and TypeSafe direct).
export pure func buildRequest(model: string, state: Json, questions: [{ name: string, q: Question }]) -> string
  ensures { startsWith(result, "{") && endsWith(result, "}") }
= encode(jo([kv("model", js(model)), kv("state", state),
             kv("questions", jo(map(\nq. kv(nq.name, questionJson(nq.q)), questions)))]))

-- questionsToJsonSchema: a strict JSON Schema asking a chat LLM for the SAME
-- questions as a per-label probability distribution (Choice/Score) or a
-- single probability (Noul). The only LLM-facing export: it yields a schema,
-- never an Answer. Used by the shadow runner's control arm.
export pure func questionsToJsonSchema(questions: [{ name: string, q: Question }]) -> string
  ensures { startsWith(result, "{") && endsWith(result, "}") }
= encode(schemaValue(questions))

-- schemaValue: the schema as Json (the fallback embeds it in a request body
-- without a decode round-trip).
func schemaValue(questions: [{ name: string, q: Question }]) -> Json =
  jo([kv("type", js("object")), kv("additionalProperties", jb(false)),
      kv("required", ja(map(\nq. js(nq.name), questions))),
      kv("properties", jo(map(\nq. kv(nq.name, questionSchema(nq.q)), questions)))])

func numberProp() -> Json = jo([kv("type", js("number")), kv("minimum", jnum(0.0)), kv("maximum", jnum(1.0))])

func labelledDist(keys: [string]) -> Json =
  jo([kv("type", js("object")), kv("additionalProperties", jb(false)),
      kv("required", ja(map(\k. js(k), keys))),
      kv("properties", jo(map(\k. kv(k, numberProp()), keys)))])

func questionSchema(q: Question) -> Json =
  match q {
    Noul(_) => numberProp(),
    Choice(_, opts) => labelledDist(map(\o. o.key, opts)),
    Score(_, levels) => labelledDist(indexKeys(length(levels), 0))
  }

func indexKeys(n: int, i: int) -> [string] =
  if i >= n then [] else [show(i)] ++ indexKeys(n, i + 1)

-- ---------------------------------------------------------------- response (pure)

func num(j: Json, k: string) -> float =
  match getNumber(j, k) { Some(x) => x, None => 0.0 }

func str(j: Json, k: string) -> string =
  match getString(j, k) { Some(s) => s, None => "" }

func dist(j: Json) -> [{ key: string, p: float }] =
  match getObject(j, "probabilities") {
    None => [],
    Some(ps) => match asObject(ps) {
      None => [],
      Some(kvs) => map(\e. { key: e.key, p: match asNumber(e.value) { Some(x) => x, None => 0.0 } }, kvs)
    }
  }

func answerOf(name: string, j: Json) -> Result[Answer, DecideError] =
  match getString(j, "type") {
    Some("noul") => Ok(NoulA(num(j, "noul"))),
    Some("choice") => Ok(ChoiceA({ choice: str(j, "choice"), confidence: num(j, "confidence"), probabilities: dist(j) })),
    Some("score") => Ok(ScoreA({ score: num(j, "score"), confidence: num(j, "confidence"), probabilities: dist(j) })),
    Some(other) => Err(BadResponse("answer ${name}: unknown type ${other}")),
    None => Err(BadResponse("answer ${name}: no type"))
  }

@allow_empty_ok("recursion base case: an empty question list legitimately yields an empty answer list")
func collect(questions: [{ name: string, q: Question }], answers: Json) -> Result[[{ name: string, answer: Answer }], DecideError] =
  match questions {
    [] => Ok([]),
    [nq, ...rest] => match get(answers, nq.name) {
      None => Err(MissingAnswer(nq.name)),
      Some(aj) => match answerOf(nq.name, aj) {
        Err(e) => Err(e),
        Ok(a) => match collect(rest, answers) {
          Err(e) => Err(e),
          Ok(tail) => Ok([{ name: nq.name, answer: a }] ++ tail)
        }
      }
    }
  }

func usageInt(body: Json, k: string) -> int =
  match getObject(body, "usage") { None => 0, Some(u) => match getInt(u, k) { Some(n) => n, None => 0 } }

func usageCost(body: Json) -> float =
  match getObject(body, "usage") { None => 0.0, Some(u) => num(u, "cost") }

-- parseAnswers: decode a Decisions response body against the questions that
-- were asked. Pure; replayable from a banked body. Every question must be
-- answered (MissingAnswer otherwise); unknown answer types are BadResponse.
export pure func parseAnswers(body: string, questions: [{ name: string, q: Question }]) -> Result[Decision, DecideError]
  ensures { match result { Ok(d) => length(d.answers) == length(questions), Err(_) => true } }
= match decode(body) {
    Err(e) => Err(BadResponse("not JSON: ${e}")),
    Ok(j) => match getObject(j, "answers") {
      None => Err(BadResponse("no answers object")),
      Some(answers) => match collect(questions, answers) {
        Err(e) => Err(e),
        Ok(named) => Ok({ model: str(j, "model"), id: str(j, "id"), answers: named,
                          input_tokens: usageInt(j, "input_tokens"), output_tokens: usageInt(j, "output_tokens"),
                          cost_usd: usageCost(j) })
      }
    }
  }

-- ---------------------------------------------------------------- helpers (pure, no policy)

-- answer: look one answer up by the name you asked under.
export pure func answer(d: Decision, name: string) -> Result[Answer, DecideError] =
  findNamed(d.answers, name)

func findNamed(xs: [{ name: string, answer: Answer }], name: string) -> Result[Answer, DecideError] =
  match xs {
    [] => Err(MissingAnswer(name)),
    [x, ...rest] => if x.name == name then Ok(x.answer) else findNamed(rest, name)
  }

-- gate: the caller supplies the threshold; the result is exhaustive.
export pure func gate(a: Answer, minConfidence: float) -> Gate
  requires { minConfidence >= 0.0 && minConfidence <= 1.0 }
= match a {
    NoulA(_) => Ungateable("NoulA carries a probability, not a confidence: threshold the probability directly"),
    ChoiceA(c) => if c.confidence >= minConfidence then Act(c.choice) else Escalate(c.confidence),
    ScoreA(s) => if s.confidence >= minConfidence then Act(show(floatToInt(round(s.score)))) else Escalate(s.confidence)
  }

-- expectedScore: Σ level·p over a ScoreA's distribution.
export pure func expectedScore(a: Answer) -> Result[float, DecideError]
  ensures { match result { Ok(x) => x >= 0.0, Err(_) => true } }
= match a {
    ScoreA(s) => Ok(weighted(s.probabilities)),
    ChoiceA(_) => Err(WrongVariant("expectedScore: ChoiceA has no ordinal levels")),
    NoulA(_) => Err(WrongVariant("expectedScore: NoulA has no levels"))
  }

func weighted(ps: [{ key: string, p: float }]) -> float =
  match ps {
    [] => 0.0,
    [x, ...rest] => (match stringToInt(x.key) { Some(i) => intToFloat(i) * x.p, None => 0.0 }) + weighted(rest)
  }

-- ---------------------------------------------------------------- the effectful shell

-- decide: one round trip via OpenRouter (the 0.1 behaviour, unchanged). Every
-- question sees the same state; answers come back keyed by the question name.
-- Bounded by the Net effect's deadline.
export func decide(model: string, state: Json, questions: [{ name: string, q: Question }])
  -> Result[Decision, DecideError] ! {Net, Env} =
  decideVia(OpenRouter, model, state, questions)

-- decideDirect: one round trip via api.typesafe.ai (TYPESAFE_API_KEY). Model
-- names are the direct API's ("jev-latest", "jev-preview").
export func decideDirect(model: string, state: Json, questions: [{ name: string, q: Question }])
  -> Result[Decision, DecideError] ! {Net, Env} =
  decideVia(TypeSafeDirect, model, state, questions)

-- decideVia: the transport made explicit. MissingKey names the key the chosen
-- transport needs.
export func decideVia(transport: Transport, model: string, state: Json, questions: [{ name: string, q: Question }])
  -> Result[Decision, DecideError] ! {Net, Env} =
  match transport {
    OpenRouter => match getEnv("OPENROUTER_API_KEY") {
      Err(_) => Err(MissingKey("OPENROUTER_API_KEY")),
      Ok(key) => decideWith("https://openrouter.ai/api/alpha/decisions", key, model, state, questions)
    },
    TypeSafeDirect => match getEnv("TYPESAFE_API_KEY") {
      Err(_) => Err(MissingKey("TYPESAFE_API_KEY")),
      Ok(key) => decideWith("https://api.typesafe.ai/v1/systemone", key, model, state, questions)
    }
  }

-- decideWith: the same call against an explicit endpoint + bearer (a proxy, a
-- recorder, a future vendor). Still ! {Env} for signature parity; reads nothing.
export func decideWith(endpoint: string, bearer: string, model: string, state: Json, questions: [{ name: string, q: Question }])
  -> Result[Decision, DecideError] ! {Net, Env} =
  match httpRequest("POST", endpoint,
                    [{ name: "Authorization", value: "Bearer ${bearer}" },
                     { name: "Content-Type", value: "application/json" },
                     { name: "X-Title", value: "sunholo/decisions" },
                     { name: "x-typesafe-sdk", value: "sunholo-decisions/0.3.0" }],
                    buildRequest(model, state, questions)) {
    Err(e) => Err(Transport(show(e))),
    Ok(resp) => if not resp.ok then Err(Http(resp.status, resp.body)) else parseAnswers(resp.body, questions)
  }

-- ============================================================================
-- Fallback: decide, or degrade to a chat LLM when the System One model is unavailable
-- ============================================================================
-- (formerly module sunholo/decisions/fallback — merged 0.2.0: a second module
-- importing this one trips an `ailang test` engine defect; see CHANGELOG.) Decide, or degrade to a chat LLM when the
-- System One model is unavailable, WITHOUT letting the fallback masquerade as
-- a calibrated answer.
--
-- The trap (quorum objection, 2026-09-18): an LLM asked for a "probability
-- distribution" self-reports one; it is not calibrated, and if it flowed into
-- Answer.confidence every gate(...) downstream would act on it. So:
--
--   type Outcome = Calibrated(Decision)            -- from the System One model
--                | Degraded(Decision, DecideError) -- from the fallback LLM, and WHY
--
--   * A Degraded Decision's ChoiceA/ScoreA carry confidence = 0.0 (forced), so
--     gate(a, t) returns Escalate(0.0) for any t > 0. Acting on a degraded
--     answer is an explicit opt-in: match Degraded, read the label yourself.
--   * NoulA(p) keeps the LLM's self-reported p — a noul has no confidence to
--     force; the Degraded constructor is the signal.
--   * Decision.model is "fallback:<chat-model>" and Decision.id the chat
--     completion id, so a banked row (D6) says where it came from.
--   * The fallback runs on the SAME std/net transport and 30s deadline, with a
--     strict json_schema built from the same Question list (per-label
--     probabilities requested, renormalised client-side).
--
-- What triggers the fallback: Transport, Http (any status), BadResponse and
-- MissingAnswer from the System One call — i.e. "Jev is not available or not
-- speaking the protocol". MissingKey does NOT: the fallback needs the same key.

export type Outcome =
  | Calibrated(Decision)
  | Degraded(Decision, DecideError)

-- decisionOf: the Decision either way — for banking (D6), not for gating.
export pure func decisionOf(o: Outcome) -> Decision =
  match o { Calibrated(d) => d, Degraded(d, _) => d }

export pure func isDegraded(o: Outcome) -> bool =
  match o { Calibrated(_) => false, Degraded(_, _) => true }

-- decideOrFallback: the System One model first; on unavailability, the chat
-- model named by fallbackModel (an OpenRouter chat slug, e.g. "z-ai/glm-5.3-flash").
export func decideOrFallback(model: string, fallbackModel: string, state: Json, questions: [{ name: string, q: Question }])
  -> Result[Outcome, DecideError] ! {Net, Env} =
  decideOrFallbackVia(OpenRouter, model, fallbackModel, state, questions)

-- decideOrFallbackVia: the same, with the System One transport explicit. The
-- fallback LLM always goes via OpenRouter chat completions (OPENROUTER_API_KEY),
-- so with TypeSafeDirect you need BOTH keys for the degraded path to exist;
-- without the OpenRouter key a direct failure returns Err(MissingKey("OPENROUTER_API_KEY")).
export func decideOrFallbackVia(transport: Transport, model: string, fallbackModel: string, state: Json, questions: [{ name: string, q: Question }])
  -> Result[Outcome, DecideError] ! {Net, Env} =
  match decideVia(transport, model, state, questions) {
    Ok(d) => Ok(Calibrated(d)),
    Err(MissingKey(k)) => Err(MissingKey(k)),
    Err(why) => match getEnv("OPENROUTER_API_KEY") {
      Err(_) => Err(MissingKey("OPENROUTER_API_KEY")),
      Ok(key) => match llmCall(key, fallbackModel, state, questions) {
        Err(e) => Err(e),
        Ok(body) => match parseFallback(body, fallbackModel, questions) {
          Err(e) => Err(e),
          Ok(d) => Ok(Degraded(d, why))
        }
      }
    }
  }

-- ---------------------------------------------------------------- the chat call

func chatBody(model: string, state: Json, qs: [{ name: string, q: Question }]) -> string =
  encode(jo([
    kv("model", js(model)),
    kv("temperature", jnum(0.0)),
    kv("messages", ja([
      jo([kv("role", js("system")), kv("content", js("You are a fallback classifier standing in for a System One decision model. You receive a STATE and QUESTIONS in the TypeSafe System One format (noul = probability the statement is true; choice = one option among the criteria keys; score = one ordered level among the criteria, index 0 upwards). Answer with a JSON object keyed by question name: for choice and score give a probability for EVERY key summing to 1; for noul give the probability the statement is true. Do not explain."))]),
      jo([kv("role", js("user")), kv("content", js(buildRequest("n/a", state, qs)))])])),
    kv("response_format", jo([kv("type", js("json_schema")), kv("json_schema", jo([kv("name", js("decisions")), kv("strict", jb(true)), kv("schema", schemaValue(qs))]))]))]))

func llmCall(key: string, model: string, state: Json, qs: [{ name: string, q: Question }]) -> Result[string, DecideError] ! {Net} =
  match httpRequest("POST", "https://openrouter.ai/api/v1/chat/completions",
                    [{ name: "Authorization", value: "Bearer ${key}" }, { name: "Content-Type", value: "application/json" }, { name: "X-Title", value: "sunholo/decisions fallback" }],
                    chatBody(model, state, qs)) {
    Err(e) => Err(Transport("fallback: ${show(e)}")),
    Ok(resp) => if resp.ok then Ok(resp.body) else Err(Http(resp.status, "fallback: ${resp.body}"))
  }

-- ---------------------------------------------------------------- parsing (pure)

-- parseFallback: a chat-completions body -> a DEGRADED Decision (confidence
-- forced to 0.0 on ChoiceA/ScoreA; model tagged "fallback:<model>").
export pure func parseFallback(body: string, fallbackModel: string, questions: [{ name: string, q: Question }]) -> Result[Decision, DecideError] =
  match decode(body) {
    Err(e) => Err(BadResponse("fallback body not JSON: ${e}")),
    Ok(j) => match contentOf(j) {
      Err(e) => Err(BadResponse("fallback: ${e}")),
      Ok(content) => match fbCollect(questions, content) {
        Err(e) => Err(e),
        Ok(named) => Ok({ model: "fallback:${fallbackModel}", id: fbStr(j, "id"), answers: named,
                          input_tokens: fbUsageInt(j, "prompt_tokens"), output_tokens: fbUsageInt(j, "completion_tokens"),
                          cost_usd: fbUsageCost(j) })
      }
    }
  }

func contentOf(body: Json) -> Result[Json, string] =
  match getArray(body, "choices") {
    None => Err("no choices"),
    Some([]) => Err("empty choices"),
    Some([c, ..._]) => match getObject(c, "message") {
      None => Err("no message"),
      Some(m) => match getString(m, "content") {
        None => Err("no content"),
        Some(text) => match decode(text) { Ok(j) => Ok(j), Err(e) => Err("content not JSON: ${e}") }
      }
    }
  }

@allow_empty_ok("recursion base case: an empty question list legitimately yields an empty answer list")
func fbCollect(questions: [{ name: string, q: Question }], content: Json) -> Result[[{ name: string, answer: Answer }], DecideError] =
  match questions {
    [] => Ok([]),
    [nq, ...rest] => match get(content, nq.name) {
      None => Err(MissingAnswer(nq.name)),
      Some(v) => match degradedAnswer(nq.q, v) {
        Err(e) => Err(e),
        Ok(a) => match fbCollect(rest, content) {
          Err(e) => Err(e),
          Ok(tail) => Ok([{ name: nq.name, answer: a }] ++ tail)
        }
      }
    }
  }

func degradedAnswer(q: Question, v: Json) -> Result[Answer, DecideError] =
  match q {
    Noul(_) => match asNumber(v) { Some(p) => Ok(NoulA(p)), None => Err(BadResponse("fallback: noul is not a number")) },
    Choice(_, _) => match asObject(v) {
      None => Err(BadResponse("fallback: choice is not an object")),
      Some(kvs) => {
        let ps = normalised(kvs);
        Ok(ChoiceA({ choice: argmax(ps, "", -1.0), confidence: 0.0, probabilities: ps }))
      }
    },
    Score(_, _) => match asObject(v) {
      None => Err(BadResponse("fallback: score is not an object")),
      Some(kvs) => {
        let ps = normalised(kvs);
        Ok(ScoreA({ score: expected(ps), confidence: 0.0, probabilities: ps }))
      }
    }
  }

func numOr0(j: Json) -> float = match asNumber(j) { Some(x) => x, None => 0.0 }

func sumP(kvs: [{ key: string, value: Json }]) -> float =
  match kvs { [] => 0.0, [x, ...rest] => numOr0(x.value) + sumP(rest) }

-- normalised: the LLM's self-reported numbers rescaled to sum to 1 (the
-- adapter's normalize_probabilities); a zero-sum vector stays all-zero.
func normalised(kvs: [{ key: string, value: Json }]) -> [{ key: string, p: float }] =
  scaled(kvs, sumP(kvs))

func scaled(kvs: [{ key: string, value: Json }], s: float) -> [{ key: string, p: float }] =
  match kvs {
    [] => [],
    [x, ...rest] => [{ key: x.key, p: if s > 0.0 then numOr0(x.value) / s else 0.0 }] ++ scaled(rest, s)
  }

func argmax(ps: [{ key: string, p: float }], bestK: string, bestP: float) -> string =
  match ps {
    [] => bestK,
    [x, ...rest] => if x.p > bestP then argmax(rest, x.key, x.p) else argmax(rest, bestK, bestP)
  }

func expected(ps: [{ key: string, p: float }]) -> float =
  match ps {
    [] => 0.0,
    [x, ...rest] => (match keyIndex(x.key) { Some(i) => i * x.p, None => 0.0 }) + expected(rest)
  }

func keyIndex(k: string) -> Option[float] =
  match decode(k) { Ok(j) => asNumber(j), Err(_) => None }

func fbStr(j: Json, k: string) -> string = match getString(j, k) { Some(s) => s, None => "" }

func fbUsageInt(body: Json, k: string) -> int =
  match getObject(body, "usage") { None => 0, Some(u) => match getInt(u, k) { Some(n) => n, None => 0 } }

func fbUsageCost(body: Json) -> float =
  match getObject(body, "usage") { None => 0.0, Some(u) => match get(u, "cost") { Some(v) => numOr0(v), None => 0.0 } }
