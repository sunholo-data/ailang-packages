module sunholo/motoko_ext_omnigraph/register

import std/env (getEnvOr)
import std/option (Option, None)
import pkg/sunholo/motoko_ext_abi/types (
  ExtensionHooks, ExtCtx, BudgetPlan, BudgetPatch,
  ToolCallEnvelope, ToolHandleDecision, ResponseInterceptDecision, FinalizeDecision,
  NoIntercept, NoDecision
)
import pkg/sunholo/motoko_ext_omnigraph/omnigraph (
  provided_tools, on_tool_policy, on_tool_handle, on_build_system_prompt
)
import pkg/sunholo/motoko_ext_omnigraph/prompts (load_agent_prompt)

func no_budget_patch() -> BudgetPatch {
  { requested_total: None, requested_solver: None, requested_verifier: None }
}

-- register_with_config uses a type variable for cfg so this extension is
-- host-config-agnostic. workdir is read from MOTOKO_WORKDIR env var
-- (set by the host at startup), falling back to "." if unset.
export func register_with_config(_cfg: a) -> ExtensionHooks ! {Env, FS} {
  let workdir = getEnvOr("MOTOKO_WORKDIR", ".");
  let cached_prompt = load_agent_prompt(workdir);
  {
    id: "omnigraph",
    provided_tools: provided_tools(),
    on_describe_tools: \_ . [],
    on_build_system_prompt: \ctx. on_build_system_prompt(cached_prompt, ctx),
    on_budget_plan: func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch ! {Env, FS} {
      no_budget_patch()
    },
    on_tool_policy: on_tool_policy,
    on_tool_handle: func(ctx: ExtCtx, call: ToolCallEnvelope) -> ToolHandleDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      on_tool_handle(ctx, call)
    },
    on_response_intercept: func(_ctx: ExtCtx, _response_text: string) -> ResponseInterceptDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      NoIntercept
    },
    on_solver_candidate: func(_ctx: ExtCtx, _candidate: string) -> FinalizeDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      NoDecision
    }
  }
}
