-- Equatorial ZAMO tetrad and pure-boost transport, BPT72 eqs 2.5, 3.1-3.3.
-- Vectors (x,y,z) mean (radial,theta,phi), directions point TO sources.
module sunholo/relativity/kerr_frame
import std/math (sqrt)
import ./optics (Vec3, dot)
import ./kerr (validSpin, zamoClockRate, frameDragOmega, orbitLocalSpeedKerr)
export type MetricFrame = {lapse:float,omega:float,h:float}
export type Constants = {lambda:float,eta:float,energy:float}
export pure func metricFrame(u:float,s:float)->MetricFrame
  requires { validSpin(s) && u >= 4.0 && u <= 2000000.0 }
{ {lapse:zamoClockRate(u,0.0,s),omega:frameDragOmega(u,0.0,s),h:sqrt(u*u+s*s+2.0*s*s/u)} }
export pure func staticVelocity(u:float,s:float)->Vec3
  requires { validSpin(s) && u >= 4.0 && u <= 2000000.0 }
{ let f=metricFrame(u,s); {x:0.0,y:0.0,z:0.0-f.omega*f.h/f.lapse} }
export pure func radialVelocity(u:float,s:float,b:float)->Vec3
  requires { validSpin(s) && u >= 4.0 && u <= 2000000.0 && b > -1.0 && b < 1.0 }
{
  let v=staticVelocity(u,s);
  {x:b*sqrt((1.0-v.z)*(1.0+v.z)),y:0.0,z:v.z}
}
export pure func circularVelocity(u:float,s:float,k:float)->Vec3
  requires { validSpin(s) && u >= 4.0 && u <= 2000000.0 && (k==1.0 || k == -1.0) }
{ {x:0.0,y:0.0,z:orbitLocalSpeedKerr(u,s,k)} }
export pure func gammaVelocity(v:Vec3)->float
  requires { dot(v,v) < 1.0 }
{ let b=sqrt(dot(v,v)); 1.0/sqrt((1.0-b)*(1.0+b)) }
-- gamma is explicit, so a caller can preserve its high-speed complement.
export pure func boostSource(n:Vec3,v:Vec3,g:float)->Vec3
  requires { g >= 1.0 && g <= 1.0e150 && dot(v,v)<1.0 }
{
  let b=sqrt(dot(v,v));
  if b==0.0 then n else {
    let d=dot(n,v); let c=d/b;
    let complement=((1.0/g)/g)/(1.0+b);
    let den=g*(if c<0.0 then complement+b*(1.0+c) else 1.0+d);
    let f=(g*(g/(g+1.0))*d+g);
    {x:(n.x+f*v.x)/den,y:(n.y+f*v.y)/den,z:(n.z+f*v.z)/den}
  }
}
export pure func sourceConstants(u:float,s:float,n:Vec3)->Constants
  requires { validSpin(s) && u >= 4.0 && u <= 2000000.0 }
{
  let f=metricFrame(u,s); let energy=f.lapse-f.omega*f.h*n.z;
  {lambda:(0.0-f.h*n.z)/energy,eta:(u*n.y/energy)*(u*n.y/energy),energy:energy}
}
export pure func frequencyRatio(u:float,s:float,n:Vec3,v:Vec3)->float
  requires { validSpin(s) && u >= 4.0 && u <= 2000000.0 && dot(v,v)<1.0 }
{
  let f=metricFrame(u,s); let c=sourceConstants(u,s,n);
  gammaVelocity(v)*(1.0+dot(v,n))*(1.0-f.omega*c.lambda)/f.lapse
}
