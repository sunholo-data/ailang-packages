-- sunholo/relativity/medium — Higgs-bubble energetics: photon drive, ISM drag,
-- glow, and the trip energy ledger.
--
-- Model (stapledons-design physics/higgs-bubble.md §4-6): a spherical pocket
-- of radius R whose wall reflects every massive particle elastically and lets
-- light through. Only light leaves, so the drive is a photon drive
-- (E = m_eff c^2 phi per boost or brake), and the interstellar medium, a
-- proton beam of density n, is mirrored off a specular sphere (half the drag
-- of a flat face-on mirror of the same projected area).
--
-- Units: SI in and out. n in m^-3, R in m, m_eff in kg, accelerations in
-- m/s^2 (accelSI converts the c/yr of kinematics and journey), distances in
-- light-years (the journey unit; converted with lightYearM). Results in J, N,
-- W, W/m^2. Every formula is in rapidity form (gamma beta = sinh phi,
-- gamma - 1 = 2 sinh^2(phi/2)), so nothing forms 1 - beta.

module sunholo/relativity/medium

import std/math (sqrt)
import ./hyper (sinh, log1p)
import ./journey (TripPlan)
import ./blackbody (stefanBoltzmannSI, luminousEfficacy)

-- Speed of light, m/s (exact).
export pure func cSI() -> float = 299792458.0

-- Proton mass, kg (CODATA 2018; m_p c^2 = 938.272 MeV = 1.50328e-10 J).
export pure func protonMassKg() -> float = 0.00000000000000000000000000167262192369

-- Light-year, m (IAU: Julian year times c).
export pure func lightYearM() -> float = 9460730472580800.0

-- Julian year, s.
export pure func julianYearS() -> float = 31557600.0

-- Astronomical unit, m (IAU 2012, exact).
export pure func astronomicalUnitM() -> float = 149597870700.0

-- CMB temperature, K (higgs-bubble HB-5; 2.7255 K would raise every CMB
-- temperature by 0.02%).
export pure func cmbTemperatureK() -> float = 2.725

pure func pi() -> float = 3.141592653589793

-- Acceleration in c per Julian year (kinematics/journey units) to m/s^2.
-- accelSI(standardGravity()) = 9.80665.
export pure func accelSI(aCPerYear: float) -> float = aCPerYear * cSI() / julianYearS()

-- Photon energy radiated by one boost (or one brake) from rest to rapidity
-- phi, ship frame: m_eff c^2 phi (J). Grows only as ln(2 gamma).
export pure func photonDriveEnergy(mEff: float, phi: float) -> float = mEff * cSI() * cSI() * phi

-- Momentum flux times c on a face-on surface, ship frame:
-- n gamma^2 beta^2 m_p c^3 = n sinh^2(phi) m_p c^3 (W/m^2). The drag follows it.
export pure func loadScale(n: float, phi: float) -> float {
  let s = sinh(phi);
  let c = cSI();
  n * s * s * protonMassKg() * c * c * c
}

-- Kinetic-energy flux that would be deposited if impacts were thermalised:
-- n gamma beta (gamma - 1) m_p c^3 = n sinh(phi) 2 sinh^2(phi/2) m_p c^3 (W/m^2).
export pure func kineticFlux(n: float, phi: float) -> float {
  let h = sinh(phi / 2.0);
  let c = cSI();
  n * sinh(phi) * 2.0 * h * h * protonMassKg() * c * c * c
}

-- Drag on the specular sphere of radius r: n sinh^2(phi) m_p c^2 pi r^2 (N).
-- (A flat face-on mirror of the same area would be twice this.) The same in
-- the ship and galaxy frames.
export pure func mirrorDragForce(n: float, phi: float, r: float) -> float {
  let s = sinh(phi);
  let c = cSI();
  n * s * s * protonMassKg() * c * c * pi() * r * r
}

-- Photon-drive power that holds cruise against the drag, ship frame: F c (W).
export pure func mirrorDragPower(n: float, phi: float, r: float) -> float = mirrorDragForce(n, phi, r) * cSI()

-- Ship-frame energy radiated to hold cruise over dCoast light-years:
-- F c tau = n sinh(phi) m_p c^2 pi r^2 dCoast (J). Grows about as gamma d.
export pure func cruiseDragEnergy(n: float, phi: float, r: float, dCoast: float) -> float {
  let c = cSI();
  n * sinh(phi) * protonMassKg() * c * c * pi() * r * r * dCoast * lightYearM()
}

-- Mean inward glow over the inner wall: a fraction eps of the kinetic flux
-- becomes light at the wall, fIn of it shines inward, spread over 4 pi R^2:
-- eps fIn K / 4 (W/m^2).
export pure func glowInwardFlux(n: float, phi: float, eps: float, fIn: float) -> float =
  eps * fIn * kineticFlux(n, phi) / 4.0

-- Inward glow emittance of the wall element whose outward normal is at angle
-- theta from the travel direction (ship frame): the element intercepts
-- K max(0, cos theta) of the forward beam, so it shines eps fIn K
-- max(0, cos theta) inward (W/m^2). Brightest at the forward pole, where it
-- is exactly 4 x glowInwardFlux; 0 on the aft hemisphere and at rest; its
-- mean over the sphere is glowInwardFlux (the mean of max(0, cos) is 1/4).
-- cosTheta is clamped to [0, 1], so a dot product that rounds past 1 gives
-- the pole. NaN cosTheta gives NaN (tested first: ailang#1419).
export pure func glowEmittanceAt(n: float, phi: float, eps: float, fIn: float, cosTheta: float) -> float {
  let c = if cosTheta != cosTheta then cosTheta
          else if cosTheta >= 1.0 then 1.0
          else if cosTheta > 0.0 then cosTheta
          else 0.0;
  eps * fIn * kineticFlux(n, phi) * c
}

-- 0.8.0: the glow's spectrum (stapledons ledger D-30, higgs-bubble.md §6).
--
-- Model: the wall is a greybody. A fraction eps of the impacts is
-- inelastic and thermalised in the wall element; by Kirchhoff's law the
-- element emits light with the same small coupling, emissivity eps (fIn of
-- it on the inner face), which is also why the wall is transparent
-- (absorptivity = emissivity, ~0). In local equilibrium the thermalised
-- flux eps K cos theta is radiated as eps sigma T^4, so eps cancels:
--     T = (K max(0, cos theta) / sigma)^(1/4)
-- the temperature a black surface would reach if it thermalised the whole
-- forward beam. eps and fIn set only the brightness: the inner face emits
-- eps fIn sigma T^4 = glowEmittanceAt, a blackbody spectrum at T dimmed by
-- the emissivity. Game approximation (the Higgs bubble is the one admitted
-- hand-wave): real GeV impacts give hadronic cascades and gamma rays, not a
-- thermal spectrum; the wall's emissivity equal to eps, local equilibrium
-- per element and an instant response are design choices.

-- Glow temperature of the wall element at angle theta from the travel
-- direction (K): (K max(0, cos theta) / sigma)^(1/4), by two square roots
-- (correctly rounded, so VM and interpreter agree bit for bit; no pow).
-- Independent of eps and fIn. 1357.5 K (orange-red) on the pole at 0.99c,
-- 14,114 K (blue-white) at 1 - beta = 1e-6, 290 K at 0.5c; T_pole cos^(1/4)
-- theta off the pole; 0 at rest, on the equator and aft. cosTheta is
-- clamped as in glowEmittanceAt; NaN cosTheta or phi gives NaN. phi < 0
-- (kineticFlux < 0) gives 0.
export pure func glowTemperatureAt(n: float, phi: float, cosTheta: float) -> float {
  let c = if cosTheta != cosTheta then cosTheta
          else if cosTheta >= 1.0 then 1.0
          else if cosTheta > 0.0 then cosTheta
          else 0.0;
  let x = kineticFlux(n, phi) * c / stefanBoltzmannSI();
  if x != x then x
  else if x > 0.0 then sqrt(sqrt(x))
  else 0.0
}

-- Inward glow radiance of the wall element (W m^-2 sr^-1): the wall is a
-- Lambertian emitter, so L = glowEmittanceAt / pi.
export pure func glowRadianceAt(n: float, phi: float, eps: float, fIn: float, cosTheta: float) -> float =
  glowEmittanceAt(n, phi, eps, fIn, cosTheta) / pi()

-- Luminous efficacy of the glow (lm/W): blackbody.luminousEfficacy at
-- glowTemperatureAt. 0.0233 lm/W on the pole at 0.99c, 43.68 at the cap
-- (the placeholder equal-energy white was 182.57). 0 at rest and for NaN.
export pure func glowEfficacyAt(n: float, phi: float, cosTheta: float) -> float =
  luminousEfficacy(glowTemperatureAt(n, phi, cosTheta))

-- Glow luminance seen on the wall element (cd/m^2): glowRadianceAt x
-- glowEfficacyAt. With n = 0.1 cm^-3, eps = 1e-11 (D-29) and fIn = 1/2:
-- 7.144e-9 cd/m^2 on the pole at 0.99c (1.65e-4 of the 23.5 mag/arcsec^2
-- dark sky) and 0.1564 cd/m^2 at the cap (3.61e3 of it). NaN cosTheta or
-- phi gives NaN.
export pure func glowLuminanceAt(n: float, phi: float, eps: float, fIn: float, cosTheta: float) -> float =
  glowRadianceAt(n, phi, eps, fIn, cosTheta) * glowEfficacyAt(n, phi, cosTheta)

-- Energy ledger of a planned trip, ship frame (J).
export type TripEnergy = { boost: float, brake: float, drag: float, total: float }

-- boost = brake = m_eff c^2 phiPeak; drag = cruiseDragEnergy over p.dCoast;
-- total = boost + brake + drag. The drag work during the boost (drive
-- supplies m_eff a + F) and the brake (m_eff a - F) cancels over the pair, so
-- it is absent; this is exact when brakeHoldsAgainstDrag holds. With
-- dCoast (not d) the ledger closes at arrival.
export pure func tripEnergy(p: TripPlan, mEff: float, n: float, r: float) -> TripEnergy {
  let b = photonDriveEnergy(mEff, p.phiPeak);
  let d = cruiseDragEnergy(n, p.phiPeak, r, p.dCoast);
  { boost: b, brake: b, drag: d, total: 2.0 * b + d }
}

-- Precondition of tripEnergy: the brake's photon thrust m_eff a (a in m/s^2)
-- is at least the drag at phi, so the brake can still decelerate. False for
-- NaN inputs (tested first: ailang#1419, the interpreter answers NaN >= x
-- with true).
export pure func brakeHoldsAgainstDrag(mEff: float, a: float, n: float, phi: float, r: float) -> bool {
  let thrust = mEff * a;
  let drag = mirrorDragForce(n, phi, r);
  if thrust == thrust && drag == drag then thrust >= drag else false
}

-- Power the photon drive spends to hold the ship still against a local
-- gravitational (or any unfelt) acceleration g, ship frame: m_eff |g| c (W)
-- (higgs-bubble.md §10, P_hover, HB-90). The pocket's acceleration is not
-- felt (property 3); the drive supplies F = m_eff |g| as photons, at F c.
-- gMs2 in m/s^2, signed or not. 0.1254 m/s^2 (50,000 km above Earth) costs
-- 3.759e7 W per kg of m_eff; Sgr A* at 3 r_s, 1.44e14 W/kg (HB-90). Linear in
-- both arguments, so a stepped hold integrates it per tick.
export pure func hoverPower(mEffKg: float, gMs2: float) -> float {
  let g = if gMs2 < 0.0 then 0.0 - gMs2 else gMs2;
  mEffKg * g * cSI()
}

-- 0.12.0: a structured medium (stapledons ledger D-60, D-61;
-- stapledons-design physics/ism-structure.md and higgs-bubble.md section 5).
-- Every function above takes n as the mass-equivalent proton density: the
-- wall reflects every massive particle, dust included, so the drag and the
-- glow follow the whole mass flux.

-- Mass-equivalent density n_H (muH + deltaDust) (m^-3 when nH is): nH the
-- hydrogen nucleon density, muH the gas mass per H nucleon (helium and
-- metals; Draine 2011: 1.4), deltaDust the dust mass per H nucleon (local
-- clouds 0.00507 from Krueger et al. 2015 and Slavin & Frisch 2008; Draine
-- 2011: 0.010), both in hydrogen (proton) masses. 0.247 cm^-3, 1.4, 0.0051
-- gives 3.4706e5 m^-3. NaN in gives NaN.
export pure func massEquivalentDensity(nH: float, muH: float, deltaDust: float) -> float = nH * (muH + deltaDust)

-- Ship-frame energy radiated to hold cruise through a column nCol = int n ds
-- (m^-2) of medium: nCol sinh(phi) m_p c^2 pi r^2 (J). For a uniform medium
-- nCol = n d and this is cruiseDragEnergy (tested to 1e-12), so a ledger
-- summed piece by piece over a structured route closes at arrival.
export pure func columnDragEnergy(nCol: float, phi: float, r: float) -> float {
  let c = cSI();
  nCol * sinh(phi) * protonMassKg() * c * c * pi() * r * r
}

-- tripEnergy with the cruise drag by column: nColCoast is the column over
-- the coast (p.dCoast) of the route (m^-2). Equals tripEnergy for a uniform
-- medium (nColCoast = n p.dCoast lightYearM()).
export pure func tripEnergyColumn(p: TripPlan, mEff: float, nColCoast: float, r: float) -> TripEnergy {
  let b = photonDriveEnergy(mEff, p.phiPeak);
  let d = columnDragEnergy(nColCoast, p.phiPeak, r);
  { boost: b, brake: b, drag: d, total: 2.0 * b + d }
}

-- asinh for x >= 0 without cancellation: log1p(x + x^2 / (1 + sqrt(1 + x^2))).
pure func asinhPos(x: float) -> float = log1p(x + x * x / (1.0 + sqrt(1.0 + x * x)))

-- The drive-hold limit: the largest rapidity whose drag at density n the
-- photon drive's force m_eff a (a in m/s^2) can still overcome,
-- asinh sqrt(mEff a / (n m_p c^2 pi r^2)). Holding cruise needs thrust equal
-- to the drag everywhere along it, so a plan uses the peak n of its whole
-- cruise; brakeHoldsAgainstDrag is true just below and false just above
-- (tested at 1e-9). Canon drive (1 kg, 7.5e5 g): gamma 16,858 in the hot gas,
-- 2,117 in the warm clouds, 19.3 at n = 4,200 cm^-3 (HB-130..HB-137). n = 0
-- gives +Inf; mEff a = 0 gives 0; NaN gives NaN.
export pure func driveHoldMaxPhi(mEff: float, a: float, n: float, r: float) -> float {
  let c = cSI();
  let x = mEff * a / (n * protonMassKg() * c * c * pi() * r * r);
  if x != x then x
  else if x > 1.0e300 then x
  else if x > 0.0 then asinhPos(sqrt(x))
  else 0.0
}

