module sunholo/relativity/kerr_nearcritical_test
import std/result (Ok,Err)
import ./hyper (absf)
import ./kerr_trace (traceSky)
pure func probe(s:float,x:float,y:float,z:float,ox:float,oy:float,oz:float)->bool=
  match traceSky(6.0,s,{x:x,y:y,z:z},0.005) {Err(_)=>false,Ok(r)=>absf(r.sky.x-ox)<1.2e-4 && absf(r.sky.y-oy)<1.2e-4 && absf(r.sky.z-oz)<1.2e-4}
test "near-critical 0 s0.9 u_ph1.5578546274233829 epsilon1.0e-05" {probe(0.9,-0.9203499540230402,0.0,-0.3910958477531918,0.7913853030910697,0.611317676868137,0.0)}
test "near-critical 1 s0.9 u_ph1.5578546274233829 epsilon1.0e-08" {probe(0.9,-0.9203516142673466,0.0,-0.3910919407447428,-0.09011173613679652,0.9959316618174223,0.0)}
test "near-critical 2 s0.9 u_ph3.0 epsilon1.0e-05" {probe(0.9,-0.6750359303813005,0.6982314848959973,0.23832600822021674,0.005707323618076382,-0.35504769939212505,-0.9348307641565279)}
test "near-critical 3 s0.9 u_ph3.0 epsilon1.0e-08" {probe(0.9,-0.6750439858157349,0.6982245096332157,0.23832362736720314,-0.9735048932073043,-0.2286638188348794,-0.0010396428640891634)}
