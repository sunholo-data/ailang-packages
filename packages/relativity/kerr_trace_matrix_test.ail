module sunholo/relativity/kerr_trace_matrix_test
import std/math (sin,cos)
import std/result (Ok,Err)
import ./hyper (absf)
import ./kerr_trace (traceSky)
pure func probe(u:float,s:float,p:float,c:float,x:float,y:float,z:float)->bool =
  match traceSky(u,s,{x:0.0-cos(p),y:sin(p)*sin(c),z:sin(p)*cos(c)},0.005) {
    Err(_)=>false,
    Ok(r)=>absf(r.sky.x-x)<1.2e-4 && absf(r.sky.y-y)<1.2e-4 && absf(r.sky.z-z)<1.2e-4
  }
test "independent Kerr matrix 0 s0.0 u4.0 psi1.2 chi0.7" { probe(4.0,0.0,1.2,0.7,0.43310032710732715,-0.6893872318558439,0.5806628550317844) }
test "independent Kerr matrix 1 s0.0 u4.0 psi1.2 chi1.5707963267948966" { probe(4.0,0.0,1.2,1.5707963267948966,0.43310032710732155,-5.5191507535873465e-17,0.901345719832036) }
