test "independent Kerr matrix 3 s0.0 u4.0 psi2.7 chi5.2" { probe(4.0,0.0,2.7,5.2,0.8081619749800786,0.27593771420092295,0.5203197094843407) }
test "independent Kerr matrix 4 s0.0 u6.0 psi0.9 chi0.0" { probe(6.0,0.0,0.9,0.0,-0.6267323167610119,-0.7792346264940839,0.0) }
