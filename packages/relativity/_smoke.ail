-- Boot probe for publish: prints "OK: ..." iff three independent checks hold
-- in a clean workdir — a trip time (rocket equation), an apparent star
-- position (aberration) and a black-hole shadow size (Schwarzschild).
module sunholo/relativity/_smoke

import std/io (println)
import std/math (acos)
import ./kinematics (standardGravity)
import ./hyper (atanh, absf)
import ./journey (flipAndBurn)
import ./optics (aberrate, dot)
import ./schwarzschild (shadowAngularRadius, pi)

export func main() -> () ! {IO} {
  let trip = flipAndBurn(4.37, standardGravity());
  let fwd = { x: 0.0, y: 0.0, z: -1.0 };
  let seen = aberrate({ x: 1.0, y: 0.0, z: 0.0 }, fwd, atanh(0.9));
  let angle = acos(dot(seen, fwd)) * 180.0 / pi();
  let shadow = shadowAngularRadius(3.0);
  let tripOk = absf(trip.shipTime - 3.582393722748) < 0.000000001 && absf(trip.galaxyTime - 6.002502777252) < 0.000000001;
  let angleOk = absf(angle - 25.841932763167) < 0.000000001;
  let shadowOk = absf(shadow - pi() / 4.0) < 0.000000000001;
  if tripOk && angleOk && shadowOk
  then println("OK: relativity alpha-Cen trip 3.5824 ship-yr / 6.0025 yr, 90deg star seen at 25.842deg at 0.9c, shadow at 3 r_s = pi/4")
  else println("FAIL: trip ${show(trip.shipTime)} / ${show(trip.galaxyTime)}, angle ${show(angle)}, shadow ${show(shadow)}")
}
