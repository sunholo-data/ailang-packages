-- Boot probe for publish: prints "OK: ..." iff six independent checks hold
-- in a clean workdir — a trip time (rocket equation), an apparent star
-- position (aberration), a black-hole shadow size (Schwarzschild), a
-- G2V temperature (photometry), a white-dwarf temperature, a cruise
-- trip with its energy ledger (journey plans, medium), and the sky
-- photometry of 0.5.0 (forward CMB radiance, B-V temperature, threshold),
-- the 0.6.0 glow pole (4 x the mean inward glow at 0.99c), and the 0.8.0
-- glow spectrum (pole temperature and luminance at 0.99c and the cap).
module sunholo/relativity/_smoke

import std/io (println)
import std/math (acos, intToFloat, sin, cos, pow, log10)
import ./kinematics (standardGravity, rapidityOfOneMinusBeta)
import ./hyper (atanh, absf)
import ./journey (TripPlan, TripPhase, Accelerating, Coasting, Decelerating, Arrived, flipAndBurn, planBurnCoastBurn, planFlipAndBurn, phaseAt, motionAt)
import ./hyper (acosh1p)
import ./optics (cmbForwardTemperature)
import ./medium (tripEnergy, mirrorDragPower, loadScale, glowInwardFlux, glowEmittanceAt, brakeHoldsAgainstDrag, accelSI)
import ./optics (aberrate, dot)
import ./schwarzschild (shadowAngularRadius, pi)
import ./photometry (teffFromBpRp, teffFromBV, bvInTable, luminanceFromSurfaceMag, surfaceMagFromLuminance, pointThresholdIlluminance, limitingMagnitude)
import ./blackbody_photometry (bbTeffFromBpRp)
import ./blackbody (photopicRadiance)
import ./optics (cmbSeenTemperature, cmbSeenTemperatureApparent, apparentDisc)
import ./medium (hoverPower, glowTemperatureAt, glowLuminanceAt, glowRadianceAt)
import ./blackbody (luminousEfficacy)

pure func wdNaN() -> float = 0.0 / 0.0
pure func wdInf() -> float = 1.0e308 * 10.0
pure func wdSweep(i: int, n: int, acc: float) -> float =
  if i > n then acc
  else wdSweep(i + 1, n, acc + bbTeffFromBpRp(-0.6 + 2.9 * intToFloat(i) / intToFloat(n)))

-- Pure digest of the white-dwarf path (both clamps, interior, NaN, +-inf);
-- interpreter and strict VM must print the same bits.
export pure func wdDigest(n: int) -> float =
  wdSweep(0, n, 0.0) + bbTeffFromBpRp(wdNaN()) + bbTeffFromBpRp(wdInf()) + bbTeffFromBpRp(-wdInf())

pure func phaseNum(ph: TripPhase) -> float =
  match ph {
    Accelerating => 1.0,
    Coasting => 2.0,
    Decelerating => 3.0,
    Arrived => 4.0
  }

-- One plan's contribution: totals, boundaries, motion and phase at k
-- evenly spaced proper times (and the boundaries themselves), and the
-- energy readouts.
pure func planSum(p: TripPlan, k: int, i: int, acc: float) -> float =
  if i > k then acc
  else {
    let tau = p.tauTotal * intToFloat(i) / intToFloat(k);
    let m = motionAt(p, tau);
    planSum(p, k, i + 1, acc + m.phi + m.t + m.x + m.tau + phaseNum(phaseAt(p, tau)))
  }

pure func planDigest(p: TripPlan, k: int) -> float {
  let e = tripEnergy(p, 1.0, 100000.0, 100.0);
  let b1 = motionAt(p, p.tauBurn);
  let b2 = motionAt(p, p.tauBurn + p.tauCoast);
  let fb = if p.fellBack then 1.0 else 0.0;
  let holds = if brakeHoldsAgainstDrag(1.0, accelSI(p.a), 100000.0, p.phiPeak, 100.0) then 1.0 else 0.0;
  planSum(p, k, 0, 0.0) + p.trip.shipTime + p.trip.galaxyTime + p.trip.peakBeta + p.trip.peakGamma
    + p.tauBurn + p.tauCoast + p.dBurn + p.dCoast + fb + holds
    + b1.x + b1.t + b2.x + b2.t + b2.phi
    + (e.total + mirrorDragPower(100000.0, p.phiPeak, 100.0) + loadScale(100000.0, p.phiPeak)) / 1.0e15
    + glowInwardFlux(100000.0, p.phiPeak, 0.000000001, 0.5) + cmbForwardTemperature(p.phiPeak)
}

-- Sweep cruise rapidity over [0.9c, the cap] for alpha Cen at 7.5e5 g, plus
-- the flip, fallback, short-trip and NaN paths.
pure func journeySweep(i: int, n: int, acc: float) -> float =
  if i > n then acc
  else {
    let lo = 1.4722194895832204;
    let phi = lo + (rapidityOfOneMinusBeta(0.000001) - lo) * intToFloat(i) / intToFloat(n);
    journeySweep(i + 1, n, acc + planDigest(planBurnCoastBurn(4.37, 774221.4566651969, phi), 8))
  }

-- Pure digest of the 0.4.0 journey and medium paths; interpreter and strict
-- VM must print the same bits.
export pure func journeyDigest(n: int) -> float {
  let nanPlan = planBurnCoastBurn(4.37, 774221.4566651969, wdNaN());
  let p = planBurnCoastBurn(4.37, 774221.4566651969, 2.6466524123622457);
  journeySweep(0, n, 0.0)
    + planDigest(planFlipAndBurn(4.37, standardGravity()), 16)
    + planDigest(planBurnCoastBurn(0.001, 774221.4566651969, rapidityOfOneMinusBeta(0.000001)), 16)
    + planDigest(planFlipAndBurn(0.000000001, standardGravity()), 16)
    + acosh1p(0.0000000001) * 1000000.0
    + phaseNum(phaseAt(p, wdNaN())) + motionAt(p, wdNaN()).x
    + (if nanPlan.fellBack then 1.0 else 0.0)
    + (if brakeHoldsAgainstDrag(wdNaN(), 1.0, 1.0, 1.0, 1.0) then 1.0 else 0.0)
}

pure func skyPoint(i: int, n: int) -> float {
  let u = intToFloat(i) / intToFloat(n);
  let th = 3.141592653589793 * u;
  let dir = { x: sin(th), y: 0.0, z: cos(th) };
  let fwd = { x: 0.0, y: 0.0, z: 1.0 };
  let phi = rapidityOfOneMinusBeta(0.000001) * u;
  let tSeen = cmbSeenTemperatureApparent(dir, fwd, phi);
  let lb = 0.00000001 * pow(1.0e14, u);
  (teffFromBV(-1.0 + 4.0 * u) + teffFromBpRp(-0.5 + 6.0 * u)) / 1000.0
    + (if bvInTable(-1.0 + 4.0 * u) then 1.0 else 0.0)
    + log10(1.0 + photopicRadiance(tSeen)) + log10(1.0 + photopicRadiance(0.001 * pow(1.0e9, u)))
    + cmbSeenTemperature(dir, fwd, phi) / 1000.0 + log10(tSeen)
    + log10(luminanceFromSurfaceMag(-10.0 + 50.0 * u)) + surfaceMagFromLuminance(0.000001 * pow(1.0e10, u))
    + log10(pointThresholdIlluminance(lb)) + limitingMagnitude(lb, 2.0)
}

pure func skySweep(i: int, n: int, acc: float) -> float =
  if i > n then acc else skySweep(i + 1, n, acc + skyPoint(i, n))

-- Pure digest of the 0.5.0 sky photometry (both clamps, NaN, the zero-T and
-- dark-background cut-offs, the CMB from 0 to the cap); interpreter and
-- strict VM must print the same bits.
export pure func photometryDigest(n: int) -> float =
  skySweep(0, n, 0.0) + teffFromBV(wdNaN()) + teffFromBV(wdInf()) + teffFromBV(-wdInf())
    + teffFromBpRp(wdNaN()) + photopicRadiance(wdNaN()) + photopicRadiance(2.725)
    + log10(pointThresholdIlluminance(wdNaN())) + (if bvInTable(wdNaN()) then 1.0 else 0.0)

pure func photopicSweep(i: int, n: int) -> bool {
  if i > n then true
  else {
    let v = photopicRadiance(0.001 * pow(1.0e9, intToFloat(i) / intToFloat(n)));
    v == v && v >= 0.0 && v < 1.0e308 * 10.0 && photopicSweep(i + 1, n)
  }
}

-- True when photopicRadiance is finite and >= 0 at n + 1 log-spaced
-- temperatures from 1e-3 K to 1e6 K (the gate runs n = 9999 on the VM).
export pure func photopicFinite(n: int) -> bool = photopicSweep(0, n)

pure func hotSweep(i: int, n: int, acc: float) -> float =
  if i > n then acc
  else hotSweep(i + 1, n, acc + log10(photopicRadiance(1.0e6 * pow(1.0e302, intToFloat(i) / intToFloat(n)))))

-- 0.5.2: digest of photopicRadiance from 1e6 K to 1e308 K (the expm1 branch
-- and the Planck-temperature clamp), plus +Inf and NaN; finite, and the
-- interpreter and strict VM must print the same bits.
export pure func photopicHotDigest(n: int) -> float =
  hotSweep(0, n, 0.0) + log10(photopicRadiance(wdInf())) + photopicRadiance(wdNaN())

pure func glowRow(phi: float, j: int, m: int, acc: float) -> float =
  if j > m then acc
  else glowRow(phi, j + 1, m, acc + glowEmittanceAt(100000.0, phi, 0.000000001, 0.5, -1.0 + 2.0 * intToFloat(j) / intToFloat(m)))

pure func glowSweep(i: int, n: int, acc: float) -> float =
  if i > n then acc
  else glowSweep(i + 1, n, acc + glowRow(rapidityOfOneMinusBeta(0.000001) * intToFloat(i) / intToFloat(n), 0, 40, 0.0))

-- 0.6.0: digest of glowEmittanceAt over [0, phiCap] x cos theta in [-1, 1]
-- (both clamps, the aft zero), plus cos past 1 and the NaN arms (NaN
-- cos theta adds 1 when it propagates); the interpreter and strict VM must
-- print the same bits.
export pure func glowDigest(n: int) -> float {
  let nanOut = glowEmittanceAt(100000.0, 2.6466524123622457, 0.000000001, 0.5, wdNaN());
  glowSweep(0, n, 0.0)
    + glowEmittanceAt(100000.0, 2.6466524123622457, 0.000000001, 0.5, 1.0000000000000002)
    + glowEmittanceAt(100000.0, 2.6466524123622457, 0.000000001, 0.5, -0.0)
    + (if nanOut != nanOut then 1.0 else 0.0)
}

pure func discSweep(i: int, n: int, phiMax: float, acc: float) -> float =
  if i > n then acc
  else {
    let f = intToFloat(i) / intToFloat(n);
    let d = apparentDisc(cos(3.141592653589793 * f), 0.001 + 1.5 * f, phiMax * f);
    discSweep(i + 1, n, phiMax, acc + d.centre + d.radius)
  }

-- 0.7.0: digest of apparentDisc over n + 1 (theta, alpha, phi) points to the
-- cap plus hoverPower; the interpreter and strict VM must print the same bits.
export pure func discDigest(n: int) -> float =
  discSweep(0, n, rapidityOfOneMinusBeta(0.000001), 0.0) + hoverPower(1.0, 0.1254) / 299792458.0

pure func specRow(phi: float, j: int, m: int, acc: float) -> float =
  if j > m then acc
  else {
    let c = -1.0 + 2.0 * intToFloat(j) / intToFloat(m);
    specRow(phi, j + 1, m, acc + glowTemperatureAt(100000.0, phi, c) / 1000.0 + glowLuminanceAt(100000.0, phi, 0.00000000001, 0.5, c) + glowRadianceAt(100000.0, phi, 0.00000000001, 0.5, c))
  }

pure func specSweep(i: int, n: int, acc: float) -> float =
  if i > n then acc
  else specSweep(i + 1, n, acc + specRow(rapidityOfOneMinusBeta(0.000001) * intToFloat(i) / intToFloat(n), 0, 10, 0.0))

-- 0.8.0: digest of the glow spectrum (temperature, radiance, luminance) over
-- (n + 1) x 11 points of [0, phiCap] x cos theta in [-1, 1], plus the
-- efficacy edges (NaN, 0, +Inf give 0) and a NaN temperature counted as 1;
-- the interpreter and strict VM must print the same bits.
export pure func glowSpectrumDigest(n: int) -> float {
  let nanT = glowTemperatureAt(100000.0, 2.6466524123622457, wdNaN());
  specSweep(0, n, 0.0)
    + luminousEfficacy(wdNaN()) + luminousEfficacy(0.0) + luminousEfficacy(wdInf()) + luminousEfficacy(6600.0)
    + (if nanT != nanT then 1.0 else 0.0)
}

export func main() -> () ! {IO} {
  let trip = flipAndBurn(4.37, standardGravity());
  let fwd = { x: 0.0, y: 0.0, z: -1.0 };
  let seen = aberrate({ x: 1.0, y: 0.0, z: 0.0 }, fwd, atanh(0.9));
  let angle = acos(dot(seen, fwd)) * 180.0 / pi();
  let shadow = shadowAngularRadius(3.0);
  let tripOk = absf(trip.shipTime - 3.582393722748) < 0.000000001 && absf(trip.galaxyTime - 6.002502777252) < 0.000000001;
  let angleOk = absf(angle - 25.841932763167) < 0.000000001;
  let shadowOk = absf(shadow - pi() / 4.0) < 0.000000000001;
  let photometryOk = absf(teffFromBpRp(0.823) - 5770.0) < 0.000000001;
  let photometryWdOk = absf(bbTeffFromBpRp(0.30) - 8941.61808557) < 0.000001;
  let cruise = planBurnCoastBurn(4.37, 774221.4566651969, rapidityOfOneMinusBeta(0.000001));
  let cruiseOk = absf(cruise.trip.shipTime - 0.006196277986522) < 0.000000000001 && absf(tripEnergy(cruise, 1.0, 100000.0, 100.0).total / 1.0e19 - 1.5104591056870126) < 0.000000001;
  let pole = { x: 0.0, y: 0.0, z: 1.0 };
  let cmbPole = cmbSeenTemperature(pole, pole, rapidityOfOneMinusBeta(0.000001));
  let skyOk = absf(cmbPole - 3853.730994033574) < 0.000001 && absf(photopicRadiance(cmbPole) / 198426544.37850556 - 1.0) < 0.000001 && absf(teffFromBV(0.65) - 5770.0) < 0.000000001 && absf(limitingMagnitude(0.0002, 1.0) - 6.942368201939953) < 0.000000001;
  let phi099 = 2.6466524123622457;
  let glowOk = glowEmittanceAt(100000.0, phi099, 0.000000001, 0.5, 1.0) == 4.0 * glowInwardFlux(100000.0, phi099, 0.000000001, 0.5) && absf(glowEmittanceAt(100000.0, phi099, 0.000000001, 0.5, 1.0) / 0.00009628776871706523 - 1.0) < 0.000000000001;
  let disc = apparentDisc(cos(pi() / 2.0), 5.0 * pi() / 180.0, atanh(0.9));
  let discOk = absf(disc.centre * 180.0 / pi() - 25.9277296298034) < 0.000000001 && absf(disc.radius * 180.0 / pi() - 2.18394056339431) < 0.000000001 && absf(hoverPower(1.0, 0.1254) - 37593974.2332) < 0.000001;
  let phiCapS = rapidityOfOneMinusBeta(0.000001);
  let specOk = absf(glowTemperatureAt(100000.0, phi099, 1.0) / 1357.5234659678836 - 1.0) < 0.000000000001 && absf(glowTemperatureAt(100000.0, phiCapS, 1.0) / 14114.023335759708 - 1.0) < 0.000000000001 && absf(glowLuminanceAt(100000.0, phi099, 0.00000000001, 0.5, 1.0) / 0.000000007143664288681881 - 1.0) < 0.000000000001 && absf(glowLuminanceAt(100000.0, phiCapS, 0.00000000001, 0.5, 1.0) / 0.15643160647071194 - 1.0) < 0.000000000001;
  if tripOk && angleOk && shadowOk && photometryOk && photometryWdOk && cruiseOk && skyOk && glowOk && discOk && specOk
  then println("OK: relativity alpha-Cen trip 3.5824 ship-yr / 6.0025 yr, 90deg star seen at 25.842deg at 0.9c, shadow at 3 r_s = pi/4, G2V = 5770 K, WD BP-RP 0.30 = 8941.6 K, alpha Cen at 1-beta = 1e-6 2.263 ship-days / 1.510e19 J, forward CMB at the cap 3853.7 K = 1.984e8 cd/m^2, Sun B-V 0.65 = 5770 K, naked-eye limit V 6.94 at 2e-4 cd/m^2, glow pole at 0.99c 9.6288e-5 W/m^2 = 4 x mean, 5 deg sphere at 90 deg seen at 25.928 deg radius 2.184 deg at 0.9c, hover at 0.1254 m/s^2 = 3.759e7 W/kg, glow at eps 1e-11 1357.5 K / 7.144e-9 cd/m^2 at 0.99c, 14114 K / 0.1564 cd/m^2 at the cap")
  else println("FAIL: trip ${show(trip.shipTime)} / ${show(trip.galaxyTime)}, angle ${show(angle)}, shadow ${show(shadow)}, G2V ${show(teffFromBpRp(0.823))}, WD ${show(bbTeffFromBpRp(0.30))}, cruise ${show(cruise.trip.shipTime)}, CMB ${show(cmbPole)} K ${show(photopicRadiance(cmbPole))} cd/m^2, B-V ${show(teffFromBV(0.65))}, limit ${show(limitingMagnitude(0.0002, 1.0))}, glow pole ${show(glowEmittanceAt(100000.0, phi099, 0.000000001, 0.5, 1.0))}, disc ${show(disc.centre)} / ${show(disc.radius)}, hover ${show(hoverPower(1.0, 0.1254))}, glow T ${show(glowTemperatureAt(100000.0, phi099, 1.0))} lum ${show(glowLuminanceAt(100000.0, phi099, 0.00000000001, 0.5, 1.0))}")
}
