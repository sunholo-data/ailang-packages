module sunholo/relativity/kerr_events_test
import std/result (Ok, Err)
import ./hyper (absf)
import ./kerr_events (outerTurningRadius, polarTurningAngle, eventPatch)
import ./kerr_geodesic (radialPotential)
test "outer radial root brackets accessible return, root residual small" {
  match outerTurningRadius(20.0,0.0,28.0,0.0) {
    Err(_)=>false,
    Ok(r)=>r>3.0 && r<4.0 && absf(radialPotential(r,0.0,28.0,0.0))<1.0e-10
  }
}
test "polar root stable for near-axis and exact axis; forbidden angular region" {
  polarTurningAngle(0.0,12.0,0.9)==0.0
  && polarTurningAngle(1.0e-10,12.0,0.9)>0.0
  && polarTurningAngle(1.0e-10,12.0,0.9)<1.0e-10
}
test "root event lands then flips just radial sign, departure leaves root" {
  let y={u:3.0+1.0e-10,theta:1.5707963267948966,phi:0.0,time:0.0,sr:1.0,st:1.0};
  match eventPatch(y,0.0,0.0,27.0,true,3.0,false) {
    Err(_)=>true, -- double radial root must be refused, never reflected
    Ok(_)=>false
  }
}
test "simple root landing preserves theta, flips once and departs into allowed interval" {
  match outerTurningRadius(20.0,0.0,28.0,0.0) {
    Err(_)=>false,
    Ok(r)=>{
      let y={u:r+1.0e-10,theta:1.5707963267948966,phi:0.0,time:0.0,sr:1.0,st:1.0};
      match eventPatch(y,0.0,0.0,28.0,true,r,false) {
        Err(_)=>false,
        Ok(at)=>match eventPatch(at,0.0,0.0,28.0,true,r,true) {
          Err(_)=>false,
          Ok(out)=>at.u==r && at.sr == -1.0 && at.st==1.0 && out.u>r && out.sr == -1.0
        }
      }
    }
  }
}
