-- sunholo/relativity/optics — what a moving observer sees.
--
-- Conventions:
--   n    unit vector from the observer TOWARD the source, rest frame
--   n'   unit vector toward where the source APPEARS to the moving observer
--   bh   unit direction of the observer's velocity (rest frame)
--   phi  observer rapidity (>= 0), beta = tanh phi
--   D    Doppler factor nu_seen / nu_emitted (> 1 is blueshift)
-- Everything is written in rapidity with the cancellations removed, so it
-- stays accurate at gamma in the millions.

module sunholo/relativity/optics

import std/math (sqrt, exp, sin, cos, acos, atan2)
import ./hyper (sinh, cosh, absf)
import ./medium (cmbTemperatureK)

export type Vec3 = { x: float, y: float, z: float }

export pure func dot(a: Vec3, b: Vec3) -> float = a.x * b.x + a.y * b.y + a.z * b.z

export pure func norm(a: Vec3) -> float
  ensures { result >= 0.0 }
{
  sqrt(dot(a, a))
}

export pure func normalize(a: Vec3) -> Vec3 {
  let l = norm(a);
  { x: a.x / l, y: a.y / l, z: a.z / l }
}

-- gamma (1 + beta c) = cosh phi + sinh phi c, rewritten as
-- e^-phi + sinh phi (1 + c) when c < 0 so it does not cancel near c = -1.
export pure func gammaOnePlusBetaCos(phi: float, c: float) -> float
  requires { phi >= 0.0 && c >= -1.0 && c <= 1.0 }
  ensures { result > 0.0 }
{
  if c < 0.0 then exp(0.0 - phi) + sinh(phi) * (1.0 + c)
  else cosh(phi) + sinh(phi) * c
}

-- Doppler factor from the rest-frame source direction: D = gamma (1 + beta cos theta).
-- Domain (0.13.0): n and bh are UNIT vectors (AGENT.md conventions), so the
-- dot product is cos theta and must lie in [-1, 1] - an unnormalised pair's
-- dot is not a cosine, and it used to flow into gammaOnePlusBetaCos outside
-- its own contract. And 0 <= phi <= 700.0: cosh/sinh of the rapidity stay
-- finite (exp saturates at 709.78), so D lies in [e^-phi, e^phi], finite and
-- positive throughout; at c = -1 the c < 0 branch multiplies sinh(phi) by 0,
-- which is NaN if sinh has saturated.
export pure func doppler(n: Vec3, bh: Vec3, phi: float) -> float
  requires { phi >= 0.0 && phi <= 700.0 && n.x * bh.x + n.y * bh.y + n.z * bh.z >= -1.0 && n.x * bh.x + n.y * bh.y + n.z * bh.z <= 1.0 }
  ensures { result > 0.0 }
{
  gammaOnePlusBetaCos(phi, dot(n, bh))
}

-- Doppler factor from the apparent direction: D = 1 / (gamma (1 - beta cos theta')).
-- Same unit-vector and rapidity bounds as doppler (0.13.0): the reciprocal's
-- argument lies in [e^-phi, e^phi], finite and positive, so D is finite and
-- positive throughout.
export pure func dopplerApparent(nSeen: Vec3, bh: Vec3, phi: float) -> float
  requires { phi >= 0.0 && phi <= 700.0 && nSeen.x * bh.x + nSeen.y * bh.y + nSeen.z * bh.z >= -1.0 && nSeen.x * bh.x + nSeen.y * bh.y + nSeen.z * bh.z <= 1.0 }
  ensures { result > 0.0 }
{
  1.0 / gammaOnePlusBetaCos(phi, 0.0 - dot(nSeen, bh))
}

-- Aberration: where a source at rest-frame direction n appears.
--   n' = (n + ((gamma - 1) c + gamma beta) bh) / (gamma (1 + beta c))
-- with gamma - 1 = 2 sinh^2(phi/2). Sources crowd toward bh.
export pure func aberrate(n: Vec3, bh: Vec3, phi: float) -> Vec3
  requires { phi >= 0.0 }
{
  let c = dot(n, bh);
  let s = sinh(phi / 2.0);
  let d = gammaOnePlusBetaCos(phi, c);
  let k = (2.0 * s * s * c + sinh(phi)) / d;
  normalize({ x: n.x / d + k * bh.x, y: n.y / d + k * bh.y, z: n.z / d + k * bh.z })
}

-- Inverse aberration: the rest-frame direction a seen ray came from
-- (use for sampling sky textures per pixel).
export pure func deaberrate(nSeen: Vec3, bh: Vec3, phi: float) -> Vec3
  requires { phi >= 0.0 }
{
  aberrate(nSeen, { x: 0.0 - bh.x, y: 0.0 - bh.y, z: 0.0 - bh.z }, phi)
}

-- Scalar aberration: cos theta' = (cos theta + beta) / (1 + beta cos theta).
export pure func cosSeen(cosTheta: float, beta: float) -> float
  requires { cosTheta >= -1.0 && cosTheta <= 1.0 && beta >= 0.0 && beta < 1.0 }
  ensures { result >= -1.0 && result <= 1.0 }
{
  let r = (cosTheta + beta) / (1.0 + beta * cosTheta);
  if r > 1.0 then 1.0 else if r < -1.0 then -1.0 else r
}

-- Doppler factor straight ahead: gamma (1 + beta) = e^phi (> 1, blueshift).
export pure func forwardDoppler(phi: float) -> float = exp(phi)

-- Temperature of the cosmic microwave background straight ahead of an
-- observer at rapidity phi: T_CMB e^phi (K). Off-axis it halves at 1/gamma
-- rad from the pole. 38.44 K at 0.99c, 3,853.7 K at 1 - beta = 1e-6.
export pure func cmbForwardTemperature(phi: float) -> float = cmbTemperatureK() * forwardDoppler(phi)

-- Temperature (K) of the CMB arriving from REST-FRAME direction n (toward the
-- source) for an observer heading bh at rapidity phi: T_CMB D(n). The CMB is
-- a blackbody at T_CMB D in every direction, so its seen radiance is
-- blackbody.photopicRadiance(cmbSeenTemperature(...)), never a ratio against
-- 2.725 K. At 1 - beta = 1e-6: 3,853.7 K on the pole (HB-63) and
-- gamma T_CMB = 1,926.9 K for n at 90 deg, which APPEARS at asin(1/gamma)
-- (0.081 deg) from the pole; 38.44 K ahead at 0.99c (HB-62).
-- 0.13.0: the same unit-vector and rapidity bounds as doppler, so the
-- temperature lies in [T_CMB e^-phi, T_CMB e^phi], finite throughout.
export pure func cmbSeenTemperature(n: Vec3, bh: Vec3, phi: float) -> float
  requires { phi >= 0.0 && phi <= 700.0 && n.x * bh.x + n.y * bh.y + n.z * bh.z >= -1.0 && n.x * bh.x + n.y * bh.y + n.z * bh.z <= 1.0 }
  ensures { result > 0.0 }
{
  cmbTemperatureK() * doppler(n, bh, phi)
}

-- The same from the APPARENT direction nSeen (per pixel of a rendered sky):
-- T_CMB / (gamma (1 - beta cos theta')). Half the pole value near
-- theta' = 1/gamma rad (HB-68); T_CMB / gamma at theta' = 90 deg; everything
-- beyond cos theta' = (1 - 1/gamma) / beta is redshifted below 2.725 K.
export pure func cmbSeenTemperatureApparent(nSeen: Vec3, bh: Vec3, phi: float) -> float
  requires { phi >= 0.0 && phi <= 700.0 && nSeen.x * bh.x + nSeen.y * bh.y + nSeen.z * bh.z >= -1.0 && nSeen.x * bh.x + nSeen.y * bh.y + nSeen.z * bh.z <= 1.0 }
  ensures { result > 0.0 }
{
  cmbTemperatureK() * dopplerApparent(nSeen, bh, phi)
}

-- ---------- apparent disc of a nearby sphere ----------

-- Apparent polar angle (rad from bh) of a source at rest-frame polar angle
-- theta: the angle form of cosSeen, by the half-angle law
--   tan(theta'/2) = e^-phi tan(theta/2) = tan(theta/2) / forwardDoppler(phi)
-- (e^-phi = sqrt((1 - beta) / (1 + beta))), so nothing forms 1 - beta and it
-- is exact at the cap and next to both poles, where acos(cosSeen) is not.
-- Written with atan2, it is continuous and odd in theta over (-2 pi, 2 pi):
-- a negative theta is the same meridian on the far side of the pole, and
-- angleSeen(2 pi - t) = 2 pi - angleSeen(t).
export pure func angleSeen(theta: float, phi: float) -> float
  requires { phi >= 0.0 }
{
  let h = theta / 2.0;
  2.0 * atan2(exp(0.0 - phi) * sin(h), cos(h))
}

-- The apparent disc: centre angle from bh and angular radius, radians.
export type ApparentDisc = { centre: float, radius: float }

-- Image of a sphere of angular radius alpha whose centre lies at rest-frame
-- polar angle theta (cosTheta = cos theta) from the observer's heading.
-- Aberration is conformal on the sky, so the outline stays a circle; its
-- edge points on the meridian are the aberrated theta - alpha and
-- theta + alpha, so the apparent centre is their mean and the radius half
-- their difference. That centre is NOT the aberrated centre angleSeen(theta)
-- (25.928 vs 25.842 deg at 0.9c, theta 90, alpha 5). A disc over a pole
-- (theta < alpha or theta > pi - alpha) keeps the pole inside its image.
-- Identity at phi = 0; finite for every phi to the cap.
export pure func apparentDisc(cosTheta: float, alpha: float, phi: float) -> ApparentDisc
  requires { cosTheta >= -1.0 && cosTheta <= 1.0 && alpha >= 0.0 && alpha <= 1.5707963267948966 && phi >= 0.0 }
  ensures { result.radius >= 0.0 && result.centre >= 0.0 }
{
  let theta = acos(cosTheta);
  let nearEdge = angleSeen(theta - alpha, phi);
  let farEdge = angleSeen(theta + alpha, phi);
  { centre: (nearEdge + farEdge) / 2.0, radius: (farEdge - nearEdge) / 2.0 }
}
