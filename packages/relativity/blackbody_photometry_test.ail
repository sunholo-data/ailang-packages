-- Blackbody white-dwarf photometry checks. Expected values come from the
-- stdlib-only reference in tools/gaia_bb_to_ail.py (design doc Appendix A),
-- not from this module.
module sunholo/relativity/blackbody_photometry_test

import std/math (exp, log, intToFloat)
import ./hyper (absf)
import ./blackbody_photometry_table (zBpRp, zGMinusV, bbColourNodes, bbLnTeffNodes, bbGMinusVNodes)
import ./blackbody_photometry (bbBpRp, bbGMinusV, bbBpRpInvertible, bbClampTeff, bbTeffFromBpRp, bbTeffFromBpRpExact, bbGMinusVFromBpRp, bbVFromG)

pure func close(got: float, want: float, tol: float) -> bool = absf(got - want) <= tol
pure func rel(got: float, want: float, tol: float) -> bool = absf(got / want - 1.0) <= tol
pure func nan() -> float = 0.0 / 0.0
pure func inf() -> float = 1.0e308 * 10.0

pure func check01() -> bool = close(zBpRp(), 0.5906467146, 0.000000000001) && close(zGMinusV(), 1.158256556847, 0.000000001)
test "zero points" { check01() }

pure func check02() -> bool {
  close(bbBpRp(3000.0), 2.216361966241, 0.000000001) &&
  close(bbBpRp(5772.0), 0.868599308943, 0.000000001) &&
  close(bbBpRp(10000.0), 0.189306824598, 0.000000001) &&
  close(bbBpRp(40000.0), -0.460816037875, 0.000000001) &&
  close(bbBpRp(100000.0), -0.569816069007, 0.000000001)
}
test "forward BP-RP" { check02() }

pure func check03() -> bool {
  close(bbGMinusV(3000.0), -0.927100403405, 0.000000001) &&
  close(bbGMinusV(5772.0), -0.185425967576, 0.000000001) &&
  close(bbGMinusV(10000.0), -0.054068770203, 0.000000001) &&
  close(bbGMinusV(40000.0), -0.065984104052, 0.000000001) &&
  close(bbGMinusV(100000.0), -0.078089386811, 0.000000001)
}
test "forward G-V" { check03() }

pure func nodesMatch(ln: [float], col: [float], gv: [float]) -> bool =
  match ln {
    [] => true,
    l :: lr => match col {
      [] => false,
      c :: cr => match gv {
        [] => false,
        g :: gr => close(bbBpRp(exp(l)), c, 0.000000001) && close(bbGMinusV(exp(l)), g, 0.000000001) && nodesMatch(lr, cr, gr)
      }
    }
  }
pure func check04() -> bool = nodesMatch(bbLnTeffNodes(), bbColourNodes(), bbGMinusVNodes())
test "every table node equals the forward model" { check04() }

pure func increasing(xs: [float], prev: float) -> bool =
  match xs { [] => true, x :: rest => x > prev && x < 1.0e300 && increasing(rest, x) }
pure func allFinite(xs: [float]) -> bool =
  match xs { [] => true, x :: rest => x == x && x > -1.0e300 && x < 1.0e300 && allFinite(rest) }
pure func lnSweep(i: int, prev: float) -> bool =
  if i > 200 then true
  else {
    let c = bbBpRp(exp(log(3000.0) + (log(100000.0) - log(3000.0)) * intToFloat(i) / 200.0));
    c < prev && lnSweep(i + 1, c)
  }
pure func check05() -> bool = increasing(bbColourNodes(), -1.0e300) && allFinite(bbGMinusVNodes()) && lnSweep(0, 1.0e300)
test "nodes finite and monotone; forward colour decreasing" { check05() }

pure func roundTrip(i: int, worst: float) -> float =
  if i > 199 then worst
  else {
    let t = exp(log(3000.0) + (log(100000.0) - log(3000.0)) * (intToFloat(i) + 0.37) / 200.0);
    let e = absf(bbTeffFromBpRp(bbBpRp(t)) / t - 1.0);
    roundTrip(i + 1, if e > worst then e else worst)
  }
pure func check06() -> bool = roundTrip(0, 0.0) <= 0.0006
test "table round trip within 6e-4 relative" { check06() }

pure func exactTrip(i: int, worst: float, vs: float) -> float =
  if i > 9 then (if vs > worst then vs else worst)
  else {
    let t = exp(log(3000.0) + (log(100000.0) - log(3000.0)) * (intToFloat(i) + 0.5) / 10.0);
    let c = bbBpRp(t);
    let e = absf(bbTeffFromBpRpExact(c) / t - 1.0);
    let v = absf(bbTeffFromBpRp(c) / bbTeffFromBpRpExact(c) - 1.0);
    exactTrip(i + 1, if e > worst then e else worst, if v > vs then v else vs)
  }
pure func check07() -> bool {
  let e = exactTrip(0, 0.0, 0.0);
  e <= 0.0006 && rel(bbTeffFromBpRpExact(bbBpRp(7777.0)), 7777.0, 0.000000001)
}
pure func check07b() -> bool = rel(bbTeffFromBpRpExact(bbBpRp(12345.0)), 12345.0, 0.000000001) && rel(bbTeffFromBpRpExact(bbBpRp(3500.0)), 3500.0, 0.000000001) && rel(bbTeffFromBpRpExact(bbBpRp(80000.0)), 80000.0, 0.000000001)
test "exact inversion" { check07() && check07b() }

pure func check08() -> bool {
  rel(bbTeffFromBpRp(-0.524274), 60871.54394205, 0.000000001) &&
  rel(bbTeffFromBpRp(-0.452312), 38307.58708594, 0.000000001) &&
  rel(bbTeffFromBpRp(-0.134162), 15513.63711061, 0.000000001) &&
  rel(bbTeffFromBpRp(-0.191004), 17249.75464724, 0.000000001) &&
  rel(bbTeffFromBpRp(0.597588), 6957.83514224, 0.000000001) &&
  rel(bbTeffFromBpRp(1.133657), 4932.47087999, 0.000000001) &&
  rel(bbTeffFromBpRp(0.30), 8941.61808557, 0.000000001)
}
test "pinned table outputs" { check08() }

pure func within(c: float, tl: float, lo: float, hi: float) -> bool {
  let r = bbTeffFromBpRp(c) / tl;
  r >= lo && r <= hi
}
pure func check09() -> bool {
  within(-0.524274, 59000.0, 0.85, 1.2) && within(-0.481523, 40204.0, 0.85, 1.2) &&
  within(-0.452312, 33301.0, 0.85, 1.2) && within(-0.482519, 43740.0, 0.85, 1.2) &&
  within(-0.134162, 15100.0, 0.85, 1.2) && within(-0.268777, 22200.0, 0.85, 1.2) &&
  within(-0.092795, 13906.0, 0.85, 1.2) &&
  within(-0.191004, 16265.0, 0.95, 1.10) && within(-0.275433, 20144.0, 0.95, 1.10) &&
  within(0.341712, 8154.0, 0.95, 1.10) && within(0.597588, 6594.0, 0.95, 1.10) &&
  within(1.133657, 4900.0, 0.95, 1.10)
}
test "within literature band" { check09() }

pure func check10() -> bool {
  bbTeffFromBpRp(3.0) == 3000.0 && bbTeffFromBpRp(-1.0) == 100000.0 &&
  bbTeffFromBpRp(nan()) == 3000.0 && bbTeffFromBpRp(inf()) == 3000.0 && bbTeffFromBpRp(-inf()) == 100000.0 &&
  bbBpRpInvertible(0.30) && not bbBpRpInvertible(2.3) && not bbBpRpInvertible(-0.6) && not bbBpRpInvertible(nan())
}
test "clamps, non-finite input, invertibility" { check10() }

pure func check11() -> bool {
  close(bbVFromG(15.0, 0.30), 15.064716662329, 0.000000001) &&
  close(bbGMinusVFromBpRp(9.0), -0.927100403405, 0.000000001) &&
  close(bbGMinusVFromBpRp(nan()), -0.927100403405, 0.000000001)
}
test "V from G and G-V clamps" { check11() }

pure func inRange(i: int) -> bool =
  if i > 600 then true
  else {
    let t = bbTeffFromBpRp(-2.0 + 0.01 * intToFloat(i));
    t >= 3000.0 && t <= 100000.0 && inRange(i + 1)
  }
pure func check12() -> bool = inRange(0) && bbClampTeff(1.0) == 3000.0 && bbClampTeff(1.0e9) == 100000.0 && bbClampTeff(5000.0) == 5000.0
test "range guarantee" { check12() }
