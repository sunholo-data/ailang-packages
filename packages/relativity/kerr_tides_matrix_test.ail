module sunholo/relativity/kerr_tides_matrix_test
import ./hyper (absf)
import ./optics (Vec3)
import ./kerr_tides (tidalTensor)
pure func near(a:float,b:float)->bool=absf(a-b)<1.0e-12*(if absf(b)>1.0e-20 then absf(b) else 1.0e-20)
pure func probe(u:float,s:float,vr:float,vp:float,rr:float,rp:float,tt:float,pp:float)->bool {
  let t=tidalTensor(u,s,{x:vr,y:0.0,z:vp});
  near(t.rr,4.0*rr) && near(t.rp,4.0*rp) && near(t.tt,4.0*tt) && near(t.pp,4.0*pp)
  && absf(t.rt)<1.0e-20 && absf(t.tp)<1.0e-20
}
test "metric tensor 0 s0 u4 zamo" {probe(4.0,0.0,0.0,0.0,-0.03125,0.0,0.015625,0.015625)}
