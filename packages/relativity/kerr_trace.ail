-- Finite-equatorial observer, complete Carter trace. EXPERIMENTAL until the
-- independent multi-ray/refinement gate closes. Failures never mean capture.
module sunholo/relativity/kerr_trace
import std/result (Result,Ok,Err)
import std/math (sin,cos)
import ./hyper (absf)
import ./optics (Vec3,normalize)
import ./kerr_frame (sourceConstants)
import ./kerr_geodesic (radialPotential,classifyCapture,Captured,Escaped,Critical,InvalidRay)
import ./kerr_carter (CarterState,CarterRates,carterRates,carterStep)
import ./kerr_events (outerTurningRadius,polarTurningAngle,eventPatch)
export type SkyTrace={sky:Vec3,phi:float,time:float,steps:int,turns:int}
pure func minf(a:float,b:float)->float=if a<b then a else b
pure func discrepancy(a:CarterState,b:CarterState)->float =
  absf(a.u-b.u)/(1.0+absf(a.u))+absf(a.theta-b.theta)+absf(a.phi-b.phi)
pure func halfStep(y:CarterState,s:float,l:float,e:float,h:float)->Result[CarterState,string] =
  match carterStep(y,s,l,e,h/2.0) { Err(msg)=>Err(msg),Ok(a)=>carterStep(a,s,l,e,h/2.0) }
pure func retry(y:CarterState,s:float,l:float,e:float,h:float,n:int)->Result[CarterState,string] =
  if n==0 then Err("step_refinement") else match carterStep(y,s,l,e,h) {
    Err(_)=>retry(y,s,l,e,h/2.0,n-1),
    Ok(full)=>match halfStep(y,s,l,e,h) {
      Err(_)=>retry(y,s,l,e,h/2.0,n-1),
      Ok(z)=>if radialPotential(z.u,l,e,s)<0.0 || discrepancy(full,z)>1.0e-11 then retry(y,s,l,e,h/2.0,n-1)
        else match carterRates(z,s,l,e) { Err(_)=>retry(y,s,l,e,h/2.0,n-1),Ok(_)=>Ok(z) }
    }
  }
pure func finish(y:CarterState,d:CarterRates,i:int,turns:int)->SkyTrace {
  let sn=sin(y.theta);let co=cos(y.theta);let cp=cos(y.phi);let sp=sin(y.phi);
  -- Asymptotic Cartesian tangent removes the O(impact/u) position offset.
  let vr=0.0-d.u;let vt=0.0-y.u*d.theta;let vp=0.0-y.u*sn*d.phi;
  {sky:normalize({x:vr*sn*cp+vt*co*cp-vp*sp,y:vr*sn*sp+vt*co*sp+vp*cp,z:vr*co-vt*sn}),
    phi:y.phi,time:y.time,steps:i,turns:turns}
}
pure func loop(y:CarterState,s:float,l:float,e:float,rt:float,pt:float,far:float,step:float,i:int,turns:int)->Result[SkyTrace,string] =
  if i>=200000 then Err("solver_steps") else match carterRates(y,s,l,e) {
    Err(msg)=>Err(msg),
    Ok(d)=>if y.u>=far then Ok(finish(y,d,i,turns)) else {
      let polarRoot=if y.st>0.0 then pt else 3.141592653589793-pt;
      let radialEvent=rt>0.0 && y.sr>0.0 && absf(y.u-rt)<1.0e-13*rt;
      let polarEvent=e>1.0e-24*(1.0+l*l+s*s) && l!=0.0 && absf(y.theta-polarRoot)<1.0e-9*pt;
      if radialEvent || polarEvent then {
        let root=if radialEvent then rt else polarRoot;
        match eventPatch(y,s,l,e,radialEvent,root,false) {
          Err(msg)=>Err(msg),
          Ok(at)=>match eventPatch(at,s,l,e,radialEvent,root,true) {
            Err(msg)=>Err(msg),
            Ok(z)=>loop(z,s,l,e,rt,pt,far,step,i+1,turns+1)
          }
        }
      } else {
        let basic=minf(step/y.u,step/(1.0+absf(d.theta)+absf(d.phi)));
        let radialLimit=if rt>0.0 && y.sr>0.0 && y.u-rt<0.01*rt && d.u>0.0 then 0.02*(y.u-rt)/d.u else basic;
        let h=0.0-minf(basic,radialLimit);
        match retry(y,s,l,e,h,50) {
          Err(msg)=>Err(msg),
          Ok(z)=>loop(z,s,l,e,rt,pt,far,step,i+1,turns)
        }
      }
    }
  }
export pure func traceSky(u:float,s:float,n:Vec3,step:float)->Result[SkyTrace,string]
  requires { u>=4.0 && u<=2000000.0 && s>=0.0 && s<=0.998 && step>0.0 && step<=0.02 }
{
  let c=sourceConstants(u,s,n);
  match classifyCapture(u,c.lambda,c.eta,s,n.x>=0.0) {
    Captured=>Err("captured"), Critical=>Err("critical"),InvalidRay=>Err("invalid_ray"),
    Escaped=>{
      let rt=match outerTurningRadius(u,c.lambda,c.eta,s) {Ok(r)=>r,Err(_)=>0.0};
      let pt=polarTurningAngle(c.lambda,c.eta,s);
      let y={u:u,theta:1.5707963267948966,phi:0.0,time:0.0,
        sr:if n.x<0.0 then 1.0 else -1.0,st:if n.y>0.0 then -1.0 else 1.0};
      let far=if u*1000.0>100000.0 then u*1000.0 else 100000.0;
      loop(y,s,c.lambda,c.eta,rt,pt,far,step,0,0)
    }
  }
}
