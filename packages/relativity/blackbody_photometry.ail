-- sunholo/relativity/blackbody_photometry — blackbody approximation of a
-- white dwarf (or any thermal source) through Gaia's passbands.
--
-- Convention: Gaia EDR3 VEGAMAG, photon counting (S * lambda weighting),
-- published zero points, trapezoid quadrature on the tabulated 5 nm (G, BP,
-- RP) and 10 nm (V) samples. A blackbody's unknown overall scale cancels in
-- each colour. Tables and zero points are generated by
-- tools/gaia_bb_to_ail.py into blackbody_photometry_table. Accuracy against
-- real white dwarfs: T_eff ~4% hot (up to +17% above 25 kK), V +-0.1 mag.
--
-- Non-finite and out-of-range colours clamp to the bracket ends. NaN is
-- always tested first with x == x (interpreter and VM disagree on NaN > x).
-- Only single-level list patterns are used (nested cons is evaluator-only).
module sunholo/relativity/blackbody_photometry

import std/math (exp, log, log10)
import ./blackbody (planck)
import ./blackbody_photometry_table (gaiaGResponse, gaiaBpResponse, gaiaRpResponse, johnsonVResponse, zBpRp, zGMinusV, bbColourNodes, bbLnTeffNodes, bbGMinusVNodes)

export pure func bbTeffMin() -> float = 3000.0
export pure func bbTeffMax() -> float = 100000.0

-- Trapezoid sum of response * lambda * planck over one response list.
pure func walk(rs: [float], lam: float, step: float, kelvin: float, w: float, acc: float) -> float =
  match rs {
    [] => acc,
    r :: rest => {
      let term = r * lam * planck(lam, kelvin);
      match rest {
        [] => acc + 0.5 * term,
        _ => walk(rest, lam + step, step, kelvin, 1.0, acc + w * term)
      }
    }
  }

pure func band(rs: [float], lo: float, step: float, kelvin: float) -> float =
  step * walk(rs, lo, step, kelvin, 0.5, 0.0)

export pure func bbBpRp(kelvin: float) -> float
  requires { kelvin > 0.0 }
{
  -2.5 * log10(band(gaiaBpResponse(), 325.0, 5.0, kelvin) / band(gaiaRpResponse(), 610.0, 5.0, kelvin)) + zBpRp()
}

export pure func bbGMinusV(kelvin: float) -> float
  requires { kelvin > 0.0 }
{
  -2.5 * log10(band(gaiaGResponse(), 320.0, 5.0, kelvin) / band(johnsonVResponse(), 470.0, 10.0, kelvin)) + zGMinusV()
}

-- Range guarantee for every temperature this module returns (Z3-proved).
export pure func bbClampTeff(t: float) -> float
  ensures { result >= 3000.0 && result <= 100000.0 }
{
  if t < 3000.0 then 3000.0 else if t > 100000.0 then 100000.0 else t
}

pure func lastOf(xs: [float], prev: float) -> float =
  match xs { [] => prev, x :: rest => lastOf(rest, x) }
pure func firstOf(xs: [float]) -> float =
  match xs { [] => 0.0, x :: _ => x }

-- True inside the open interval (colour at 100 kK, colour at 3 kK); false for NaN.
export pure func bbBpRpInvertible(bpRp: float) -> bool {
  let col = bbColourNodes();
  bpRp == bpRp && bpRp < lastOf(col, 0.0) && bpRp > firstOf(col)
}

-- One-pass linear interpolation of ys against ascending xs; c must not be NaN.
pure func interp(c: float, x0: float, y0: float, xs: [float], ys: [float]) -> float =
  match xs {
    [] => y0,
    x1 :: xr => match ys {
      [] => y0,
      y1 :: yr => if c <= x1 then y0 + (c - x0) * (y1 - y0) / (x1 - x0) else interp(c, x1, y1, xr, yr)
    }
  }

-- NaN maps to the last node (3000 K end); below the first node clamps to it.
pure func lookup(c: float, ys: [float]) -> float {
  let cc = if c == c then c else 1.0e300;
  match bbColourNodes() {
    [] => 0.0,
    x0 :: xr => match ys {
      [] => 0.0,
      y0 :: yr => if cc <= x0 then y0 else interp(cc, x0, y0, xr, yr)
    }
  }
}

-- Production inversion: 61-node table, linear in (colour, ln T).
export pure func bbTeffFromBpRp(bpRp: float) -> float = bbClampTeff(exp(lookup(bpRp, bbLnTeffNodes())))

pure func bisect(c: float, a: float, b: float, n: int) -> float =
  if n == 0 then exp(0.5 * (a + b))
  else {
    let m = 0.5 * (a + b);
    if bbBpRp(exp(m)) > c then bisect(c, m, b, n - 1) else bisect(c, a, m, n - 1)
  }

-- Exact inversion: 48 fixed halvings of ln T. Expensive; tests and tools only.
export pure func bbTeffFromBpRpExact(bpRp: float) -> float =
  if bpRp == bpRp then
    (if bpRp >= bbBpRp(3000.0) then 3000.0
     else if bpRp <= bbBpRp(100000.0) then 100000.0
     else bbClampTeff(bisect(bpRp, log(3000.0), log(100000.0), 48)))
  else 3000.0

export pure func bbGMinusVFromBpRp(bpRp: float) -> float = lookup(bpRp, bbGMinusVNodes())

export pure func bbVFromG(g: float, bpRp: float) -> float = g - bbGMinusVFromBpRp(bpRp)
