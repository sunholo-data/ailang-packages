-- Generated test-only literals: tools/kerr_null_ref.py --nearaxis, DOP853 refinement.
module sunholo/relativity/kerr_axis_matrix_test
import std/math (sqrt)
import std/result (Ok,Err)
import ./kerr_trace (traceSky)
pure func probe(u:float,s:float,x:float,y:float,z:float,ox:float,oy:float,oz:float)->bool =
  match traceSky(u,s,{x:x,y:y,z:z},0.005) {Err(_)=>false,Ok(r)=>sqrt((r.sky.x-ox)*(r.sky.x-ox)+(r.sky.y-oy)*(r.sky.y-oy)+(r.sky.z-oz)*(r.sky.z-oz))<1.2e-4}
