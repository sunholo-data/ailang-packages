-- sunholo/relativity/blackbody — colour and brightness of thermal sources,
-- and how Doppler shifts change them.
--
-- Planck spectrum x CIE 1931 2-degree colour-matching functions (multi-lobe
-- Gaussian fit, Wyman, Sloan & Shirley 2013, JCGT 2(2)) -> XYZ -> linear sRGB
-- (D65 white, so ~6500 K renders white). Integrated 360-830 nm at 1 nm.
-- Absolute scale is arbitrary but consistent across temperatures, which is
-- all ratios need.

module sunholo/relativity/blackbody

import std/math (exp, pow)
import ./hyper (expm1)

export type XYZ = { x: float, y: float, z: float }
export type RGB = { r: float, g: float, b: float }

-- second radiation constant hc/k in nm*K
pure func c2() -> float = 14387769.0

pure func lobe(l: float, mu: float, s1: float, s2: float) -> float {
  let s = if l < mu then s1 else s2;
  let t = (l - mu) / s;
  exp(-0.5 * t * t)
}

-- CIE 1931 2-degree colour-matching functions at wavelength l (nm).
export pure func cmf(l: float) -> XYZ = {
  x: 1.056 * lobe(l, 599.8, 37.9, 31.0) + 0.362 * lobe(l, 442.0, 16.0, 26.7) - 0.065 * lobe(l, 501.1, 20.4, 26.2),
  y: 0.821 * lobe(l, 568.8, 46.9, 40.5) + 0.286 * lobe(l, 530.9, 16.3, 31.1),
  z: 1.217 * lobe(l, 437.0, 11.8, 36.0) + 0.681 * lobe(l, 459.0, 26.0, 13.8)
}

-- Planck temperature (CODATA 2018), the ceiling `planck` clamps to.
pure func planckTemperature() -> float = 1.416784e32

-- Spectral radiance up to a constant; wavelength enters in micrometres so
-- cool sources stay far from float underflow.
-- Finite, and accurate, for every T > 0, +Inf included (0.5.2):
--   * for e < 1e-5 (T > ~1.7e9 K at 830 nm) the denominator is
--     hyper.expm1(e) instead of exp(e) - 1. In 0.5.1, exp(e) - 1 lost
--     digits there (relative error ~1e-16 / e: 19% high at 1e20 K) and was
--     exactly 0 once exp(e) rounded to 1 (T > ~1.6e20 K), giving +Inf;
--   * T is clamped at the Planck temperature 1.416784e32 K, beyond which a
--     blackbody means nothing; that keeps the sums in xyz/luminance/
--     photopicRadiance far below overflow (photopicRadiance(T_P) = 9.2e38).
-- For e >= 1e-5 (every T below ~1.7e9 K) the arithmetic is unchanged, so
-- those results are bit-identical to 0.5.1. NaN is tested first and never
-- clamped, so NaN behaves as in 0.5.1 on both engines (ailang#1419).
export pure func planck(lNm: float, kelvin: float) -> float
  requires { lNm > 0.0 && kelvin > 0.0 }
  ensures { result >= 0.0 }
{
  let t = if kelvin == kelvin && kelvin > planckTemperature() then planckTemperature() else kelvin;
  let e = c2() / (lNm * t);
  if e > 700.0 then 0.0
  else pow(lNm / 1000.0, -5.0) / (if e < 0.00001 then expm1(e) else exp(e) - 1.0)
}

func integrate(kelvin: float, l: float, acc: XYZ) -> XYZ {
  if l > 830.0 then acc
  else {
    let p = planck(l, kelvin);
    let c = cmf(l);
    integrate(kelvin, l + 1.0, { x: acc.x + c.x * p, y: acc.y + c.y * p, z: acc.z + c.z * p })
  }
}

-- CIE XYZ tristimulus of a blackbody (arbitrary but T-consistent scale).
export pure func xyz(kelvin: float) -> XYZ
  requires { kelvin > 0.0 }
{
  integrate(kelvin, 360.0, { x: 0.0, y: 0.0, z: 0.0 })
}

-- Visual-band (CIE Y) radiance.
export pure func luminance(kelvin: float) -> float
  requires { kelvin > 0.0 }
  ensures { result >= 0.0 }
{
  xyz(kelvin).y
}

-- CIE 1931 chromaticity (x, y) returned as { x, y, z = 1 - x - y }.
export pure func chromaticity(kelvin: float) -> XYZ
  requires { kelvin > 0.0 }
{
  let v = xyz(kelvin);
  let s = v.x + v.y + v.z;
  { x: v.x / s, y: v.y / s, z: v.z / s }
}

-- Linear sRGB (D65) colour with luminance Y = 1. Out-of-gamut colours are
-- desaturated toward white at constant luminance.
export pure func rgbUnitLuminance(kelvin: float) -> RGB
  requires { kelvin > 0.0 }
{
  let v = xyz(kelvin);
  let x = v.x / v.y;
  let z = v.z / v.y;
  let r = 3.2404542 * x - 1.5371385 - 0.4985314 * z;
  let g = -0.9692660 * x + 1.8760108 + 0.0415560 * z;
  let b = 0.0556434 * x - 0.2040259 + 1.0572252 * z;
  let m = if r < g then (if r < b then r else b) else (if g < b then g else b);
  if m < 0.0 then {
    let k = (0.0 - m) / (1.0 - m);
    { r: r * (1.0 - k) + k, g: g * (1.0 - k) + k, b: b * (1.0 - k) + k }
  } else { r: r, g: g, b: b }
}

-- Seen/rest flux ratio of a thermal POINT source (a star) in the visual band.
-- I_nu / nu^3 is invariant, so a blackbody at T is seen as one at D*T whose
-- solid angle shrinks by 1/D^2:   (Y(D T) / Y(T)) / D^2.
-- (Bolometrically this is D^2.)
export pure func pointFluxRatio(kelvin: float, d: float) -> float
  requires { kelvin > 0.0 && d > 0.0 }
  ensures { result >= 0.0 }
{
  luminance(kelvin * d) / luminance(kelvin) / (d * d)
}

-- Seen/rest radiance ratio of a thermal EXTENDED source (nebula, sky) in the
-- visual band: surface brightness is the blackbody at D*T, Y(D T) / Y(T).
-- (Bolometrically this is D^4.)
export pure func surfaceBrightnessRatio(kelvin: float, d: float) -> float
  requires { kelvin > 0.0 && d > 0.0 }
  ensures { result >= 0.0 }
{
  luminance(kelvin * d) / luminance(kelvin)
}

-- Absolute photopic luminance of a blackbody in cd/m^2:
--   Km * integral B_lambda(T) ybar(lambda) dlambda,  Km = 683 lm/W,
-- on this module's ybar (360-830 nm, 1 nm). 2 h c^2 = 1.1910429723971884e-16
-- W m^2 sr^-1 (exact SI); with lambda in um in `planck` that is
-- 1.1910429723971884e5 W m^-2 sr^-1 nm^-1 per unit of `luminance`.
-- Checks (tools/photometry_ref.py): 2856 K 1.978e7, 5772 K 1.845e9, Pt point
-- 2041.4 K 5.98e5 (the pre-1979 candela defined it as 6.0e5). The ybar fit
-- is within 0.5% of the CIE table for 1,900-6,000 K, 1% at 800 K; its red
-- tail falls off too fast, so below about 700 K the value is too low (still
-- far below any visible luminance). Finite and >= 0 for every input, +Inf
-- included: T <= 0 and NaN give 0, the CMB's 2.725 K underflows to exactly 0,
-- at very high T it follows Rayleigh-Jeans (linear in T: 1e25 K gives
-- 6.4956e31), and from the Planck temperature 1.416784e32 K up it is flat at
-- 9.2028e38 (see `planck`; 0.5.1 lost digits above ~1e10 K, 3e-7 at 1e15 K
-- and 19% at 1e20 K, and returned +Inf above ~1.6e20 K).
export pure func photopicRadiance(kelvin: float) -> float
  ensures { result >= 0.0 }
{
  if kelvin == kelvin && kelvin > 0.0
  then 683.0 * 119104.29723971884 * luminance(kelvin)
  else 0.0
}
