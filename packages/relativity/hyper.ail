-- sunholo/relativity/hyper — hyperbolic functions that stay accurate near 0.
--
-- std/math has exp/log but no sinh/cosh/tanh/expm1/log1p. Relativity lives in
-- rapidity (beta = tanh phi, gamma = cosh phi), and the naive (e^u - e^-u)/2
-- loses every significant digit as u -> 0, i.e. at low speed. These use
-- Kahan's expm1/log1p constructions so small arguments keep full precision.
--
-- Floats are outside Z3's decidable fragment: the contracts below are
-- runtime-checked assertions (ailang run --verify-contracts), not proofs.

module sunholo/relativity/hyper

import std/math (exp, log, sqrt)

export pure func absf(u: float) -> float
  ensures { result >= 0.0 }
{
  if u < 0.0 then 0.0 - u else u
}

-- e^u - 1, accurate to a few ulps for tiny |u| (Kahan).
-- Domain (0.13.0): u <= 700.0. exp(u) itself saturates to +Inf past
-- u = 709.78 (the float64 max, e^709.782...), and before that the Kahan
-- ratio's numerator (e^u - 1) u overflows past u ~ 703.3, so 700.0 is the
-- largest round bound that keeps the result finite with headroom. Far below
-- zero exp underflows to 0 and expm1 returns exactly -1.0, the correctly
-- rounded value.
export pure func expm1(u: float) -> float
  requires { u <= 700.0 }
  ensures { result > -1.0 || result == -1.0 }
{
  let y = exp(u);
  if y == 1.0 then u
  else if y - 1.0 == -1.0 then -1.0
  else (y - 1.0) * u / log(y)
}

-- ln(1 + x), accurate for tiny |x| (Kahan).
export pure func log1p(x: float) -> float
  requires { x > -1.0 }
{
  let y = 1.0 + x;
  if y == 1.0 then x else log(y) * x / (y - 1.0)
}

export pure func sinh(u: float) -> float {
  let a = absf(u);
  -- The e (e + 2) / (2 (e + 1)) form overflows once e^a passes about 6e153
  -- (|a| > 355): it returned +Inf where the true sinh is finite up to
  -- |a| = 709.09, and NaN past exp's own 709.78. Above 350, sinh = e^a / 2
  -- to the last bit (the e^-a half is far below one ulp of e^a), and it
  -- saturates to +Inf exactly when e^a does (0.13.0).
  let s = if a > 350.0 then exp(a) / 2.0 else {
    let e = expm1(a);
    e * (e + 2.0) / (2.0 * (e + 1.0))
  };
  if u < 0.0 then 0.0 - s else s
}

export pure func cosh(u: float) -> float
  ensures { result >= 1.0 }
{
  let e = exp(absf(u));
  (e + 1.0 / e) / 2.0
}

-- Above |u| = 20 the result rounds to exactly +-1 (0.10.0: it used to be NaN
-- beyond |u| ~ 355, where expm1 overflows to Inf/Inf; bit-identical below).
export pure func tanh(u: float) -> float
  ensures { result >= -1.0 && result <= 1.0 }
{
  let a = absf(u);
  let t = if a > 20.0 then 1.0 else {
    let e = expm1(2.0 * a);
    e / (e + 2.0)
  };
  if u < 0.0 then 0.0 - t else t
}

export pure func atanh(b: float) -> float
  requires { b > -1.0 && b < 1.0 }
{
  let a = absf(b);
  let r = 0.5 * log1p(2.0 * a / (1.0 - a));
  if b < 0.0 then 0.0 - r else r
}

export pure func acosh(x: float) -> float
  requires { x >= 1.0 }
  ensures { result >= 0.0 }
{
  let t = x - 1.0;
  log1p(t + sqrt(t * (x + 1.0)))
}

-- sinh(u)/u with the removable singularity filled in (1 at u = 0).
-- Domain (0.13.0): |u| <= 700.0, where sinh is finite (it saturates to
-- +Inf like cosh, at |u| ~ 709.1); sinh(u)/u >= 1 throughout.
export pure func sinhc(u: float) -> float
  requires { u >= -700.0 && u <= 700.0 }
  ensures { result >= 1.0 }
{
  if absf(u) < 0.0001 then 1.0 + u * u / 6.0 else sinh(u) / u
}

-- acosh(1 + u) without forming 1 + u: log1p(u + sqrt(u (2 + u))). Use it
-- wherever the argument is naturally "1 + something small" (a short trip's
-- a d / 2), where acosh(1.0 + u) would round the low bits of u away.
export pure func acosh1p(u: float) -> float
  requires { u >= 0.0 }
  ensures { result >= 0.0 }
{
  log1p(u + sqrt(u * (2.0 + u)))
}
