module sunholo/relativity/kerr_carter_test
import std/result (Ok, Err)
import ./hyper (absf)
import ./kerr_carter (CarterState, carterRates, carterStep, carterInvariants)
pure func state() -> CarterState = {u:6.0,theta:1.2,phi:0.0,time:0.0,sr:1.0,st:1.0}
test "Carter all four Mino coordinates, independent BPT72 evaluation" {
  match carterRates(state(),0.9,-2.0,12.0) {
    Err(_) => false,
    Ok(d) => absf(d.u-31.37451194839531)<1.0e-12 && absf(d.theta-3.3914240859811806)<1.0e-12
      && absf(d.phi+1.8016945121948509)<1.0e-12 && absf(d.time-54.78108347749117)<1.0e-12
  }
}
test "past-directed RK4 moves time backwards and updates unwrapped phi" {
  match carterStep(state(),0.9,-2.0,12.0,-0.0001) {
    Err(_) => false,
    Ok(y) => y.time<0.0 && y.phi>0.0 && y.u<6.0 && y.theta<1.2
  }
}
test "forbidden potentials refused, lambda-zero axis chart finite" {
  let axis={u:6.0,theta:0.0,phi:0.0,time:0.0,sr:1.0,st:1.0};
  let bad={u:3.0,theta:1.5707963267948966,phi:0.0,time:0.0,sr:1.0,st:1.0};
  (match carterRates(bad,0.0,0.0,28.0) { Err(_) => true, Ok(_) => false })
  && (match carterRates(axis,0.9,0.0,12.0) { Ok(d) => d.theta>0.0 && d.phi==d.phi, Err(_) => false })
}
test "metric recovers Killing energy, lambda, Carter eta and null norm" {
  match carterInvariants(state(),0.9,-2.0,12.0) {
    Err(_)=>false,
    Ok(q)=>absf(q.energy-1.0)<1.0e-12 && absf(q.lambda+2.0)<1.0e-12
      && absf(q.eta-12.0)<1.0e-12 && q.nullResidual<1.0e-13
  }
}
