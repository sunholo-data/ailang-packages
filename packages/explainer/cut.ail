-- sunholo/explainer/cut — where to cut one take into its lines.
--
-- The take is measured in 10 ms frames: frame k's level is the RMS of the samples within 5 ms
-- of k * 10 ms (numpy.convolve(x*x, ones(hop)/hop, "same")[::hop], square-rooted). A frame is
-- quiet below 5% of the loudest frame. Each cut falls in the middle of the longest quiet run
-- between one line's last matched word and the next line's first, widened by 150 ms each way
-- for timing jitter: words neither side matched ("read-only" heard as "read only") sit in that
-- span too, and the paragraph pause after them is the longest. Of equal runs, the later wins.
-- With no quiet frame in the window, the cut goes at its quietest frame.

module sunholo/explainer/cut

import std/array as A
import std/list (length, reverse)
import std/math (sqrt, floatToInt)
import std/option (Option, Some, None)
import ./align (Span)

-- Samples per frame: 10 ms at 24 kHz, the rate of Gemini's and Kokoro's speech. 100 frames a
-- second is what turns a word's time into a frame below (seconds * 100).
export pure func hop() -> int
  ensures { result * 100 == 24000 }
{
  240
}

-- The longest quiet run seen so far in a window: its length in frames and the frame after it.
export type Run = { size: int, end: int } deriving (Eq)

-- The run so far, after one more frame: a frame that is quiet extends it.
export pure func extend(run: int, quiet: bool) -> int
  requires { run >= 0 }
  ensures { (quiet && result == run + 1) || (not quiet && result == 0) }
{
  if quiet then run + 1 else 0
}

-- Python's max((size, end), (run, end')): the longer run, and of equal ones the later.
export pure func longer(best: Run, run: int, end: int) -> Run
  requires { run >= 0 && best.size >= 0 }
  ensures { result.size >= best.size
    && ((result.size == best.size && result.end == best.end) || (result.size == run && result.end == end)) }
{
  if run > best.size || (run == best.size && end > best.end) then { size: run, end: end } else best
}

-- The frame in the middle of a run that ends before frame `end`.
export pure func middle(run: Run) -> int
  requires { run.size >= 1 && run.end >= run.size }
  ensures { result <= run.end && result > run.end - run.size }
{
  run.end - run.size / 2
}

-- A window clipped to the frames there are.
export pure func clip(i: int, frames: int) -> int
  requires { frames >= 0 }
  ensures { result >= 0 && result <= frames }
{
  if i < 0 then 0 else if i > frames then frames else i
}

-- Whether a cut at frame f keeps the line before it non-empty.
export pure func after(f: int, previous: int) -> bool
  ensures { result == (f * hop() > previous) }
{
  f * hop() > previous
}

pure func energyIn(xs: Array[float], i: int, end: int, acc: float) -> float =
  if i >= end then acc else { let x = A.get(xs, i); energyIn(xs, i + 1, end, acc + x * x) }

-- Frame k's level, as above.
export pure func frameLevel(xs: Array[float], k: int) -> float
  ensures { result >= 0.0 }
{
  let n = A.length(xs);
  let h = hop();
  sqrt(energyIn(xs, clip(k * h - h / 2, n), clip(k * h + h / 2, n), 0.0) / intToFloat(h))
}

pure func levelsFrom(xs: Array[float], k: int, acc: [float]) -> [float] =
  if k < 0 then acc else levelsFrom(xs, k - 1, frameLevel(xs, k) :: acc)

-- Every frame's level: ceil(samples / hop) frames.
export pure func frameLevels(xs: Array[float]) -> Array[float]
  ensures { A.length(result) == (A.length(xs) + hop() - 1) / hop() }
{
  A.fromList(levelsFrom(xs, (A.length(xs) + hop() - 1) / hop() - 1, []))
}

pure func quietest(levels: Array[float], i: int, hi: int, best: int) -> int =
  if i >= hi then best
  else quietest(levels, i + 1, hi, if A.get(levels, i) < A.get(levels, best) then i else best)

pure func longestQuiet(levels: Array[float], floor: float, i: int, hi: int, run: int, best: Run) -> Run =
  if i >= hi then best
  else {
    let r = extend(run, A.get(levels, i) < floor);
    longestQuiet(levels, floor, i + 1, hi, r, longer(best, r, i + 1))
  }

-- The frame to cut at, from lo to hi inclusive: the middle of a one-frame run that ends at hi
-- is hi itself.
export pure func cutFrame(levels: Array[float], floor: float, lo: int, hi: int) -> int
  requires { lo >= 0 && lo <= hi && hi <= A.length(levels) }
  ensures { result >= lo && result <= hi }
{
  let best = longestQuiet(levels, floor, lo, hi, 0, { size: 0, end: lo });
  if best.size >= 1 then middle(best) else quietest(levels, lo + 1, hi, lo)
}

pure func fmin(x: float, y: float) -> float = if y < x then y else x
pure func fmax(x: float, y: float) -> float = if y > x then y else x

pure func cutsFrom(levels: Array[float], floor: float, spans: [Span], previous: int, acc: [int]) -> Option[[int]] =
  match spans {
    this :: next :: rest => {
      let frames = A.length(levels);
      let lo = floatToInt((fmin(this.last, next.first) - 0.15) * 100.0);
      let hi = floatToInt((fmax(this.last, next.first) + 0.15) * 100.0);
      if not after(lo, previous) || lo >= frames then None
      else {
        let at = cutFrame(levels, floor, lo, clip(hi, frames)) * hop();
        cutsFrom(levels, floor, next :: rest, at, at :: acc)
      }
    },
    _ => Some(reverse(acc))
  }

-- Whether each number is smaller than the next.
pure func increasing(xs: [int]) -> bool =
  match xs { a :: b :: rest => a < b && increasing(b :: rest), _ => true }

-- Where each line starts and the take ends, in samples: [0, cut 1, ..., cut n-1, length].
-- None if some cut would leave a line empty: two lines' windows overlap, or the last cut
-- reaches the end of the take. None for no lines or an empty take.
export pure func bounds(xs: Array[float], spans: [Span]) -> Option[[int]]
  ensures { match result {
    Some(cs) => length(cs) == length(spans) + 1 && increasing(cs)
      && _list_head(cs) == 0 && _list_nth(cs, length(cs) - 1) == A.length(xs),
    None => true
  } }
{
  if A.length(xs) == 0 || length(spans) == 0 then None else boundsOf(xs, frameLevels(xs), spans)
}

pure func boundsOf(xs: Array[float], levels: Array[float], spans: [Span]) -> Option[[int]] {
  let floor = 0.05 * A.get(levels, A.argmax(levels));
  match cutsFrom(levels, floor, spans, 0, []) {
    Some(cuts) => { let cs = 0 :: cuts ++ [A.length(xs)]; if increasing(cs) then Some(cs) else None },
    None => None
  }
}
