-- sunholo/explainer/narrate — a take voiced through std/ai.callSpeech, and a take cut into
-- its lines' clips.
--
-- Voicing is the one effect (AI). Cutting is pure: the caller supplies the take's PCM (s16le,
-- mono, 24 kHz, as callSpeech returns it) and the words speech-to-text heard in it, with times;
-- word timings are not computed here (the explainer films use faster-whisper).

module sunholo/explainer/narrate

import std/ai (callSpeech, AIError)
import std/audio (pcm16ToFloats)
import std/bytes (length)
import std/json (encode, jo, kv, js)
import std/list (length as count, reverse)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import ./align (Heard, Span, lineSpans)
import ./cut (bounds)
import ./level (levelClip)

-- Attempts per take: an error the provider marks retryable is tried again.
export pure func attempts() -> int = 3

-- The options callSpeech takes: the TTS model and the language the voice speaks. Name the
-- model: gemini-2.5-pro-tts and gemini-2.5-flash-tts work on Vertex; AILANG's default
-- (gemini-2.5-flash-preview-tts) answered "Internal error" there on 2026-10-26.
export pure func speechOptions(model: string, language: string) -> string =
  encode(jo([kv("model", js(model)), kv("language_code", js(language))]))

-- Voice a text, trying again while the provider says the error is retryable.
export func speak(text: string, voice: string, style: string, options: string, tries: int) -> Result[bytes, AIError] ! {AI} =
  match callSpeech(text, voice, style, options) {
    Ok(pcm) => Ok(pcm),
    Err(e) => if e.retryable && tries > 1 then speak(text, voice, style, options, tries - 1) else Err(e)
  }

pure func clipsFrom(take: bytes, cuts: [int], acc: [bytes], k: int) -> Result[[bytes], string] =
  match cuts {
    from :: to :: rest => match levelClip(take, from, to - from) {
      Some(wav) => clipsFrom(take, to :: rest, wav :: acc, k + 1),
      None => Err("line ${show(k + 1)} is silent between samples ${show(from)} and ${show(to)}")
    },
    _ => Ok(reverse(acc))
  }

-- A take cut into one levelled WAV clip per line, in order. Err names what could not be
-- placed: a line none of whose words were heard, windows that overlap, or a silent line.
export pure func cutTake(take: bytes, heard: [Heard], lines: [string]) -> Result[[bytes], string] =
  match lineSpans(lines, heard) {
    None => Err("some line has no word that was heard; listen to the take"),
    Some(spans) => match pcm16ToFloats(take, 0, length(take) / 2, 1) {
      Err(msg) => Err("take: ${msg}"),
      Ok(xs) => match bounds(xs, spans) {
        None => Err("two lines' cut windows overlap"),
        Some(cuts) => clipsFrom(take, cuts, [], 0)
      }
    }
  }
