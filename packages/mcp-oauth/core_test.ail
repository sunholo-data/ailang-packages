-- Tests for sunholo/mcp_oauth/core. Names are referenced by the sprint
-- plan's acceptance criteria (m-mcp-oauth-package-sprint-plan.md P1).

module sunholo/mcp_oauth/core_test

import ./core (authResponseUrl, stateCharsOk, stateMaxLen, formGet, formUnescape, s256, pkceOk, verifierOk, verifierLengthOk, challengeMethodOk,
  redirectAllowed, loopbackRedirectOk, redirectOk, stripLoopbackPort, cimdUrlOk,
  httpsHost, codeExpiresAt, isExpired, asMetadata,
  ClientConfig, defaultClientConfig, asMetadataFor, clientKind, authMethodOk, cimdAuthMethodsOk, advertisedAuthMethods,
  refreshPolicyOk, stableIdleExpiresAt, stableRefreshLive, stableAbsoluteSec)
import std/string (repeat, contains)

-- RFC 7636 Appendix B
pure func rfcVerifier() -> string = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
pure func rfcChallenge() -> string = "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"

-- ---------------- PKCE (T1) ----------------
test "pkce rfc7636 vector" { pkceOk(rfcVerifier(), rfcChallenge()) }
test "pkce rejects wrong verifier" { pkceOk(repeat("a", 43), rfcChallenge()) == false }
test "pkce s256 matches appendix b" { s256(rfcVerifier()) == rfcChallenge() }
test "verifier too short rejected" { verifierLengthOk(repeat("a", 42)) == false }
test "verifier min and max length accepted" { verifierLengthOk(repeat("a", 43)) && verifierLengthOk(repeat("a", 128)) }
test "verifier too long rejected" { verifierLengthOk(repeat("a", 129)) == false }
test "verifier bad charset rejected" { verifierOk("${repeat("a", 43)}+") == false && verifierOk("${repeat("a", 43)} ") == false }
test "verifier unreserved charset accepted" { verifierOk("abcXYZ019-._~${repeat("q", 30)}") }
test "plain pkce method refused" { challengeMethodOk("plain") == false && challengeMethodOk("S256") }

-- ---------------- Redirects (T4) ----------------
pure func regs() -> [string] = ["https://claude.ai/api/mcp/auth_callback", "http://localhost/callback"]
test "exact redirect accepted" { redirectOk("https://claude.ai/api/mcp/auth_callback", regs()) }
test "prefix redirect rejected" { redirectOk("https://claude.ai/api/mcp/auth_callback/evil", regs()) == false }
test "suffix host redirect rejected" { redirectOk("https://claude.ai.evil.com/api/mcp/auth_callback", regs()) == false }
test "loopback any port accepted" { loopbackRedirectOk("http://localhost:53682/callback", regs()) }
test "loopback 127 any port needs registration" { loopbackRedirectOk("http://127.0.0.1:9000/callback", regs()) == false }
test "loopback path must match" { loopbackRedirectOk("http://localhost:53682/other", regs()) == false }
test "loopback lookalike host rejected" { stripLoopbackPort("http://localhost.evil.com/callback") == "" }
test "loopback non-numeric port rejected" { stripLoopbackPort("http://localhost:80a/callback") == "" }
test "loopback https not loopback" { stripLoopbackPort("https://localhost:1/callback") == "" }

-- ---------------- CIMD URL (T5) ----------------
test "cimd accepts https client document" { cimdUrlOk("https://claude.ai/oauth/claude-code-client-metadata") }
test "cimd rejects http" { cimdUrlOk("http://claude.ai/client.json") == false }
test "cimd rejects ipv4" { cimdUrlOk("https://169.254.169.254/latest") == false }
test "cimd rejects ipv6" { cimdUrlOk("https://[::1]/client.json") == false }
test "cimd rejects localhost" { cimdUrlOk("https://localhost/client.json") == false }
test "cimd rejects .internal" { cimdUrlOk("https://svc.internal/client.json") == false }
test "cimd rejects metadata.google.internal" { cimdUrlOk("https://metadata.google.internal/computeMetadata/v1/") == false }
test "cimd rejects userinfo" { cimdUrlOk("https://user@claude.ai/client.json") == false }
test "cimd rejects fragment" { cimdUrlOk("https://claude.ai/client.json#x") == false }
test "cimd host parsing strips port" { httpsHost("https://example.com:8443/x") == "example.com" }

-- ---------------- Code lifetime (T2/T8) ----------------
test "code expires after 60 seconds" { codeExpiresAt(1000) == 1060 }
test "code valid before expiry" { isExpired(1059, 1060) == false }
test "code expired at expiry" { isExpired(1060, 1060) }

-- ---------------- Metadata ----------------
test "metadata advertises s256 cimd and no registration" {
  let m = asMetadata("https://auth.example.com");
  contains(m, "\"S256\"") && contains(m, "client_id_metadata_document_supported\":true")
    && contains(m, "registration_endpoint") == false && contains(m, "\"plain\"") == false
}

-- ---------------- Form decoding (token endpoint) ----------------
test "form decodes plus and percent" { formUnescape("a+b%20c%2Fd") == "a b c/d" }
test "form decodes utf8" { formUnescape("caf%C3%A9") == "café" }
test "form bad percent kept" { formUnescape("100%zz") == "100%zz" }
test "form get finds key" {
  formGet("grant_type=authorization_code&code=abc123&redirect_uri=https%3A%2F%2Fclaude.ai%2Fapi%2Fmcp%2Fauth_callback", "redirect_uri")
    == "https://claude.ai/api/mcp/auth_callback"
}
test "form get missing key empty" { formGet("a=1&b=2", "c") == "" }
test "form get first match wins" { formGet("code=first&code=second", "code") == "first" }

test "auth response carries iss (rfc9207)" {
  authResponseUrl("https://claude.ai/api/mcp/auth_callback", "c0de", "st", "https://docparse.ailang.sunholo.com")
    == "https://claude.ai/api/mcp/auth_callback?code=c0de&state=st&iss=https%3A%2F%2Fdocparse.ailang.sunholo.com"
}
test "auth response appends to an existing query" {
  authResponseUrl("http://127.0.0.1:5000/cb?x=1", "c", "s", "https://a.example")
    == "http://127.0.0.1:5000/cb?x=1&code=c&state=s&iss=https%3A%2F%2Fa.example"
}
test "auth response percent-encodes state" {
  authResponseUrl("https://vertexaisearch.cloud.google.com/oauth-redirect", "c", "eyJh+b/c=&x#y", "https://a.example")
    == "https://vertexaisearch.cloud.google.com/oauth-redirect?code=c&state=eyJh%2Bb%2Fc%3D%26x%23y&iss=https%3A%2F%2Fa.example"
}
test "state: gemini enterprise base64 with padding accepted" { stateCharsOk("${repeat("A", 766)}==") }
test "state: every vschar accepted" { stateCharsOk(" !\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~") }
test "state: max length inclusive" { stateCharsOk(repeat("a", stateMaxLen())) && stateCharsOk(repeat("a", stateMaxLen() + 1)) == false }
test "state: control characters refused" { stateCharsOk("a\nb") == false && stateCharsOk("a\tb") == false }
test "state: non-ascii refused" { stateCharsOk("caf\u00e9") == false }
test "state: empty accepted" { stateCharsOk("") }
test "metadata advertises iss support" {
  contains(asMetadata("https://a.example"), "\"authorization_response_iss_parameter_supported\":true")
}


-- ---------------- 0.2: metadata (M1e) ----------------
-- Byte for byte what 0.1.2's asMetadata returned for this issuer (captured
-- from the 0.1.2 release, ailang-packages 1c70be9).
pure func golden012() -> string = "{\"issuer\":\"https://auth.example.com\",\"authorization_endpoint\":\"https://auth.example.com/oauth/authorize\",\"token_endpoint\":\"https://auth.example.com/oauth/token\",\"response_types_supported\":[\"code\"],\"grant_types_supported\":[\"authorization_code\",\"refresh_token\"],\"code_challenge_methods_supported\":[\"S256\"],\"token_endpoint_auth_methods_supported\":[\"none\"],\"client_id_metadata_document_supported\":true,\"authorization_response_iss_parameter_supported\":true}"
test "metadata golden: asMetadata is byte-identical to 0.1.2" { asMetadata("https://auth.example.com") == golden012() }
test "metadata golden: default config is 0.1.2" { asMetadataFor("https://auth.example.com", defaultClientConfig()) == golden012() }
pure func cfgOn() -> ClientConfig = { defaultClientConfig() | confidential: true, dcr: true, revocation: true }
test "metadata advertises registration only with dcr" {
  contains(asMetadataFor("https://a.example", { defaultClientConfig() | dcr: true }), "\"registration_endpoint\":\"https://a.example/oauth/register\"")
    && contains(asMetadataFor("https://a.example", { defaultClientConfig() | confidential: true, revocation: true }), "registration_endpoint") == false
}
test "metadata advertises revocation only when on" {
  contains(asMetadataFor("https://a.example", { defaultClientConfig() | revocation: true }), "\"revocation_endpoint\":\"https://a.example/oauth/revoke\"")
    && contains(asMetadataFor("https://a.example", { defaultClientConfig() | dcr: true }), "revocation_endpoint") == false
}
test "metadata secret methods only with confidential, none first" {
  contains(asMetadataFor("https://a.example", cfgOn()), "\"token_endpoint_auth_methods_supported\":[\"none\",\"client_secret_basic\",\"client_secret_post\"]")
    && contains(asMetadataFor("https://a.example", cfgOn()), "client_id_metadata_document_supported\":true")
    && contains(asMetadataFor("https://a.example", cfgOn()), "private_key_jwt") == false
}

-- ---------------- 0.2: client kinds (T14) ----------------
test "client kind registered id" { clientKind("mco_0123456789abcdef0123456789abcdef") == "registered" }
test "client kind cimd url" { clientKind("https://claude.ai/oauth/claude-code-client-metadata") == "cimd" }
test "client kind rejects near misses" {
  clientKind("mco_0123456789abcdef0123456789abcde") == "unknown"
    && clientKind("mco_0123456789abcdef0123456789abcdef0") == "unknown"
    && clientKind("mco_0123456789ABCDEF0123456789abcdef") == "unknown"
    && clientKind("mco_https://evil.example/aaaaaaaaaaaa") == "unknown"
    && clientKind("mco_0123456789abcdef0123456789abcd/x") == "unknown"
    && clientKind("http://claude.ai/c") == "unknown" && clientKind("client-a") == "unknown" && clientKind("") == "unknown"
}

-- ---------------- 0.2: auth methods (M1d) ----------------
test "auth method intersection" {
  authMethodOk("none", advertisedAuthMethods(defaultClientConfig()))
    && authMethodOk("client_secret_basic", advertisedAuthMethods(defaultClientConfig())) == false
    && authMethodOk("client_secret_post", advertisedAuthMethods(cfgOn()))
    && authMethodOk("private_key_jwt", advertisedAuthMethods(cfgOn())) == false
}
test "cimd plural must contain none" {
  cimdAuthMethodsOk(["none", "private_key_jwt"], true) && cimdAuthMethodsOk([], false)
    && cimdAuthMethodsOk(["private_key_jwt"], true) == false && cimdAuthMethodsOk([], true) == false
}

-- ---------------- 0.2: refresh policy (M1c, D3) ----------------
test "stable refresh needs a secret method" {
  refreshPolicyOk("stable", "client_secret_basic") && refreshPolicyOk("stable", "client_secret_post")
    && refreshPolicyOk("stable", "none") == false && refreshPolicyOk("rotate", "none") && refreshPolicyOk("sticky", "client_secret_basic") == false
}
test "stable idle deadline never passes the absolute one" {
  stableIdleExpiresAt(1000, 1000 + stableAbsoluteSec()) == 1000 + 2592000 && stableIdleExpiresAt(5000, 6000) == 6000
}
test "stable refresh dead at either deadline" {
  stableRefreshLive(10, 20, 30) && stableRefreshLive(20, 20, 30) == false && stableRefreshLive(30, 40, 30) == false
}

-- ---------------- 0.2: the one host parser (core.httpsHost) ----------------
-- The host ends at the first "/", "?", "#" or "\\" and the port at ":".
test "host ends at the query" {
  httpsHost("https://localhost?.example.com/c") == "localhost" && cimdUrlOk("https://localhost?.example.com/c") == false
    && cimdUrlOk("https://localhost?.claude.ai/oauth/client.json") == false
}
test "host ends at the fragment" { httpsHost("https://localhost#.example.com") == "localhost" }
test "host ends at a backslash" {
  httpsHost("https://localhost\\.example.com/c") == "localhost" && cimdUrlOk("https://localhost\\.example.com/c") == false
    && cimdUrlOk("https://claude.ai\\@metadata.google.internal/c") == false
}
test "host refuses userinfo" {
  httpsHost("https://u@claude.ai/c") == "" && httpsHost("https://claude.ai:443@localhost/c") == ""
    && cimdUrlOk("https://claude.ai:443@localhost/c") == false
}
test "host is lowercased" {
  httpsHost("https://Claude.AI/c") == "claude.ai" && cimdUrlOk("https://LOCALHOST/c") == false
    && cimdUrlOk("https://Metadata.Google.Internal/computeMetadata/v1/") == false && cimdUrlOk("https://SVC.INTERNAL/c") == false
}
test "host refuses a trailing dot" {
  httpsHost("https://localhost./c") == "" && cimdUrlOk("https://localhost./c") == false
    && cimdUrlOk("https://metadata.google.internal./c") == false && cimdUrlOk("https://claude.ai./c") == false
}
test "host refuses ipv6 brackets" {
  httpsHost("https://[::1]/c") == "" && cimdUrlOk("https://[::ffff:127.0.0.1]/c") == false && cimdUrlOk("https://[fe80::1%25en0]/c") == false
}
test "host refuses percent-encoding" {
  httpsHost("https://local%68ost/c") == "" && cimdUrlOk("https://local%68ost/c") == false && cimdUrlOk("https://claude.ai%2F@evil.example/c") == false
}
test "host refuses numeric addresses" {
  cimdUrlOk("https://127.1/c") == false && cimdUrlOk("https://2130706433/c") == false
    && cimdUrlOk("https://0x7f.0.0.1/c") == false && cimdUrlOk("https://10.0.0.1:8443/c") == false
}
test "host refuses single labels and empty labels" {
  cimdUrlOk("https://intranet/c") == false && httpsHost("https://claude..ai/c") == "" && httpsHost("https://.claude.ai/c") == ""
    && httpsHost("https://-claude.ai/c") == "" && httpsHost("https://claude ai/c") == ""
}
test "host port must be digits" {
  httpsHost("https://claude.ai:8443/c") == "claude.ai" && httpsHost("https://claude.ai:abc/c") == ""
    && httpsHost("https://claude.ai:/c") == "" && httpsHost("http://claude.ai/c") == ""
}
test "real client metadata urls still accepted" {
  cimdUrlOk("https://claude.ai/oauth/claude-code-client-metadata") && cimdUrlOk("https://chatgpt.com/oauth/client.json")
    && cimdUrlOk("https://ailang.sunholo.com/mcp-check/client-metadata.json") && cimdUrlOk("https://Example.com:8443/c.json")
}
test "loopback refuses query fragment backslash and userinfo tricks" {
  stripLoopbackPort("http://localhost?.evil.example/cb") == "" && stripLoopbackPort("http://localhost#x") == ""
    && stripLoopbackPort("http://127.0.0.1@evil.example/cb") == "" && stripLoopbackPort("http://localhost\\@evil.example/cb") == ""
    && stripLoopbackPort("http://localhost:80@evil.example/cb") == "" && stripLoopbackPort("http://localhost:8080?x") == ""
}
