-- Integration fixture for sunholo/mcp_oauth: a listed MCP service with one
-- gated tool, the four OAuth endpoints, and SharedMem-backed hooks.
-- Pre-registered client (the CIMD fetch waits on ailang Net[scope=public]).
--
--   OAUTH_ISSUER=http://localhost:PORT AILANG_TRACE_VALUES=off \
--   ailang serve-api --mcp-http --port PORT --oauth-issuer http://localhost:PORT \
--     --caps IO,SharedMem,Rand,Clock,Env,FS,Net .
module sunholo/mcp_oauth_example/svc

import std/io (println)
import std/clock (now)
import std/env (getEnvOr)
import std/crypto (sha256Hex)
import std/rand (uuid4)
import std/string (replace)
import std/sharedmem (get as smGet, put as smPut, delete as smDelete, has_key)
import std/bytes (fromString, toString)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/json (Json, decode, getString, js)
import pkg/sunholo/mcp_oauth/core (asMetadata, formGet)
import pkg/sunholo/mcp_oauth/flow (Hooks, beginAuthorize, completeLogin, exchangeCode, refreshTokens, oauthError)

-- ---------------- hooks ----------------
func hAuth(idToken: string) -> Result[string, string] ! {IO, FS, Env, Net, Clock, SharedMem} =
  if idToken == "demo-user-token" then Ok("demo-user") else Err("unknown user")

-- Tokens are random, stored by digest; the verifier accepts exactly these.
func hMint(account: string, clientId: string) -> Result[string, string] ! {IO, FS, Env, Net, Clock, SharedMem, Rand[mode=crypto]} {
  let t = "demo_${replace(uuid4(), "-", "")}";
  smPut("valid:${sha256Hex(t)}", fromString(account));
  Ok(t)
}
func hPut(k: string, v: string, exp: int) -> bool ! {IO, FS, Env, Net, Clock, SharedMem} { smPut("s:${k}", fromString(v)); true }
func hGet(k: string) -> Option[string] ! {IO, FS, Env, Net, Clock, SharedMem} =
  match smGet("s:${k}") { Some(b) => Some(toString(b)), None => None }
func hDel(k: string) -> bool ! {IO, FS, Env, Net, Clock, SharedMem} { smDelete("s:${k}"); true }
func hRevoke(d: string) -> bool ! {IO, FS, Env, Net, Clock, SharedMem} { smDelete("valid:${d}"); true }

func hooks() -> Hooks = { authenticate: hAuth, mint: hMint, put: hPut, get: hGet, del: hDel, revoke: hRevoke }

func issuer() -> string ! {Env} = getEnvOr("OAUTH_ISSUER", "http://localhost:8080")
func nowSec() -> int ! {Clock} = now() / 1000

pure func client() -> string = "https://claude.ai/oauth/claude-code-client-metadata"
pure func registered() -> [string] = ["https://claude.ai/api/mcp/auth_callback", "http://localhost/callback"]

pure func q(req: Json, k: string) -> string = match getString(req, k) { Some(s) => s, None => "" }

-- ---------------- the gated MCP tool + verifier ----------------
@mcp_token_verifier
export func verifyToken(token: string) -> bool ! {SharedMem} = has_key("valid:${sha256Hex(token)}")

-- Say who is signed in.
@mcp_title("Who am I")
@mcp_hints("readOnly")
@mcp_auth("oauth2")
export func whoami() -> string = "signed in"

-- ---------------- OAuth endpoints ----------------
@route("GET", "/.well-known/oauth-authorization-server")
@nowrap
@nomcp
export func asMeta() -> string ! {Env} = asMetadata(issuer())

pure func redirect(loc: string) -> {_body: string, _status: int, _headers: {location: string}} =
  {_body: "", _status: 302, _headers: {location: loc}}
pure func badRequest(body: string) -> {_body: string, _status: int, _headers: {location: string}} =
  {_body: body, _status: 400, _headers: {location: ""}}

@route("GET", "/oauth/authorize")
@raw
@nomcp
export func authorize(req: {body: string, headers: Json, method: string, path: string, query: Json})
  -> {_body: string, _status: int, _headers: {location: string}} ! {IO, FS, Env, Net, Clock, SharedMem, Rand[mode=crypto], Declassify} {
  let cid = q(req.query, "client_id");
  if cid != client() then badRequest(oauthError("invalid_client", "unknown client_id"))
  else match beginAuthorize(hooks(), "${issuer()}/login", cid, registered(), q(req.query, "redirect_uri"),
                            q(req.query, "response_type"), q(req.query, "code_challenge"),
                            q(req.query, "code_challenge_method"), q(req.query, "state"), nowSec()) {
    Ok(loc) => redirect(loc),
    Err(e) => badRequest(e)
  }
}

@route("POST", "/oauth/login/complete")
@raw
@nomcp
export func loginComplete(req: {body: string, headers: Json, method: string, path: string, query: Json})
  -> {_body: string, _status: int, _headers: {location: string}} ! {IO, FS, Env, Net, Clock, SharedMem, Rand[mode=crypto], Declassify} =
  match completeLogin(hooks(), formGet(req.body, "handle"), formGet(req.body, "id_token"), nowSec()) {
    Ok(loc) => redirect(loc),
    Err(e) => badRequest(e)
  }

pure func errJson(e: string) -> Json = match decode(e) { Ok(j) => j, Err(_) => js(e) }

@route("POST", "/oauth/token")
@raw
@nowrap
@nomcp
export func token(req: {body: string, headers: Json, method: string, path: string, query: Json})
  -> Result[string, Json] ! {IO, FS, Env, Net, Clock, SharedMem, Rand[mode=crypto], Declassify} {
  let b = req.body;
  let grant = formGet(b, "grant_type");
  let res =
    if grant == "authorization_code" then
      exchangeCode(hooks(), formGet(b, "code"), formGet(b, "code_verifier"), formGet(b, "client_id"), formGet(b, "redirect_uri"), nowSec())
    else if grant == "refresh_token" then refreshTokens(hooks(), formGet(b, "refresh_token"), formGet(b, "client_id"), nowSec())
    else Err(oauthError("unsupported_grant_type", "grant_type must be authorization_code or refresh_token"));
  match res { Ok(body) => Ok(body), Err(e) => Err(errJson(e)) }
}
