-- sunholo/mcp_oauth/core: the pure security predicates of the OAuth 2.1
-- authorization server (design: ailang design_docs/planned/v0_52_0/
-- m-mcp-oauth-package.md, threats T1 T4 T5 T2/T8).
--
-- Everything here is pure: no effects, so `ailang verify` can prove the
-- contracts with Z3 and the flow module can rely on them. Secrets never
-- appear here; comparisons that involve secrets use constantTimeEqual.
--
-- Usage:
--   import pkg/sunholo/mcp_oauth/core (pkceOk, verifierOk, redirectAllowed,
--     loopbackRedirectOk, cimdUrlOk, codeExpiresAt, isExpired, asMetadata,
--     ClientConfig, defaultClientConfig, clientKind, authMethodOk, asMetadataFor)

module sunholo/mcp_oauth/core

import std/crypto (sha256Hex, constantTimeEqual)
import std/bytes (fromInts, toInts, fromString, toString, toBase64URL)
import std/string (length, substring, find, startsWith, endsWith, contains as strContains, chars, toLower, split)
import std/list (contains, any, map)
import std/json (Json, encode, jo, kv, js, ja, jb)
import std/net (urlEncode)

-- ============================================================
-- PKCE (RFC 7636), S256 only (T1)
-- ============================================================

pure func hexVal(c: string) -> int = find("0123456789abcdef", c)

-- Decode lowercase hex (sha256Hex output) to byte values.
pure func hexInts(h: string, i: int, n: int) -> [int] =
  if i >= n then []
  else (hexVal(substring(h, i, i + 1)) * 16 + hexVal(substring(h, i + 1, i + 2))) :: hexInts(h, i + 2, n)

-- BASE64URL(SHA256(ASCII(code_verifier))) with no padding.
export pure func s256(verifier: string) -> string
  tests [("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk", "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM")]
{
  let h = sha256Hex(verifier);
  toBase64URL(fromInts(hexInts(h, 0, length(h))))
}

-- RFC 7636 §4.1: 43..128 characters.
export pure func verifierLengthOk(verifier: string) -> bool
  ensures { result == (length(verifier) >= 43 && length(verifier) <= 128) }
{
  length(verifier) >= 43 && length(verifier) <= 128
}

-- unreserved = ALPHA / DIGIT / "-" / "." / "_" / "~"
pure func unreserved(c: string) -> bool =
  find("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~", c) >= 0

export pure func verifierCharsOk(verifier: string) -> bool =
  not any(\c. not unreserved(c), chars(verifier))

export pure func verifierOk(verifier: string) -> bool =
  verifierLengthOk(verifier) && verifierCharsOk(verifier)

-- The only accepted method. "plain" (or anything else) is refused.
export pure func challengeMethodOk(method: string) -> bool
  ensures { result == (method == "S256") }
{
  method == "S256"
}

-- Constant-time: the stored challenge is derived from a secret verifier.
export pure func pkceOk(verifier: string, storedChallenge: string) -> bool =
  verifierOk(verifier) && constantTimeEqual(s256(verifier), storedChallenge)

-- ============================================================
-- Redirect URIs (T4)
-- ============================================================

-- Exact match against the client's registered list. No prefix, no
-- substring, no normalisation: the property Z3 proves is exactly this.
export pure func redirectAllowed(presented: string, registered: [string]) -> bool
  ensures { result == contains(registered, presented) }
{
  contains(registered, presented)
}

-- RFC 8252 §7.3 loopback: http://127.0.0.1 or http://localhost, ANY port,
-- the path must equal the registered loopback URI's path exactly.
-- Returns the presented URI with its port removed, or "" if it is not a
-- loopback http URI.
export pure func stripLoopbackPort(uri: string) -> string {
  let host =
    if startsWith(uri, "http://127.0.0.1") then "http://127.0.0.1"
    else if startsWith(uri, "http://localhost") then "http://localhost"
    else "";
  if host == "" then ""
  else {
    let rest = substring(uri, length(host), length(uri));
    if startsWith(rest, ":") then {
      let slash = find(rest, "/");
      let port = if slash < 0 then substring(rest, 1, length(rest)) else substring(rest, 1, slash);
      let path = if slash < 0 then "" else substring(rest, slash, length(rest));
      if length(port) == 0 || any(\c. find("0123456789", c) < 0, chars(port)) then ""
      else "${host}${path}"
    }
    else if rest == "" || startsWith(rest, "/") then "${host}${rest}"
    else ""   -- e.g. http://localhost.evil.com
  }
}

export pure func loopbackRedirectOk(presented: string, registered: [string]) -> bool {
  let canon = stripLoopbackPort(presented);
  canon != "" && contains(registered, canon)
}

export pure func redirectOk(presented: string, registered: [string]) -> bool =
  redirectAllowed(presented, registered) || loopbackRedirectOk(presented, registered)

-- ============================================================
-- CIMD client_id URL (T5, string layer; connect-time layer is S0)
-- ============================================================

-- host part of an https:// URL ("" when malformed).
export pure func httpsHost(url: string) -> string {
  if startsWith(url, "https://") == false then ""
  else {
    let rest = substring(url, 8, length(url));
    let slash = find(rest, "/");
    let authority = if slash < 0 then rest else substring(rest, 0, slash);
    let colon = find(authority, ":");
    if colon < 0 then authority else substring(authority, 0, colon)
  }
}

pure func isIpLiteral(host: string) -> bool =
  startsWith(host, "[") || not any(\c. find("0123456789.", c) < 0, chars(host))

pure func isInternalHost(host: string) -> bool {
  let h = toLower(host);
  h == "localhost" || endsWith(h, ".localhost") || endsWith(h, ".internal")
    || endsWith(h, ".local") || startsWith(h, "metadata")
}

-- The https-only invariant, proved by Z3. Kept separate from the shape
-- checks below because those use higher-order helpers Z3 cannot encode;
-- the shape checks are covered by the "cimd rejects ..." tests instead.
export pure func cimdHttpsGate(url: string, shapeOk: bool) -> bool
  ensures { result == (startsWith(url, "https://") && shapeOk) }
{
  startsWith(url, "https://") && shapeOk
}

pure func cimdShapeOk(url: string) -> bool {
  let host = httpsHost(url);
  host != ""
    && strContains(url, "@") == false
    && strContains(url, "#") == false
    && isIpLiteral(host) == false
    && isInternalHost(host) == false
}

-- A client_id document URL we are willing to fetch.
export pure func cimdUrlOk(url: string) -> bool = cimdHttpsGate(url, cimdShapeOk(url))

-- ============================================================
-- Code lifetime (T2/T8)
-- ============================================================

export pure func codeTtlSeconds() -> int = 60

export pure func codeExpiresAt(nowSec: int) -> int
  ensures { result == nowSec + 60 }
{
  nowSec + 60
}

export pure func isExpired(nowSec: int, expiresAt: int) -> bool
  ensures { result == (nowSec >= expiresAt) }
{
  nowSec >= expiresAt
}

-- ============================================================
-- Client models (0.2.0, ailang design_docs/planned/v0_57_2/
-- m-mcp-oauth-client-models.md §M1)
-- ============================================================

-- What a deployment accepts. Build it from defaultClientConfig() with a record
-- update ({defaultClientConfig() | confidential: true}), never as a full
-- literal: a later minor release may add a field, and an update keeps compiling.
--   confidential         accept operator-created mco_ clients, and advertise
--                        client_secret_basic / client_secret_post (M1a)
--   dcr                  serve RFC 7591 registration (M1b)
--   dcrRedirectHosts     [] = any https host; else exact host or ".suffix"
--   dcrPerCallerPerHour  registrations per caller per hour
--   dcrGlobalPerDay      registrations per day, all callers
--   revocation           advertise and serve RFC 7009 /oauth/revoke (M1c)
export type ClientConfig = {
  confidential: bool,
  dcr: bool,
  dcrRedirectHosts: [string],
  dcrPerCallerPerHour: int,
  dcrGlobalPerDay: int,
  revocation: bool
}

-- 0.1.2 behaviour: CIMD clients only, no DCR, no revocation endpoint.
export pure func defaultClientConfig() -> ClientConfig =
  { confidential: false, dcr: false, dcrRedirectHosts: [], dcrPerCallerPerHour: 10, dcrGlobalPerDay: 500, revocation: false }

-- One lowercase hex character at index i. Non-recursive and first-order, so
-- Z3 can reason about lowerHex32 (a chars/any version would be skipped).
pure func hexAt(s: string, i: int) -> bool = find("0123456789abcdef", substring(s, i, i + 1)) >= 0

pure func lowerHex32(s: string) -> bool =
  length(s) == 32
    && hexAt(s, 0) && hexAt(s, 1) && hexAt(s, 2) && hexAt(s, 3) && hexAt(s, 4) && hexAt(s, 5) && hexAt(s, 6) && hexAt(s, 7)
    && hexAt(s, 8) && hexAt(s, 9) && hexAt(s, 10) && hexAt(s, 11) && hexAt(s, 12) && hexAt(s, 13) && hexAt(s, 14) && hexAt(s, 15)
    && hexAt(s, 16) && hexAt(s, 17) && hexAt(s, 18) && hexAt(s, 19) && hexAt(s, 20) && hexAt(s, 21) && hexAt(s, 22) && hexAt(s, 23)
    && hexAt(s, 24) && hexAt(s, 25) && hexAt(s, 26) && hexAt(s, 27) && hexAt(s, 28) && hexAt(s, 29) && hexAt(s, 30) && hexAt(s, 31)

-- T14: the two client_id namespaces are disjoint, and Z3 proves it. A
-- registered id is "mco_" plus 32 lowercase hex characters and never contains
-- "://", so it is never fetched; a CIMD id starts with https://. Nothing that
-- starts with https:// is ever "registered", and nothing that starts with mco_
-- is ever "cimd". ("cimd" names the namespace; a CIMD id must still pass
-- cimdUrlOk wherever it is accepted, which cimd.fetchClient and the flow do.)
export pure func clientKind(id: string) -> string
  ensures {
    result == "cimd" || result == "registered" || result == "unknown",
    startsWith(id, "https://") == false || result != "registered",
    startsWith(id, "mco_") == false || result != "cimd",
    result != "registered" || (startsWith(id, "mco_") && length(id) == 36 && strContains(id, "://") == false),
    result != "cimd" || startsWith(id, "https://")
  }
{
  if startsWith(id, "mco_") && strContains(id, "://") == false && lowerHex32(substring(id, 4, length(id))) then "registered"
  else if startsWith(id, "https://") then "cimd"
  else "unknown"
}

-- Token-endpoint auth methods (M1d, D1). The intersection rule: a method is
-- usable only when we advertise it.
export pure func authMethodOk(method: string, advertised: [string]) -> bool
  ensures { result == contains(advertised, method) }
{
  contains(advertised, method)
}

-- A CIMD client always authenticates with "none" here. Its document's plural
-- token_endpoint_auth_methods_supported, when present, must contain "none";
-- the singular token_endpoint_auth_method is informational and never read.
export pure func cimdAuthMethodsOk(plural: [string], present: bool) -> bool
  ensures { result == (present == false || contains(plural, "none")) }
{
  present == false || authMethodOk("none", plural)
}

-- The methods this server advertises and accepts. "none" is always present
-- and first (Claude picks CIMD only when it sees it); private_key_jwt is never
-- advertised in 0.2.
export pure func advertisedAuthMethods(cfg: ClientConfig) -> [string]
  ensures { contains(result, "none"), contains(result, "private_key_jwt") == false }
{
  if cfg.confidential then ["none", "client_secret_basic", "client_secret_post"] else ["none"]
}

export pure func isSecretMethod(method: string) -> bool
  ensures { result == (method == "client_secret_basic" || method == "client_secret_post") }
{
  method == "client_secret_basic" || method == "client_secret_post"
}

-- Refresh policy (M1c, D3): "stable" only for a secret-holding client; every
-- other client rotates.
export pure func refreshPolicyOk(policy: string, method: string) -> bool
  ensures { result == (policy == "rotate" || (policy == "stable" && (method == "client_secret_basic" || method == "client_secret_post"))) }
{
  policy == "rotate" || (policy == "stable" && isSecretMethod(method))
}

export pure func stableIdleSec() -> int = 2592000       -- 30 days, sliding
export pure func stableAbsoluteSec() -> int = 15552000  -- 180 days from first issue

-- The next idle deadline of a stable refresh token: 30 days from now, never
-- past its absolute lifetime.
export pure func stableIdleExpiresAt(nowSec: int, absoluteExpiresAt: int) -> int
  ensures { result <= absoluteExpiresAt, result <= nowSec + 2592000 }
{
  if nowSec + 2592000 < absoluteExpiresAt then nowSec + 2592000 else absoluteExpiresAt
}

-- A stable refresh token is usable while neither deadline has passed.
export pure func stableRefreshLive(nowSec: int, idleExpiresAt: int, absoluteExpiresAt: int) -> bool
  ensures { result == (nowSec < idleExpiresAt && nowSec < absoluteExpiresAt) }
{
  isExpired(nowSec, idleExpiresAt) == false && isExpired(nowSec, absoluteExpiresAt) == false
}

-- ============================================================
-- RFC 8414 authorization-server metadata
-- ============================================================

-- The authorization response Location (RFC 6749 §4.1.2 + RFC 9207 §2):
-- code, state and the issuer identifier `iss`, so a client talking to more
-- than one authorization server can reject a response from the wrong one
-- (mix-up attacks). Appends with & when the redirect URI already has a query.
-- code is hex and state is checked to unreserved characters (stateOk), so
-- only iss needs percent-encoding.
export pure func authResponseUrl(redirectUri: string, code: string, state: string, issuer: string) -> string {
  let sep = if strContains(redirectUri, "?") then "&" else "?";
  "${redirectUri}${sep}code=${code}&state=${state}&iss=${urlEncode(issuer)}"
}

-- 0.1.2's document, unchanged: asMetadataFor with the default config, which
-- the "metadata golden" test pins byte for byte.
export pure func asMetadata(issuer: string) -> string = asMetadataFor(issuer, defaultClientConfig())

pure func methodsJson(cfg: ClientConfig) -> Json = ja(map(js, advertisedAuthMethods(cfg)))

-- The metadata for a configuration. Keys appear only when their feature is on:
-- registration_endpoint (cfg.dcr), revocation_endpoint (cfg.revocation), and
-- the secret methods (cfg.confidential). CIMD with "none" is always advertised,
-- so Claude keeps choosing CIMD and ChatGPT keeps preferring it.
export pure func asMetadataFor(issuer: string, cfg: ClientConfig) -> string =
  encode(jo([
    kv("issuer", js(issuer)),
    kv("authorization_endpoint", js("${issuer}/oauth/authorize")),
    kv("token_endpoint", js("${issuer}/oauth/token"))
  ] ++ (if cfg.dcr then [kv("registration_endpoint", js("${issuer}/oauth/register"))] else [])
    ++ (if cfg.revocation then [kv("revocation_endpoint", js("${issuer}/oauth/revoke")),
                                 kv("revocation_endpoint_auth_methods_supported", methodsJson(cfg))] else [])
    ++ [
    kv("response_types_supported", ja([js("code")])),
    kv("grant_types_supported", ja([js("authorization_code"), js("refresh_token")])),
    kv("code_challenge_methods_supported", ja([js("S256")])),
    kv("token_endpoint_auth_methods_supported", methodsJson(cfg)),
    kv("client_id_metadata_document_supported", jb(true)),
    kv("authorization_response_iss_parameter_supported", jb(true))
  ]))

-- ============================================================
-- application/x-www-form-urlencoded (token endpoint bodies)
-- ============================================================
-- std/net has urlEncodeForm but no decoder; both directory clients POST the
-- token request form-encoded. Works on bytes so %-encoded UTF-8 survives.

pure func hexDigit(b: int) -> int =
  if b >= 48 && b <= 57 then b - 48
  else if b >= 65 && b <= 70 then b - 55
  else if b >= 97 && b <= 102 then b - 87
  else 0 - 1

pure func pctDecodeBytes(bs: [int]) -> [int] =
  match bs {
    [] => [],
    [37, h1, h2, ...rest] =>
      if hexDigit(h1) >= 0 && hexDigit(h2) >= 0 then (hexDigit(h1) * 16 + hexDigit(h2)) :: pctDecodeBytes(rest)
      else 37 :: pctDecodeBytes([h1, h2] ++ rest),
    [43, ...rest] => 32 :: pctDecodeBytes(rest),
    [b, ...rest] => b :: pctDecodeBytes(rest)
  }

-- Decode one form-encoded component ('+' = space, %XX = byte).
export pure func formUnescape(s: string) -> string = toString(fromInts(pctDecodeBytes(toInts(fromString(s)))))

-- Value of `key` in a form-encoded body ("" when absent). First match wins.
export pure func formGet(body: string, key: string) -> string =
  formGetIn(split(body, "&"), key)

pure func formGetIn(pairs: [string], key: string) -> string =
  match pairs {
    [] => "",
    [p, ...rest] => {
      let eq = find(p, "=");
      let k = if eq < 0 then p else substring(p, 0, eq);
      if formUnescape(k) == key then (if eq < 0 then "" else formUnescape(substring(p, eq + 1, length(p))))
      else formGetIn(rest, key)
    }
  }
