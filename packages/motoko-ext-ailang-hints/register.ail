-- motoko-ext-ailang-hints: tier-1 conditional prompt-patch extension.
--
-- Injects AILANG-specific hints into motoko's system prompt ONLY when the
-- task signals AILANG-shaped work. Pairs with microRAG-style retrieval
-- extensions (when present) by pointing the model at search tools for
-- stdlib lookups instead of guessing symbol names.
--
-- Sibling of motoko-ext-decision-framework@0.1.1; uses the same
-- context-aware-extension pattern: pure substring check on ctx.task at
-- on_build_system_prompt time, gates the hints by relevance.
--
-- Trigger keywords (case-insensitive substring on task text):
--   ".ail", "ailang", "pure func", "requires {", "ensures {",
--   "effect row", "std/io", "std/json", "std/result", "std/option",
--   "Hindley-Milner", "pattern match" (when paired with "ailang"),
--   "module ".. (canonical AILANG module declaration)
--
-- Why this is separate from decision-framework: different scope (language
-- hints vs self-modification policy), different audiences (any AILANG
-- task vs only ext-authoring tasks), different evolution (hints can be
-- updated as AILANG itself adds features without touching decision policy).
--
-- Loaded via profile config:
--   "extensions": { "order": [..., "ailang_hints"] }

module sunholo/motoko_ext_ailang_hints/register

import std/option (None)
import std/string (length, toLower, contains)
import pkg/sunholo/motoko_ext_abi/types (
  ExtCtx,
  ExtensionHooks,
  ToolSchema,
  PromptPatch,
  BudgetPlan,
  BudgetPatch,
  ToolPolicyDecision,
  ToolHandleDecision,
  ToolCallEnvelope,
  ToolResultEnvelope,
  ResponseInterceptDecision,
  FinalizeDecision,
  NoOpinion, Delegate, NoIntercept, NoDecision
)

-- AILANG hint text. Tight (~250 tokens) — points the model at the high-
-- leverage AILANG features motoko-mediated authoring leans on, plus the
-- canonical microRAG-tools-first reminder for stdlib lookups.
--
-- Keep this list ANCHORED on observed failure modes (hallucinated stdlib
-- names, .method() syntax, missing effect rows, missing Z3 contracts). If
-- you're tempted to add a feature dump, file a design_doc instead.
pure func ailang_hints_text() -> string {
  "## AILANG context (this task involves AILANG code)

- **Stdlib lookups via tools, not memory.** If `microrag_context_for_file` / `microrag_search` / `ctx_search` are in the catalog, use them BEFORE writing imports. Hallucinated names (`stringify`, `from_int`, `.drop()`) are the #1 failure mode.
- **Effect rows in signatures.** Effectful: `func f(x: int) -> int ! {IO, FS}`. Pure: omit the row entirely. Pure functions can carry Z3 contracts: `pure func g(n: int) -> int requires { n >= 0 } ensures { result >= n }`.
- **No method syntax.** AILANG has no `xs.drop(1)` / `xs.map(f)`. Use `std/list` (foldl, map, filter, head, tail) or pattern-match recursion.
- **Inline tests.** `pure func ok() -> bool tests [((), true)] { ... }` runs via `ailang test`. Use these instead of separate test files for small, deterministic checks.
- **show before formatting.** `println(show(value))` for any printable type — prefer `show` over `intToStr`/`floatToStr`.
- **Verify before declaring done.** `make check_core` (type+effect), `make verify_core` (Z3 contracts on `pure func`), inline tests. DP7 will reject `done` with type errors when active."
}

pure func ailang_hints_text_is_well_formed() -> bool
  tests [((), true)]
  {
    let t = ailang_hints_text();
    length(t) > 200 && length(t) < 4000
      && contains(t, "AILANG")
      && contains(t, "Effect")
      && contains(t, "tests")
  }

-- Decide whether the task references AILANG. Pure substring check on the
-- lowercased task text. Same shape as motoko-ext-decision-framework's
-- task_signals_self_modification; the trigger words are different.
--
-- Keep the list narrow: false negatives (hints don't fire when they could
-- have helped) cost an uninformed import or two; false positives (hints
-- fire when irrelevant) cost ~250 tokens of prompt budget every step. We
-- bias toward false negatives.
pure func task_signals_ailang(task: string) -> bool {
  let t = toLower(task);
  -- Strong signals: explicit AILANG references.
  contains(t, "ailang")              -- name of the language
    || contains(t, ".ail")           -- file extension (also catches AILANG_RELAX...)
    || contains(t, "ailang.toml")    -- package manifest
    -- Syntactic signals: AILANG-specific keyword combinations.
    || contains(t, "pure func")
    || contains(t, "export func")
    || contains(t, "requires {")
    || contains(t, "ensures {")
    || contains(t, "effect row")
    -- Stdlib signals: AILANG stdlib paths are distinctive.
    || contains(t, "std/io")
    || contains(t, "std/json")
    || contains(t, "std/result")
    || contains(t, "std/option")
    || contains(t, "std/list")
    || contains(t, "std/ai")
    -- Tool/runtime signals.
    || contains(t, "make check_core")
    || contains(t, "make verify_core")
    || contains(t, "z3 contract")
    || contains(t, "hindley-milner")
}

pure func task_signals_ailang_fires_correctly() -> bool
  tests [((), true)]
  {
    -- Positive: each canonical signal must fire.
    task_signals_ailang("Refactor src/core/foo.ail")
      && task_signals_ailang("Write a pure func that returns Result")
      && task_signals_ailang("AILANG type error in compaction module")
      && task_signals_ailang("Add a requires { } contract to gcd")
      && task_signals_ailang("Why does std/io.println need IO effect?")
      && task_signals_ailang("Run make check_core")
      && task_signals_ailang("ailang.toml needs a new dependency")
    -- Negative: generic / non-AILANG tasks must NOT fire.
      && not task_signals_ailang("Write a Python fizzbuzz script")
      && not task_signals_ailang("Refactor the auth middleware in TypeScript")
      && not task_signals_ailang("Fix the React component re-render")
      && not task_signals_ailang("Update the SQL migration")
      && not task_signals_ailang("")
  }

pure func empty_describe_tools() -> [ToolSchema] { [] }

-- Conditional prompt patch: returns AILANG hints iff task_signals_ailang.
-- Pure, runs every step, ~strcmp cost.
pure func conditional_prompt_patch(ctx: ExtCtx) -> PromptPatch {
  if task_signals_ailang(ctx.task) then
    { prepend: [], append: [ailang_hints_text()] }
  else
    { prepend: [], append: [] }
}

export func register_with_config(_cfg: a) -> ExtensionHooks {
  {
    id: "ailang_hints",
    provided_tools: [],
    on_describe_tools: empty_describe_tools,
    on_build_system_prompt: conditional_prompt_patch,
    on_budget_plan:
      func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch ! {Env, FS} {
        { requested_total: None, requested_solver: None, requested_verifier: None }
      },
    on_tool_policy: \_ctx _call. NoOpinion,
    on_tool_handle:
      func(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
        Delegate
      },
    on_response_intercept:
      func(_ctx: ExtCtx, _resp: string) -> ResponseInterceptDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
        NoIntercept
      },
    on_solver_candidate:
      func(_ctx: ExtCtx, _candidate: string) -> FinalizeDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
        NoDecision
      }
  }
}
