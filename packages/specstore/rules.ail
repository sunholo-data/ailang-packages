module sunholo/specstore/rules
-- The rules that are proofs. Pure, with contracts: `ailang verify specstore/rules.ail`.
-- Everything else a standard says is data (the standard's YAML); these are the rules whose
-- logic does not change from one agency to the next.

-- A version major.minor as one comparable number.
export pure func versionKey(major: int, minor: int) -> int ! {}
requires { major >= 0, minor >= 0, minor < 1000 }
ensures { result >= 0 }
{ major * 1000 + minor }

-- Whole numbers go to the client and nothing else does; 0.x never does.
export pure func statusFitsVersion(major: int, minor: int, sent: bool) -> bool ! {}
requires { major >= 0, minor >= 0 }
ensures { result == (if major == 0 then !sent else sent == (minor == 0)) }
{ if major == 0 then !sent else sent == (minor == 0) }

-- The history only moves forward.
export pure func movesForward(prev: int, next: int) -> bool ! {}
ensures { result == (next > prev) }
{ next > prev }

-- A QA round tests a version that exists, no later than the current one.
export pure func roundTestsKnownVersion(tested: int, current: int, known: bool) -> bool ! {}
ensures { result == (known && tested <= current) }
{ known && tested <= current }

-- A system may record a failure; only a person sets a pass.
export pure func passAllowed(byPerson: bool, isPass: bool) -> bool ! {}
ensures { result == (!isPass || byPerson) }
{ !isPass || byPerson }

-- A row needs retesting when it changed after the version it was last tested against.
export pure func needsRetest(changed: int, lastTested: int, everTested: bool) -> bool ! {}
ensures { result == (!everTested || changed > lastTested) }
{ !everTested || changed > lastTested }

-- An automated comparison's outcome for one event in one visit, as a severity:
-- 0 matched, 1 could not be checked (blocked, error, did not run), 2 failed.
-- Several visits can expect the same event; the worst outcome stands, so a failure in one
-- visit is never hidden by a match in another.
export pure func worstOutcome(a: int, b: int) -> int ! {}
requires { a >= 0, a <= 2, b >= 0, b <= 2 }
ensures { result >= a, result >= b, result <= 2, result == a || result == b }
{ if a >= b then a else b }

-- A visit that was blocked or broke checks nothing: its events are "could not be checked",
-- never "matched" and never "failed", whatever was captured before it stopped.
export pure func visitOutcome(ran: bool, blocked: bool, failed: bool) -> int ! {}
ensures { result >= 0, result <= 2, (ran && !blocked) || result == 1, !(ran && !blocked) || result == (if failed then 2 else 0) }
{ if !ran || blocked then 1 else if failed then 2 else 0 }
