module sunholo/specstore/view
-- The Sheet: Read me, Summary, Parameters, Visits, Spec, Matrix (one column per dataLayer key), Dictionary, History, QA rounds.
-- Every result is a written value; colour sits beside a state, never instead of it.

import std/option (Option, Some, None)
import std/list (map, filter, length, foldl, concat, sortBy, dedup, flatMap, zip, range, take)
import std/string (join, find)
import std/json (Json, JBool, get)
import ./rules (needsRetest)
import ./model (Field, Rule, Std, Dev, Param, Event, Dict, Hist, Res, Round, VisitRes, ParamRes, Spec, str, arr, strs, obj, loadYaml, toStd, toSpec, toRound, loadSpec, matches, varsIn, parseVersion, keyOf, present, fieldsOf, missingIn, dup)
import ./xlsx (sheetXml)

export type Latest = { round: int, version: string, state: string, comment: string }

-- The latest result a person or a check recorded for an event; "not tested" never replaces a result.
export func latestFor(id: string, rs: [Round]) -> Option[Latest] =
  foldl(\acc. \r. match filter(\x. x.event == id && x.state != "not tested", r.results) {
      [x, ..._] => Some({ round: r.n, version: r.version, state: x.state, comment: x.comment }),
      [] => acc
    }, None, rs)

-- The latest automatic check of an event, matched included: "not tested" hides a match from latestFor,
-- which keeps a person's pass from being overwritten, so the check is read from the rounds separately.
export type Check = { round: int, check: string, matched: int, expected: int, comment: string, visits: [VisitRes] }

export func latestCheckFor(id: string, rs: [Round]) -> Option[Check] =
  foldl(\acc. \r. match filter(\x. x.event == id && x.check != "", r.results) {
      [x, ..._] => Some({ round: r.n, check: x.check, matched: x.matched, expected: x.expected, comment: x.comment, visits: x.visits }),
      [] => acc
    }, None, rs)

export func paramsText(m: int, t: int) -> string = if m < 0 || t <= 0 then "" else "${show(m)} of ${show(t)}"

export func checkText(c: Option[Check]) -> string = match c { Some(k) => "${k.check} · round ${show(k.round)}", None => "" }

export func countsText(c: Option[Check]) -> string = match c { Some(k) => paramsText(k.matched, k.expected), None => "" }

-- The first tab: one written line per event and visit, so what went right shows as a line of its own
-- (a consent-reject visit that found nothing, say), then the totals and what they were built from.
-- A round written before 0.3.4 has no visits: its event gets one line. Each line carries its own visit's
-- comment; a round from before 0.3.6 has none per visit, so the event's comment sits on its first line.
export func summaryRows(sp: Spec) -> [[(string, int)]] {
  let lines = flatMap(\e. {
      let c = latestCheckFor(e.id, sp.rounds);
      let result = match latestFor(e.id, sp.rounds) { Some(l) => l.state, None => "not tested" };
      let comment = match c { Some(k) => k.comment, None => "" };
      let row = \visit. \ck. \counts. \first. \note. [(e.id, 0), (e.eventName, 0), (e.priority, 0), (visit, 0), (ck, 0), (counts, 0),
                                               (if first then result else "", if first then stateStyle(result) else 0),
                                               (note, 0)];
      match c {
        Some(k) => match k.visits {
          [] => [(k.check, row("", k.check, paramsText(k.matched, k.expected), true, comment))],
          vs => map(\p. match p { (n, v) => (v.check, row(v.visit, v.check, paramsText(v.matched, v.expected), n == 0,
                                                       if v.comment != "" then v.comment else if n == 0 then comment else "")) },
                    zip(range(0, length(vs)), vs))
        },
        None => [("", row("", "", "", true, ""))]
      }
    }, sp.events);
  let count = \k. length(filter(\l. match l { (ck, _) => ck == k }, lines));
  let tot = foldl(\acc. \e. match latestCheckFor(e.id, sp.rounds) {
      Some(k) => foldl(\a. \v. match a { (m, t) => if v.matched >= 0 && v.expected > 0 then (m + v.matched, t + v.expected) else (m, t) },
                       acc, match k.visits { [] => [{ visit: "", check: k.check, matched: k.matched, expected: k.expected, comment: "", params: [] }], vs => vs }),
      None => acc }, (0, 0), sp.events);
  let pct = match tot { (m, t) => if t > 0 then "${show(m)} of ${show(t)} (${show((100 * m) / t)}%)" else "" };
  let last = foldl(\acc. \r. if r.n > acc.n then { n: r.n, date: r.date, by: r.by } else acc, { n: 0, date: "", by: "" }, sp.rounds);
  concat(map(\l. match l { (_, r) => r }, lines),
    [[("All", 0), ("${show(length(sp.events))} events", 0), ("", 0), ("${show(length(lines))} checks", 0),
      ("matched ${show(count("matched"))} · correctly absent ${show(count("correctly absent"))} · gaps found ${show(count("gaps found"))} · could not check ${show(count("could not check"))}", 0),
      (pct, 0), ("", 0), ("spec v${sp.version} · round ${show(last.n)} · ${last.date} · ${last.by}", 0)]])
}

-- What the spec expects, in words: a fixed value as it is; a variable as "one of: …" when the dictionary
-- lists its allowed values, else "any value (name)", which is all a run can confirm for it.
export func expectedText(p: Param) -> string =
  if p.variable == "" then p.value
  else match p.allowed {
    [] => "any value (${p.variable})",
    xs => "one of: ${join(", ", take(6, xs))}${if length(xs) > 6 then ", …" else ""}"
  }

-- One written line per parameter on the visit that checked it, the ones that are right as well as the
-- ones to decide, so a reader can see the check working, not only failing.
export func parameterRows(sp: Spec) -> [[(string, int)]] =
  flatMap(\e. match latestCheckFor(e.id, sp.rounds) {
      Some(k) => flatMap(\v. map(\p. [(e.id, 0), (e.eventName, 0), (v.visit, 0), (p.key, 0),
                                        (match filter(\q. q.key == p.key, e.params) { [q, ..._] => expectedText(q), [] => "" }, 0),
                                        (p.status, 0)], v.params), k.visits),
      None => []
    }, sp.events)

-- One step of a visit, in words a reader follows without the selector.
export func stepText(st: Json) -> string {
  let d = str(st, "do");
  let tab = match get(st, "new_tab") { Some(JBool(true)) => " in a new tab", _ => "" };
  if d == "click" then "click${tab}"
  else if d == "pick" then "pick one at random${tab}"
  else if d == "fill" then (if find(str(st, "value"), "{{env:QA_TEST_") >= 0 then "fill in the test account" else "fill in a field")
  else if d == "press" then "press ${str(st, "key")}"
  else if d == "goto" then "go to ${str(st, "url")}"
  else if d == "wait" then "wait"
  else d
}

export func consentText(c: string) -> string =
  if c == "accept" then "accepted" else if c == "reject" then "refused" else if c == "none" then "not answered" else c

-- The visits tab: what each visit does, so V01 means something without the spec open. A visit may
-- carry a description; without one its steps are written out.
export func visitRows(sp: Spec) -> [[(string, int)]] {
  let ids = \xs. if length(xs) > 0 && length(xs) == length(sp.events) then "every event (${show(length(xs))})"
                 else join(", ", map(\i. match filter(\e. e.id == i, sp.events) { [e, ..._] => "${i} ${e.eventName}", [] => i }, xs));
  map(\v. {
      let steps = arr(v, "steps");
      let does = if str(v, "description") != "" then str(v, "description")
                 else match steps { [] => "open the page and stay", _ => join(", then ", map(stepText, steps)) };
      [(str(v, "id"), 0), (str(v, "url"), 0), (consentText(str(v, "consent")), 0), (does, 0),
       (ids(strs(v, "expects")), 0), (ids(strs(v, "forbids")), 0)]
    }, arr(sp.j, "visits"))
}

-- The first tab: what each tab shows and what every written value means, so the sheet explains itself to a
-- reader who was not in the room. The same for every spec; nothing in it comes from the spec.
export func readMeRows(version: string) -> [[(string, int)]] = map(\r. map(\c. (c, 0), r), [
    ["THE TABS", "What each tab shows", "When to read it"],
    ["Summary", "One line per event and visit: what that visit found, how many parameters are right, the event's result. Totals at the bottom.", "Every morning: is anything wrong, and where"],
    ["Parameters", "One line per parameter on the visit that checked it: what the spec expects, in words, and its status.", "When deciding the gaps, line by line"],
    ["Visits", "What each visit does: the page, the consent choice, its steps, the events it expects and the ones it forbids.", "To see what V01, V02, … mean"],
    ["Spec v${version}", "The spec itself: one row per event with its description, trigger, scope, parameters, priority, versions and latest result.", "To see what an event should be"],
    ["Matrix", "Events against dataLayer keys: which event should send which key, with which value.", "To see the whole tagging plan at a glance"],
    ["Dictionary", "Every variable: what it means, its type, an example, where it comes from, its allowed values.", "To see what a value is allowed to be"],
    ["History", "Every version of the spec: who changed what, the second reader, its status.", "To see what changed, and when"],
    ["QA rounds", "Every round so far, every event: result, automatic check, parameters, comment.", "To see how things have moved over time"],
    ["", "", ""],
    ["THE AUTOMATIC CHECK COLUMN", "What one visit found for one event. On Summary, Spec and QA rounds.", "What to do with it"],
    ["matched", "Every parameter as the spec says (and the GA4 hit, where the spec checks GA4).", "Nothing. A person may review it and set pass"],
    ["gaps found", "The event was seen, but at least one parameter is missing, empty or not as the spec says; or it was not seen at all.", "Open the Parameters tab to see which ones"],
    ["correctly absent", "A visit that forbids the event (consent refused, say) did not see it. A good result.", "Nothing"],
    ["sent although forbidden", "A visit that forbids the event saw it: for a consent-refused visit, tracking despite the refusal.", "Raise it: a consent problem on the site"],
    ["could not check", "The visit stopped before it could check (a step failed).", "Fix the visit first (PROMPT-blocked.md), then run again"],
    ["did not run", "The visit was not in this run.", "Run again"],
    ["waiting for release", "The event changed in a version the client has not put live yet. Not checked until it is.", "Nothing until the client releases it"],
    ["no visit", "No visit covers the event, so nothing checked it.", "Add a visit to the spec"],
    ["", "", ""],
    ["THE STATUS COLUMN", "One parameter on one visit. On Parameters.", "What to do with it"],
    ["as the spec says", "The value itself is confirmed: the fixed value, or one of the variable's allowed values.", "Nothing"],
    ["present", "Set, but the dictionary lists no allowed values for it, so only that it is set can be confirmed.", "Nothing; list allowed values in the dictionary to check the value too"],
    ["missing", "The key is not in the push.", "Decide: the site does not send it, or the spec asks too much"],
    ["empty", "The key is there with no value.", "Decide: a site gap, or a value that only exists later (after a login, say)"],
    ["not an allowed value", "The site sends a value the dictionary does not list for this variable.", "Decide: fix the site, or add the value to the dictionary"],
    ["differs", "Not the fixed value the spec gives, or not a number where the dictionary says number.", "Decide: fix the site, or correct the spec"],
    ["not pushed", "The event itself was not seen, so none of its parameters were.", "See the event's line on Summary"],
    ["", "", ""],
    ["THE RESULT COLUMN", "The event's state in the round. On Summary, Spec and QA rounds.", "What to do with it"],
    ["not tested", "Not judged by a person yet. An automatic run never records a pass, so a match still reads not tested, with matched in Automatic check.", "Review it; set pass when it is right"],
    ["pass", "A person checked it and signed the round.", "Nothing"],
    ["fail", "Gaps found.", "Decide each gap on the Parameters tab"],
    ["blocked", "Could not be checked.", "Fix the visit first"],
    ["", "", ""],
    ["HOW TO CHANGE IT", "Every result is a written value; colour, where there is any, sits beside it and never replaces it. The sheet is a view of the spec and its rounds.", "Change the spec, never the sheet"]
  ])

export func stateStyle(s: string) -> int = if s == "pass" then 2 else if s == "fail" then 3 else if s == "blocked" then 4 else 0

export func view(sp: Spec) -> [(string, string)] {
  let specRows = map(\e. {
      let base = [(e.id, 0), (e.description, 0), (e.trigger, 0), (e.scope, 0), (e.eventName, 0),
                  (join("\n", map(\p. "${p.key} = ${p.value}", e.params)), 0), (e.priority, 0), (e.since, 0), (e.changed, 0)];
      match latestFor(e.id, sp.rounds) {
        None => concat(base, [("—", 0), ("not tested", 4), (checkText(latestCheckFor(e.id, sp.rounds)), 0), (countsText(latestCheckFor(e.id, sp.rounds)), 0), ("", 0), ("yes", 4), (e.note, 0)]),
        Some(l) => {
          let re = needsRetest(keyOf(e.changed), keyOf(l.version), true);
          concat(base, [("round ${show(l.round)} · v${l.version}", 0), (l.state, stateStyle(l.state)),
                        (checkText(latestCheckFor(e.id, sp.rounds)), 0), (countsText(latestCheckFor(e.id, sp.rounds)), 0), (l.comment, 0),
                        (if re then "yes" else "", if re then 4 else 0), (e.note, 0)])
        }
      }
    }, sp.events);
  -- the wide view the team knows: one column per dataLayer key
  let keys = sortBy(\a. \b. if a < b then -1 else if a > b then 1 else 0, dedup(flatMap(\e. map(\p. p.key, e.params), sp.events)));
  let matrixRows = map(\e. concat([(e.id, 0), (e.eventName, 0)],
      map(\k. match filter(\p. p.key == k, e.params) { [p, ..._] => (p.value, 0), [] => ("", 0) }, keys)), sp.events);
  [ ("Read me", sheetXml(["Read me", "", ""], readMeRows(sp.version), [28, 90, 50])),
    ("Summary", sheetXml(["ID", "eventName", "Priority", "Visit", "Automatic check", "Parameters", "Result", "Comment"],
                         summaryRows(sp), [6, 18, 9, 10, 40, 16, 12, 60])),
    ("Parameters", sheetXml(["ID", "eventName", "Visit", "Key", "Expected", "Status"],
                            parameterRows(sp), [6, 18, 8, 34, 24, 18])),
    ("Visits", sheetXml(["Visit", "Page", "Consent", "What it does", "Expects", "Forbids"],
                        visitRows(sp), [7, 30, 12, 70, 40, 30])),
    ("Spec v${sp.version}", sheetXml(["ID", "Description", "Trigger", "Scope", "eventName", "Parameters", "Priority", "Since", "Last changed", "Last QA", "Result", "Automatic check", "Parameters", "QA comment", "Retest", "Note"],
                                      specRows, [6, 30, 30, 16, 18, 36, 9, 7, 12, 15, 10, 20, 12, 36, 8, 24])),
    ("Matrix", sheetXml(concat(["ID", "eventName"], keys), matrixRows, concat([6, 18], map(\k. 18, keys)))),
    ("Dictionary", sheetXml(["Name", "Definition", "Type", "Example", "Source", "Allowed"],
        map(\d. [(d.name, 0), (d.definition, 0), (d.typ, 0), (d.example, 0), (d.source, 0), (join(", ", d.allowed), 0)], sp.dict), [18, 36, 10, 16, 16, 36])),
    ("History", sheetXml(["Version", "Date", "Author", "What changed", "Second reader", "Status"],
        map(\h. [(h.version, 0), (h.date, 0), (h.author, 0), (h.what, 0), (if h.reader == "" then "—" else h.reader, 0), (h.status, 0)], sp.hist), [9, 12, 12, 50, 14, 16])),
    ("QA rounds", sheetXml(["Round", "Version", "Date", "Tester", "By", "Event", "Result", "Automatic check", "Parameters", "Comment"],
        flatMap(\r. map(\x. [(show(r.n), 0), ("v${r.version}", 0), (r.date, 0), (r.tester, 0), (r.by, 0), (x.event, 0), (x.state, stateStyle(x.state)),
                             (x.check, 0), (paramsText(x.matched, x.expected), 0), (x.comment, 0)], r.results), sp.rounds),
        [7, 9, 12, 18, 10, 7, 13, 18, 12, 50])) ]
}

