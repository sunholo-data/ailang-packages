module sunholo/specstore/qa
-- Scheduled tag QA against a spec, in two halves around a browser:
--
--   specstore visits  <standard> <spec-folder> <visits.json>     the run list for the browser
--   (a browser script visits each page and writes observed.json: dataLayer pushes, GA4 hits)
--   specstore compare <standard> <spec-folder> <observed.json> <round.yaml>
--
-- A spec's `site` block names the base URL and the consent buttons; its `visits` list says,
-- for each visit, the page, the consent state, the steps and the events it should produce.
-- The comparison writes a QA round by an automated tester, so it can record a failure but
-- never a pass (passAllowed): a match is "not tested" with a note, for a person to confirm.

import std/result (Result, Ok, Err)
import std/option (Option, Some, None)
import std/json (Json, JString, JNumber, JBool, JNull, JArray, encode, decode, get, js, ja, jo, kv)
import std/fs (readFile, writeFile)
import std/io (println)
import std/list (map, filter, length, any, flatMap, foldl, concat)
import std/string (split, join, trim, endsWith, startsWith, substring, find, stringToFloat, length as strLength)
import ./rules (worstOutcome, visitOutcome)
import ./model (Std, Event, Param, Spec, Round, ParamRes, VisitRes, str, arr, strs, obj, matches, dup, keyOf)

export type Visit = { id: string, url: string, consent: string, expects: [string], forbids: [string], j: Json }
export type Seen = { id: string, status: string, reason: string, pushes: [Json], hits: [string] }

export func visitsOf(sp: Spec) -> [Visit] =
  map(\v. { id: str(v, "id"), url: str(v, "url"),
            consent: if str(v, "consent") == "" then "none" else str(v, "consent"),
            expects: strs(v, "expects"), forbids: strs(v, "forbids"), j: v }, arr(sp.j, "visits"))

export func has(j: Json, k: string) -> bool = match get(j, k) { Some(_) => true, None => false }

-- ── check: the visits cover the spec ─────────────────────────────────────────

export func ok(cond: bool, msg: string) -> [(string, string)] = if cond then [] else [("visits", msg)]

export func visitChecks(sp: Spec) -> [(string, string)] {
  let vs = visitsOf(sp);
  let ids = map(\e. e.id, sp.events);
  let site = obj(sp.j, "site");
  let covered = flatMap(\v. v.expects, vs);
  if length(vs) == 0 then [("visits", "spec: no visits, so scheduled QA has nothing to run")]
  else flatMap(\xs. xs, [
    ok(str(site, "base_url") != "", "site: no base_url"),
    map(\i. ("visits", "${i}: the visit ID is used twice"), dup(map(\v. v.id, vs))),
    flatMap(\v. flatMap(\xs. xs, [
        ok(v.url != "", "${v.id}: no url"),
        ok(v.consent == "accept" || v.consent == "reject" || v.consent == "none",
           "${v.id}: consent is \"${v.consent}\"; it is accept, reject or none"),
        ok(v.consent == "none" || has(obj(site, "consent"), v.consent),
           "${v.id}: consent ${v.consent}, but the site block names no button for it"),
        ok(length(v.expects) + length(v.forbids) > 0, "${v.id}: expects and forbids no events"),
        flatMap(\i. ok(any(\k. k == i, ids), "${v.id}: expects ${i}, which is not in the spec"), v.expects),
        flatMap(\i. ok(any(\k. k == i, ids), "${v.id}: forbids ${i}, which is not in the spec"), v.forbids)
      ]), vs),
    flatMap(\e. ok(e.priority != "high" || any(\c. c == e.id, covered),
                   "${e.id}: high priority, but no visit expects it, so scheduled QA never checks it"), sp.events)
  ])
}

-- ── visits: the run list ─────────────────────────────────────────────────────

export func planJson(sp: Spec) -> string =
  encode(jo([
    kv("site", obj(sp.j, "site")),
    kv("spec_version", js(sp.version)),
    kv("visits", ja(map(\v. jo([
        kv("id", js(v.id)), kv("url", js(v.url)), kv("consent", js(v.consent)),
        kv("steps", match get(v.j, "steps") { Some(s) => s, None => ja([]) }),
        kv("expects", ja(map(\i. js(i), v.expects))),
        kv("forbids", ja(map(\i. js(i), v.forbids)))
      ]), visitsOf(sp))))
  ]))

-- ── compare: what was seen against what the spec says ────────────────────────

export func seenOf(o: Json) -> [Seen] =
  map(\v. { id: str(v, "id"), status: str(v, "status"), reason: str(v, "reason"),
            pushes: map(\r. obj(r, "item"), arr(v, "datalayer")),
            hits: map(\h. str(h, "en"), arr(v, "hits")) }, arr(o, "visits"))

export func numText(s: string) -> string =
  if endsWith(s, ".0") then substring(s, 0, strLength(s) - 2) else s

export func valueText(j: Json) -> string =
  match j {
    JString(s) => s,
    JNumber(n) => numText(show(n)),
    JBool(b) => if b then "true" else "false",
    JNull => "",
    _ => encode(j)
  }

-- A key as written (GTM's own keys contain dots: gtm.scrollThreshold), else as a path:
-- page.type → push["page"]["type"]
export func pathGet(j: Json, key: string) -> Option[Json] =
  if has(j, key) then get(j, key) else foldl(\acc. \seg. match acc { Some(x) => get(x, seg), None => None }, Some(j), split(key, "."))

-- One value against the spec's expected value: fixed; or, for a {{variable}}, non-empty and, where the
-- dictionary lists allowed values, one of them.
-- Two values the same: as numbers when the dictionary says the variable is a number (3.00 is 3), else exactly.
export func sameValue(typ: string, a: string, b: string) -> bool =
  if typ == "number" then match stringToFloat(trim(a)) {
      Some(x) => match stringToFloat(trim(b)) { Some(y) => x == y, None => false },
      None => a == b
    }
  else a == b

export func isNumber(t: string) -> bool = match stringToFloat(trim(t)) { Some(_) => true, None => false }

func valueProblem(std: Std, label: string, expected: string, allowed: [string], typ: string, v: Json) -> [string] {
  let t = valueText(v);
  if matches(std.pVar, expected) then (
    if trim(t) == "" then ["${label} empty"]
    else if typ == "number" && !isNumber(t) then ["${label} is \"${t}\", not a number"]
    else if length(allowed) > 0 && !any(\a. sameValue(typ, a, t), allowed) then ["${label} is \"${t}\", not one of the allowed values of ${expected}"]
    else [])
  else if t == expected then []
  else ["${label} is \"${t}\", the spec says \"${expected}\""]
}

-- A key with [] names every element of an array: ecommerce.items[].item_id is item_id in each
-- item. An empty array fails, since the spec expects at least one; the first bad element is named.
func arrayProblems(std: Std, key: string, expected: string, allowed: [string], typ: string, push: Json, at: int) -> [string] {
  let before = substring(key, 0, at);
  let rest = substring(key, at + 2, strLength(key));
  let inner = if strLength(rest) > 0 && substring(rest, 0, 1) == "." then substring(rest, 1, strLength(rest)) else rest;
  match pathGet(push, before) {
    Some(JArray(items)) =>
      if length(items) == 0 then ["${before} is empty"]
      else {
        let probs = foldl(\acc. \it. match acc {
            (i, []) => (i + 1, match (if inner == "" then Some(it) else pathGet(it, inner)) {
                None => ["${before}[${show(i)}].${inner} missing"],
                Some(v) => valueProblem(std, "${before}[${show(i)}].${inner}", expected, allowed, typ, v)
              }),
            done => done
          }, (0, []), items);
        match probs { (_, ps) => ps }
      },
    Some(_) => ["${before} is not a list"],
    None => ["${before} missing"]
  }
}

-- One parameter against one push: its problems, none when it is as the spec says.
func oneParam(std: Std, p: Param, push: Json) -> [string] {
  let at = find(p.key, "[]");
  if at >= 0 then arrayProblems(std, p.key, p.value, p.allowed, p.typ, push, at)
  else match pathGet(push, p.key) {
    None => ["${p.key} missing"],
    Some(v) => valueProblem(std, p.key, p.value, p.allowed, p.typ, v)
  }
}

export func paramProblems(std: Std, e: Event, push: Json) -> [string] = flatMap(\p. oneParam(std, p, push), e.params)

-- How many of the event's parameters are as the spec says in this push.
export func paramsMatched(std: Std, e: Event, push: Json) -> int =
  length(filter(\p. length(oneParam(std, p, push)) == 0, e.params))

-- One event in one visit: (severity, note). Severity as in rules.visitOutcome.
export func inVisit(std: Std, e: Event, s: Seen) -> (int, string) = inVisitWith(std, true, e, s)

-- ga4 false: the spec's site block checks the data layer only (checks: [datalayer]), so a missing
-- GA4 hit is not a failure and a match says so.
export func inVisitWith(std: Std, ga4: bool, e: Event, s: Seen) -> (int, string) {
  let blocked = s.status != "ok";
  let gaOnly = e.dlEvent == "none";
  let pushes = filter(\x. str(x, "event") == e.dlEvent, s.pushes);
  let probs = map(\x. paramProblems(std, e, x), pushes);
  let paramFail = length(pushes) > 0 && !any(\ps. length(ps) == 0, probs);
  let firstProbs = match probs { [ps, ..._] => ps, [] => [] };
  let ga = any(\en. en == e.eventName, s.hits);
  let counted = match pushes {
      [x, ..._] => if gaOnly || length(e.params) == 0 then "" else "${show(paramsMatched(std, e, x))} of ${show(length(e.params))} parameters match",
      [] => ""
    };
  let lead = if counted == "" then "" else "${counted}; ";
  let tail = if counted == "" then "" else " (${counted})";
  let fails = flatMap(\xs. xs, [
    if gaOnly || length(pushes) > 0 then [] else ["no dataLayer push with event \"${e.dlEvent}\""],
    if !gaOnly && paramFail then firstProbs else [],
    if ga || !ga4 then [] else ["no GA4 hit with en=${e.eventName}"]
  ]);
  let sev = visitOutcome(true, blocked, length(fails) > 0);
  let note = if blocked then "${s.id}: could not check (${s.status}: ${s.reason})"
    else if length(fails) > 0 then "${s.id}: ${lead}${join("; ", fails)}"
    else if gaOnly then "${s.id}: GA4 hit matches the spec (no dataLayer push expected)"
    else if !ga4 then "${s.id}: dataLayer push matches the spec${tail} (data layer only; GA4 not checked)"
    else "${s.id}: dataLayer push and GA4 hit match the spec${tail}";
  (sev, note)
}

-- A visit that forbids an event (consent rejected, say): any GA4 hit or dataLayer push for it fails.
export func absentIn(e: Event, s: Seen) -> (int, string) {
  let blocked = s.status != "ok";
  let hit = any(\en. en == e.eventName, s.hits);
  let pushed = e.dlEvent != "none" && any(\x. str(x, "event") == e.dlEvent, s.pushes);
  let sev = visitOutcome(true, blocked, hit || pushed);
  let note = if blocked then "${s.id}: could not check (${s.status}: ${s.reason})"
    else if hit then "${s.id}: GA4 hit en=${e.eventName} sent, which this visit forbids"
    else if pushed then "${s.id}: dataLayer push \"${e.dlEvent}\", which this visit forbids"
    else "${s.id}: correctly absent";
  (sev, note)
}

export func outcomeFor(std: Std, vs: [Visit], seen: [Seen], e: Event) -> (int, string) = outcomeWith(std, true, vs, seen, e)

export func outcomeWith(std: Std, ga4: bool, vs: [Visit], seen: [Seen], e: Event) -> (int, string) {
  let run = \v. \f. match filter(\s. s.id == v.id, seen) {
      [s, ..._] => f(s),
      [] => (visitOutcome(false, false, false), "${v.id}: did not run")
    };
  let each = flatMap(\xs. xs, [
    map(\v. run(v, \s. inVisitWith(std, ga4, e, s)), filter(\v. any(\i. i == e.id, v.expects), vs)),
    map(\v. run(v, \s. absentIn(e, s)), filter(\v. any(\i. i == e.id, v.forbids), vs))
  ]);
  if length(each) == 0 then (-1, "no visit covers this event")
  else (foldl(\acc. \p. match p { (s, _) => worstOutcome(acc, s) }, 0, each),
        join(" | ", map(\p. match p { (_, n) => n }, each)))
}

-- An event whose last change is newer than the version the client has put live is not judged:
-- a failure there would be the release not having happened yet, not a broken tag.
export func waitingForRelease(e: Event) -> bool = e.live != "" && keyOf(e.live) >= 0 && keyOf(e.live) < keyOf(e.changed)

-- site.checks lists what a run judges; without it, both the data layer and GA4.
export func checksGa4(spec: Json) -> bool = match strs(obj(spec, "site"), "checks") {
    [] => true,
    cs => any(\c. c == "ga4", cs)
  }

-- The event's parameters as the spec says, of those it lists, on the first visit that expects it and ran:
-- (-1, -1) when no such visit ran, or the event has no dataLayer push or no parameters to count.
export func eventCounts(std: Std, vs: [Visit], seen: [Seen], e: Event) -> (int, int) {
  let n = length(e.params);
  let ran = flatMap(\v. filter(\s. s.id == v.id && s.status == "ok", seen), filter(\v. any(\i. i == e.id, v.expects), vs));
  if e.dlEvent == "none" || n == 0 then (-1, -1)
  else match ran {
    [] => (-1, -1),
    [s, ..._] => match filter(\x. str(x, "event") == e.dlEvent, s.pushes) {
      [x, ..._] => (paramsMatched(std, e, x), n),
      [] => (0, n)
    }
  }
}

-- One parameter's problems as a written status.
export func statusOf(problems: [string]) -> string = match problems {
    [] => "as the spec says",
    _ => if any(\m. find(m, " missing") >= 0 || find(m, " is empty") >= 0, problems) then "missing"
         else if any(\m. endsWith(m, " empty"), problems) then "empty"
         else if any(\m. find(m, "not one of the allowed values") >= 0, problems) then "not an allowed value"
         else "differs"
  }

-- What a parameter without problems confirms: the value itself (a fixed one, or one of a variable's
-- allowed values), or only that it is set (a variable the dictionary gives no allowed values for).
export func paramStatus(p: Param, problems: [string]) -> string =
  match problems { [] => if p.variable != "" && length(p.allowed) == 0 then "present" else "as the spec says", _ => statusOf(problems) }

-- Every parameter of an event on one visit that ran: from its first dataLayer push, or "not pushed".
export func paramResults(std: Std, e: Event, s: Seen) -> [ParamRes] =
  if e.dlEvent == "none" then []
  else match filter(\x. str(x, "event") == e.dlEvent, s.pushes) {
    [x, ..._] => map(\p. { key: p.key, status: paramStatus(p, oneParam(std, p, x)) }, e.params),
    [] => map(\p. { key: p.key, status: "not pushed" }, e.params)
  }

func noCounts(v: string, ck: string, c: string) -> VisitRes = { visit: v, check: ck, matched: -1, expected: -1, comment: c, params: [] }

-- A visit's own note, without the "V01: " the event's comment needs to tell its visits apart.
export func ownNote(v: string, note: string) -> string =
  if startsWith(note, "${v}: ") then substring(note, strLength(v) + 2, strLength(note)) else note

-- The event on every visit that expects or forbids it, so a visit that went right shows as its own line.
export func visitResults(std: Std, ga4: bool, vs: [Visit], seen: [Seen], e: Event) -> [VisitRes] {
  let expecting = map(\v. match filter(\s. s.id == v.id, seen) {
      [] => noCounts(v.id, "did not run", "did not run"),
      [s, ..._] => if s.status != "ok" then noCounts(v.id, "could not check", "could not check (${s.status}: ${s.reason})") else {
        let res = inVisitWith(std, ga4, e, s);
        let sev = match res { (x, _) => x };
        let note = match res { (_, n) => ownNote(v.id, n) };
        let ps = paramResults(std, e, s);
        let ok = length(filter(\p. p.status == "as the spec says" || p.status == "present", ps));
        { visit: v.id, check: if sev == 0 then "matched" else "gaps found",
          matched: if length(ps) == 0 then -1 else ok, expected: if length(ps) == 0 then -1 else length(ps), comment: note, params: ps }
      }
    }, filter(\v. any(\i. i == e.id, v.expects), vs));
  let forbidding = map(\v. match filter(\s. s.id == v.id, seen) {
      [] => noCounts(v.id, "did not run", "did not run"),
      [s, ..._] => match absentIn(e, s) {
        (sev, n) => noCounts(v.id, if sev == 0 then "correctly absent" else if sev == 1 then "could not check" else "sent although forbidden", ownNote(v.id, n))
      }
    }, filter(\v. any(\i. i == e.id, v.forbids), vs));
  concat(expecting, forbidding)
}

-- The written verdict beside the state, which says "not tested" for both a match and an event never
-- checked: only a person sets a pass.
export func checkOf(sev: int) -> string =
  if sev == 2 then "gaps found" else if sev == 1 then "could not check" else if sev == 0 then "matched" else "no visit"

export func stateOf(sev: int) -> string =
  if sev == 2 then "fail" else if sev == 1 then "blocked" else "not tested"

export func commentOf(sev: int, note: string) -> string =
  if sev == 0 then "Matched automatically; a person sets the pass. ${note}" else note

func countLines(ind: string, m: int, t: int) -> [string] =
  if m >= 0 then ["${ind}matched: ${show(m)}", "${ind}expected: ${show(t)}"] else []

func visitLines(v: VisitRes) -> [string] = flatMap(\xs. xs, [
    ["      - visit: ${v.visit}", "        check: ${encode(js(v.check))}"],
    if v.comment == "" then [] else ["        comment: ${encode(js(v.comment))}"],
    countLines("        ", v.matched, v.expected),
    if length(v.params) == 0 then []
    else concat(["        params:"], map(\p. "          - {key: ${encode(js(p.key))}, status: ${encode(js(p.status))}}", v.params))
  ])

func resultLines(r: (string, string, string, (int, int), [VisitRes], string)) -> [string] =
  match r { (i, st, ck, counts, visits, c) => match counts { (m, t) => flatMap(\xs. xs, [
    ["  - event: ${i}", "    state: ${st}", "    check: ${encode(js(ck))}"],
    countLines("    ", m, t),
    ["    comment: ${encode(js(c))}"],
    if length(visits) == 0 then [] else concat(["    visits:"], flatMap(visitLines, visits))
  ]) } }

export func roundYaml(n: int, version: string, date: string, rows: [(string, string, string, (int, int), [VisitRes], string)]) -> string =
  join("\n", flatMap(\xs. xs, [
    ["# Written by specstore compare from a scheduled run. Not edited after writing.",
     "round: ${show(n)}", "version: ${encode(js(version))}", "date: ${encode(js(date))}",
     "tester: specstore compare", "by: automated", "results:"],
    flatMap(resultLines, rows),
    [""]
  ]))

export func runCompare(std: Std, sp: Spec, obsPath: string, out: string) -> () ! {IO, FS} =
  match decode(readFile(obsPath)) {
    Err(e) => println("✗ ${obsPath}: ${e}"),
    Ok(o) => {
      let vs = visitsOf(sp);
      let seen = seenOf(o);
      let observedFor = str(o, "spec_version");
      let n = 1 + foldl(\acc. \r. if r.n > acc then r.n else acc, 0, sp.rounds);
      let date = substring(str(o, "captured_at"), 0, 10);
      let ga4 = checksGa4(sp.j);
      let rows = map(\e. if waitingForRelease(e) then (e.id, "not tested", "waiting for release", (-1, -1), [], "Waiting for release: changed in v${e.changed}, live is v${e.live}. Not checked until the client puts it live.")
        else match outcomeWith(std, ga4, vs, seen, e) {
          (sev, note) => if sev < 0 then (e.id, "not tested", checkOf(sev), (-1, -1), [], note)
                         else (e.id, stateOf(sev), checkOf(sev), eventCounts(std, vs, seen, e), visitResults(std, ga4, vs, seen, e), commentOf(sev, note))
        }, sp.events);
      writeFile(out, roundYaml(n, sp.version, date, rows));
      let count = \st. length(filter(\r. match r { (_, s, _, _, _, _) => s == st }, rows));
      let totals = foldl(\acc. \r. match r { (_, _, _, counts, _, _) => match counts { (m, t) => match acc { (am, at) =>
          if m >= 0 then (am + m, at + t) else (am, at) } } }, (0, 0), rows);
      let matchedCount = length(filter(\r. match r { (_, _, ck, _, _, _) => ck == "matched" }, rows));
      if observedFor != sp.version then println("  ~ the run was planned from v${observedFor}; the spec is now v${sp.version}") else ();
      foldl(\u. \r. match r { (i, st, _, _, _, c) => println("  ${if st == "fail" then "✗" else if st == "blocked" then "!" else "·"} ${i}  ${st}  ${c}") }, (), rows);
      let paramLine = match totals { (m, t) => if t > 0 then "; ${show(m)} of ${show(t)} parameters without a gap" else "" };
      println("✓ wrote ${out}: QA round ${show(n)} of v${sp.version}, ${show(count("fail"))} failed, ${show(count("blocked"))} could not be checked, ${show(length(rows) - count("fail") - count("blocked"))} not failed (a person sets the pass), ${show(matchedCount)} matched${paramLine}")
    }
  }
