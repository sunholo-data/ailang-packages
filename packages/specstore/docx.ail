module sunholo/specstore/docx
-- The blocks a document specstore hands to people is made of (a title, headings, paragraphs,
-- bullet lists, code blocks, tables), rendered as Markdown. The Word file is made from that
-- Markdown by AILANG Parse (main.ail): from 0.4.1, specstore no longer writes WordprocessingML itself.

import std/list (map, length, zip, range, concat)
import std/string (join, replace, split)

export type Blk = Title(string) | Subtitle(string) | H1(string) | H2(string) | Para(string)
                | Bullets([string]) | Code(string) | Table([string], [[string]])

-- ── Markdown ───────────────────────────────────────────────────────────────

export func mdCell(s: string) -> string = replace(replace(s, "|", "\\|"), "\n", " ")

export func mdBlock(b: Blk) -> string =
  match b {
    Title(t) => "# ${t}",
    Subtitle(t) => "*${t}*",
    H1(t) => "## ${t}",
    H2(t) => "### ${t}",
    Para(t) => t,
    Bullets(xs) => join("\n", map(\x. "- ${x}", xs)),
    Code(c) => "```\n${c}\n```",
    Table(hs, rows) => join("\n", concat([
        "| ${join(" | ", map(mdCell, hs))} |",
        "|${join("|", map(\h. "---", hs))}|"
      ], map(\r. "| ${join(" | ", map(mdCell, r))} |", rows)))
  }

export func toMarkdown(bs: [Blk]) -> string = "${join("\n\n", map(mdBlock, bs))}\n"
