-- Boot smoke test for sunholo/external_backend.
--
-- Registry pre-publish gate runs this with --ai-stub and a broad
-- capability set, looking for "OK:" on the final line.
--
-- We exercise:
--   1. formatError: each BackendError variant renders to a non-empty string
--      with the expected prefix.
--   2. runJson with a non-existent command — must return Err(ExecFailed).
--   3. runJson with "false" — must return Err(NonZeroExit{code: 1}).
--   4. runJson with "echo not-json" — must return Err(InvalidJson{...}).
--   5. runJson with "echo {\"ok\":true}" — must return Ok(Json).
--   6. describeProcessError: each ProcessError variant renders its OWN
--      cause, not a generic "could not execute". Regression guard — every
--      variant used to collapse into that one string, so a docparse OCR
--      backend killed by the 30s process timeout reported `uv` as missing
--      from PATH, on a PATH that was correct.
--
-- All checks are offline. No network, no real backend installed.

module _smoke

import std/io (println)
import std/string (length, contains)
import std/result (Result, Ok, Err)
import std/process (Timeout, OutputLimitExceeded, NotFound, AbnormalExit)
import sunholo/external_backend/runner (
  runJson, formatError, describeProcessError,
  ExecFailed, NonZeroExit, InvalidJson, BackendError
)

func check(name: string, cond: bool) -> int ! {IO} {
  if cond then {
    println("  ✓ ${name}");
    1
  } else {
    println("  ✗ ${name}");
    0
  }
}

export func main() -> () ! {IO, Process} {
  let s1 = formatError(ExecFailed("nope"));
  let s2 = formatError(NonZeroExit({code: 2, stderr: "boom"}));
  let s3 = formatError(InvalidJson({stderr: "warn", msg: "bad"}));

  let p1 = check("formatError(ExecFailed) non-empty", length(s1) > 0);
  let p2 = check("formatError(ExecFailed) mentions cmd", contains(s1, "nope"));
  let p3 = check("formatError(NonZeroExit) mentions code", contains(s2, "2"));
  let p4 = check("formatError(NonZeroExit) mentions stderr", contains(s2, "boom"));
  let p5 = check("formatError(InvalidJson) mentions msg", contains(s3, "bad"));

  -- runJson with non-existent command → ExecFailed
  let r1 = runJson("definitely-not-a-real-command-xyz123", []);
  let p6 = match r1 {
    Err(ExecFailed(_)) => check("runJson missing cmd → ExecFailed", true),
    _ => check("runJson missing cmd → ExecFailed", false)
  };

  -- runJson with "false" → NonZeroExit
  let r2 = runJson("false", []);
  let p7 = match r2 {
    Err(NonZeroExit(_)) => check("runJson exit-1 → NonZeroExit", true),
    _ => check("runJson exit-1 → NonZeroExit", false)
  };

  -- runJson with non-JSON stdout → InvalidJson
  let r3 = runJson("echo", ["not-json"]);
  let p8 = match r3 {
    Err(InvalidJson(_)) => check("runJson non-JSON → InvalidJson", true),
    _ => check("runJson non-JSON → InvalidJson", false)
  };

  -- runJson with valid JSON → Ok
  let r4 = runJson("printf", ["{\"ok\":true}"]);
  let p9 = match r4 {
    Ok(_) => check("runJson valid JSON → Ok", true),
    _ => check("runJson valid JSON → Ok", false)
  };

  -- describeProcessError: each variant must say its own name. A timeout
  -- rendered as "could not execute" is the bug this package shipped.
  let d1 = describeProcessError("uv", Timeout(30000));
  let p10 = check("Timeout names the timeout", contains(d1, "timed out"));
  let p11 = check("Timeout carries the duration", contains(d1, "30000"));
  let p12 = check("Timeout does not claim exec failed",
                  contains(d1, "could not execute") == false);

  let d2 = describeProcessError("uv", OutputLimitExceeded(10485760));
  let p13 = check("OutputLimitExceeded names the limit", contains(d2, "10485760"));

  let d3 = describeProcessError("uv", NotFound("uv"));
  let p14 = check("NotFound names PATH", contains(d3, "PATH"));

  let d4 = describeProcessError("uv", AbnormalExit(9, "SIGKILL"));
  let p15 = check("AbnormalExit names the signal", contains(d4, "SIGKILL"));

  let total = p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
            + p10 + p11 + p12 + p13 + p14 + p15;
  if total == 15
    then println("OK: 15/15 checks passed")
    else println("FAIL: ${show(total)}/15 checks passed")
}
