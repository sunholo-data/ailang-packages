-- Proposal summaries for human-readable display
--
-- Generates descriptions of plan changes for UI or chat presentation.
-- Used by AI agents to explain proposed upgrades to users.
--
-- Usage:
--   import pkg/sunholo/billing_proposals/proposal_summary (summarizeProposal, ProposalSummary)

module sunholo/billing_proposals/proposal_summary

import std/result (Ok, Err)
import std/string (length)
import pkg/sunholo/billing_entitlements/plan (Plan, lookupPlan)

-- Human-readable summary of a plan change
type ProposalSummary = {
  description: string,
  currentPlan: string,
  targetPlan: string,
  requestLimit: string,
  unitLimit: string,
  apiAccess: string
}

-- Build the summary body from the resolved plan's fields.
--
-- Contracts live here rather than on summarizeProposal because the property
-- test framework has no generator for types imported from dependencies
-- (Plan, or the catalog list[{key: string, plan: Plan}]); properties on
-- functions taking them would never run and fail the test gate. Every
-- parameter here is a primitive type the framework can generate.
pure func buildSummary(
  currentPlanName: string,
  targetName: string,
  requestLimit: int,
  unitLimit: int,
  apiAccess: bool,
  reason: string
) -> ProposalSummary
  requires { length(currentPlanName) > 0 }
  ensures {
    length(result.description) > 0
    && result.currentPlan == currentPlanName
    && result.targetPlan == targetName
  }
=
  {
    description: "Upgrade from ${currentPlanName} to ${targetName}: ${reason}",
    currentPlan: currentPlanName,
    targetPlan: targetName,
    requestLimit: "${show(requestLimit)} requests/month",
    unitLimit: "${show(unitLimit)} units/month",
    apiAccess: if apiAccess then "enabled" else "disabled"
  }

-- Summarize a proposal for display
--
-- Looks up both current and target plans to produce a comparison.
export pure func summarizeProposal(
  targetPlanKey: string,
  currentPlanName: string,
  catalog: [{key: string, plan: Plan}],
  reason: string
) -> Result[ProposalSummary, string] =
  match lookupPlan(catalog, targetPlanKey) {
    Err(e) => Err(e),
    Ok(target) =>
      Ok(buildSummary(
        currentPlanName,
        target.name,
        target.monthlyRequestLimit,
        target.monthlyUnitLimit,
        target.apiAccess,
        reason
      ))
  }

-- Format a one-line upgrade prompt for chat display
export pure func upgradePrompt(currentPlan: string, targetPlan: string, reason: string) -> string
  requires { length(currentPlan) > 0 && length(targetPlan) > 0 }
  ensures { length(result) > 0 }
=
  "Your current plan (${currentPlan}) ${reason}. Would you like to upgrade to ${targetPlan}?"
