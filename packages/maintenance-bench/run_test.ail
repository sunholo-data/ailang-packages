module sunholo/maintenance_bench/run_test
import ./run_codec (decodeRunBundle)
import ./run_metrics (summarizeRuns)
import std/result (Ok, Err)
import std/string (replace)

func runCase() -> bool = match decodeRunBundle(planText(), runsText()) {
  Ok(b) => match summarizeRuns(b) {
    Ok(x) => x.scheduledTrajectories == 8 && x.scheduledStages == 24 && x.successfulTrajectories == 3 && x.unknownTrajectories == 3 && x.visibleGreenRegressions == 1,
    _ => false
  },
  _ => false
}

test "all 24 scripted stages remain accounted" {
  runCase()
}

func badOracle() -> bool {
  let p = planText()
  let r = runsText()
  match decodeRunBundle(p, replace(r, "oracleArtifact", "inventedArtifact")) {
    Err(_) => true,
    _ => false
  }
}

test "missing oracle artifact evidence is rejected" {
  badOracle()
}

