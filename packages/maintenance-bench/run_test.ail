func wrongPrior() -> bool {
  match decodeRunBundle(planText(), replace(runsText(), "priorDigest", "wrongPrior")) {
    Err(_) => true,
    _ => false
  }
}

test "wrong owned checkpoint is rejected" {
  wrongPrior()
}

func drift() -> bool {
  match decodeRunBundle(planText(), replace(runsText(), "scripted-control", "changed-model")) {
    Err(_) => true,
    _ => false
  }
}

test "model identity drift is rejected" {
  drift()
}

func duplicateAttempt() -> bool {
  match decodeRunBundle(planText(), replace(runsText(), "resource-1-python-attempt-1", "resource-1-ailang-attempt-1")) {
    Err(_) => true,
    _ => false
  }
}

test "duplicate attempt identity is rejected" {
  duplicateAttempt()
}

func unknownLanguage() -> bool {
  match decodeRunBundle(replace(planText(), "python", "invented"), runsText()) {
    Ok(_) => false,
    Err(_) => true
  }
}

test "changed plan identities cannot reuse another ledger" {
  unknownLanguage()
}
