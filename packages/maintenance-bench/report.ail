module sunholo/maintenance_bench/report
import ./lineage (Artifact, artifacts)
import ./types (Snapshot, Manifest)
import ./cohort (Cohort, applyAnnotations, buildCohort)
import ./codec (decodeSnapshot, decodeManifest, decodeAnnotations)
import ./metrics (Summary, summaries)
import ./compare (compareLanguages, deltaPP)
import ./report_json (summaryJson, pairJson, optionalNumber)
import std/json (Json, JObject, JArray, JString, JBool, JNull, kv, jint, encode)
import std/result (Result, Ok, Err, flatMap)
import std/option (Some, None)
import std/list (map, foldl, filter, length as size)
import std/string (join, replace, concat)
import std/crypto (sha256Hex)

export type Analysis = { json: string, markdown: string }

export type Prepared = { snapshot: Snapshot, manifest: Manifest, cohort: Cohort, groups: [Summary] }

export pure func prepare(snapshotText: string, annotationText: string, manifestText: string) -> Result[Prepared, string] =
  flatMap(\s. flatMap(\labels. flatMap(\m. flatMap(\reviewed. flatMap(\c. Ok({ snapshot: reviewed, manifest: m, cohort: c, groups: summaries(c, reviewed.episodes) }), buildCohort(reviewed, m)), applyAnnotations(s, labels)), decodeManifest(manifestText)), decodeAnnotations(annotationText)), decodeSnapshot(snapshotText))

func md(s: string) -> string =
  replace(replace(replace(replace(replace(replace(replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "|", "\\|"), "\n", " "), "[", "\\["), "]", "\\]")

func tableRow(r: Summary) -> string =
  concat(["| ", join(" | ", [md(r.repo), md(r.language), show(r.eligible), show(r.mature), show(r.censored), show(r.linkedRepairChanges), show(r.repairEpisodes), show(r.interceptedRepairs)]), " |"])

func artifactRow(a: Artifact) -> string {
  let paths = md(join(" -> ", a.paths))
  "| ${md(a.repo)} | ${paths} | ${show(a.touches)} | ${show(a.repairTouches)} | ${show(a.featureTouches)} | ${show(a.otherTouches)} |"
}

func languageCount(groups: [Summary], language: string, linked: bool) -> int =
  foldl(\n r. n + (if linked then r.linkedRepairChanges else r.mature), 0, filter(\r. r.language == language, groups))

export pure func analyse(snapshotText: string, annotationText: string, manifestText: string, left: string, right: string) -> Result[Analysis, string] =
  flatMap(\p. {
    let snapshotHash = sha256Hex(snapshotText)
    let annotationHash = sha256Hex(annotationText)
    let manifestHash = sha256Hex(manifestText)
    let identity = sha256Hex(encode(JArray(map(\s. JString(s), ["maintenance_bench/0.2.0", p.manifest.metricVersion, p.manifest.compilerId, snapshotHash, annotationHash, manifestHash, left, right]))))
    let comparison = if left == "" && right == "" then Ok(JNull) else match compareLanguages(p.cohort.eligible, left, right) {
      Err(e) => Err(e),
      Ok(pair) => Ok(JObject([kv("kind", JString("descriptive_unadjusted_not_causal")), kv("left", JString(left)), kv("right", JString(right)), kv("observationalDeltaPP", optionalNumber(deltaPP(languageCount(p.groups, left, true), languageCount(p.groups, left, false), languageCount(p.groups, right, true), languageCount(p.groups, right, false)))), kv("semanticPairs", pairJson(pair))]))
    }
    flatMap(\comp. {
      let result = JObject([kv("schema", JString("maintenance.report/1")), kv("packageVersion", JString("0.2.0")), kv("metricVersion", JString(p.manifest.metricVersion)), kv("reportId", JString(identity)), kv("snapshotDigest", JString(snapshotHash)), kv("annotationDigest", JString(annotationHash)), kv("manifestDigest", JString(manifestHash)), kv("declaredCompilerId", JString(p.manifest.compilerId)), kv("identityProvenance", JString("compiler identity is declared input; attest actual runtime externally")), kv("source", JString(p.snapshot.source)), kv("sourceRef", JString(p.snapshot.sourceRef)), kv("cutoffMs", jint(p.cohort.cutoffMs)), kv("windowDays", jint(p.cohort.windowDays)), kv("sourceComplete", JBool(p.cohort.complete)), kv("excluded", jint(p.cohort.excluded)), kv("eligible", jint(size(p.cohort.eligible))), kv("mature", jint(size(p.cohort.mature))), kv("censored", jint(size(p.cohort.censored))), kv("unlabelled", jint(p.cohort.unlabelled)), kv("claim", JString("exploratory project associations; observed linked repairs are not true bug prevalence")), kv("inferential", JObject([kv("status", JString("not_computed")), kv("reason", JString("v0.1 is descriptive; project clustering and selection prevent population claims"))])), kv("costProvenance", JString("reported micro-units only; metered billing not established")), kv("timeBasis", JString(p.snapshot.timeBasis)), kv("artifactLineageScope", JString("observed within snapshot; acceptedMs/id order, not proof of original creation")), kv("artifacts", JArray(map(\a. JObject([kv("id", JString(a.id)), kv("repo", JString(a.repo)), kv("language", JString(a.language)), kv("cluster", JString(a.cluster)), kv("paths", JArray(map(\path. JString(path), a.paths))), kv("touches", jint(a.touches)), kv("confirmedRepairTouches", jint(a.repairTouches)), kv("featureTouches", jint(a.featureTouches)), kv("otherOrUncertainTouches", jint(a.otherTouches))]), artifacts(p.snapshot.episodes)))), kv("groups", JArray(map(\g. summaryJson(g), p.groups))), kv("comparison", comp)])
      let artifactTable = join("\n", map(\a. artifactRow(a), artifacts(p.snapshot.episodes)))
      let table = join("\n", map(\r. tableRow(r), p.groups))
      let markdown = join("\n", ["# Maintenance evidence", "", concat(["Report `", identity, "`; package 0.2.0; ", show(p.cohort.windowDays), "-day window; cutoff ", show(p.cohort.cutoffMs), " UTC milliseconds."]), "", "Exploratory project associations. Observed linked repairs are not true bug prevalence. No population inference is computed.", "", concat(["Source complete: ", show(p.cohort.complete), ". Eligible: ", show(size(p.cohort.eligible)), "; mature: ", show(size(p.cohort.mature)), "; censored: ", show(size(p.cohort.censored)), "; excluded: ", show(p.cohort.excluded), "; unlabelled: ", show(p.cohort.unlabelled), "."]), "", "| Project | Language | Eligible | Mature | Censored | Linked changes | Repair episodes | Intercepted repairs |", "|---|---|---:|---:|---:|---:|---:|---:|", table, "", "Observed artifact touches (within snapshot, not complete creation history):", "", "| Project | Observed paths | Touches | Confirmed repairs | Features | Other/uncertain |", "|---|---|---:|---:|---:|---:|", artifactTable, "", "Missing tokens/costs remain unknown. Detailed JSON carries known-value counts and unavailable states. Compiler identity is declared and must be externally attested. Derived updates and compiler repairs are separate workload categories.", ""])
      Ok({ json: encode(result), markdown: markdown })
    }, comparison)
  }, prepare(snapshotText, annotationText, manifestText))
