module sunholo/maintenance_bench/report
import ./types (Snapshot, Manifest)
import ./cohort (Cohort, applyAnnotations, buildCohort)
import ./codec (decodeSnapshot, decodeManifest, decodeAnnotations)
import ./metrics (Summary, summaries)
import ./compare (compareLanguages, deltaPP)
import ./report_json (summaryJson, pairJson, optionalNumber)
import std/json (Json, JObject, JArray, JString, JBool, JNull, kv, jint, encode)
import std/result (Result, Ok, Err, flatMap)
import std/option (Some, None)
import std/list (map, foldl, filter, length as size)
import std/string (join, replace)
import std/crypto (sha256Hex)
export type Analysis = {json:string,markdown:string}
export type Prepared = {snapshot:Snapshot,manifest:Manifest,cohort:Cohort,groups:[Summary]}
export pure func prepare(snapshotText: string, annotationText: string, manifestText: string) -> Result[Prepared,string] =
 flatMap(\s. flatMap(\labels. flatMap(\m. flatMap(\reviewed. flatMap(\c. Ok({snapshot:reviewed,manifest:m,cohort:c,groups:summaries(c,reviewed.episodes)}),buildCohort(reviewed,m)),applyAnnotations(s,labels)),decodeManifest(manifestText)),decodeAnnotations(annotationText)),decodeSnapshot(snapshotText))
func md(s: string) -> string = replace(replace(replace(replace(replace(replace(replace(s,"&","&amp;"),"<","&lt;"),">","&gt;"),"|","\\|"),"\n"," "),"[","\\["),"]","\\]")
func tableRow(r: Summary) -> string = "| ${md(r.repo)} | ${md(r.language)} | ${show(r.eligible)} | ${show(r.mature)} | ${show(r.censored)} | ${show(r.linkedRepairChanges)} | ${show(r.repairEpisodes)} | ${show(r.interceptedRepairs)} |"
func languageCount(groups: [Summary], language: string, linked: bool) -> int = foldl(\n r. n + (if linked then r.linkedRepairChanges else r.mature),0,filter(\r. r.language==language,groups))
export pure func analyse(snapshotText: string, annotationText: string, manifestText: string, left: string, right: string) -> Result[Analysis,string] = flatMap(\p. {
 let snapshotHash=sha256Hex(snapshotText);
 let annotationHash=sha256Hex(annotationText);
 let manifestHash=sha256Hex(manifestText);
 let identity=sha256Hex(encode(JArray(map(\s. JString(s),["maintenance_bench/0.1.0",p.manifest.metricVersion,p.manifest.compilerId,snapshotHash,annotationHash,manifestHash]))));
 let comparison=if left=="" && right=="" then Ok(JNull) else match compareLanguages(p.cohort.eligible,left,right) {
  Err(e)=>Err(e),Ok(pair)=>Ok(JObject([kv("kind",JString("descriptive_unadjusted_not_causal")),kv("left",JString(left)),kv("right",JString(right)),kv("observationalDeltaPP",optionalNumber(deltaPP(languageCount(p.groups,left,true),languageCount(p.groups,left,false),languageCount(p.groups,right,true),languageCount(p.groups,right,false)))),kv("semanticPairs",pairJson(pair))]))
 };
 flatMap(\comp. {
  let result=JObject([
   kv("schema",JString("maintenance.report/1")),kv("packageVersion",JString("0.1.0")),kv("metricVersion",JString(p.manifest.metricVersion)),kv("reportId",JString(identity)),kv("snapshotDigest",JString(snapshotHash)),kv("annotationDigest",JString(annotationHash)),kv("manifestDigest",JString(manifestHash)),kv("declaredCompilerId",JString(p.manifest.compilerId)),kv("identityProvenance",JString("compiler identity is declared input; attest actual runtime externally")),kv("source",JString(p.snapshot.source)),kv("sourceRef",JString(p.snapshot.sourceRef)),kv("cutoffMs",jint(p.cohort.cutoffMs)),kv("windowDays",jint(p.cohort.windowDays)),kv("sourceComplete",JBool(p.cohort.complete)),kv("excluded",jint(p.cohort.excluded)),kv("eligible",jint(size(p.cohort.eligible))),kv("mature",jint(size(p.cohort.mature))),kv("censored",jint(size(p.cohort.censored))),kv("unlabelled",jint(p.cohort.unlabelled)),kv("claim",JString("exploratory project associations; observed linked repairs are not true bug prevalence")),kv("inferential",JObject([kv("status",JString("not_computed")),kv("reason",JString("v0.1 is descriptive; project clustering and selection prevent population claims"))])),kv("costProvenance",JString("reported micro-units only; metered billing not established")),kv("groups",JArray(map(\g. summaryJson(g),p.groups))),kv("comparison",comp)
  ]);
  let table=join("\n",map(\r. tableRow(r),p.groups));
  let markdown="# Maintenance evidence\n\nReport `${identity}`; package 0.1.0; ${show(p.cohort.windowDays)}-day window; cutoff ${show(p.cohort.cutoffMs)} UTC milliseconds.\n\nExploratory project associations. Observed linked repairs are not true bug prevalence. No population inference is computed.\n\nSource complete: ${show(p.cohort.complete)}. Eligible: ${show(size(p.cohort.eligible))}; mature: ${show(size(p.cohort.mature))}; censored: ${show(size(p.cohort.censored))}; excluded: ${show(p.cohort.excluded)}; unlabelled: ${show(p.cohort.unlabelled)}.\n\n| Project | Language | Eligible | Mature | Censored | Linked changes | Repair episodes | Intercepted repairs |\n|---|---|---:|---:|---:|---:|---:|---:|\n${table}\n\nMissing tokens/costs remain unknown. Detailed JSON carries known-value counts and unavailable states. Compiler identity is declared and must be externally attested. Derived updates and compiler repairs are separate workload categories.\n";
  Ok({json:encode(result),markdown:markdown})
 },comparison)
},prepare(snapshotText,annotationText,manifestText))
