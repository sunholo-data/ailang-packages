func input() -> Result[{ bundle: RunBundle, receipts: [UsageReceipt] }, string] =
  flatMap(\b. flatMap(\rows. Ok({ bundle: b, receipts: rows }), decodeReceipts(usageText())), decodeRunBundle(planText(), runText()))

func result() -> Result[RunComparison, string] = flatMap(\i. compareRuns(i.bundle, i.receipts), input())

func knownEconomics() -> bool = match result() {
  Ok(c) => c.matched == 4 && c.bothPass == 4 && c.left.successes == 4 && c.right.successes == 4 && c.left.usage.leafCount == 13 && c.left.usage.failedLeaves == 1 && c.right.usage.leafCount == 12 && c.left.usage.costMicros.total == Some(150000) && c.right.usage.costMicros.total == Some(240000) && c.left.costPerSuccessMicros == Some(37500.0) && c.right.costPerSuccessMicros == Some(60000.0) && c.costPerSuccessDeltaMicros == Some(-22500.0),
  _ => false
}

test "independent matched-cohort economic fixture keeps retry cost" {
  knownEconomics()
}

func knownFresh() -> bool = match result() {
  Ok(c) => c.left.usage.fresh.total == Some(650) && c.right.usage.fresh.total == Some(1200) && c.freshTokenDelta == Some(-540) && c.freshInputTokenDelta == Some(-550) && c.deltaDirection == "left_minus_right",
  _ => false
}

test "fresh delta preserves left-minus-right direction and cache accounting" {
  knownFresh()
}

func unreportedCost() -> bool = match input() {
  Ok(i) => {
    let rows = map(\r. if r.id == "resource-1-ailang-economic-attempt-1-receipt" then { r | cost: { r.cost | amount: None, currency: None, basis: "unknown", priceVersion: None } } else r, i.receipts)
    match compareRuns(i.bundle, rows) {
      Ok(c) => c.left.costPerSuccessMicros == None && c.costPerSuccessDeltaMicros == None && c.left.costStatus != "available",
      _ => false
    }
  },
  _ => false
}

test "unreported cost cannot yield a cost-per-success saving" {
  unreportedCost()
}

func unreportedIdentity() -> bool = match input() {
  Ok(i) => {
    let rows = map(\r. if r.id == "resource-1-ailang-economic-attempt-1-receipt" then { r | identity: { r.identity | model: None } } else r, i.receipts)
    match compareRuns(i.bundle, rows) {
      Ok(c) => c.left.unknownReceiptIdentity == 1 && c.left.costStatus == "incomplete_attempt_usage" && c.costPerSuccessDeltaMicros == None && c.freshTokenDelta == None,
      _ => false
    }
  },
  _ => false
}

test "missing observed model identity blocks economic attribution" {
  unreportedIdentity()
}

func noSuccess() -> bool = match input() {
  Ok(i) => {
    let leftIds = map(\p. p.id, filter(\p. p.language == i.bundle.plan.leftLanguage, i.bundle.plan.trajectories))
    let runs = map(\r. if contains(leftIds, r.id) then { r | stages: map(\s. if s.id == "S1" then { s | oracle: "fail" } else s, r.stages) } else r, i.bundle.runs)
    match compareRuns({ i.bundle | runs: runs }, i.receipts) {
      Ok(c) => c.left.successes == 0 && c.left.unknown == 0 && c.left.usage.costMicros.total == Some(150000) && c.left.costStatus == "no_verified_success" && c.costPerSuccessDeltaMicros == None,
      _ => false
    }
  },
  _ => false
}

test "zero successful trajectories keep failed work charged but no ratio" {
  noSuccess()
}

func unknownOutcome() -> bool = match input() {
  Ok(i) => {
    let runs = map(\r. if r.id == "resource-1-ailang" then { r | stages: map(\s. if s.id == "S1" then { s | state: "budget_stopped", oracle: "not_run", oracleDigest: None, oracleArtifact: None } else s, r.stages) } else r, i.bundle.runs)
    match compareRuns({ i.bundle | runs: runs }, i.receipts) {
      Ok(c) => c.left.unknown == 1 && c.left.costStatus == "unknown_outcomes" && c.costPerSuccessDeltaMicros == None && c.freshTokenDelta == None,
      _ => false
    }
  },
  _ => false
}

test "missing independent outcome blocks comparisons" {
  unknownOutcome()
}

func missingAttempt() -> bool = match input() {
  Ok(i) => {
    let id = "resource-1-ailang-economic-attempt-1"
    let runs = map(\r. { r | stages: map(\s. { s | attempts: map(\a. if a.id == id then { a | receiptIds: [] } else a, s.attempts) }, r.stages) }, i.bundle.runs)
    let rows = filter(\r. r.id != "${id}-receipt", i.receipts)
    match compareRuns({ i.bundle | runs: runs }, rows) {
      Ok(c) => c.left.missingAttemptUsage == 1 && c.left.costStatus == "incomplete_attempt_usage" && c.costPerSuccessDeltaMicros == None,
      _ => false
    }
  },
  _ => false
}

test "an observed attempt without a leaf receipt is incomplete" {
  missingAttempt()
}

func unreferencedLeaf() -> bool = match input() {
  Ok(i) => match head(i.receipts) {
    Some(row) => {
      let extra = { row | id: "extra", identity: { row.identity | attemptId: "unknown-attempt", requestId: Some("extra") } }
      match compareRuns(i.bundle, extra :: i.receipts) {
        Err(_) => true,
        _ => false
      }
    },
    _ => false
  },
  _ => false
}

test "unreferenced normal leaf spend is rejected" {
  unreferencedLeaf()
}

func receiptDrift() -> bool = match input() {
  Ok(i) => {
    let rows = map(\r. if r.id == "resource-1-ailang-economic-attempt-1-receipt" then { r | identity: { r.identity | model: Some("unexpected-model") } } else r, i.receipts)
    match compareRuns(i.bundle, rows) {
      Err(_) => true,
      _ => false
    }
  },
  _ => false
}

test "receipt model drift is rejected rather than averaged" {
  receiptDrift()
}

func unmatchedWork() -> bool = match input() {
  Ok(i) => {
    let plan = { i.bundle.plan | trajectories: map(\p. if p.id == "resource-1-python" then { p | variant: "other-real-requirement" } else p, i.bundle.plan.trajectories) }
    match compareRuns({ i.bundle | plan: plan }, i.receipts) {
      Ok(c) => c.matched == 3 && c.unmatchedTrajectories == 2 && c.usage.costMicros.total == Some(390000) && c.unmatchedUsage.costMicros.total == Some(120000) && c.left.usage.costMicros.total == Some(90000) && c.right.usage.costMicros.total == Some(180000) && c.costPerSuccessDeltaMicros == Some(-30000.0),
      _ => false
    }
  },
  _ => false
}

test "unmatched work remains charged outside matched-cohort economics" {
  unmatchedWork()
}

func preparationOverhead() -> bool = match input() {
  Ok(i) => match head(i.receipts) {
    Some(row) => {
      let prep = { row | id: "prep", purpose: "preparation", failed: false, identity: { row.identity | attemptId: "prep-attempt", requestId: Some("prep-request"), model: None, harness: "preparation-tools" }, cost: { row.cost | amount: Some("0.10") } }
      match compareRuns(i.bundle, prep :: i.receipts) {
        Ok(c) => c.usage.costMicros.total == Some(490000) && c.overheadUsage.costMicros.total == Some(100000) && c.left.usage.costMicros.total == Some(150000) && c.costPerSuccessDeltaMicros == Some(-22500.0),
        _ => false
      }
    },
    _ => false
  },
  _ => false
}

test "unallocated preparation overhead stays visible and globally charged" {
  preparationOverhead()
}

func differentContract() -> bool = match input() {
  Ok(i) => {
    let plan = { i.bundle.plan | trajectories: map(\p. if p.id == "resource-1-python" then { p | stages: map(\s. if s.id == "S1" then { s | requirementDigest: p.starterDigest } else s, p.stages) } else p, i.bundle.plan.trajectories) }
    match compareRuns({ i.bundle | plan: plan }, i.receipts) {
      Err(_) => true,
      _ => false
    }
  },
  _ => false
}

test "matching labels cannot hide different stage requirements" {
  differentContract()
}

func differentProvider() -> bool = match input() {
  Ok(i) => {
    let rightAttempts = flatten(\r. flatten(\s. map(\a. a.id, s.attempts), r.stages), filter(\r. r.id == "resource-1-python" || r.id == "resource-2-python" || r.id == "text-1-python" || r.id == "text-2-python", i.bundle.runs))
    let rows = map(\r. if contains(rightAttempts, r.identity.attemptId) then { r | identity: { r.identity | provider: Some("OTHER_FIXTURE") } } else r, i.receipts)
    match compareRuns(i.bundle, rows) {
      Ok(c) => c.left.costPerSuccessMicros == Some(37500.0) && c.right.costPerSuccessMicros == Some(60000.0) && c.costPerSuccessDeltaMicros == None && c.costDeltaStatus == "provider_mismatch",
      _ => false
    }
  },
  _ => false
}

test "different provider treatments cannot produce a language delta" {
  differentProvider()
}

func unknownCache() -> bool = match input() {
  Ok(i) => {
    let rows = map(\r. if r.id == "resource-1-ailang-economic-attempt-1-receipt" then { r | tokens: { r.tokens | cacheReported: false, cacheRead: Some(0), cacheWrite: Some(0) } } else r, i.receipts)
    match compareRuns(i.bundle, rows) {
      Ok(c) => c.left.freshStatus == "unreported_or_unreconciled_tokens" && c.freshTokenDelta == None && c.costPerSuccessDeltaMicros == Some(-22500.0),
      _ => false
    }
  },
  _ => false
}

test "unknown cache split blocks token delta while attested billed cost stays separate" {
  unknownCache()
}

func invalidThenFailure() -> bool = match input() {
  Ok(i) => {
    let runs = map(\r. if r.id == "resource-1-ailang" then { r | stages: map(\s. if s.id == "S1" then { s | state: "invalid", oracle: "not_run", oracleDigest: None, oracleArtifact: None } else if s.id == "S2" then { s | oracle: "fail" } else s, r.stages) } else r, i.bundle.runs)
    match compareRuns({ i.bundle | runs: runs }, i.receipts) {
      Ok(c) => c.left.unknown == 1 && c.unknownPairs == 1 && c.left.costStatus == "unknown_outcomes" && c.costStatus == "unknown_outcomes" && c.costPerSuccessDeltaMicros == None,
      _ => false
    }
  },
  _ => false
}

test "invalid continuation cannot become a known model failure" {
  invalidThenFailure()
}

func swappedProviderTreatments() -> bool = match input() {
  Ok(i) => {
    let aIds = flatten(\r. flatten(\s. map(\a. a.id, s.attempts), r.stages), filter(\r. r.id == "resource-1-ailang" || r.id == "resource-2-ailang" || r.id == "text-1-python" || r.id == "text-2-python", i.bundle.runs))
    let rows = map(\r. { r | identity: { r.identity | provider: Some(if contains(aIds, r.identity.attemptId) then "FIXTURE_A" else "FIXTURE_B") } }, i.receipts)
    match compareRuns(i.bundle, rows) {
      Ok(c) => c.costDeltaStatus == "provider_mismatch" && c.costPerSuccessDeltaMicros == None,
      _ => false
    }
  },
  _ => false
}

test "equal aggregate provider sets do not hide per-pair provider drift" {
  swappedProviderTreatments()
}

func missingGeneratedControl() -> bool = match input() {
  Ok(i) => match compareRuns(i.bundle, map(\r. { r | tokens: { r.tokens | output: None, reasoning: None, reasoningReported: false, outputScheme: "unknown" } }, i.receipts)) {
    Ok(c) => c.freshTokenDelta == None && c.left.usage.freshGenerated.total == None && c.freshInputTokenDelta == Some(-550) && c.costPerSuccessDeltaMicros == Some(-22500.0),
    _ => false
  },
  _ => false
}

test "missing generated tokens block total token KPI but preserve input diagnostic" {
  missingGeneratedControl()
}

func exactEditBound(extra: int) -> bool = match input() {
  Ok(i) => {
    let rows = map(\r. { r | stages: map(\s. { s | attempts: map(\a. { a | localEdits: Some(if a.id == "resource-1-ailang-economic-attempt-1-failed-retry" then 9007199254740991 else if a.id == "resource-1-ailang-economic-attempt-1" then extra else 0) }, s.attempts) }, r.stages) }, i.bundle.runs)
    match summarizeRuns({ i.bundle | runs: rows }) {
      Ok(x) => extra == 0 && x.knownLocalEdits == 9007199254740991,
      Err(_) => extra > 0
    }
  },
  _ => false
}

test "exact edit aggregation boundary remains lossless" {
  exactEditBound(0)
}

test "one edit above exact boundary is refused" {
  exactEditBound(1)
}
