module sunholo/maintenance_bench/evidence_card_test
import ./evidence_card (qualifyCard, decodeCards)
import std/result (Ok, Err)
import std/list (head)
import std/option (Some, None)
import std/string (replace)

test "empty evidence cannot become design ready" {
  match decodeCards("{\"schema\":\"maintenance.cards/2\",\"cards\":[{}]}") {
    Err(_) => true,
    _ => false
  }
}

func seedCards() -> string =
  "{\"schema\":\"maintenance.cards/2\",\"cards\":[{\"id\":\"ailang-historical-semantic-regression\",\"state\":\"reproduced\",\"role\":\"development\",\"obligation\":\"retained image bytes remain owned by their document\",\"beforeId\":\"d8c04a66993d8abbe97a286be40ac975d1858557\",\"afterId\":\"583e7d57cc53455af2268cd9fdb140507463941e\",\"oracleDigest\":\"23740ab833c67ae16ca0adb497d1a4831a7ab35b8a62ab75f4f742b467f3f991\",\"reproducer\":\"sh research/real-world-maintenance/mature-2026-10-23/reproductions/reproduce_cases.sh\",\"beforeCompiled\":true,\"afterCompiled\":true,\"beforeFails\":true,\"afterPasses\":true,\"mutationControls\":0,\"usageStatus\":\"unknown\",\"claim\":\"reproduction\",\"route\":\"package\",\"reuseAudit\":null,\"alternative\":\"A requirement-specific application fix may suffice; no reusable language deficiency established.\",\"consumers\":[\"ailang-parse\"],\"severityException\":null,\"model\":\"unknown-historical\",\"harness\":\"historical-component-probe\",\"toolchain\":\"AILANG v0.54.17 / rustc 1.98.0 as applicable; see immutable evidence\",\"configDigest\":\"0c0e2d30f37b764e9f57bdc1ed5983ff94a09776d4487222f48c5ad8076f6690\",\"scope\":\"production extractMediaToFiles component on pinned modern runtime; application repair already shipped\"},{\"id\":\"rust-historical-semantic-regression\",\"state\":\"reproduced\",\"role\":\"development\",\"obligation\":\"logical text and explicit preserve-space survive trimming\",\"beforeId\":\"058cb507c8d74541f96d6439b6abd80e52f0c058\",\"afterId\":\"bec70ca56621a6aab429d676a14ee8db5b1a3c1c\",\"oracleDigest\":\"23740ab833c67ae16ca0adb497d1a4831a7ab35b8a62ab75f4f742b467f3f991\",\"reproducer\":\"sh research/real-world-maintenance/mature-2026-10-23/reproductions/reproduce_cases.sh\",\"beforeCompiled\":true,\"afterCompiled\":true,\"beforeFails\":true,\"afterPasses\":true,\"mutationControls\":0,\"usageStatus\":\"unknown\",\"claim\":\"reproduction\",\"route\":\"investigation\",\"reuseAudit\":null,\"alternative\":\"A requirement-specific application fix may suffice; no reusable language deficiency established.\",\"consumers\":[\"calamine\"],\"severityException\":null,\"model\":\"unknown-historical\",\"harness\":\"historical-component-probe\",\"toolchain\":\"AILANG v0.54.17 / rustc 1.98.0 as applicable; see immutable evidence\",\"configDigest\":\"0c0e2d30f37b764e9f57bdc1ed5983ff94a09776d4487222f48c5ad8076f6690\",\"scope\":\"production text trimming with old focused tests and two new semantic checks\"}]}"

test "historical controls support reproduced cards with unknown economics" {
  match decodeCards(seedCards()) {
    Ok(xs) => true,
    Err(_) => false
  }
}

func badMutation() -> bool = match decodeCards(replace(seedCards(), "reproduced", "design_ready")) {
  Err(_) => true,
  _ => false
}

test "missing mutation and reuse audit block design ready" {
  badMutation()
}

func badEconomics() -> bool = match decodeCards(replace(seedCards(), "reproduction", "economic")) {
  Err(_) => true,
  _ => false
}

test "unknown costs block economic claim" {
  badEconomics()
}

func badWin() -> bool = match decodeCards(replace(seedCards(), "reproduction", "language_advantage")) {
  Err(_) => true,
  _ => false
}

test "small exposed evidence cannot declare language advantage" {
  badWin()
}

func badBuild() -> bool =
  match decodeCards(replace(seedCards(), "\"beforeCompiled\":true", "\"beforeCompiled\":false")) {
    Err(_) => true,
    _ => false
  }

test "failed build is not semantic regression evidence" {
  badBuild()
}

func contradictoryArtifact() -> bool =
  match decodeCards(replace(seedCards(), "583e7d57cc53455af2268cd9fdb140507463941e", "d8c04a66993d8abbe97a286be40ac975d1858557")) {
    Err(_) => true,
    _ => false
  }

test "same candidate cannot fail before and pass after unchanged" {
  contradictoryArtifact()
}

func inventedDigest() -> bool =
  match decodeCards(replace(seedCards(), "0c0e2d30f37b764e9f57bdc1ed5983ff94a09776d4487222f48c5ad8076f6690", "not-a-digest")) {
    Err(_) => true,
    _ => false
  }

test "unbound text is not a configuration digest" {
  inventedDigest()
}

func unboundEconomics() -> bool =
  match decodeCards(replace(replace(seedCards(), "reproduction", "economic"), "unknown", "known")) {
    Err(_) => true,
    _ => false
  }

test "standalone known label cannot qualify an economic card" {
  unboundEconomics()
}

func severityDraft() -> bool = match decodeCards(seedCards()) {
  Ok(xs) => match head(xs) {
    Some(c) => match qualifyCard({ c | identity: { c.identity | state: "design_ready" }, evidence: { c.evidence | mutationControls: 1 }, context: { c.context | reuseAudit: Some("explicit application/package reuse audit in synthetic policy control"), severityException: Some("documented severe single-case exception for reviewer") } }) {
      Ok(_) => true,
      _ => false
    },
    None => false
  },
  _ => false
}

test "explicit severe-case exception can qualify a reproduction draft for review" {
  severityDraft()
}
