module sunholo/maintenance_bench/_smoke
import ./report (analyse)
import ./verify_snapshot (verifySnapshot)
import ./codec (encodeSnapshot, encodeAnnotations, encodeManifest)
import ./reference (data, label, manifest)
import std/result (Ok, Err)
import std/io (println, exit)
export func main() -> () ! {IO} = match analyse(encodeSnapshot(data()),encodeAnnotations([label("r1")]),encodeManifest(manifest()),"","") {
 Err(e)=>{println(e);exit(1)},Ok(report)=>match verifySnapshot(report.json,"{\"schema\":\"maintenance.expectation/1\",\"eligible\":3,\"mature\":3,\"censored\":0,\"excluded\":0,\"groups\":[{\"repo\":\"project/a\",\"language\":\"ailang\",\"mature\":3,\"linkedRepairChanges\":1,\"knownRepairDefects\":1,\"knownRepairRounds\":1,\"interceptedRepairs\":0}]}") {
  Err(e)=>{println(e);exit(1)},Ok(_)=>println("OK: independent maintenance counts verified; offline smoke")
 }
}
