-- sunholo/oauth/token — credential storage and the refresh→access exchange.
--
-- The runtime half of OAuth2: you have a refresh token on disk, you need a
-- bearer token now. Provider-agnostic; the token endpoint is a parameter.
--
-- Credentials are stored in Google's ADC "authorized_user" shape:
--   { "type": "authorized_user", "client_id", "client_secret", "refresh_token" }
-- not because this is Google-specific but because it is an existing, boring
-- convention that sunholo/gcp_auth already reads, so files written here work
-- with gcloud tooling unchanged.

module sunholo/oauth/token

import std/fs (readFile, writeFile, fileExists)
import std/net (httpRequest, urlEncodeForm)
import std/json (decode, getString)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)

-- A long-lived grant. The refresh token is the secret worth protecting; the
-- client id and secret identify the app, not the user.
export type OAuthCreds = {
  clientId: string,
  clientSecret: string,
  refreshToken: string
}

-- Read credentials from a path. Accepts the ADC "authorized_user" shape.
export func readCreds(path: string) -> Result[OAuthCreds, string] ! {FS @limit=5} {
  if not(fileExists(path)) then Err("no credentials at ${path}")
  else {
    let raw = readFile(path);
    match decode(raw) {
      Ok(doc) => {
        let cid = match getString(doc, "client_id") { Some(s) => s, None => "" };
        let sec = match getString(doc, "client_secret") { Some(s) => s, None => "" };
        let ref = match getString(doc, "refresh_token") { Some(s) => s, None => "" };
        if cid == "" then Err("no client_id in ${path}")
        else if sec == "" then Err("no client_secret in ${path}")
        else if ref == "" then Err("no refresh_token in ${path}")
        else Ok({ clientId: cid, clientSecret: sec, refreshToken: ref })
      },
      Err(e) => Err("could not parse ${path}: ${e}")
    }
  }
}

-- Write credentials in ADC "authorized_user" shape.
--
-- CAUTION: std/fs.writeFile takes no mode, so the file lands at the process
-- umask — typically 0644 for a document that is a live credential. Callers
-- must chmod 600 afterwards. There is no way to do that from AILANG today.
export func writeCreds(path: string, creds: OAuthCreds) -> () ! {FS @limit=2} {
  writeFile(path,
    "{\"type\":\"authorized_user\",\"client_id\":\"${creds.clientId}\",\"client_secret\":\"${creds.clientSecret}\",\"refresh_token\":\"${creds.refreshToken}\"}")
}

-- Exchange a refresh token for a short-lived access token.
--
-- tokenUrl is the provider's token endpoint, e.g.
--   Google:   https://oauth2.googleapis.com/token
--   LinkedIn: https://www.linkedin.com/oauth/v2/accessToken
export func exchangeRefresh(
  tokenUrl: string,
  creds: OAuthCreds
) -> Result[string, string] ! {Net @limit=1} {
  -- urlEncodeForm, not interpolation: a client secret containing "+" or "&"
  -- silently corrupts a hand-built body, and the failure looks like bad
  -- credentials rather than bad encoding.
  let form = urlEncodeForm([
    { name: "grant_type", value: "refresh_token" },
    { name: "refresh_token", value: creds.refreshToken },
    { name: "client_id", value: creds.clientId },
    { name: "client_secret", value: creds.clientSecret }
  ]);
  postForm(tokenUrl, form)
}

-- Shared POST + parse. Kept private so both exchanges fail identically.
--
-- NOTE for callers writing their own: httpRequest is (METHOD, URL, headers,
-- body). Both leading parameters are `string`, so swapping them type-checks
-- and fails at runtime with InvalidMethod, in about a millisecond, looking
-- exactly like a dead network.
export func postFormBody(url: string, form: string) -> Result[string, string] ! {Net @limit=1} {
  let hdrs = [{ name: "Content-Type", value: "application/x-www-form-urlencoded" }];
  match httpRequest("POST", url, hdrs, form) {
    Ok(resp) =>
      if resp.ok then Ok(resp.body)
      else Err("token endpoint returned ${show(resp.status)}: ${resp.body}"),
    -- `show` rather than an exhaustive match: NetError carries variants the
    -- docs do not list (InvalidMethod, found 2026-09-08), and matching only
    -- the documented ones turns a bad error into "no pattern matched".
    Err(e) => Err("transport: ${show(e)}")
  }
}

-- The common case: POST a form and pull out access_token.
-- The authorization-code exchange needs the whole payload instead, so it
-- calls postFormBody directly.
export func postForm(url: string, form: string) -> Result[string, string] ! {Net @limit=1} {
  match postFormBody(url, form) {
    Ok(payload) => match decode(payload) {
      Ok(doc) => match getString(doc, "access_token") {
        Some(t) => Ok(t),
        None => Err("no access_token in response: ${payload}")
      },
      Err(e) => Err("could not parse token response: ${e}")
    },
    Err(e) => Err(e)
  }
}
