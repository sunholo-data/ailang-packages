module sunholo/test_pkg_consumer/wrap

-- Wraps sunholo/test_pkg/hello so a bump to test_pkg cascades into a
-- bump here. Used by the M-PKG-AUTONOMOUS-CASCADE-SAFE smoke tests.

import pkg/sunholo/test_pkg/hello (greet)

export func greetExcited(name: string) -> string =
  "${greet(name)} (via consumer)"

export func consumerVersion() -> string =
  "test-pkg-consumer"
