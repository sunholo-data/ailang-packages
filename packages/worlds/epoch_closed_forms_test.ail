module sunholo/worlds/epoch_closed_forms_test
-- R3-UNIVERSE-LAB UL2a3: ended-state bins, the late-contact share and the
-- closed form for a lineage rate. Check values are the proposed registry rows
-- LW-49p to LW-51p and the table of stapledons-design
-- features/next/seti-factors.md s3.4, at their printed figures.
import ./epoch_statistics (EpochError,EpochParamsInvalid,EpochYearsInvalid,EpochCountInvalid,LineageCountInvalid,LineagesOverlap,EndedShares,LineageShares,traceCappedMean,historyProbabilities,endedShares,endedWorlds,lateShare,lineageShares)
import ./baseline (baseline)
import ./dial (Params,applyDial,zeroDial)
import ./history (PlanetState,Remnant,Ecocide,Transcended,historyOf,stateAt)
import std/result (Result,Ok,Err)
import std/math (abs_Float,intToFloat,exp,sqrt)
import std/list (foldl,range)

pure func near(a:float,b:float,tol:float) -> bool = abs_Float(a-b)<=tol
pure func rel(a:float,b:float,tol:float) -> bool = abs_Float(a-b)<=tol*abs_Float(b)
pure func fails[a](r:Result[a,EpochError],why:EpochError) -> bool = match r {Err(e) => e==why, Ok(v) => false}
pure func saturated(years:float) -> Params = {fLife:1.0,fComplex:1.0,fMinds:1.0,fTech:1.0,lifetimeYr:years,windowYr:5e9,remnantLoYr:1e3,remnantHiYr:1e7}
pure func ended(p:Params) -> EndedShares = match endedShares(p) {Ok(v) => v, Err(e) => {remnant:-1.0,ecocide:-1.0,transcended:-1.0}}
pure func late(gap:float,years:float) -> float = match lateShare(gap,years) {Ok(v) => v, Err(e) => -1.0}
pure func lineages(p:Params,n:float) -> LineageShares = match lineageShares(p,n) {Ok(v) => v, Err(e) => {alive:-1.0,remnant:-1.0,spacingYr:-1.0,quietYr:-1.0}}

test "LW-49p, LW-50p, LW-51p: mean persistence, saturated remnant share and baseline living share at printed figures" {
 let z=applyDial(baseline(),zeroDial());
 near(traceCappedMean(1e3,1e7,1e100),1.086e6,0.0005e6)
 && near(ended(saturated(3.2e7)).remnant,1.63e-4,0.005e-4)
 && near(historyProbabilities(z,0.0).tech,3.998e-8,0.0005e-8)
 && rel(historyProbabilities(z,0.0).tech,z.fLife*z.fMinds*z.fTech*z.lifetimeYr/z.windowYr,1e-15)
}
test "the remnant bin is historyProbabilities' remnant, bit for bit; ecocide and transcended are their shares of the lineages already ended" {
 let z=applyDial(baseline(),zeroDial());
 let lineage=z.fLife*z.fMinds*z.fTech;
 let e=ended(z);
 e.remnant==historyProbabilities(z,0.0).remnant
 && rel(e.ecocide,lineage*0.15*(2.5e9-1e5)/5e9,1e-15) && rel(e.transcended,lineage*0.10*(2.5e9-1e5)/5e9,1e-15)
 && rel(e.ecocide/e.transcended,1.5,1e-15)
}
test "hand values on a small window, and nothing has ended when the lifetime fills the past half-window" {
 let p={fLife:0.5,fComplex:0.5,fMinds:0.4,fTech:0.5,lifetimeYr:4.0,windowYr:10.0,remnantLoYr:1.0,remnantHiYr:2.0};
 let e=ended(p);
 let full=ended({p|lifetimeYr:5.0});
 near(e.remnant,0.0075,1e-15) && near(e.ecocide,0.1*0.15*1.0/10.0,1e-16) && near(e.transcended,0.1*0.10*1.0/10.0,1e-16)
 && full.remnant==0.0 && full.ecocide==0.0 && full.transcended==0.0
 && ended({p|lifetimeYr:50.0}).ecocide==0.0
}
test "expected worlds by bin are the shares times the habitable-zone worlds" {
 let z=applyDial(baseline(),zeroDial());
 match endedWorlds(z,1339731.6428103606) {
  Ok(w) => rel(w.remnant,1339731.6428103606*ended(z).remnant,1e-15) && rel(w.ecocide,1339731.6428103606*ended(z).ecocide,1e-15)
   && rel(w.transcended,1339731.6428103606*ended(z).transcended,1e-15) && w.remnant>0.4 && w.remnant<0.5,
  Err(e) => false
 }
}
-- 20000 histories from historyOf on a lattice of uniforms, every world a
-- lineage, long traces so that all three bins are visible at epoch 0.
pure func busy() -> Params = {fLife:1.0,fComplex:1.0,fMinds:1.0,fTech:1.0,lifetimeYr:5e8,windowYr:5e9,remnantLoYr:1e8,remnantHiYr:1e9}
pure func lattice(n:int) -> [float] = [
 (intToFloat((n*7919)%20000)+0.5)/20000.0,(intToFloat((n*3571)%20000)+0.5)/20000.0,
 (intToFloat((n*1237)%20000)+0.5)/20000.0,(intToFloat((n*1777)%20000)+0.5)/20000.0,
 (intToFloat(n)+0.5)/20000.0,(intToFloat((n*3019)%20000)+0.5)/20000.0,
 (intToFloat((n*4567)%20000)+0.5)/20000.0,(intToFloat((n*4051)%20000)+0.5)/20000.0]
pure func count(n:int,r:int,e:int,t:int) -> (int,int,int) =
 if n==20000 then (r,e,t) else {
  let s=stateAt(historyOf(busy(),true,lattice(n)),0.0);
  count(n+1,if s==Remnant then r+1 else r,if s==Ecocide then e+1 else e,if s==Transcended then t+1 else t)
 }
pure func within(k:int,p:float) -> bool = abs_Float(intToFloat(k)/20000.0-p)<=4.0*sqrt(p*(1.0-p)/20000.0)
test "20000 histories from historyOf: the three ended bins at epoch 0 within 4 standard errors of the closed forms" {
 let e=ended(busy());
 match count(0,0,0,0) {(r,ec,tr) => within(r,e.remnant) && within(ec,e.ecocide) && within(tr,e.transcended) && e.ecocide==0.06 && near(e.transcended,0.04,1e-16) && e.remnant>0.05}
}
test "the late-contact share is min(1, G/L): the fraction of living civilisations that end within G years" {
 late(600.0,3.2e7)==600.0/3.2e7 && late(16000.0,1e6)==0.016 && late(1e4,1e4)==1.0 && late(16000.0,1e4)==1.0
 && late(0.0,1e5)==0.0
 && fails(lateShare(-1.0,1e5),EpochYearsInvalid) && fails(lateShare(600.0,0.0),EpochYearsInvalid)
 && fails(lateShare(0.0/0.0,1e5),EpochYearsInvalid) && fails(lateShare(600.0,0.0/0.0),EpochYearsInvalid)
}
-- seti-factors s3.4: A = 6.4e-3 held fixed, lifetime traded against the number
-- of lineages. Columns: lineages per planet, one every (yr), ends within the
-- 16,000 yr game, ends in a 600 yr gap, remnant share.
pure func rowOk(years:float,n:float,every:float,everyHalf:float,game:float,gameHalf:float,gap:float,gapHalf:float,remnant:float,remnantHalf:float) -> bool {
 let v=lineages(saturated(years),n);
 rel(v.alive,6.4e-3,1e-14) && rel(n,6.4e-3*5e9/years,1e-14) && near(v.spacingYr,every,everyHalf)
 && near(late(16000.0,years),game,gameHalf) && near(late(600.0,years),gap,gapHalf) && near(v.remnant,remnant,remnantHalf)
}
test "seti-factors s3.4, rows 1 and 2, at printed figures" {
 rowOk(3.2e7,1.0,5e9,0.5,0.0005,0.00005,0.00002,0.000005,0.00016,0.000005)
 && rowOk(1e6,32.0,156e6,0.5e6,0.016,0.0005,0.0006,0.00005,0.005,0.0005)
}
-- Two printed cells do not follow from a fixed lifetime. A civilisation that
-- lasts exactly L and is alive now ends within G years with probability
-- min(1, G/L): 16 % at L = 1e5 and 100 % at L = 1e4. The table prints 15 % and
-- 80 %, which are 1-exp(-G/L): a memoryless lifetime, not this model's. The
-- package keeps the fixed lifetime of history.ail and records the difference.
test "seti-factors s3.4, rows 3 and 4: every column but the two memoryless cells, which are 16 % and 100 % here" {
 let r3=lineages(saturated(1e5),320.0);
 let r4=lineages(saturated(1e4),3200.0);
 rel(r3.alive,6.4e-3,1e-14) && near(r3.spacingYr,15.6e6,0.05e6) && near(late(600.0,1e5),0.006,0.0005) && near(r3.remnant,0.05,0.005)
 && rel(r4.alive,6.4e-3,1e-14) && near(r4.spacingYr,1.56e6,0.005e6) && near(late(600.0,1e4),0.06,0.005) && near(r4.remnant,0.23,0.005)
 && late(16000.0,1e5)==0.16 && late(16000.0,1e4)==1.0
 && near(1.0-exp(0.0-0.16),0.15,0.005) && near(1.0-exp(0.0-1.6),0.80,0.005)
}
test "the lineage closed form: one lineage is the history model away from its window edge; traces are cut by the next onset" {
 let z=applyDial(baseline(),zeroDial());
 let one=lineages(z,1.0);
 let many=lineages(saturated(1e4),3200.0);
 rel(one.alive,historyProbabilities(z,0.0).tech,1e-15) && rel(one.remnant,historyProbabilities(z,0.0).remnant,1e-15)
 && one.spacingYr==5e9 && one.quietYr==5e9-1e5
 && many.quietYr==1562500.0-1e4 && rel(many.remnant,3200.0*0.75*traceCappedMean(1e3,1e7,1552500.0)/5e9,1e-15)
 && rel(lineages(saturated(1e4),500000.0).alive,1.0,1e-15) && lineages(saturated(1e4),500000.0).remnant==0.0
}
test "a lineage rate outside the closed form is refused: overlapping lineages, no lineages, invalid parameters" {
 fails(lineageShares(saturated(1e4),500001.0),LineagesOverlap)
 && fails(lineageShares(saturated(1e5),0.0),LineageCountInvalid)
 && fails(lineageShares(saturated(1e5),-3.0),LineageCountInvalid)
 && fails(lineageShares(saturated(1e5),0.0/0.0),LineageCountInvalid)
 && fails(lineageShares({saturated(1e5)|fTech:1.5},2.0),EpochParamsInvalid)
 && fails(endedShares({saturated(1e5)|fLife:-0.1}),EpochParamsInvalid)
 && fails(endedShares({saturated(1e5)|windowYr:0.0}),EpochParamsInvalid)
 && fails(endedWorlds(saturated(1e5),-1.0),EpochCountInvalid)
 && fails(endedWorlds(saturated(1e5),0.0/0.0),EpochCountInvalid)
}
-- Probe for tools/selection_validation.md. Not a public export.
pure func rowText(years:float,n:float) -> string {
 let v=lineages(saturated(years),n);
 "L ${years} lineages ${n} every ${v.spacingYr} alive ${v.alive} endsIn16000 ${late(16000.0,years)} endsIn600 ${late(600.0,years)} remnant ${v.remnant}\n"
}
export pure func closedFormProbe() -> string {
 let z=applyDial(baseline(),zeroDial());
 let e=ended(z);
 let s=ended(saturated(3.2e7));
 "LW-49p ${traceCappedMean(1e3,1e7,1e100)} LW-50p ${s.remnant} LW-51p ${historyProbabilities(z,0.0).tech}\nbaseline ended remnant ${e.remnant} ecocide ${e.ecocide} transcended ${e.transcended}\n${rowText(3.2e7,1.0)}${rowText(1e6,32.0)}${rowText(1e5,320.0)}${rowText(1e4,3200.0)}"
}
