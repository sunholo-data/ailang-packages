module sunholo/worlds/_smoke
import ./baseline (baseline,baselineVersion,quantileOf,AbiogenesisRate)
import ./dial (Params,applyDial,zeroDial,luckDex)
import ./disc (starsWithin,radiusQuantile,aliveWithin,existInWindow)
import ./occurrence (sag13Expected,sag13Sample)
import ./history (historyOf,stateAt,epochs,Technological)
import ./epoch_statistics (historyProbabilities)
import ./propagate (certain,validBelief,transitionRates,propagate,propagateExact,PredictionError,OutsideExactDomain)
import ./selection (drawParams,dialOf,acceptanceProbability,expectedDraws,luckProbability,AtLeast,AnyCount)
import ./epoch_statistics (endedShares)
import std/result (Result,Ok,Err)
import std/io (println,exit)
import std/math (abs_Float)
import std/string (join)
import std/list (map)
-- The 0.3.0 additions, in their own function: with them inline, main exceeds
-- the strict VM's 256-register limit for one function.
func selectionSmoke(p:Params,n:float) -> bool ! {IO} {
 let drawn=drawParams(baseline(),[0.6,0.7,0.4,0.55]);
 let setting={hzWorlds:0.2*n,reach:[{lifetimeYr:1e5,share:1.0}],endedYr:0.0,gapYr:0.0,found:AtLeast(3.0),ended:AnyCount,late:AnyCount};
 let chance=acceptanceProbability(baseline(),setting,1);
 let selected=match (drawn,chance) {
  (Ok(q),Ok(c)) => (match dialOf(baseline(),q) {Ok(d) => abs_Float(c.p-0.1255402977194)<1e-9 && abs_Float(luckDex(baseline(),d)-0.8992000846277812)<1e-9, Err(e) => false}),
  _ => false
 };
 match chance {
  Ok(c) => println("selection: 3 living within 1000 ly p ${c.p} error ${c.error} oneIn ${match expectedDraws(c) {Ok(v) => v, Err(e) => -1.0}}"),
  Err(e) => println("selection: ERR")
 };
 match luckProbability(baseline(),applyDial(baseline(),{life:3.0,minds:3.0,tech:3.0,lifetime:2.505149978319906}),1) {
  Ok(c) => println("selection: calibrated universe p ${c.p}"),
  Err(e) => println("selection: ERR")
 };
 match endedShares(p) {
  Ok(e) => println("ended shares ${e.remnant} ${e.ecocide} ${e.transcended}"),
  Err(e) => println("ended shares: ERR")
 };
 selected
}
export func main() -> () ! {IO} {
 let p=applyDial(baseline(),zeroDial());
 let m={rho0Pc3:0.079,scaleHeightPc:300.0};
 let h=historyOf(p,true,[0.1,0.001,0.5,0.01,0.5,0.7,0.2,0.5]);
 let n=starsWithin(m,1000.0);
 let half=radiusQuantile(m,3000.0,0.75);
 let total=sag13Expected(0.5,16.0,0.5,640.0);
 let rates=historyProbabilities(p,16000.0);
 let unknown={sterile:0.0,microbial:0.0,complex:0.0,preTech:0.0,technological:0.0,remnant:0.0,transcended:0.0,ecocide:0.0};
 let chain=match transitionRates(p) {
  Ok(r) => match propagate(certain(Technological),r,867.0) {Ok(b) => b, Err(e) => unknown},
  Err(e) => unknown
 };
 let exact=match propagateExact(certain(Technological),p,867.0) {Ok(b) => b, Err(e) => unknown};
 let refused=propagateExact(certain(Technological),p,3e9)==Err(OutsideExactDomain);
 let ok=refused && validBelief(chain) && validBelief(exact) && abs_Float(exact.technological-0.99133)<1e-12 && abs_Float(n-6698658.214051803)<1e-7 && abs_Float(total-2.9017005327211267)<1e-13
  && abs_Float(starsWithin(m,half)/starsWithin(m,3000.0)-0.75)<1e-12
  && luckDex(baseline(),zeroDial())==0.0 && stateAt(h,0.0)==Technological
  && rates.life==p.fLife && rates.tech>0.0 && rates.mindsWindow>=rates.tech && rates.remnant>0.0;
 println(baselineVersion());
 println("params ${p.fLife} ${p.fComplex} ${p.fMinds} ${p.fTech} ${p.lifetimeYr} ${p.windowYr} ${p.remnantLoYr} ${p.remnantHiYr}");
 println("luck ${luckDex(baseline(),zeroDial())}");
 println("lifeQ25 ${quantileOf(AbiogenesisRate,0.25)}");
 println("stars ${n} tiny ${starsWithin(m,1e-6)} radiusQ75 ${half}");
 println("alive ${aliveWithin(m,1000.0,0.00012,p)} overlap ${existInWindow(m,3000.0,0.00012,p,24000.0)}");
 match sag13Sample(0.9,0.8) {(r,period)=>println("SAG13 ${total} sample ${r} ${period}")};
 println(join(";",map(\e. match e {(s,t)=>"${show(s)}:${t}"},epochs(h))));
 println("epoch probabilities ${rates.life} ${rates.mindsWindow} ${rates.tech} ${rates.remnant}");
 println("arrival +867 yr from Technological: exact ${exact.technological} ${exact.remnant} ${exact.transcended} ${exact.ecocide} ${exact.complex}");
 println("arrival +867 yr from Technological: chain ${chain.technological} ${chain.remnant} ${chain.transcended} ${chain.ecocide} ${chain.complex}");
 let selected=selectionSmoke(p,n);
 if ok && selected then println("OK: worlds priors, dial, disc, occurrence, history, propagate, selection") else {println("FAIL: worlds smoke");exit(1)}
}
