module sunholo/worlds/_smoke
import ./baseline (baseline,baselineVersion,quantileOf,AbiogenesisRate)
import ./dial (applyDial,zeroDial,luckDex)
import ./disc (starsWithin,radiusQuantile,aliveWithin,existInWindow)
import ./occurrence (sag13Expected,sag13Sample)
import ./history (historyOf,stateAt,epochs,Technological)
import ./epoch_statistics (historyProbabilities)
import std/io (println,exit)
import std/math (abs_Float)
import std/string (join)
import std/list (map)
export func main() -> () ! {IO} {
 let p=applyDial(baseline(),zeroDial());
 let m={rho0Pc3:0.079,scaleHeightPc:300.0};
 let h=historyOf(p,true,[0.1,0.001,0.5,0.01,0.5,0.7,0.2,0.5]);
 let n=starsWithin(m,1000.0);
 let half=radiusQuantile(m,3000.0,0.75);
 let total=sag13Expected(0.5,16.0,0.5,640.0);
 let rates=historyProbabilities(p,16000.0);
 let ok=abs_Float(n-6698658.214051803)<1e-7 && abs_Float(total-2.9017005327211267)<1e-13
  && abs_Float(starsWithin(m,half)/starsWithin(m,3000.0)-0.75)<1e-12
  && luckDex(baseline(),zeroDial())==0.0 && stateAt(h,0.0)==Technological
  && rates.life==p.fLife && rates.tech>0.0 && rates.mindsWindow>=rates.tech && rates.remnant>0.0;
 println(baselineVersion());
 println("params ${p.fLife} ${p.fComplex} ${p.fMinds} ${p.fTech} ${p.lifetimeYr} ${p.windowYr} ${p.remnantLoYr} ${p.remnantHiYr}");
 println("luck ${luckDex(baseline(),zeroDial())}");
 println("lifeQ25 ${quantileOf(AbiogenesisRate,0.25)}");
 println("stars ${n} tiny ${starsWithin(m,1e-6)} radiusQ75 ${half}");
 println("alive ${aliveWithin(m,1000.0,0.00012,p)} overlap ${existInWindow(m,3000.0,0.00012,p,24000.0)}");
 match sag13Sample(0.9,0.8) {(r,period)=>println("SAG13 ${total} sample ${r} ${period}")};
 println(join(";",map(\e. match e {(s,t)=>"${show(s)}:${t}"},epochs(h))));
 println("epoch probabilities ${rates.life} ${rates.mindsWindow} ${rates.tech} ${rates.remnant}");
 if ok then println("OK: worlds priors, dial, disc, occurrence, history") else {println("FAIL: worlds smoke");exit(1)}
}
