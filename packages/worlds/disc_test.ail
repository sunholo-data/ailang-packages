module sunholo/worlds/disc_test
import ./disc (Disc, starsWithin, radiusQuantile, aliveWithin, existInWindow)
import ./dial (Params)
import std/math (abs_Float, pow)
import std/list (foldl)
pure func all[a](f: a -> bool, xs:[a]) -> bool = foldl(\acc x. acc && f(x), true, xs)

pure func disc() -> Disc = {rho0Pc3: 0.079, scaleHeightPc: 300.0}
pure func ref() -> Params = {fLife: 0.3, fComplex: 0.1, fMinds: 0.1, fTech: 0.05, lifetimeYr: 1e4, windowYr: 5e9, remnantLoYr: 1e3, remnantHiYr: 1e7}
pure func rounded(v: float, want: float, half: float) -> bool = abs_Float(v - want) <= half

test "LW-23..27: exponential-disc star counts at printed precision" {
  rounded(starsWithin(disc(), 500.0), 9.92e5, 500.0)
  && rounded(starsWithin(disc(), 1000.0), 6.70e6, 5000.0)
  && rounded(starsWithin(disc(), 3000.0), 1.04e8, 5e5)
  && rounded(starsWithin(disc(), 5000.0), 3.24e8, 5e5)
  && rounded(starsWithin(disc(), 10000.0), 1.37e9, 5e6)
}
-- Whole feature-doc tables: each tuple holds radius, printed stars, biospheres,
-- ever technological, alive, overlap at 1e3 / 1e5 / 1e6 yr.
type Row = {r: float, stars: float, bio: float, ever: float, alive: float, w1: float, w2: float, w3: float}
pure func rows() -> [Row] = [
 {r:1000.0, stars:6.7e6, bio:1.6e5, ever:804.0, alive:0.0016, w1:0.002, w2:0.018, w3:0.16},
 {r:3000.0, stars:1.0e8, bio:2.5e6, ever:1.3e4, alive:0.025, w1:0.03, w2:0.28, w3:2.5},
 {r:10000.0, stars:1.4e9, bio:3.3e7, ever:1.6e5, alive:0.33, w1:0.36, w2:3.6, w3:33.0}
]
pure func checkRow(r: Row) -> bool {
 let n = starsWithin(disc(), r.r);
 let p = ref();
 rounded(n,r.stars,if r.r==1000.0 then 5e4 else if r.r==3000.0 then 5e6 else 5e7)
 && rounded(n*0.024,r.bio,if r.r==1000.0 then 5e3 else if r.r==3000.0 then 5e4 else 5e5)
 && rounded(n*0.00012,r.ever,if r.r==1000.0 then 0.5 else if r.r==3000.0 then 500.0 else 5000.0)
 && rounded(aliveWithin(disc(),r.r,0.00012,p),r.alive,if r.r==1000.0 then 0.00005 else if r.r==3000.0 then 0.0005 else 0.005)
 && rounded(existInWindow(disc(),r.r,0.00012,p,1e3),r.w1,if r.r==1000.0 then 0.0005 else 0.005)
 && rounded(existInWindow(disc(),r.r,0.00012,p,1e5),r.w2,if r.r==1000.0 then 0.0005 else if r.r==3000.0 then 0.005 else 0.05)
 && rounded(existInWindow(disc(),r.r,0.00012,p,1e6),r.w3,if r.r==1000.0 then 0.005 else if r.r==3000.0 then 0.05 else 0.5)
}
test "historical table, with documented 805 -> 804 and 1.7e5 -> 1.6e5 corrections" { all(checkRow,rows()) }
test "doom-window table, with documented 0.27 -> 0.26 correction" {
 let p=ref();
 rounded(starsWithin(disc(),500.0)*0.024,2.4e4,500.0)
 && rounded(starsWithin(disc(),1000.0)*0.024,1.6e5,5000.0)
 && rounded(starsWithin(disc(),3000.0)*0.024,2.5e6,50000.0)
 && rounded(starsWithin(disc(),5000.0)*0.024,7.8e6,50000.0)
 && rounded(existInWindow(disc(),500.0,0.00012,p,1e4),0.0005,0.00005)
 && rounded(existInWindow(disc(),500.0,0.00012,p,24000.0),0.0008,0.00005)
 && rounded(existInWindow(disc(),1000.0,0.00012,p,1e4),0.003,0.0005)
 && rounded(existInWindow(disc(),1000.0,0.00012,p,24000.0),0.005,0.0005)
 && rounded(existInWindow(disc(),3000.0,0.00012,p,1e4),0.05,0.005)
 && rounded(existInWindow(disc(),3000.0,0.00012,p,24000.0),0.09,0.005)
 && rounded(existInWindow(disc(),5000.0,0.00012,p,1e4),0.16,0.005)
 && rounded(existInWindow(disc(),5000.0,0.00012,p,24000.0),0.26,0.005)
}
test "LW-28..33: unrounded references, optimistic and pessimistic reconstructions" {
 let p=ref();
 rounded(aliveWithin(disc(),1000.0,0.00012,p),0.00161,0.000005)
 && rounded(existInWindow(disc(),10000.0,0.00012,p,1e6),33.3,0.05)
 && rounded(existInWindow(disc(),3000.0,0.00012,p,24000.0),0.085,0.0005)
 && rounded(aliveWithin(disc(),1000.0,0.0008,{p|lifetimeYr:1e6}),1.07,0.005)
 && rounded(aliveWithin(disc(),10000.0,0.0008,{p|lifetimeYr:1e6}),220.0,5.0)
 && rounded(aliveWithin(disc(),1000.0,8e-9,{p|lifetimeYr:1000.0}),1.07e-8,5e-11)
}
test "inverse CDF, origin, and small radius stable limit" {
 let m=disc();
 all(\u. abs_Float(starsWithin(m,radiusQuantile(m,3000.0,u))/starsWithin(m,3000.0)-u)<1e-12,[0.0,1e-12,0.001,0.1,0.5,0.9,0.999999])
 && starsWithin(m,0.0)==0.0 && starsWithin(m,1e-6)>0.0
 && abs_Float(starsWithin(m,1e-6)/(4.0*3.141592653589793*0.079*pow(1e-6/3.26156,3.0)/3.0)-1.0)<1e-8
}
