pure func toL(b:Belief) -> [float] = [b.sterile,b.microbial,b.complex,b.preTech,b.technological,b.remnant,b.transcended,b.ecocide]
pure func worstGap(c:Cell) -> float = match historyKernel(c.p,c.seen,c.years) {
 Err(e) => 1.0,
 Ok(b) => foldl(\acc i. {let d=abs_Float(nth_or(toL(b),i,9.0)-nth_or(c.want,i,9.0)); if d>acc then d else acc},0.0,range(0,8))
}
pure func allWithin(cells:[Cell]) -> bool = foldl(\ok c. ok && exactDomain(c.p,c.years) && worstGap(c)<=1e-9,true,cells)
test "historyKernel equals the oracle's exact law to 1e-9: base (19 cells)" { length(baseCells())==19 && allWithin(baseCells()) }
test "historyKernel equals the oracle's exact law to 1e-9: busy (8 cells)" { length(busyCells())==8 && allWithin(busyCells()) }
test "historyKernel equals the oracle's exact law to 1e-9: capBinds (7 cells)" { length(capBindsCells())==7 && allWithin(capBindsCells()) }
test "historyKernel equals the oracle's exact law to 1e-9: longLife (4 cells)" { length(longLifeCells())==4 && allWithin(longLifeCells()) }
test "historyKernel equals the oracle's exact law to 1e-9: fixedTrace (4 cells)" { length(fixedTraceCells())==4 && allWithin(fixedTraceCells()) }
-- Probe: the worst gap per cell, for tools/propagate_validation.md.
export pure func referenceProbe() -> string =
 foldl(\acc c. "${acc}${c.name} ${show(c.seen)} ${c.years} gap ${worstGap(c)}\n","",baseCells()++busyCells()++capBindsCells()++longLifeCells()++fixedTraceCells())
