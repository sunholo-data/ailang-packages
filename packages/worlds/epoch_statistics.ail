module sunholo/worlds/epoch_statistics
-- Exact marginal probabilities of history.ail's epoch model, not a detector
-- or a change to its sampler. Onset is uniform on [-windowYr/2,windowYr/2].
-- "life" means an inhabited immutable background, including ended lineages;
-- "mindsWindow" means a technological epoch overlaps [0,futureWindowYr].
import ./dial (Params)
import ./history (collapseShare,ecocideShare,transcendenceShare)
import std/result (Result,Ok,Err)
import std/math (log)

export type Probabilities = {life:float,mindsWindow:float,tech:float,remnant:float}
pure func minF(a:float,b:float) -> float = if a<b then a else b
pure func positive(x:float) -> float = if x>0.0 then x else 0.0
-- The short series avoids losing a narrow positive interval to hi/lo rounding.
-- The ordinary branch preserves existing broad-prior float64 results exactly.
pure func logRatio(hi:float,lo:float) -> float {
 let x=(hi-lo)/lo;
 if x<1e-6 then x*(1.0+x*(-0.5+x*(1.0/3.0+x*(-0.25+x/5.0)))) else log(hi/lo)
}

-- E[min(T,cap)] for T log-uniform on [lo,hi], in years. Equal bounds
-- represent a deterministic duration. All branches include clipping exactly.
export pure func traceCappedMean(lo:float,hi:float,cap:float) -> float
requires {lo>=1e-100,hi>=lo,hi<=1e100,cap>=0.0,cap<=1e100}
ensures {result>=0.0,result<=cap,result<=hi}
{
 if cap<=0.0 then 0.0 else if hi==lo then minF(lo,cap)
 else if cap<=lo then cap else if cap>=hi then (hi-lo)/logRatio(hi,lo)
 else (cap-lo+cap*logRatio(hi,cap))/logRatio(hi,lo)
}
pure func validParams(p:Params) -> bool =
 p.fLife>=0.0 && p.fLife<=1.0 && p.fMinds>=0.0 && p.fMinds<=1.0
 && p.fComplex>=p.fMinds && p.fComplex<=1.0 && p.fTech>=0.0 && p.fTech<=1.0
 && p.lifetimeYr>=1e-100 && p.lifetimeYr<=1e100 && p.windowYr>=1e-100 && p.windowYr<=1e100
 && p.remnantLoYr>=1e-100 && p.remnantLoYr<=p.remnantHiYr && p.remnantHiYr<=1e100

-- Technology at t=0, technological epochs intersecting a future interval,
-- and collapse traces at t=0. The 0.75 ending share is history.ail's adopted
-- collapse probability. Finite onset-window edges are respected even for
-- lifetimes longer than half that window; neither L/W nor traceMean/W is
-- blindly extrapolated past it. These are per-habitable-world probabilities.
export pure func historyProbabilities(p:Params,futureWindowYr:float) -> Probabilities
requires {validParams(p),futureWindowYr>=0.0,futureWindowYr<=1e100}
ensures {result.life>=0.0,result.life<=1.0,result.tech>=0.0,result.tech<=result.mindsWindow,result.mindsWindow<=result.life,result.remnant>=0.0,result.remnant<=result.life}
{
 let lineage=p.fLife*p.fMinds*p.fTech;
 let past=minF(p.lifetimeYr,p.windowYr/2.0);
 {life:p.fLife,mindsWindow:lineage*(past+minF(positive(futureWindowYr),p.windowYr/2.0))/p.windowYr,
 tech:lineage*past/p.windowYr,
 remnant:lineage*0.75*traceCappedMean(p.remnantLoYr,p.remnantHiYr,positive(p.windowYr/2.0-p.lifetimeYr))/p.windowYr}
}

-- ---- 0.3.0: ended-state bins, the late-contact share, a lineage rate ----------
-- Why a closed form was not computed.
--   EpochParamsInvalid   outside validParams above.
--   EpochYearsInvalid    a negative or NaN gap, or a lifetime that is not positive.
--   EpochCountInvalid    a world count that is negative, NaN or above 1e100.
--   LineageCountInvalid  lineages per world not in (0, 1e100].
--   LineagesOverlap      more lineages than fit end to end in the window.
export type EpochError = EpochParamsInvalid | EpochYearsInvalid | EpochCountInvalid | LineageCountInvalid | LineagesOverlap deriving (Eq)
-- Per habitable-zone world at epoch 0, or expected worlds (endedWorlds).
export type EndedShares = {remnant:float,ecocide:float,transcended:float}
export type LineageShares = {alive:float,remnant:float,spacingYr:float,quietYr:float}

-- The probability that a habitable-zone world is in each ended state at
-- epoch 0, for history.ail's one-lineage model. A lineage has ended by now
-- when its onset fell more than L before now: (W/2 - L)/W of the window.
-- Ecocide and Transcended are permanent labels, so each is its ending share of
-- those. Remnant is historyProbabilities' remnant (collapse traces still
-- present), by the same expression. These are states, not detections.
export pure func endedShares(p:Params) -> Result[EndedShares,EpochError] =
 if not validParams(p) then Err(EpochParamsInvalid) else {
  let lineage=p.fLife*p.fMinds*p.fTech;
  let over=positive(p.windowYr/2.0-p.lifetimeYr);
  Ok({remnant:lineage*collapseShare()*traceCappedMean(p.remnantLoYr,p.remnantHiYr,over)/p.windowYr,
   ecocide:lineage*ecocideShare()*over/p.windowYr,transcended:lineage*transcendenceShare()*over/p.windowYr})
 }
-- Expected worlds in each ended state among hzWorlds habitable-zone worlds
-- (for a radius: disc.starsWithin times habitable-zone worlds per star).
export pure func endedWorlds(p:Params,hzWorlds:float) -> Result[EndedShares,EpochError] =
 if not (hzWorlds>=0.0 && hzWorlds<=1e100) then Err(EpochCountInvalid) else match endedShares(p) {
  Err(e) => Err(e),
  Ok(s) => Ok({remnant:hzWorlds*s.remnant,ecocide:hzWorlds*s.ecocide,transcended:hzWorlds*s.transcended})
 }
-- The share of civilisations alive now that end within gapYr: min(1, G/L).
-- A lifetime is exactly L and the age of a living one is uniform on [0, L],
-- away from the window's edges. A memoryless lifetime would give
-- 1-exp(-G/L) instead; that is not this model.
export pure func lateShare(gapYr:float,lifetimeYr:float) -> Result[float,EpochError] =
 if not (gapYr>=0.0 && gapYr<=1e100 && lifetimeYr>=1e-100 && lifetimeYr<=1e100) then Err(EpochYearsInvalid)
 else Ok(minF(1.0,gapYr/lifetimeYr))
-- A lineage RATE in closed form; no generator, and not history.ail's model.
-- A world that hosts technology at all (probability fLife*fMinds*fTech) has
-- lineagesPerWorld technological lineages in the window, evenly spaced: one
-- starts every spacingYr = W/n years, lasts L, and leaves quietYr = W/n - L
-- before the next. Per habitable-zone world:
--   alive   = lineage * n * L / W
--   remnant = lineage * n * collapseShare * E[min(trace, quietYr)] / W
-- (a collapse's traces are overwritten by the next onset). With n = 1 these
-- are historyProbabilities' tech and remnant wherever the window edge does
-- not bind. Even spacing is a mean-field statement: it is exact for the
-- shares of a regular sequence and is not a Poisson process. More lineages
-- than fit end to end (n * L > W) are refused.
export pure func lineageShares(p:Params,lineagesPerWorld:float) -> Result[LineageShares,EpochError] =
 if not validParams(p) then Err(EpochParamsInvalid)
 else if not (lineagesPerWorld>0.0 && lineagesPerWorld<=1e100) then Err(LineageCountInvalid) else {
  let spacing=p.windowYr/lineagesPerWorld;
  if spacing<p.lifetimeYr then Err(LineagesOverlap) else {
   let lineage=p.fLife*p.fMinds*p.fTech;
   let quiet=spacing-p.lifetimeYr;
   Ok({alive:lineage*lineagesPerWorld*p.lifetimeYr/p.windowYr,
    remnant:lineage*lineagesPerWorld*collapseShare()*traceCappedMean(p.remnantLoYr,p.remnantHiYr,quiet)/p.windowYr,
    spacingYr:spacing,quietYr:quiet})
  }
 }
