pure func named(name:string) -> [Cell] = foldl(\acc c. if c.name==name then acc++[c] else acc,[],cells())
pure func holds(name:string) -> bool = match named(name) {
 [c] => (match acceptanceProbability(baseline(),c.s,1) {
  Ok(pr) => abs_Float(pr.p-c.want)+pr.error<=1e-8*c.want && abs_Float(c.mc-pr.p)<=3.0*c.se,
  Err(e) => false
 }),
 _ => false
}
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: found3 (p = 1.255e-01)" { holds("found3") }
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: threeBands (p = 1.957e-02)" { holds("threeBands") }
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: nearOne (p = 9.827e-01)" { holds("nearOne") }
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: tail1e5 (p = 2.561e-05)" { holds("tail1e5") }
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: tail1e6 (p = 2.184e-06)" { holds("tail1e6") }
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: narrow (p = 1.630e-03)" { holds("narrow") }
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: lateOnly (p = 1.897e-02)" { holds("lateOnly") }
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: endedOnly (p = 1.745e-01)" { holds("endedOnly") }
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: product32e6 (p = 2.796e-04)" { holds("product32e6") }
test "acceptanceProbability equals the oracle to 1e-8 and its Monte Carlo within 3 se: product1e5 (p = 6.082e-02)" { holds("product1e5") }
