-- Check values for sunholo/celestial/ism (0.4.0). Every expected number comes
-- from the independent oracle tools/ism_dust_ref.py (stapledons-godot, stdlib
-- Python; its HEALPix rows also agree with healpy 1.20.1 to 8.2e-15 over
-- 11,433 pixels), never from the code under test. IS-n and HB-n are the IDs of
-- stapledons-design physics/ism-structure.md and higgs-bubble.md section 6b.
--
-- The LIC rows are Linsky, Redfield & Tilipman 2019 (ApJ 886, 41) Table 2,
-- transcribed from the arXiv LaTeX source; the coefficients are the refit of
-- IS-4..IS-12 (Table 3's printed coefficients do not reproduce Table 2 in any
-- standard convention: ism-structure.md section 3).

module sunholo/celestial/ism_test

import std/math (sin, cos, sqrt, intToFloat, floatToInt, log)
import std/list (sortBy, length, nth_or)
import ./kepler (Vec3, absf)
import ./frames (unitFromAngles)
import ./ism (Interval, GrainDist, realSphericalHarmonic, realSphericalHarmonicAt, starSurfaceRadius, insideStarSurface, starSurfaceCrossings, starSurfaceChords, rayExitDistance, coneShellChord, insideConeShell, ellipsoidChord, slabChord, nHFromExtinction, healpixRingVec, grainDist, grainsAbove, grainRadiusAt, grainMass, grainMassDensity, grainTailMassFraction, poissonDraw)

type Row = { l: float, b: float, d: float }
type HpRow = { nside: int, pix: int, v: Vec3 }
type PoRow = { mean: float, u: float, v: float, k: int }

pure func rel(got: float, want: float, tol: float) -> bool = absf(got - want) <= tol * absf(want)
pure func near(got: float, want: float, tol: float) -> bool = absf(got - want) <= tol
pure func rad(d: float) -> float = d * 3.141592653589793 / 180.0
pure func pi() -> float = 3.141592653589793
pure func lb(l: float, b: float) -> Vec3 = unitFromAngles(rad(l), rad(b))
pure func scale(v: Vec3, s: float) -> Vec3 = { x: v.x * s, y: v.y * s, z: v.z * s }
pure func origin() -> Vec3 = { x: 0.0, y: 0.0, z: 0.0 }
pure func licCentre() -> Vec3 = { x: -0.8, y: 0.7, z: -0.4 }

pure func refit() -> [float] = [5.10602120415779, 0.4379750325843465, -0.15514366716101505, 0.21630484986380535, -0.1802370109468545, -0.15959544595860856, -0.06209055640526657, -0.5809081289730775, 0.6815497676249773]

