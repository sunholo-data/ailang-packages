module sunholo/test_pkg/hello

import std/string (toUpper, join)
import std/list (map)

-- Minimal test module for integration testing.
-- Used by the coordinator package update pipeline tests.

export func greet(name: string, suffix: string) -> string tests [(("world", "!"), "Hello, world!")] {
  "Hello, ${name}${suffix}"
}

export func shout(name: string) -> string tests [("world", "HELLO, WORLD!")] {
  toUpper(greet(name, "!"))
}

export func greetAll(names: [string]) -> string {
  join(" ", map(\n. greet(n, "."), names))
}

-- M-PKG-CASCADE-DETERMINISTIC-FIRST class C smoke: removed `version` export.
-- This forces change_class=C (export removed) → wrapper skips deterministic
-- path and dispatches AI from the start, with full hash context.
-- The AI agent must repair test_pkg_consumer/wrap.ail to stop using version().
