-- sunholo/deontic — the event fold + pure report builders.
--
-- runEvents is a pure fold: no IO anywhere in this package. Consumers print
-- the report lines (or feed them elsewhere) under their own capabilities.
--
-- Semantics (pinned; see README for the full rule set):
-- - Delivery penalty: perDay per day late, capped, accruing to delivery day,
--   or to (termination day - 1) for obligations cancelled by termination.
-- - Payment due = delivery day + payWithin. Interest is per-diem at
--   ratePerAnnumBp basis points where that is set, otherwise ratePct% of
--   price per FULL ratePeriod days late, floor division, simple.
-- - Notice opens a cure window ending notice day + cureDays INCLUSIVE.
--   Payment breaches cure by paying principal in the window (interest still
--   accrues to the payment day); delivery breaches cure by delivering.
-- - Waiver: the breach cannot ground termination and its penalty/interest is
--   EXCLUDED from the owed sums. Report lines always show ACCRUED values.
--   Waiver forgives the CONSEQUENCES of a breach, never the price itself —
--   an unpaid principal stays owed by a party whose lateness was waived.
-- - Termination is valid only against a noticed, uncured, unwaived breach
--   whose window has expired (day > notice day + cureDays); grounds = first
--   qualifying notice in arrival order. Invalid attempts change nothing.
--
-- Termination and earned money (CHANGED in 0.2.0, and this is the important
-- one). On termination, UNDELIVERED obligations cancel: no price is owed and
-- the penalty freezes at day-1. Obligations that were DELIVERED and not paid
-- do NOT cancel — the price stays owed and interest keeps running to the
-- valuation date. Until 0.2.0 they cancelled for payment, which meant
-- terminating a contract for non-payment silently extinguished the very debt
-- being terminated over and reported the contract as settled. Delivered work
-- is earned; termination stops the future, not the past.
--
-- Outstanding money is now REPORTED (0.2.0). A delivered, unpaid, unterminated
-- obligation previously produced no payment line at all and contributed
-- nothing to the owed sums, so an overdue invoice was invisible in the very
-- report meant to settle it. Principal now flows into client_owes whenever
-- delivery has happened and payment has not.
--
-- Valuation (0.2.0). Interest on money still outstanding needs an as-of date,
-- and a pure fold has no clock — so the date is an event, AsOf(day). Without
-- one the principal is still reported and owed; interest is reported as
-- uncomputed rather than as zero.
--
-- Suspension (0.2.0). Suspend/Resume model the remedy most services contracts
-- actually grant: stop performing, keep the contract alive, restart on
-- payment. Suspension passes the same validity test as termination and holds
-- undelivered deadlines for its duration.

module sunholo/deontic/engine

import std/list (concat)
import std/string (substring, length, endsWith)
import ./types (Event, Deliver, Pay, AmendPrice, ForceMajeure, Notice, Waive, Terminate,
                Suspend, Resume, AsOf, AttributedDelay,
                Term, NoTerm, TermAt, SuspWindow, SuspW, Attribution, Attr,
                Policy, State, aGet, aSet, hasStr)
import ./settle (penaltyFor, interestFor, interestPerDiem, daysLateAt, netOf)

-- ---------------------------------------------------------------- events --

export pure func runEvents(pol: Policy, st: State, evs: [Event]) -> State {
  match evs {
    [] => st,
    e :: rest => runEvents(pol, applyEvent(pol, st, e), rest)
  }
}

-- Force majeure: extend UNDELIVERED delivery deadlines lying inside [d1,d2]
-- inclusive by the window length (d2 - d1 + 1). Payment dues unaffected.
func extendFm(dls: [(string, int)], delivered: [(string, int)], d1: int, d2: int) -> [(string, int)] {
  match dls {
    [] => [],
    p :: rest => match p {
      (id, dl) => {
        let span = d2 - d1 + 1;
        let ndl = if dl >= d1 && dl <= d2 && aGet(delivered, id) < 0 then dl + span else dl;
        (id, ndl) :: extendFm(rest, delivered, d1, d2)
      }
    }
  }
}

-- Resume: every UNDELIVERED deadline moves by the length of the suspension,
-- in-window or not. A suspension stops the clock on work not yet done.
func extendUndelivered(dls: [(string, int)], delivered: [(string, int)], span: int) -> [(string, int)] {
  match dls {
    [] => [],
    p :: rest => match p {
      (id, dl) => {
        let ndl = if aGet(delivered, id) < 0 then dl + span else dl;
        (id, ndl) :: extendUndelivered(rest, delivered, span)
      }
    }
  }
}

-- The day an open suspension began, or -1 if performance is running.
export pure func openSuspFrom(ws: [SuspWindow]) -> int {
  match ws {
    [] => -1,
    w :: rest => match w { SuspW(r) => if r.to < 0 then r.from else openSuspFrom(rest) }
  }
}

func closeSusps(ws: [SuspWindow], day: int) -> [SuspWindow] {
  match ws {
    [] => [],
    w :: rest => match w {
      SuspW(r) => {
        let nw = if r.to < 0 then SuspW({ from: r.from, to: day, by: r.by, grounds: r.grounds }) else w;
        nw :: closeSusps(rest, day)
      }
    }
  }
}

export pure func applyEvent(pol: Policy, s: State, ev: Event) -> State {
  match ev {
    Deliver(day, id) => ({ s | delivered: aSet(s.delivered, id, day) }),
    Pay(day, id) => ({ s | paid: aSet(s.paid, id, day) }),
    AmendPrice(_, id, p) => ({ s | prs: aSet(s.prs, id, p) }),
    ForceMajeure(_, d1, d2) => {
      let nd = extendFm(s.dls, s.delivered, d1, d2);
      { s | dls: nd }
    },
    Notice(day, bid) => ({ s | notices: concat(s.notices, [(bid, day)]) }),
    Waive(_, bid) => ({ s | waived: concat(s.waived, [bid]) }),
    Terminate(day, by) => (match findGrounds(pol, s, s.notices, day) {
      NoTerm => s,
      TermAt(d, _, g) => {
        let nt = TermAt(d, by, g);
        { s | term: nt }
      }
    }),
    -- Suspension passes the same validity test as termination: a noticed,
    -- uncured, unwaived breach whose cure window has expired. A second
    -- Suspend while one is already running changes nothing.
    Suspend(day, by) => (match findGrounds(pol, s, s.notices, day) {
      NoTerm => s,
      TermAt(_, _, g) => {
        let already = openSuspFrom(s.susps);
        if already >= 0 then s
        else {
          let w = SuspW({ from: day, to: -1, by: by, grounds: g });
          let ns = concat(s.susps, [w]);
          { s | susps: ns }
        }
      }
    }),
    Resume(day) => {
      let from = openSuspFrom(s.susps);
      if from < 0 then s
      else {
        let span = day - from;
        let nd = extendUndelivered(s.dls, s.delivered, span);
        let nw = closeSusps(s.susps, day);
        { s | dls: nd, susps: nw }
      }
    },
    AsOf(day) => ({ s | asOf: day }),
    AttributedDelay(_, d1, d2, cause) => {
      let nd = extendFm(s.dls, s.delivered, d1, d2);
      let a = Attr({ from: d1, to: d2, span: d2 - d1 + 1, cause: cause });
      let na = concat(s.attributions, [a]);
      { s | dls: nd, attributions: na }
    }
  }
}


-- A breach "<id>-payment" cures by paying principal within the window;
-- "<id>-delivery" cures by delivering within the window.
export pure func isCured(pol: Policy, s: State, bid: string, nday: int) -> bool {
  let id = obligationOf(bid);
  let d = if isPaymentBreach(bid) then aGet(s.paid, id) else aGet(s.delivered, id);
  d >= 0 && d <= nday + pol.cureDays
}

func findGrounds(pol: Policy, s: State, notices: [(string, int)], day: int) -> Term {
  match notices {
    [] => NoTerm,
    p :: rest => match p {
      (bid, nday) =>
        if hasStr(s.waived, bid) then findGrounds(pol, s, rest, day)
        else if (isCured(pol, s, bid, nday) == false) && day > nday + pol.cureDays
        then TermAt(day, "", bid)
        else findGrounds(pol, s, rest, day)
    }
  }
}

-- Breach ids are "<obligationId>-delivery" | "<obligationId>-payment".
func isPaymentBreach(bid: string) -> bool = endsWith(bid, "-payment")

func obligationOf(bid: string) -> string {
  let suffixLen = if isPaymentBreach(bid) then 8 else 9;
  substring(bid, 0, length(bid) - suffixLen)
}

-- Interest under whichever model the policy selects. ratePerAnnumBp wins
-- where it is set; a policy with neither model configured charges nothing
-- rather than dividing by zero.
export pure func interestDue(pol: Policy, price: int, daysLate: int) -> int {
  if pol.ratePerAnnumBp > 0 then interestPerDiem(price, pol.ratePerAnnumBp, daysLate)
  else if pol.ratePeriod > 0 then interestFor(price, pol.ratePct, daysLate, pol.ratePeriod)
  else 0
}

-- ---------------------------------------------------------------- report --

func termDay(t: Term) -> int {
  match t { NoTerm => -1, TermAt(d, _, _) => d }
}

-- The date outstanding money is valued at: an explicit AsOf if one was
-- supplied, otherwise the termination day, otherwise unvalued.
func valuationDay(s: State) -> int {
  if s.asOf >= 0 then s.asOf else termDay(s.term)
}

func breachLine(pol: Policy, s: State, id: string, what: string) -> string {
  let bid = "${id}-${what}";
  if hasStr(s.waived, bid) then "${id} ${what} breach: WAIVED"
  else {
    let nday = aGet(s.notices, bid);
    if nday < 0 then ""
    else if isCured(pol, s, bid, nday) then "${id} ${what} breach: CURED"
    else "${id} ${what} breach: UNCURED"
  }
}

func keepNonEmpty(xs: [string]) -> [string] {
  match xs {
    [] => [],
    h :: t => if h == "" then keepNonEmpty(t) else h :: keepNonEmpty(t)
  }
}

-- Lines + (vendor accrual owed, client accrual owed) for one obligation.
--
-- client_owes carries interest AND outstanding principal; vendor_owes carries
-- delivery penalties. Waiver removes the consequence of a breach from the
-- owed sums, never the price.
func obligationReport(pol: Policy, s: State, id: string) -> ([string], (int, int)) {
  let dl = aGet(s.dls, id);
  let price = aGet(s.prs, id);
  let dDay = aGet(s.delivered, id);
  let tday = termDay(s.term);
  let vday = valuationDay(s);
  let breaches = keepNonEmpty([breachLine(pol, s, id, "delivery"), breachLine(pol, s, id, "payment")]);
  if dDay >= 0 then {
    let late = daysLateAt(dDay, dl);
    let pen = penaltyFor(late, pol.penPerDay, pol.penCap);
    let penOwed = if hasStr(s.waived, "${id}-delivery") then 0 else pen;
    let dLine = "${id} delivery: DELIVERED day=${show(dDay)} late=${show(late)} penalty=${show(pen)}";
    let due = dDay + pol.payWithin;
    let pDay = aGet(s.paid, id);
    if pDay >= 0 then {
      let lateP = daysLateAt(pDay, due);
      let interest = interestDue(pol, price, lateP);
      let intOwed = if hasStr(s.waived, "${id}-payment") then 0 else interest;
      let pLine = "${id} payment: PAID day=${show(pDay)} late=${show(lateP)} interest=${show(interest)}";
      (concat([dLine, pLine], breaches), (penOwed, intOwed))
    } else {
      -- Delivered and unpaid. The price is earned and stays owed whether or
      -- not the contract was terminated; only the future cancels.
      let status = if tday >= 0 then "OUTSTANDING (survives termination)" else "OUTSTANDING";
      if vday >= 0 then {
        let lateP = daysLateAt(vday, due);
        let interest = interestDue(pol, price, lateP);
        let intOwed = if hasStr(s.waived, "${id}-payment") then 0 else interest;
        let pLine = "${id} payment: ${status} as_of=${show(vday)} due=${show(due)} late=${show(lateP)} principal=${show(price)} interest=${show(interest)}";
        (concat([dLine, pLine], breaches), (penOwed, price + intOwed))
      } else {
        let pLine = "${id} payment: ${status} due=${show(due)} principal=${show(price)} interest=not computed (no AsOf)";
        (concat([dLine, pLine], breaches), (penOwed, price))
      }
    }
  } else {
    if tday >= 0 then {
      let lateDays = daysLateAt(tday - 1, dl);
      let pen = penaltyFor(lateDays, pol.penPerDay, pol.penCap);
      let penOwed = if hasStr(s.waived, "${id}-delivery") then 0 else pen;
      let dLine = "${id} delivery: CANCELLED late_days=${show(lateDays)} penalty=${show(pen)}";
      (concat([dLine, "${id} payment: CANCELLED"], breaches), (penOwed, 0))
    } else {
      -- Undelivered and still running. Silent unless somebody has valued the
      -- contract, because "not yet delivered" is not news; overdue is.
      let sFrom = openSuspFrom(s.susps);
      if sFrom >= 0 then
        (concat(["${id} delivery: SUSPENDED since=${show(sFrom)} deadline_held=${show(dl)}"], breaches), (0, 0))
      else if vday >= 0 && vday > dl then {
        let lateDays = daysLateAt(vday, dl);
        let pen = penaltyFor(lateDays, pol.penPerDay, pol.penCap);
        let penOwed = if hasStr(s.waived, "${id}-delivery") then 0 else pen;
        let dLine = "${id} delivery: OVERDUE as_of=${show(vday)} late=${show(lateDays)} penalty=${show(pen)}";
        (concat([dLine], breaches), (penOwed, 0))
      }
      else (breaches, (0, 0))
    }
  }
}

func effectiveLines(s: State, ids: [string]) -> [string] {
  match ids {
    [] => [],
    id :: rest => "${id} effective: deadline=${show(aGet(s.dls, id))} price=${show(aGet(s.prs, id))}" :: effectiveLines(s, rest)
  }
}

func obligationsReport(pol: Policy, s: State, ids: [string]) -> ([string], (int, int)) {
  match ids {
    [] => ([], (0, 0)),
    id :: rest => match obligationReport(pol, s, id) {
      (lines, owed) => match obligationsReport(pol, s, rest) {
        (moreLines, moreOwed) => match owed {
          (v, c) => match moreOwed {
            (mv, mc) => (concat(lines, moreLines), (v + mv, c + mc))
          }
        }
      }
    }
  }
}

-- Attributed delays are reported: a deadline that moved should say why, and
-- whose delay it was. Plain ForceMajeure stays unattributed and silent.
func attributionLines(xs: [Attribution]) -> [string] {
  match xs {
    [] => [],
    a :: rest => match a {
      Attr(r) => "delay: [${show(r.from)}..${show(r.to)}] +${show(r.span)}d to undelivered deadlines — cause: ${r.cause}" :: attributionLines(rest)
    }
  }
}

func suspensionLines(xs: [SuspWindow]) -> [string] {
  match xs {
    [] => [],
    w :: rest => match w {
      SuspW(r) => {
        let toPart = if r.to < 0 then "open" else show(r.to);
        "suspension: from=${show(r.from)} to=${toPart} by=${r.by} grounds=${r.grounds}" :: suspensionLines(rest)
      }
    }
  }
}

func termLines(t: Term) -> [string] {
  match t {
    NoTerm => [],
    TermAt(d, by, g) => ["termination: day=${show(d)} by=${by} grounds=${g}"]
  }
}

func netLines(vendorOwes: int, clientOwes: int) -> [string] {
  let n = netOf(vendorOwes, clientOwes);
  let netLine =
    if n > 0 then "net: Vendor pays Client ${show(n)}"
    else if n < 0 then "net: Client pays Vendor ${show(0 - n)}"
    else "net: settled";
  ["vendor_owes=${show(vendorOwes)}", "client_owes=${show(clientOwes)}", netLine]
}

-- The full report: effective terms, attributed delays, per-obligation blocks,
-- suspensions, termination, owed sums, and the net settlement line.
export pure func report(pol: Policy, s: State, ids: [string]) -> [string] {
  match obligationsReport(pol, s, ids) {
    (lines, owed) => match owed {
      (v, c) => {
        let head = concat(effectiveLines(s, ids), attributionLines(s.attributions));
        let mid = concat(lines, suspensionLines(s.susps));
        concat(concat(concat(head, mid), termLines(s.term)), netLines(v, c))
      }
    }
  }
}
