-- Checks for sunholo/audio/pcm on hand-built bytes: the int16 little-endian encoding, a WAV made by
-- std/audio, a WAV with a LIST chunk before fmt and data, refusals, and the round trip bound
-- 1/32767 + 1/32768. Pin 2: the reference loop's WAV sha256 (the 44-byte header + pin 1's PCM).
module sunholo/audio/pcm_test
import std/list (map, range, zipWith, foldl, length as size, take, drop, flatMap)
import std/bytes (fromInts, toInts, concat)
import std/result (Result, Ok, Err)
import std/crypto (sha256Bytes)
import std/audio (wavHeader)
import ./pcm (pcm16, wav16, wavInfo, pcm16Floats, WavInfo)
import ./recipe (render)
import ./reference (loopRecipe, sineWave)
import ./dsp (absF)

test "pcm16: 0, full scale and minus full scale" { toInts(pcm16([0.0, 1.0, -1.0, 2.0])) == [0, 0, 255, 127, 1, 128, 255, 127] }

test "wavInfo reads std/audio's header: 48 kHz mono 16-bit, data at 44" {
  match wavInfo(wav16([0.0, 0.5, -0.5], 48000)) { Ok(i) => i.rate == 48000 && i.channels == 1 && i.bits == 16 && i.frames == 3 && i.dataOffset == 44, Err(_) => false }
}

pure func le32(n: int) -> [int] = [n % 256, n / 256 % 256, n / 65536 % 256, n / 16777216 % 256]
pure func withList() -> bytes {
  let pcm = toInts(pcm16([0.25, -0.25]));
  let fmt = [102, 109, 116, 32] ++ le32(16) ++ [1, 0, 1, 0] ++ le32(24000) ++ le32(48000) ++ [2, 0, 16, 0];
  let lst = [76, 73, 83, 84] ++ le32(5) ++ [1, 2, 3, 4, 5, 0];
  let body = [87, 65, 86, 69] ++ lst ++ fmt ++ [100, 97, 116, 97] ++ le32(4) ++ pcm;
  fromInts([82, 73, 70, 70] ++ le32(size(body)) ++ body)
}
test "wavInfo skips a LIST chunk (odd size, padded) and finds fmt and data" {
  match wavInfo(withList()) { Ok(i) => i.rate == 24000 && i.frames == 2 && pcm16Floats(withList(), i) == [8192.0 / 32768.0, -8192.0 / 32768.0], Err(_) => false }
}

test "wavInfo refuses non-RIFF bytes and float PCM (tag 3)" {
  let notRiff = match wavInfo(fromInts(map(\i. 0, range(0, 64)))) { Err(_) => true, Ok(_) => false };
  let w = toInts(wav16([0.0], 48000));
  let tag3 = fromInts(zipWith(\k v. if k == 20 then 3 else v, range(0, size(w)), w));
  notRiff && (match wavInfo(tag3) { Err(_) => true, Ok(_) => false })
}

test "pcm16 then pcm16Floats is within 1/32767 + 1/32768" {
  let xs = sineWave(997.0, 0.9, 480);
  let b = wav16(xs, 48000);
  match wavInfo(b) {
    Ok(i) => foldl(\ok p. ok && p, true, zipWith(\x y. absF(x - y) <= 1.0 / 32767.0 + 1.0 / 32768.0, xs, pcm16Floats(b, i))),
    Err(_) => false
  }
}

test "the reference loop's WAV is its header plus pin 1's PCM" {
  let pcm = pcm16(render(loopRecipe()));
  sha256Bytes(wav16(render(loopRecipe()), 48000)) == sha256Bytes(concat(wavHeader(24000, 48000, 1, 16), pcm))
}

pure func replaceByte(b: bytes, idx: int, v: int) -> bytes {
  let xs = toInts(b);
  fromInts(zipWith(\i x. if i == idx then v else x, range(0, size(xs)), xs))
}

test "wavInfo rejects zero sample rate and inconsistent alignment or byte rate" {
  let b = wav16([0.0, 0.5], 48000);
  let zeroRate = foldl(\w i. replaceByte(w, i, 0), b, [24, 25, 26, 27]);
  (match wavInfo(zeroRate) { Err(_) => true, _ => false })
  && (match wavInfo(replaceByte(b, 32, 1)) { Err(_) => true, _ => false })
  && (match wavInfo(replaceByte(b, 28, 1)) { Err(_) => true, _ => false })
}

test "wavInfo honors RIFF extent and refuses partial frames" {
  let b = wav16([0.0, 0.5], 48000);
  let zeroRiff = foldl(\w i. replaceByte(w, i, 0), b, [4, 5, 6, 7]);
  (match wavInfo(zeroRiff) { Err(_) => true, _ => false })
  && (match wavInfo(replaceByte(b, 40, 3)) { Err(_) => true, _ => false })
}

pure func riffBody(xs: [int]) -> bytes = fromInts([82, 73, 70, 70] ++ le32(size(xs)) ++ xs)

test "WAV rejects short fmt, duplicate fmt/data and truncated chunks after data" {
  let header = toInts(wavHeader(0, 8000, 1, 16));
  let body = drop(8, header);
  let fmt = take(24, drop(12, header));
  let data = [100, 97, 116, 97] ++ le32(0);
  (match wavInfo(replaceByte(fromInts(header), 16, 14)) { Err(_) => true, _ => false })
  && (match wavInfo(riffBody(body ++ fmt)) { Err(_) => true, _ => false })
  && (match wavInfo(riffBody(body ++ data)) { Err(_) => true, _ => false })
  && (match wavInfo(riffBody(body ++ [74, 85, 78, 75] ++ le32(2))) { Err(_) => true, _ => false })
  && (match wavInfo(riffBody(body ++ [1])) { Err(_) => true, _ => false })
}

test "WAV enforces its chunk ceiling without recursion failure" {
  let junk = flatMap(\i. [74, 85, 78, 75, 0, 0, 0, 0], range(0, 4096));
  let body = [87, 65, 86, 69] ++ junk ++ drop(12, toInts(wavHeader(0, 8000, 1, 16)));
  match wavInfo(riffBody(body)) { Err(_) => true, _ => false }
}

test "WAV permits trailing bytes outside RIFF but validates chunks inside it" {
  let b = wav16([0.25], 8000);
  match wavInfo(concat(b, fromInts([1, 2, 3]))) { Ok(i) => i.frames == 1 && i.dataOffset == 44, _ => false }
}

test "PCM16 decode retains the first channel of independent stereo bytes" {
  let b = concat(wavHeader(8, 8000, 2, 16), fromInts([0, 128, 255, 127, 0, 64, 0, 0]));
  match wavInfo(b) { Ok(i) => i.channels == 2 && i.frames == 2 && pcm16Floats(b, i) == [-1.0, 0.5], _ => false }
}
