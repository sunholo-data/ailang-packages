-- Boot probe for publish: prints "OK: ..." iff independent checks hold in a clean workdir: the
-- reference loop's PCM sha256 (render stability, pin 1), a WAV round trip through wavInfo and
-- pcm16Floats, the gated RMS of a full-scale 1 kHz sine (-2.83 dB, closed form sqrt(24/46)), and
-- white noise uncorrelated at lag 1.
--
-- renderProbe, wavProbe and levelProbe are the VM-vs-interpreter probes: pure, and the strict
-- bytecode VM must print the same bytes as the interpreter. From packages/audio:
--   ailang run --quiet --relax-modules --bytecode --strict-bytecode --entry renderProbe --args-json 0 _smoke.ail
--   ailang run --quiet --relax-modules --entry renderProbe --args-json 0 _smoke.ail
--   (likewise wavProbe and levelProbe; compare with cmp)
--   ailang run --quiet --relax-modules --caps IO --entry main _smoke.ail
module sunholo/audio/_smoke

import std/io (println)
import std/crypto (sha256Bytes)
import std/array (toList)
import std/bytes (toInts, length as byteLength)
import ./clip (Mono, fromMono, defaultClipLimits)
import ./edit (gain, panMono)
import ./clip_pcm (Reject, toPcm16, toWav16, fromWav16)
import ./levels (MatchRms, PeakSafe, BelowActivityFloor, prepare as prepareLevelClip, measure as measureLevels, plan as planLevels)
import ./block (LowPass, defaultBlockLimits, startFilter, processFilter, resetFilter)
import ./delay (defaultDelayLimits, startDelay, processDelay, resetDelay)
import ./automation (startGain, setGain, processGain)
import std/math (log)
import std/list (map, range, foldl, take, zipWith)
import std/result (Result, Ok, Err)
import ./recipe (render, frames, renderChecked, validateRecipe)
import ./pcm (pcm16, wav16, wavInfo, pcm16Floats, wav16Checked, pcm16FloatsChecked)
import ./analysis (level, highpassKeepDb, lowbandDb, seam)
import ./noise (white, rampNoise)
import ./mix (tile, sum)
import ./reference (loopRecipe, shotRecipe, sineWave, loopPcmSha)
import ./safety (defaultLimits, ResourceLimit, InvalidRecipe, InvalidWav, InvalidClip)

-- The reference loop and one-shot as PCM hashes, and the first n samples of the one-shot as int16.
export pure func renderProbe(n: int) -> string {
  let shot = take(if n > 0 then n else 64, render(shotRecipe()));
  "${sha256Bytes(pcm16(render(loopRecipe())))} ${sha256Bytes(pcm16(render(shotRecipe())))} ${show(frames(loopRecipe()))} ${show(shot)}"
}

-- A WAV built in memory, read back: header fields and the decoded samples.
export pure func wavProbe(n: int) -> string {
  let b = wav16(sineWave(441.0, 0.8, if n > 0 then n else 480), 48000);
  match wavInfo(b) {
    Ok(i) => "${show(i.rate)} ${show(i.channels)} ${show(i.bits)} ${show(i.frames)} ${show(i.dataOffset)} ${show(pcm16Floats(b, i))}",
    Err(e) => "ERR ${e}"
  }
}

-- The analysis over closed-form signals and a mix.
export pure func levelProbe(n: int) -> string {
  let s = sineWave(1000.0, 1.0, 48000);
  let lv = level(s, 0.0, 48000);
  let mixed = sum([tile(render(shotRecipe()), false, 0.5, 9600, [0, 4800]), tile(render(loopRecipe()), true, 0.25, 9600, [])], 9600);
  let sm = seam(render(loopRecipe()));
  "${show(lv.peakCdb)} ${show(lv.rmsCdb)} ${show(highpassKeepDb(s, 150.0, 48000))} ${show(lowbandDb(sineWave(60.0, 1.0, 48000), 120.0, 4, 48000))} ${show(level(mixed, 0.0, 48000))} ${show(sm.seam)} ${show(sm.maxStep)} ${show(white(n, 3))} ${show(rampNoise(n, 3))}"
}

pure func lag1(xs: [float]) -> float =
  match foldl(\acc x. {prev: x, num: acc.num + x * acc.prev, den: acc.den + x * x}, {prev: 0.0, num: 0.0, den: 0.0}, xs) { r => r.num / r.den }
pure func absF(x: float) -> float = if x < 0.0 then 0.0 - x else x

export func main() -> () ! {IO @limit=1} {
  let pinOk = sha256Bytes(pcm16(render(loopRecipe()))) == loopPcmSha();
  let xs = sineWave(997.0, 0.9, 480);
  let b = wav16(xs, 48000);
  let wavOk = match wavInfo(b) { Ok(i) => i.frames == 480 && foldl(\ok p. ok && p, true, zipWith(\x y. absF(x - y) <= 1.0 / 32767.0 + 1.0 / 32768.0, xs, pcm16Floats(b, i))), Err(_) => false };
  let lv = level(sineWave(1000.0, 1.0, 48000), 0.0, 48000);
  let rmsOk = lv.rmsCdb == -283 && lv.peakCdb == 0;
  let whiteOk = absF(lag1(map(\i. white(i, 3), range(0, 20000)))) < 0.03;
  if pinOk && wavOk && rmsOk && whiteOk && checkedProbe(0) == "true true true true" && clipProbe(0) == "true true true" && prepareLevelsProbe(0) == "true true true true" && blockProbe(0) == "true true true" && effectsProbe(0) == "true true true"
  then println("OK: audio reference loop PCM sha256 28ee281f...7467 (render stability), WAV round trip 480 frames, gated RMS of a full-scale 1 kHz sine -2.83 dB (sqrt(24/46)), white noise lag-1 |r| < 0.03; checked boundaries, stereo clips, levels, filters, delay and automation passed")
  else println("FAIL: pin ${show(pinOk)} wav ${show(wavOk)} rms ${show(lv.rmsCdb)} peak ${show(lv.peakCdb)} white ${show(whiteOk)} checked ${checkedProbe(0)} clips ${clipProbe(0)} levels ${prepareLevelsProbe(0)} blocks ${blockProbe(0)} effects ${effectsProbe(0)}")
}


-- Checked API parity and contract probe: pin, resource failure, nonfinite input,
-- and metadata rejection. Run with --verify-contracts on both engines too.
export pure func checkedProbe(n: int) -> string {
  let pin = match renderChecked(loopRecipe(), defaultLimits()) { Ok(xs) => sha256Bytes(pcm16(xs)) == loopPcmSha(), Err(_) => false };
  let budget = match renderChecked(shotRecipe(), {defaultLimits() | maxFrames: 1}) { Err(ResourceLimit(_)) => true, _ => false };
  let invalid = match validateRecipe({shotRecipe() | drive: 1.0 / 0.0}) { Err(InvalidRecipe(_)) => true, _ => false };
  let metadata = match wav16Checked([0.0, 0.5], 48000, 2) {
    Err(_) => false,
    Ok(b) => match wavInfo(b) {
      Err(_) => false,
      Ok(i) => match pcm16FloatsChecked(b, {i | dataOffset: n - 1}, 2) { Err(InvalidWav(_)) => true, _ => false }
    }
  };
  "${show(pin)} ${show(budget)} ${show(invalid)} ${show(metadata)}"
}


-- Full stereo workflow: float clip -> gain -> pan -> PCM/WAV -> import. The
-- expected PCM bytes are independently rounded 0.5*sqrt(0.5)*32767 = 11585.
export pure func clipProbe(n: int) -> string {
  let l = defaultClipLimits();
  match fromMono(24000, [0.0, 0.25, -0.25], l) {
    Err(_) => "mono failed",
    Ok(c) => match gain(c, 2.0, l) {
      Err(_) => "gain failed",
      Ok(g) => match panMono(g, 0.0, l) {
        Err(_) => "pan failed",
        Ok(st) => {
          let bytesOk = match toPcm16(st, Reject, l) { Ok(b) => toInts(b) == [0,0,0,0,65,45,65,45,191,210,191,210], _ => false };
          let imported = match toWav16(st, Reject, l) {
            Err(_) => false,
            Ok(b) => byteLength(b) == 56 && (match fromWav16(b, l) {
              Ok(out) => out.rate == 24000 && out.frames == 3 && map(toList, out.planes) == [[0.0,11585.0/32768.0,-11585.0/32768.0],[0.0,11585.0/32768.0,-11585.0/32768.0]], _ => false
            })
          };
          let invalid = match gain({st | frames: n + 99}, 1.0, l) { Err(InvalidClip(_)) => true, _ => false };
          "${show(bytesOk)} ${show(imported)} ${show(invalid)}"
        }
      }
    }
  }
}

-- Closed-form preparation decisions; execute with --verify-contracts on both engines.
export pure func prepareLevelsProbe(n: int) -> string {
  let l = defaultClipLimits(); let config = {windowFrames: 2, activityFloor: 0.001};
  let policy = MatchRms({targetRms: 0.25, peakCeiling: 0.5, maxBoost: 4.0, minActiveFrames: 1});
  let matched = match fromMono(8000, [0.125, -0.125], l) {
    Err(_) => false, Ok(c) => match prepareLevelClip(c, config, policy, l) {
      Ok(v) => v.plan.gain == 2.0 && map(toList, v.clip.planes) == [[0.25, -0.25]] && map(toList, c.planes) == [[0.125, -0.125]], _ => false
    }
  };
  let gated = match fromMono(8000, [0.0001, -0.0001], l) {
    Err(_) => false, Ok(c) => match planLevels(c, config, policy, l) { Ok(p) => p.gain == 1.0 && p.reason == BelowActivityFloor, _ => false }
  };
  let ceiling = match fromMono(8000, [2.0, -2.0], l) {
    Err(_) => false, Ok(c) => match prepareLevelClip(c, config, PeakSafe(0.5), l) {
      Ok(v) => match measureLevels(v.clip, config, l) { Ok(r) => r.peak <= 0.5 && r.peak > 0.499999999, _ => false }, _ => false
    }
  };
  let measured = match fromMono(8000, [0.5, 0.5, 0.0, 0.0], l) {
    Err(_) => false, Ok(c) => match measureLevels(c, config, l) {
      Ok(r) => absF(r.rms - 0.3535533905932738) < 1.0e-12 && r.activeRms == 0.5 && r.activeFrames == 2, _ => false
    }
  };
  "${show(matched)} ${show(gated)} ${show(ceiling)} ${show(measured)}"
}

export pure func blockProbe(n: int) -> string {
  let limits = {defaultBlockLimits() | maxTotalFrames: 4};
  match (fromMono(8000, [1.0, 0.0, 0.0, 0.0], defaultClipLimits()),
    startFilter(8000, Mono, LowPass, log(2.0) * 8000.0 / 6.283185307179586, limits)) {
    (Ok(c), Ok(state)) => match processFilter(state, c, limits) {
      Err(_) => "false false false", Ok(out) => {
        let expected = map(toList, out.clip.planes) == [[0.5, 0.25, 0.125, 0.0625]];
        let reset = match resetFilter(out.state, limits) { Ok(s) => s.history == [0.0] && s.processedFrames == 0, _ => false };
        let budget = match processFilter(out.state, c, limits) { Err(ResourceLimit(_)) => true, _ => false };
        "${show(expected)} ${show(reset)} ${show(budget)}"
      }
    }, _ => "false false false"
  }
}

export pure func effectsProbe(n: int) -> string {
  let l = defaultDelayLimits();let b = defaultBlockLimits();
  match (fromMono(8000,[1.0,1.0,1.0,1.0],defaultClipLimits()),startGain(8000,Mono,0.0,b),
    startDelay(8000,Mono,{delayFrames:1,feedback:0.5,dry:0.0,wet:1.0},l)) {
    (Ok(c),Ok(g),Ok(d)) => match setGain(g,1.0,4,b) {
      Err(_) => "false false false", Ok(ramp) => match processGain(ramp,c,b) {
        Err(_) => "false false false", Ok(faded) => match processDelay(d,faded.clip,l) {
          Err(_) => "false false false", Ok(out) => {
            let fade = map(toList,faded.clip.planes) == [[0.25,0.5,0.75,1.0]];
            let echo = map(toList,out.clip.planes) == [[0.0,0.25,0.625,1.0625]];
            let reset = match resetDelay(out.state,l) { Ok(s) => s.processedFrames == 0 && map(toList,s.history) == [[0.0]], _ => false };
            "${show(fade)} ${show(echo)} ${show(reset)}"
          }
        }
      }
    }, _ => "false false false"
  }
}
