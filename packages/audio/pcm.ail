module sunholo/audio/pcm
-- PCM16 keeps the legacy *32767 encode and /32768 decode conventions. Checked
-- entry points reject invalid data without contract flags; all decoding is mono
-- (first channel), even when the WAV metadata describes more than one channel.
import std/list (map, range, flatMap, length as size)
import std/math (round, floatToInt)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/bytes (fromInts, byteAt, length as blen)
import std/audio (wavFromPcm)
import ./dsp (clamp16)
import ./safety (AudioError, InvalidWav, UnsupportedFormat, ResourceLimit, InvalidSamples, samplesInRange, pcm16ByteCount)

-- Compatibility encoder: rounds and saturates to int16; callers own input validity.
export pure func pcm16(xs: [float]) -> bytes =
  fromInts(flatMap(\x. { let v = clamp16(floatToInt(round(x * 32767.0))); let u = if v < 0 then v + 65536 else v; [u % 256, u / 256] }, xs))

export func wav16(xs: [float], rate: int) -> bytes ! {}
requires { rate > 0 }
{
  wavFromPcm(pcm16(xs), rate, 1, 16)
}

export type WavInfo = {rate: int, channels: int, bits: int, frames: int, dataOffset: int}

pure func u8(b: bytes, i: int) -> int = match byteAt(b, i) { Some(v) => v, None => 0 }
pure func u16(b: bytes, i: int) -> int = u8(b, i) + 256 * u8(b, i + 1)
pure func u32(b: bytes, i: int) -> int = u16(b, i) + 65536 * u16(b, i + 2)
pure func tag(b: bytes, i: int) -> [int] = [u8(b, i), u8(b, i + 1), u8(b, i + 2), u8(b, i + 3)]

-- All reads below follow a validated chunk extent; unknown chunks must fit too.
pure func scan(b: bytes, i: int, end: int, fmt: Option[WavInfo], data: Option[WavInfo], chunks: int) -> Result[WavInfo, string] =
  if i == end then match data { Some(d) => Ok(d), None => Err("no data chunk") }
  else if chunks >= 4096 then Err("WAV chunk limit exceeded (4096)")
  else if end - i < 8 then Err("truncated chunk header")
  else {
    let t = tag(b, i);
    let n = u32(b, i + 4);
    if n > end - i - 8 then Err("chunk runs past RIFF extent")
    else if n + n % 2 > end - i - 8 then Err("missing chunk padding")
    else {
      let next = i + 8 + n + n % 2;
      if t == [102, 109, 116, 32] then match fmt {
        Some(_) => Err("duplicate fmt chunk"),
        None => if n < 16 then Err("short fmt chunk")
          else if u16(b, i + 8) != 1 then Err("not integer PCM (format tag ${show(u16(b, i + 8))})")
          else {
            let f = {rate: u32(b, i + 12), channels: u16(b, i + 10), bits: u16(b, i + 22), frames: 0, dataOffset: 0};
            if f.rate <= 0 || f.channels <= 0 || (f.bits != 8 && f.bits != 16 && f.bits != 24 && f.bits != 32) then Err("bad PCM format")
            else {
              let stride = f.channels * (f.bits / 8);
              if u16(b, i + 20) != stride || u32(b, i + 16) != f.rate * stride then Err("inconsistent block alignment or byte rate")
              else scan(b, next, end, Some(f), data, chunks + 1)
            }
          }
      } else if t == [100, 97, 116, 97] then match data {
        Some(_) => Err("duplicate data chunk"),
        None => match fmt {
          None => Err("data chunk before fmt"),
          Some(f) => {
            let stride = f.channels * (f.bits / 8);
            if n % stride != 0 then Err("partial PCM frame")
            else scan(b, next, end, fmt, Some({f | frames: n / stride, dataOffset: i + 8}), chunks + 1)
          }
        }
      } else scan(b, next, end, fmt, data, chunks + 1)
    }
  }

-- Parse integer PCM (8/16/24/32 bits); validate every chunk within declared RIFF
-- extent. Trailing bytes outside that extent are ignored. fmt must precede data.
export pure func wavInfo(b: bytes) -> Result[WavInfo, string] =
  if blen(b) < 12 || tag(b, 0) != [82, 73, 70, 70] || tag(b, 8) != [87, 65, 86, 69] then Err("not a RIFF/WAVE file")
  else {
    let end = 8 + u32(b, 4);
    if end < 12 || end > blen(b) then Err("invalid RIFF extent")
    else scan(b, 12, end, None, None, 0)
  }

pure func decodeFirst(b: bytes, info: WavInfo) -> [float] =
  map(\i. { let k = info.dataOffset + info.channels * 2 * i; let u = u16(b, k); intToFloat(if u >= 32768 then u - 65536 else u) / 32768.0 }, range(0, info.frames))

-- Re-parse metadata before indexing, preventing forged offsets/frame counts. Uses
-- byteAt directly: no full-file byte->boxed-int list copy. maxFrames may be zero.
export func pcm16FloatsChecked(b: bytes, info: WavInfo, maxFrames: int) -> Result[[float], AudioError] ! {}
ensures { match result { Ok(xs) => size(xs) == info.frames && size(xs) <= maxFrames && samplesInRange(xs, -1.0, 1.0), Err(_) => true } }
{
  if maxFrames < 0 then Err(ResourceLimit("negative decode frame limit"))
  else match wavInfo(b) {
    Err(e) => Err(InvalidWav(e)),
    Ok(actual) => if actual.rate != info.rate || actual.channels != info.channels || actual.bits != info.bits || actual.frames != info.frames || actual.dataOffset != info.dataOffset then Err(InvalidWav("metadata does not match WAV bytes"))
      else if actual.bits != 16 then Err(UnsupportedFormat("PCM16 decoding requires 16-bit integer PCM"))
      else if actual.frames > maxFrames then Err(ResourceLimit("decode frame limit exceeded"))
      else Ok(decodeFirst(b, actual))
  }

}

-- Compatibility decoder: malformed/unsupported input returns [], never indexes
-- using unchecked caller metadata. Use pcm16FloatsChecked to distinguish errors.
export pure func pcm16Floats(b: bytes, info: WavInfo) -> [float] =
  match pcm16FloatsChecked(b, info, 2147483647) { Ok(xs) => xs, Err(_) => [] }

-- Checked encoding rejects non-finite and out-of-full-scale input; unlike the
-- compatibility encoder, it never silently clips. The byte count fits classic RIFF.
export func pcm16Checked(xs: [float], maxFrames: int) -> Result[bytes, AudioError] ! {}
ensures { match result { Ok(b) => blen(b) == 2 * size(xs) && size(xs) <= maxFrames && samplesInRange(xs, -1.0, 1.0), Err(_) => true } }
{
  if maxFrames < 0 || maxFrames > 2147483629 || size(xs) > maxFrames then Err(ResourceLimit("PCM frame limit exceeded or invalid"))
  else if not samplesInRange(xs, -1.0, 1.0) then Err(InvalidSamples("PCM samples must be finite and within -1..1"))
  else {
    let b = pcm16(xs);
    if blen(b) == pcm16ByteCount(size(xs)) then Ok(b) else Err(InvalidSamples("PCM byte count mismatch"))
  }

}

export func wav16Checked(xs: [float], rate: int, maxFrames: int) -> Result[bytes, AudioError] ! {}
ensures { match result { Ok(b) => blen(b) == 44 + 2 * size(xs) && rate > 0 && rate <= 2147483647, Err(_) => true } }
{
  if rate <= 0 || rate > 2147483647 then Err(InvalidWav("mono PCM16 rate must be 1..2147483647"))
  else match pcm16Checked(xs, maxFrames) {
    Err(e) => Err(e),
    Ok(pcm) => Ok(wavFromPcm(pcm, rate, 1, 16))
  }

}
