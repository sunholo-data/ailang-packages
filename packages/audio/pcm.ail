module sunholo/audio/pcm
-- 16-bit PCM and WAV: floats to little-endian int16 bytes (x * 32767, rounded, clamped), a WAV
-- around them through std/audio, and the way back: a RIFF/WAVE reader (`wavInfo`, a chunk walk
-- that skips LIST and other chunks) and a decoder to floats (s16 / 32768, the convention of
-- Godot's and most readers). The encode/decode scales differ (32767 vs 32768) on purpose: the
-- encode is what shipped sounds were made with (render stability), the decode is what measuring
-- tools read; a round trip is within 1/32767 + 1/32768.
import std/list (map, range, flatMap)
import std/array (fromList, get)
import std/math (round, floatToInt)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/bytes (fromInts, toInts, byteAt, length as blen)
import std/audio (wavFromPcm)
import ./dsp (clamp16)

-- 16-bit little-endian PCM.
export pure func pcm16(xs: [float]) -> bytes =
  fromInts(flatMap(\x. { let v = clamp16(floatToInt(round(x * 32767.0))); let u = if v < 0 then v + 65536 else v; [u % 256, u / 256] }, xs))

-- A mono 16-bit WAV of xs at rate Hz.
export func wav16(xs: [float], rate: int) -> bytes ! {}
requires { rate > 0 }
{
  wavFromPcm(pcm16(xs), rate, 1, 16)
}

export type WavInfo = {rate: int, channels: int, bits: int, frames: int, dataOffset: int}

pure func u8(b: bytes, i: int) -> int = match byteAt(b, i) { Some(v) => v, None => 0 }
pure func u16(b: bytes, i: int) -> int = u8(b, i) + 256 * u8(b, i + 1)
pure func u32(b: bytes, i: int) -> int = u16(b, i) + 65536 * u16(b, i + 2)
pure func tag(b: bytes, i: int) -> [int] = [u8(b, i), u8(b, i + 1), u8(b, i + 2), u8(b, i + 3)]

pure func walk(b: bytes, i: int, fmt: Option[WavInfo]) -> Result[WavInfo, string] =
  if i + 8 > blen(b) then Err("no data chunk")
  else {
    let t = tag(b, i);
    let n = u32(b, i + 4);
    if t == [102, 109, 116, 32] then {
      if u16(b, i + 8) != 1 then Err("not integer PCM (format tag ${show(u16(b, i + 8))})")
      else walk(b, i + 8 + n + n % 2, Some({rate: u32(b, i + 12), channels: u16(b, i + 10), bits: u16(b, i + 22), frames: 0, dataOffset: 0}))
    } else if t == [100, 97, 116, 97] then match fmt {
      None => Err("data chunk before fmt"),
      Some(f) => if f.channels <= 0 || f.bits <= 0 || f.bits % 8 != 0 then Err("bad fmt chunk")
        else if i + 8 + n > blen(b) then Err("data chunk runs past the end")
        else Ok({f | frames: n / (f.channels * f.bits / 8), dataOffset: i + 8})
    } else walk(b, i + 8 + n + n % 2, fmt)
  }

-- The format and data position of a RIFF/WAVE file with integer PCM (format tag 1), or Err.
export pure func wavInfo(b: bytes) -> Result[WavInfo, string] =
  if blen(b) < 44 || tag(b, 0) != [82, 73, 70, 70] || tag(b, 8) != [87, 65, 86, 69] then Err("not a RIFF/WAVE file")
  else walk(b, 12, None)

-- The first channel of 16-bit PCM as floats, s16 / 32768. Empty unless info.bits == 16.
export pure func pcm16Floats(b: bytes, info: WavInfo) -> [float] =
  if info.bits != 16 then []
  else {
    let xs = fromList(toInts(b));
    let step = info.channels * 2;
    map(\i. { let k = info.dataOffset + step * i; let u = get(xs, k) + 256 * get(xs, k + 1); intToFloat(if u >= 32768 then u - 65536 else u) / 32768.0 }, range(0, info.frames))
  }
