module sunholo/audio/compat
-- Render-stability fixtures for 0.6.0 (R3-SUNHOLO-AUDIO-REALISM AR0). Eight short recipes that
-- between them use every 0.5.0 field (glide, vibrato, beat, swell, a filter sweep, 1-4 low-pass
-- poles, high-pass, drive, legacy noise, white, noise loops, envelopes with delay and stop, a
-- one-shot fade, a 24 kHz rate), and the PCM sha256 of each as rendered by the published 0.5.0.
-- FROZEN at AR0: these pins are never edited. A later release that changes one of them changes an
-- existing sound and must be kind = "breaking" (AGENT.md, render stability).
export pure func compatText() -> string = "{\"schema\":\"sunholo.audio.recipes/1\",\"recipes\":[{\"id\":\"c_glide\",\"seconds\":0.1,\"peak_db\":-3,\"fade_ms\":15,\"layers\":[{\"kind\":\"sine\",\"freq\":440,\"glide_to\":660,\"glide_from_s\":0.02,\"glide_until_s\":0.08,\"amp\":0.5,\"env\":{\"attack\":0.005,\"tau\":0.05}}]},{\"id\":\"c_vib_beat_loop\",\"seconds\":0.25,\"loop\":true,\"peak_db\":-6,\"swell\":{\"rate\":4,\"depth\":0.3},\"layers\":[{\"kind\":\"sine\",\"freq\":400,\"amp\":0.5,\"vib_hz\":8,\"vib_cents\":30,\"beat_hz\":4,\"beat_depth\":0.5},{\"kind\":\"sine\",\"freq\":200,\"amp\":0.3}]},{\"id\":\"c_sweep\",\"seconds\":0.12,\"peak_db\":-4,\"layers\":[{\"kind\":\"white\",\"amp\":0.5,\"lowpass_hz\":300,\"lowpass_to_hz\":6000,\"highpass_hz\":100,\"seed\":5,\"env\":{\"attack\":0.01,\"tau\":0.04}}]},{\"id\":\"c_poles_loop\",\"seconds\":0.25,\"loop\":true,\"peak_db\":-6,\"layers\":[{\"kind\":\"white\",\"amp\":0.5,\"lowpass_hz\":800,\"lowpass_poles\":3,\"highpass_hz\":200,\"seed\":11,\"beat_hz\":4,\"beat_depth\":0.6},{\"kind\":\"white\",\"amp\":0.3,\"lowpass_hz\":2000,\"lowpass_poles\":4,\"seed\":12},{\"kind\":\"white\",\"amp\":0.2,\"lowpass_hz\":5000,\"lowpass_poles\":2,\"seed\":13}]},{\"id\":\"c_drive\",\"seconds\":0.1,\"peak_db\":-1,\"fade_ms\":30,\"drive\":3,\"layers\":[{\"kind\":\"sine\",\"freq\":220,\"amp\":0.6,\"env\":{\"attack\":0.002,\"tau\":0.06}},{\"kind\":\"sine\",\"freq\":330,\"amp\":0.4,\"env\":{\"attack\":0.002,\"tau\":0.03}}]},{\"id\":\"c_noise_loop\",\"seconds\":0.2,\"loop\":true,\"peak_db\":-6,\"layers\":[{\"kind\":\"noise\",\"amp\":0.3,\"lowpass_hz\":1200,\"seed\":9},{\"kind\":\"sine\",\"freq\":250,\"amp\":0.4}]},{\"id\":\"c_fade_24k\",\"seconds\":0.1,\"rate\":24000,\"peak_db\":-3,\"fade_ms\":40,\"layers\":[{\"kind\":\"white\",\"amp\":0.5,\"lowpass_hz\":3000,\"seed\":21,\"env\":{\"delay\":0.01,\"attack\":0.01,\"tau\":0.03,\"stop\":0.09}}]},{\"id\":\"c_bed_loop\",\"seconds\":0.25,\"loop\":true,\"peak_db\":-6,\"swell\":{\"rate\":4,\"depth\":0.15},\"layers\":[{\"kind\":\"white\",\"amp\":0.5,\"lowpass_hz\":1000,\"highpass_hz\":250,\"seed\":101,\"beat_hz\":8,\"beat_depth\":0.55,\"lowpass_poles\":3},{\"kind\":\"white\",\"amp\":0.25,\"lowpass_hz\":160,\"seed\":104}]}]}"

