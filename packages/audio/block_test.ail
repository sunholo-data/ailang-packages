module sunholo/audio/block_test
import std/array (fromList, toList, encodeF64LE)
import std/list (map, range, drop, foldl)
import std/math (log, sqrt)
import std/bytes (toInts)
import std/result (Result, Ok, Err)
import ./clip (Clip, Mono, Stereo, fromMono, create, defaultClipLimits)
import ./edit (trim)
import ./dsp (twoPi, absF)
import ./block (FilterState, FilterKind, FilterBypass, LowPass, HighPass, BlockLimits, defaultBlockLimits, startFilter, processFilter, resetFilter)
import ./safety (InvalidClip, InvalidSamples, ResourceLimit)

pure func fixture(xs: [float]) -> Clip = match fromMono(8000, xs, defaultClipLimits()) {
  Ok(c) => c, _ => {rate: 0, layout: Mono, frames: -1, planes: []}
}
pure func halfCutoff() -> float = log(2.0) * 8000.0 / twoPi()
pure func near(a: float, b: float) -> bool = absF(a - b) < 1.0e-12
pure func values(c: Clip) -> [float] = match c.planes { p :: _ => toList(p), _ => [] }
pure func run(kind: FilterKind, c: Clip) -> Result[Clip, string] =
  match startFilter(c.rate, c.layout, kind, halfCutoff(), defaultBlockLimits()) {
    Err(_) => Err("start"), Ok(s) => match processFilter(s, c, defaultBlockLimits()) { Err(_) => Err("process"), Ok(b) => Ok(b.clip) }
  }
pure func partition(c: Clip, expected: Clip, s: FilterState, at: int, count: int, limits: BlockLimits) -> bool =
  if at >= c.frames then s.processedFrames == c.frames
  else {
    let end = if count > c.frames - at then c.frames else at + count;
    match (trim(c, at, end, defaultClipLimits()), trim(expected, at, end, defaultClipLimits())) {
      (Ok(input), Ok(want)) => match processFilter(s, input, limits) {
        Err(_) => false, Ok(out) => map(toList, out.clip.planes) == map(toList, want.planes)
          && partition(c, expected, out.state, end, count, limits)
      }, _ => false
    }
  }

test "start has one zero history per channel, explicit rate and a fresh frame budget" {
  match startFilter(8000, Stereo, LowPass, halfCutoff(), defaultBlockLimits()) {
    Ok(s) => s.rate == 8000 && s.layout == Stereo && s.history == [0.0, 0.0] && s.processedFrames == 0, _ => false
  }
}
test "low-pass impulse and DC step agree with closed-form half-coefficient responses" {
  (match run(LowPass, fixture([1.0, 0.0, 0.0, 0.0])) { Ok(c) => values(c) == [0.5, 0.25, 0.125, 0.0625], _ => false })
  && (match run(LowPass, fixture([1.0, 1.0, 1.0, 1.0])) { Ok(c) => values(c) == [0.5, 0.75, 0.875, 0.9375], _ => false })
}
test "high-pass impulse is the complementary first-order response" {
  match run(HighPass, fixture([1.0, 0.0, 0.0, 0.0])) {
    Ok(c) => values(c) == [0.5, -0.25, -0.125, -0.0625], _ => false
  }
}
test "quarter-rate sine response matches the analytical transfer magnitude after warmup" {
  let c = fixture(map(\i. if i % 4 == 1 then 1.0 else if i % 4 == 3 then -1.0 else 0.0, range(0, 1024)));
  match run(LowPass, c) {
    Err(_) => false, Ok(out) => {
      let ys = drop(64, values(out));
      let mean = foldl(\sum x. sum + x * x, 0.0, ys) / 960.0;
      near(sqrt(mean), 0.5 / sqrt(1.25) / sqrt(2.0))
    }
  }
}
test "stereo channel histories stay independent without downmix cancellation" {
  let l = defaultClipLimits();
  match create(8000, Stereo, [fromList([1.0, 0.0]), fromList([-1.0, 0.0])], l) {
    Err(_) => false, Ok(c) => match run(LowPass, c) { Ok(out) => out.rate == 8000 && out.layout == Stereo && map(toList, out.planes) == [[0.5, 0.25], [-0.5, -0.25]], _ => false }
  }
}
test "partitions 1 127 128 1024 and whole preserve mono output and final frame count" {
  let c = fixture(map(\i. intToFloat(i % 11 - 5) / 8.0, range(0, 259)));let l = defaultBlockLimits();
  match startFilter(8000, Mono, LowPass, halfCutoff(), l) {
    Err(_) => false, Ok(s) => match processFilter(s, c, l) {
      Err(_) => false, Ok(full) => partition(c, full.clip, s, 0, 1, l) && partition(c, full.clip, s, 0, 127, l)
        && partition(c, full.clip, s, 0, 128, l) && partition(c, full.clip, s, 0, 1024, l)
    }
  }
}
test "stereo high-pass state survives arbitrary block boundaries" {
  let l = defaultBlockLimits();
  match create(8000, Stereo, [fromList(map(\i. intToFloat(i % 7) / 8.0, range(0, 259))), fromList(map(\i. intToFloat(0 - i % 5) / 8.0, range(0, 259)))], defaultClipLimits()) {
    Err(_) => false, Ok(c) => match startFilter(8000, Stereo, HighPass, 120.0, l) {
      Err(_) => false, Ok(s) => match processFilter(s, c, l) {
        Err(_) => false, Ok(full) => partition(c, full.clip, s, 0, 1, l) && partition(c, full.clip, s, 0, 127, l)
          && partition(c, full.clip, s, 0, 128, l) && partition(c, full.clip, s, 0, 1024, l)
      }
    }
  }
}
test "bypass preserves exact sample bytes including negative zero and finite headroom" {
  let c = fixture([-0.0, 0.0, 2.0, -2.0]);
  match run(FilterBypass, c) {
    Err(_) => false, Ok(out) => match (c.planes, out.planes) {
      (a :: [], b :: []) => toInts(encodeF64LE(a)) == toInts(encodeF64LE(b)), _ => false
    }
  }
}
test "empty block preserves filter history and cursor" {
  let l = defaultBlockLimits();
  match startFilter(8000, Mono, LowPass, halfCutoff(), l) {
    Err(_) => false, Ok(s) => match processFilter(s, fixture([1.0]), l) {
      Err(_) => false, Ok(one) => match processFilter(one.state, fixture([]), l) {
        Ok(empty) => empty.state.history == one.state.history && empty.state.processedFrames == 1 && empty.clip.frames == 0, _ => false
      }
    }
  }
}
test "reset flushes tail and starts a new logical budget without changing configuration" {
  let l = defaultBlockLimits();
  match startFilter(8000, Mono, LowPass, halfCutoff(), l) {
    Err(_) => false, Ok(s) => match processFilter(s, fixture([1.0]), l) {
      Err(_) => false, Ok(one) => match resetFilter(one.state, l) {
        Err(_) => false, Ok(fresh) => fresh.processedFrames == 0 && fresh.history == [0.0] && fresh.cutoffHz == one.state.cutoffHz
          && one.state.history == [0.5] && (match processFilter(fresh, fixture([0.0]), l) { Ok(out) => values(out.clip) == [0.0], _ => false })
      }
    }
  }
}
test "cumulative limit rejects a later block even when each block fits" {
  let l = {maxFrames: 2, maxSamples: 2, maxTotalFrames: 3};
  match startFilter(8000, Mono, LowPass, 100.0, l) {
    Err(_) => false, Ok(s) => match processFilter(s, fixture([0.1, 0.2]), l) {
      Err(_) => false, Ok(one) => (match processFilter(one.state, fixture([0.1, 0.2]), l) { Err(ResourceLimit(_)) => true, _ => false })
        && one.state.processedFrames == 2 && s.processedFrames == 0
    }
  }
}
test "per-block channel sample budget and invalid limits fail before processing" {
  let l = {maxFrames: 4, maxSamples: 7, maxTotalFrames: 8};
  match create(8000, Stereo, [fromList([0.1, 0.2, 0.3, 0.4]), fromList([0.0, 0.0, 0.0, 0.0])], defaultClipLimits()) {
    Err(_) => false, Ok(c) => match startFilter(8000, Stereo, LowPass, 100.0, l) {
      Err(_) => false, Ok(s) => (match processFilter(s, c, l) { Err(ResourceLimit(_)) => true, _ => false })
        && (match processFilter(s, c, {l | maxTotalFrames: -1}) { Err(ResourceLimit(_)) => true, _ => false })
    }
  }
}
test "invalid rate and cutoff domains include NaN infinities and frequencies above Nyquist" {
  let l = defaultBlockLimits();
  (match startFilter(0, Mono, LowPass, 100.0, l) { Err(InvalidClip(_)) => true, _ => false })
  && (match startFilter(8000, Mono, LowPass, 0.0, l) { Err(InvalidSamples(_)) => true, _ => false })
  && (match startFilter(8000, Mono, LowPass, 4001.0, l) { Err(InvalidSamples(_)) => true, _ => false })
  && (match startFilter(8000, Mono, LowPass, 0.0 / 0.0, l) { Err(InvalidSamples(_)) => true, _ => false })
  && (match startFilter(8000, Mono, HighPass, 1.0 / 0.0, l) { Err(InvalidSamples(_)) => true, _ => false })
}
test "forged public state is validated at process and reset boundaries" {
  let l = defaultBlockLimits();
  match startFilter(8000, Mono, LowPass, 100.0, l) {
    Err(_) => false, Ok(s) =>
      (match processFilter({s | history: []}, fixture([0.1]), l) { Err(InvalidClip(_)) => true, _ => false })
      && (match resetFilter({s | history: [0.0 / 0.0]}, l) { Err(InvalidSamples(_)) => true, _ => false })
      && (match processFilter({s | processedFrames: -1}, fixture([0.1]), l) { Err(InvalidClip(_)) => true, _ => false })
      && (match resetFilter({s | processedFrames: 9223372036854775807}, l) { Err(ResourceLimit(_)) => true, _ => false })
  }
}
test "input shape rate layout and nonfinite samples are independently rejected" {
  let l = defaultBlockLimits();let c = fixture([0.1]);
  match startFilter(8000, Mono, LowPass, 100.0, l) {
    Err(_) => false, Ok(s) =>
      (match processFilter(s, {c | frames: 2}, l) { Err(InvalidClip(_)) => true, _ => false })
      && (match processFilter(s, {c | rate: 44100}, l) { Err(InvalidClip(_)) => true, _ => false })
      && (match processFilter(s, {c | layout: Stereo, planes: c.planes ++ c.planes}, l) { Err(InvalidClip(_)) => true, _ => false })
      && (match processFilter(s, {c | planes: [fromList([1.0 / 0.0])]}, l) { Err(InvalidSamples(_)) => true, _ => false })
  }
}
test "convex low-pass update avoids opposite-extreme subtraction overflow" {
  let l = defaultBlockLimits();
  match startFilter(8000, Mono, LowPass, halfCutoff(), l) {
    Err(_) => false, Ok(s) => match processFilter({s | history: [-1.6e308]}, fixture([1.6e308]), l) {
      Ok(out) => values(out.clip) == [0.0] && out.state.history == [0.0], _ => false
    }
  }
}
test "high-pass numerical overflow returns a typed error instead of releasing infinity" {
  let l = defaultBlockLimits();
  match startFilter(8000, Mono, HighPass, 1.0, l) {
    Err(_) => false, Ok(s) => match processFilter({s | history: [-1.6e308]}, fixture([1.6e308]), l) {
      Err(InvalidSamples(_)) => true, _ => false
    }
  }
}

property "small arbitrary filter signals are invariant under partitioning" {
  forall(n: int) => {
    let raw = n % 31;let count = if raw < 0 then 0 - raw else raw;
    let c = fixture(map(\i. intToFloat((i * 7) % 17 - 8) / 8.0, range(0, count)));let l = defaultBlockLimits();
    match startFilter(8000, Mono, LowPass, 173.0, l) {
      Err(_) => false, Ok(s) => match processFilter(s, c, l) { Err(_) => false, Ok(full) => partition(c, full.clip, s, 0, 3, l) }
    }
  }
}
property "low-pass plus high-pass reconstructs bounded input within floating tolerance" {
  forall(n: int) => {
    let x = intToFloat(n % 1000) / 1000.0;let c = fixture([x, 0.0, 0.0 - x]);
    match (run(LowPass, c), run(HighPass, c)) {
      (Ok(low), Ok(high)) => match (values(low), values(high)) {
        (a :: b :: d :: [], p :: q :: r :: []) => near(a + p, x) && near(b + q, 0.0) && near(d + r, 0.0 - x), _ => false
      }, _ => false
    }
  }
}
