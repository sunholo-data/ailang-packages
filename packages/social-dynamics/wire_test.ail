module sunholo/social_dynamics/wire_test
import ./model (Proposal, Operation, OfferTask, RaiseConcern, RequestRelief, OfferCommitment, AcceptTask, ResolveRelief, AcceptCommitment, Authored, AI, ActorInput, UnsupportedVersion, InvalidSchema, StaleRevision, TaskOffered, ObservationDelivered, TaskCompleted, State, Config, Offered, IndicatorDelta)
import ./wire (encodeProposal, decodeProposal, encodeEvents, encodeState, encodeError, encodeConfig, singleObject)
import std/string (replace, repeat, concat, contains)
import std/result (Ok, Err)
import std/option (Some, None)
pure func golden() -> string = "{\"schema\":\"social_proposal/1\",\"id\":\"p1\",\"config_id\":\"ship_v1\",\"base_revision\":0,\"principal_id\":\"scientist\",\"origin\":\"authored\",\"expires_tick\":60,\"causes\":[\"request1\"],\"operations\":[{\"type\":\"offer_task\",\"offer_id\":\"offer1\",\"recipe_id\":\"observations\",\"participants\":[\"scientist\"],\"causes\":[\"request1\"]}]}"
pure func proposal() -> Proposal = {id:"p1",config:"ship_v1",baseRevision:0,principal:"scientist",origin:Authored,expires:60,causes:["request1"],operations:[OfferTask("offer1","observations",["scientist"],["request1"])]}
test "exact proposal golden" { encodeProposal(proposal()) == golden() && decodeProposal(golden()) == Ok(proposal()) }
test "malformed rejects" { match decodeProposal("{") { Err(_) => true, _ => false } }
test "duplicate fields reject" { match decodeProposal("{\"schema\":\"social_proposal/1\",\"schema\":\"social_proposal/1\"}") { Err(_) => true, _ => false } }

pure func roundtrip(ops: [Operation]) -> bool = let p = {id:"p",config:"c",baseRevision:7,principal:"host",origin:Authored,expires:30,causes:[],operations:ops} in decodeProposal(encodeProposal(p)) == Ok(p)
pure func rejects(s: string) -> bool = match decodeProposal(s) {Err(_)=>true,Ok(_)=>false}
test "all seven operation variants roundtrip" { roundtrip([OfferTask("o","r",["a"],[]),RaiseConcern("c",["e"],["a"],"line\nquoted \"hi\""),RequestRelief("rr","o",[]),OfferCommitment("cm",["a","b"],"promise",20,[]),AcceptTask("o"),ResolveRelief("rr",true),AcceptCommitment("cm")]) }
test "full otherwise valid duplicate schema rejects" { rejects(replace(golden(),"\"schema\":\"social_proposal/1\"","\"schema\":\"social_proposal/1\",\"schema\":\"social_proposal/1\"")) }
test "unknown field rejects" { rejects(replace(golden(),"\"base_revision\":0","\"extra\":1,\"base_revision\":0")) }
test "fractional and huge integers reject" { rejects(replace(golden(),"\"base_revision\":0","\"base_revision\":0.5")) && rejects(replace(golden(),"\"base_revision\":0","\"base_revision\":1000000001")) }
test "duplicate IDs reject" { rejects(replace(golden(),"[\"request1\"]","[\"request1\",\"request1\"]")) }
test "wrong operation variant rejects" { rejects(replace(golden(),"offer_task","invent_trust")) }
test "wrong field types reject" { rejects(replace(golden(),"\"base_revision\":0","\"base_revision\":\"0\"")) && rejects(replace(golden(),"[\"scientist\"]","[42]")) }
test "unsupported version typed error" { decodeProposal(replace(golden(),"social_proposal/1","social_proposal/2")) == Err(UnsupportedVersion("schema")) }
test "operation object repeated and unknown fields reject" { rejects(replace(golden(),"\"recipe_id\":\"observations\"","\"recipe_id\":\"observations\",\"recipe_id\":\"observations\"")) && rejects(replace(golden(),"\"recipe_id\":\"observations\"","\"recipe_id\":\"observations\",\"reward\":100")) }
test "oversized raw input rejects before parse" { decodeProposal(repeat(" ",65537)) == Err(InvalidSchema("wire_size")) }
test "text size and ID limits" { rejects(replace(golden(),"\"p1\"",concat(["\"",repeat("a",97),"\""]))) && not roundtrip([RaiseConcern("c",[],[],repeat("x",4097))]) }
test "canonical set ordering retains operation order" { encodeProposal({id:"p",config:"c",baseRevision:0,principal:"host",origin:AI,expires:0,causes:["z","a"],operations:[AcceptTask("z"),AcceptTask("a")]}) == "{\"schema\":\"social_proposal/1\",\"id\":\"p\",\"config_id\":\"c\",\"base_revision\":0,\"principal_id\":\"host\",\"origin\":\"ai\",\"expires_tick\":0,\"causes\":[\"a\",\"z\"],\"operations\":[{\"type\":\"accept_task\",\"offer_id\":\"z\"},{\"type\":\"accept_task\",\"offer_id\":\"a\"}]}" }
test "event golden" { encodeEvents([{schema:"social_event/1",seq:1,revision:2,tick:3,kind:TaskOffered("o"),causes:["b","a"],evidence:None}]) == "[{\"schema\":\"social_event/1\",\"seq\":1,\"revision\":2,\"tick\":3,\"kind\":\"task_offered\",\"causes\":[\"a\",\"b\"],\"evidence\":null,\"payload\":{\"id\":\"o\"}}]" }
test "typed error golden" { encodeError(StaleRevision("p")) == "{\"schema\":\"social_error/1\",\"code\":\"stale_revision\",\"detail\":\"p\"}" }
pure func stateFixture() -> State = {config:"c",configBody:"canonical_config",session:"s",tick:3,revision:2,seq:1,actors:[],resources:[],relationships:[],tasks:[{id:"t",recipe:"r",participants:["b","a"],causes:[],supervisor:"host",status:Offered,started:0,due:0}],reliefs:[{id:"r",task:"t",author:"a",resolved:false}],commitments:[{id:"c",parties:["b","a"],accepted:["a"],terms:"terms",due:9,causes:[],active:false}],evidence:[{id:"e",author:"a",kind:"concern",text:"private",causes:[]}],knowledge:[{observer:"a",evidence:"e"}],conditions:[{id:"low",since:2,active:true,cooldownUntil:7}],accepted:[{id:"p",body:"canonical"}],continuation:Some({config:"c",revision:2,target:20,cursor:3})}
test "state serializes pending work knowledge dedup and continuation" { let s=encodeState(stateFixture()); contains(s,"\"knowledge\":[{\"observer\":\"a\",\"evidence\":\"e\"}]") && contains(s,"\"accepted\":[{\"id\":\"p\",\"body\":\"canonical\"}]") && contains(s,"\"continuation\":{\"config\":\"c\",\"revision\":2,\"target\":20,\"cursor\":3}") && contains(s,"\"participants\":[\"a\",\"b\"]") && contains(s,"\"terms\":\"terms\"") }
test "wrong relief boolean and commitment due reject" { not roundtrip([OfferCommitment("c",["a"],"terms",1000000001,[])]) && rejects(replace(encodeProposal({id:"p",config:"c",baseRevision:0,principal:"host",origin:Authored,expires:0,causes:[],operations:[ResolveRelief("r",true)]}),"true","\"true\"")) }
test "operation count boundary enforced" { let p = {id:"p",config:"c",baseRevision:0,principal:"host",origin:Authored,expires:0,causes:[],operations:[AcceptTask("a"),AcceptTask("b"),AcceptTask("c"),AcceptTask("d"),AcceptTask("e"),AcceptTask("f"),AcceptTask("g"),AcceptTask("h"),AcceptTask("i"),AcceptTask("j"),AcceptTask("k"),AcceptTask("l"),AcceptTask("m"),AcceptTask("n"),AcceptTask("o"),AcceptTask("p"),AcceptTask("q")]}; rejects(encodeProposal(p)) }
test "empty operations rejects" { not roundtrip([]) }
test "actor input source roundtrip and integer endpoints" { let p = {id:"p",config:"c",baseRevision:0-1000000000,principal:"a",origin:ActorInput,expires:1000000000,causes:[],operations:[AcceptTask("a")]}; decodeProposal(encodeProposal(p)) == Ok(p) }
test "trailing JSON garbage rejected" { rejects(concat([golden(),"{}"] )) && rejects(concat([golden()," junk"])) }
pure func configFixture() -> Config = {id:"c",version:1,session:"s",timeUnit:"day",authorityId:"authority",appraisalId:"appraisal",limits:{actors:128,tasks:64,commitments:64,reliefs:64,evidence:4096,knowledge:4096,accepted:4096,operations:16,effects:64,text:4096,wire:65536},indicators:[{id:"trust",minimum:0,maximum:100},{id:"strain",minimum:0,maximum:100}],recipes:[{id:"repair",duration:2,allocation:1,costs:[{resource:"parts",reserve:2,consume:1}],effects:[IndicatorDelta("a","strain",5)]}],rules:[{id:"strain_high",actor:"a",indicator:"strain",above:true,threshold:70,recovery:60,duration:2,cooldown:3}],evidence:[{id:"e",author:"a",kind:"concern",text:"private",causes:[]}],knowledge:[{observer:"a",evidence:"e"}],relationships:[{from:"a",to:"b",dimension:"trust",value:50}]}
test "config collections deterministic" { let c=configFixture(); encodeConfig(c) == encodeConfig({c | indicators:[{id:"strain",minimum:0,maximum:100},{id:"trust",minimum:0,maximum:100}]}) }
test "config policy limits and mechanics change identity" { let c=configFixture(); encodeConfig(c) != encodeConfig({c | authorityId:"new_authority"}) && encodeConfig(c) != encodeConfig({c | limits:{c.limits | tasks:65}}) && encodeConfig(c) != encodeConfig({c | rules:[{id:"strain_high",actor:"a",indicator:"strain",above:true,threshold:70,recovery:55,duration:2,cooldown:3}]}) }
test "state carries immutable config identity" { contains(encodeState(stateFixture()),"\"config_body\":\"canonical_config\"") }
test "single object syntax and trailing guard" { singleObject("  {\"quoted\":\"}\\\"[\",\"nested\":[{}]} \n") && not singleObject("{} {}") && not singleObject("{} junk") && not singleObject("{]") && not singleObject("[{}]") && not singleObject("{bad}") }
test "observation event keeps evidence and observer arguments" { encodeEvents([{schema:"social_event/1",seq:1,revision:1,tick:0,kind:ObservationDelivered("evidence1","crew1"),causes:[],evidence:None}]) == "[{\"schema\":\"social_event/1\",\"seq\":1,\"revision\":1,\"tick\":0,\"kind\":\"observation_delivered\",\"causes\":[],\"evidence\":null,\"payload\":{\"evidence\":\"evidence1\",\"observer\":\"crew1\"}}]" }
test "task outcome evidence full golden" { encodeEvents([{schema:"social_event/1",seq:2,revision:2,tick:10,kind:TaskCompleted("repair"),causes:["offer1"],evidence:Some("event-2")}]) == "[{\"schema\":\"social_event/1\",\"seq\":2,\"revision\":2,\"tick\":10,\"kind\":\"task_completed\",\"causes\":[\"offer1\"],\"evidence\":\"event-2\",\"payload\":{\"id\":\"repair\"}}]" }
