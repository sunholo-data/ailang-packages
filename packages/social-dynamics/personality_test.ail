module sunholo/social_dynamics/personality_test
import ./model (Value, Host, ActorPrincipal)
import ./personality (Personality, Receipt, MajorReceipt, InteractionReceipt, FirstContact, Loss, DeepTime, Betrayal, Support, Conflict, Neutral, initialize, beginMajor, receiveInteraction, advance)
import std/result (Ok, Err)
import std/option (Some, None)
import std/list (head, filter, length, map)

pure func traits(o: int,n: int) -> [Value] = [{id:"openness",value:o},{id:"conscientiousness",value:50},{id:"extraversion",value:50},{id:"agreeableness",value:50},{id:"neuroticism",value:n}]
pure func initial() -> Personality = match initialize("medic",traits(50,50),0) { Ok(p)=>p, Err(_)=>{actor:"invalid",baseline:[],current:[],active:None,lastTick:0,history:[]} }
pure func receipt(id: string) -> Receipt = {id:id,observer:"medic",evidence:"report",receivedAt:0,principal:Host,perceivedSource:"captain"}
pure func major() -> MajorReceipt = {receipt:receipt("major-1"),kind:FirstContact}
pure func started() -> Personality = match beginMajor(initial(),major()) {Ok(p)=>p,Err(_)=>initial()}
pure func number(vs: [Value],id: string) -> int = match head(filter(\v. v.id==id,vs)) {Some(v)=>v.value,None=>0-999}

test "major initiates response without instant trait jump" { match beginMajor(initial(),major()) {Ok(p)=>p.current==initial().current && p.active!=None && length(p.history)==1,Err(_)=>false} }
test "ordinary interaction cannot initiate drift" {match receiveInteraction(initial(),{receipt:receipt("speech-1"),kind:Support}) {Ok(p)=>match advance(p,10) {Ok(q)=>q.current==initial().current && q.active==None,Err(_)=>false},Err(_)=>false} }
test "elapsed turn changes at most one point and retry is exact" {match advance(started(),1) {Ok(p)=>number(p.current,"openness")==51 && number(p.current,"neuroticism")==51 && advance(p,1)==Ok(p),Err(_)=>false} }
test "foreign observer and actor principal cannot deliver major" {let m=major();let r=m.receipt;match (beginMajor(initial(),{m|receipt:{r|observer:"engineer"}}),beginMajor(initial(),{m|receipt:{r|principal:ActorPrincipal("medic")}})) {(Err(_),Err(_))=>true,_=>false} }
test "altered duplicate fails and exact retry does not alter history" {let p=started();let m=major();beginMajor(p,m)==Ok(p) && match beginMajor(p,{m|kind:Loss}) {Err(_)=>true,_=>false} }
test "clock rewind refuses without returning changed state" {match advance(started(),2) {Ok(p)=>match advance(p,1) {Err(_)=>true,_=>false},Err(_)=>false} }

test "support and conflict change course only after time passes" {let p=started();let s={receipt:receipt("speech-1"),kind:Support};let c={s|kind:Conflict};match (receiveInteraction(p,s),receiveInteraction(p,c)) {(Ok(ps),Ok(pc))=>ps.current==p.current && pc.current==p.current && match (advance(ps,10),advance(pc,10)) {(Ok(a),Ok(b))=>number(a.current,"neuroticism")==56 && number(b.current,"neuroticism")==60,_=>false},_=>false} }
test "neutral speech records evidence without steering" {let p=started();match receiveInteraction(p,{receipt:receipt("neutral-1"),kind:Neutral}) {Ok(q)=>q.current==p.current && q.active==p.active && length(q.history)==2,_=>false} }
test "different baselines perceive the same major event differently" {match initialize("medic",traits(20,20),0) {Ok(low)=>match (beginMajor(low,major()),advance(started(),4)) {(Ok(q),Ok(high))=>match advance(q,4) {Ok(l)=>number(l.current,"openness")==16 && number(high.current,"openness")==54 && number(l.current,"neuroticism")==22 && number(high.current,"neuroticism")==54,_=>false},_=>false},_=>false} }
test "new major starts from experienced current traits" {match advance(started(),4) {Ok(p)=>let r=receipt("major-2") in match beginMajor(p,{receipt:{r|receivedAt:4},kind:FirstContact}) {Ok(q)=>q.current==p.current && match advance(q,8) {Ok(a)=>number(a.current,"openness")==58,_=>false},_=>false},_=>false} }
test "baseline envelope survives repeated major events" {let p=started();match advance(p,20) {Ok(q)=>let r=receipt("major-2") in match beginMajor(q,{receipt:{r|receivedAt:20},kind:FirstContact}) {Ok(a)=>match advance(a,40) {Ok(b)=>let r3=receipt("major-3") in match beginMajor(b,{receipt:{r3|receivedAt:40},kind:FirstContact}) {Ok(c)=>match advance(c,100) {Ok(d)=>number(d.current,"openness")==70 && number(d.current,"neuroticism")==70 && d.active==None,_=>false},_=>false},_=>false},_=>false},_=>false} }
test "world bounds and closed catalogue remain valid" {match initialize("medic",traits(100,100),0) {Ok(p)=>match beginMajor(p,major()) {Ok(q)=>match advance(q,100) {Ok(a)=>number(a.current,"openness")==100 && number(a.current,"neuroticism")==100,_=>false},_=>false},_=>false} }
test "loss betrayal and deep time target their own traits" {match (beginMajor(initial(),{receipt:receipt("loss"),kind:Loss}),beginMajor(initial(),{receipt:receipt("betrayal"),kind:Betrayal}),beginMajor(initial(),{receipt:receipt("deep"),kind:DeepTime})) {(Ok(a),Ok(b),Ok(c))=>match (advance(a,20),advance(b,20),advance(c,20)) {(Ok(x),Ok(y),Ok(z))=>number(x.current,"extraversion")==44 && number(y.current,"agreeableness")==40 && number(z.current,"openness")==56 && number(z.current,"conscientiousness")==54,_=>false},_=>false} }
test "partitioned advance agrees without intervening inputs" {let p=started();match advance(p,3) {Ok(q)=>advance(q,20)==advance(p,20),_=>false} }
test "expired response cannot be recreated by ordinary speech" {match advance(started(),20) {Ok(p)=>let r=receipt("speech-end") in match receiveInteraction(p,{receipt:{r|receivedAt:20},kind:Conflict}) {Ok(q)=>q.active==None && match advance(q,30) {Ok(a)=>a.current==p.current,_=>false},_=>false},_=>false} }
test "exact major retry after expiry leaves state unchanged" {match advance(started(),100) {Ok(p)=>beginMajor(p,major())==Ok(p),_=>false} }
test "interaction retries are exact and cannot change perception" {let i={receipt:receipt("speech-1"),kind:Support};match receiveInteraction(started(),i) {Ok(p)=>receiveInteraction(p,i)==Ok(p) && match receiveInteraction(p,{i|kind:Conflict}) {Err(_)=>true,_=>false},_=>false} }
test "receipt identities cannot be reused across kinds" {match receiveInteraction(initial(),{receipt:receipt("major-1"),kind:Neutral}) {Ok(p)=>match beginMajor(p,major()) {Err(_)=>true,_=>false},_=>false} }
test "new future stale and blank source receipts refuse" {let m=major();let r=m.receipt;match (beginMajor(initial(),{m|receipt:{r|receivedAt:1}}),beginMajor(initial(),{m|receipt:{r|perceivedSource:""}}),advance(initial(),4)) {(Err(_),Err(_),Ok(p))=>match beginMajor(p,m) {Err(_)=>true,_=>false},_=>false} }
test "invalid traits unknown duplicate missing negative over100 refuse" {match (initialize("medic",traits(101,50),0),initialize("medic",traits(0-1,50),0),initialize("medic",map(\v. if v.id=="openness" then {v|id:"other"} else v,traits(50,50)),0),initialize("medic",traits(50,50)++[{id:"openness",value:50}],0)) {(Err(_),Err(_),Err(_),Err(_))=>true,_=>false} }
test "invalid stored current state refuses all APIs atomically" {let p=initial();let corrupt={p|current:traits(99,50)};match (beginMajor(corrupt,major()),receiveInteraction(corrupt,{receipt:receipt("speech"),kind:Support}),advance(corrupt,1)) {(Err(_),Err(_),Err(_))=>true,_=>false} }
test "clock numeric bounds refuse before arithmetic overflow" {match (initialize("medic",traits(50,50),0-1),advance(initial(),1000000001),initialize("medic",traits(50,50),1000000000)) {(Err(_),Err(_),Ok(p))=>let r=receipt("last") in match beginMajor(p,{receipt:{r|receivedAt:1000000000},kind:FirstContact}) {Err(_)=>true,_=>false},_=>false} }
pure func fill(p:Personality,left:int) -> Personality = if left<=0 then p else match receiveInteraction(p,{receipt:receipt("speech-${show(left)}"),kind:Neutral}) {Ok(q)=>fill(q,left-1),Err(_)=>p}
test "bounded retention refuses new inputs but keeps exact retries" {let p=fill(initial(),128);length(p.history)==128 && match receiveInteraction(p,{receipt:receipt("new"),kind:Support}) {Err(_)=>receiveInteraction(p,{receipt:receipt("speech-128"),kind:Neutral})==Ok(p),_=>false} }
test "changed evidence or source on retry is rejected" {let m=major();let r=m.receipt;match (beginMajor(started(),{m|receipt:{r|evidence:"other"}}),beginMajor(started(),{m|receipt:{r|perceivedSource:"engineer"}})) {(Err(_),Err(_))=>true,_=>false} }
test "interaction receipt remains observer owned" {let r=receipt("speech");match (receiveInteraction(started(),{receipt:{r|observer:"engineer"},kind:Support}),receiveInteraction(started(),{receipt:{r|principal:ActorPrincipal("medic")},kind:Support})) {(Err(_),Err(_))=>true,_=>false} }
test "malformed response expiry cannot extend gradual window" {let p=started();match p.active {Some(r)=>match advance({p|active:Some({r|until:100})},1) {Err(_)=>true,_=>false},None=>false} }
