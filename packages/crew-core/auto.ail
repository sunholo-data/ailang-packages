module sunholo/crew_core/auto
import std/result (Result, Ok, Err)
import std/option (Option, Some, None)
import std/list (map, filter, foldl, length, head, any, contains, range, reverse)
import std/json (Json, decode, getString, getInt, getArray, getStringArrayOrEmpty, keys)
import std/string (startsWith)
import pkg/sunholo/social_dynamics/model (Task, Offered, Working)
import ./scenario (Scenario)
import ./session (Session, Output, Request, HostError, HostFailure, TaskAgreement, input, encodeHostError, moot)
import ./conversations (Issue, approaches, suggestions as replySuggestions)
import std/json (encode, jo, kv, js, jnum, jint, jb)
import ./policy (Policy, authoredAnswer)
import ./cohorts (Cohort, division, pressure)

-- Auto-captain (crew_core 0.3.0, Stapledon R2-CREW CI-0). Standing orders say
-- what the captain would decide; escalation rules say which moments must go
-- to the player. advanceAuto runs whole turns under the orders, with the
-- same host calls and journal records as a player's decisions, and stops at
-- the first escalation. Reactions are authored (response policy and the
-- caller's seed); nothing here is random beyond that seed.
--
-- One turn, in this order (the crew lab's crew-sim captain loop):
--  1. offered work: start it if the worker agreed earlier, else ask again;
--  2. every other turn, check in with working crew; answer relief requests;
--  3. each idle worker (scenario order): offer work (or rest when tired and
--     the orders rest the tired), ask, start under the orders;
--  4. advance one tick.

-- crew_standing_orders/1.
--  start: "agreed" (start only what the worker accepted) | "always" (orders)
--  rest: "tired" (send the tired to rest) | "never"
--  relief: "grant" | "deny" | "strained" (grant only at or over the
--    overextension threshold)
--  fatigue, stress: what counts as tired
--  cadence: decide every `cadence` turns (1 = daily). Between check-ins the
--    engine runs on: work completes and events fire, but nobody is asked;
--    a decade at a monthly cadence is about 120 decision turns.
--  concerns (0.4.1, watch-v3): what the auto-captain does with a crew
--    member's open concern about an offer, which only the captain can answer.
--    "escalate" (the default): hand it to the player (escalation `uncovered`,
--    once per opening of the concern). An approach (clear_scope, ask_advice,
--    stage_plan, explain_priority, assert_authority): reply once per concern
--    with the host's suggested words for that approach, then hear the
--    worker's reconsideration. An `uncovered` rule in the escalation set
--    escalates whatever this says. Until the concern is settled, the worker
--    is not asked again or offered other work. A concern the worker reopens
--    after that one reply is not answered again: it waits until the offer
--    lapses (20 ticks), then the worker is offered work afresh.
export type Orders = { start: string, rest: string, relief: string, fatigue: int, stress: int, cadence: int, concerns: string } deriving (Eq)

-- crew_escalation/1 rules. kind:
--  "refusal_under_orders": a worker declines and the orders would start anyway
--  "breakdown": a crew indicator reaches threshold (each crossing once)
--  "trust_floor": a crew member's trust in the captain is below threshold
--    (each fall once, until it recovers)
--  "major": a ship event of one of `kinds` (loss, deep_time, ...) fires
--  "argument": crew argue over lost capacity
--  "uncovered": a request no standing order covers: a crew member opens a
--    conversation issue only the captain can answer (watch-v3). Implied
--    whenever the standing orders say concerns "escalate"
--  "stuck" (never listed; always on): the same error (actor and text) three
--    times in one advanceAuto call, so a deadlocked crew cannot look calm
--  Crossing rules (breakdown, trust_floor, cohort) re-arm only once the value
--    is 10 back across the line (hysteresis, 0.4.1).
--  "cohort": a cohort's `indicator` ("pressure" or "division", 0..100)
--    reaches threshold (each crossing once, until it falls back). The
--    escalation's actor is the cohort's voice (may be empty) and its detail
--    starts "cohort:<id>"
export type Rule = { kind: string, indicator: string, threshold: int, kinds: [string] } deriving (Eq)

-- What happened, for callers that tally (crew-sim) or show (the game).
-- kind: offer | reply | start | refusal | relief_asked | relief_decision | error
export type Act = { kind: string, actor: string, label: string, detail: string, request: Option[Request], tick: int, fatigue: int, stress: int, morale: int } deriving (Eq)

export type Escalated = { rule: string, actor: string, task: string, tick: int, detail: string } deriving (Eq)

-- Carried between calls: the seed, workers' earlier acceptances, and which
-- breakdown crossings were already raised.
-- calls: how many advanceAuto calls came before; from the second call on,
-- request and offer ids carry "a<calls>" so resuming at the tick a call
-- stopped on never reuses an id.
export type AutoState = { seed: int, agreed: [string], raised: [string], calls: int } deriving (Eq)

-- noted: every escalation seen in counting mode (decideTurn and finishTurn,
-- for the lab), where play goes on under the orders instead of stopping.
export type AutoResult = { session: Session, state: AutoState, turns: int, escalated: Option[Escalated], log: [Act], noted: [Escalated] } deriving (Eq)

export pure func consentOrders() -> Orders ! {}
ensures { result.start == "agreed" } = { start: "agreed", rest: "tired", relief: "grant", fatigue: 70, stress: 75, cadence: 1, concerns: "escalate" }

export pure func ordersOrders() -> Orders ! {}
ensures { result.start == "always" } = { start: "always", rest: "never", relief: "deny", fatigue: 70, stress: 75, cadence: 1, concerns: "escalate" }

-- --------------------------------------------------------------- decoding

pure func str(j: Json, k: string) -> string = match getString(j, k) { Some(s) => s, None => "" }

export pure func decodeOrders(body: string) -> Result[Orders, string] ! {}
ensures { match result { Ok(o) => o.start == "agreed" || o.start == "always", Err(_) => true } } = match decode(body) {
 Err(e) => Err("standing orders JSON: ${e}"),
 Ok(j) => if str(j, "schema") != "crew_standing_orders/1" then Err("standing orders: schema must be crew_standing_orders/1")
  else if any(\k. not contains(["schema", "start", "rest", "relief", "fatigue", "stress", "cadence", "concerns"], k), keys(j)) then Err("standing orders: unknown field")
  else if not contains(["escalate"] ++ approaches(), concernsOf(j)) then Err("standing orders: concerns must be escalate or a reply approach")
  else if (match getInt(j, "cadence") { Some(c) => c < 1 || c > 365, None => false }) then Err("standing orders: cadence must be 1..365")
  else if not contains(["agreed", "always"], str(j, "start")) then Err("standing orders: start must be agreed or always")
  else if not contains(["tired", "never"], str(j, "rest")) then Err("standing orders: rest must be tired or never")
  else if not contains(["grant", "deny", "strained"], str(j, "relief")) then Err("standing orders: relief must be grant, deny or strained")
  else match (getInt(j, "fatigue"), getInt(j, "stress")) {
   (Some(f), Some(s)) => if f < 0 || f > 100 || s < 0 || s > 100 then Err("standing orders: fatigue and stress must be 0..100") else Ok({ start: str(j, "start"), rest: str(j, "rest"), relief: str(j, "relief"), fatigue: f, stress: s, cadence: cadenceOf(j), concerns: concernsOf(j) }),
   _ => Ok({ start: str(j, "start"), rest: str(j, "rest"), relief: str(j, "relief"), fatigue: 70, stress: 75, cadence: cadenceOf(j), concerns: concernsOf(j) })
  }
}

pure func cadenceOf(j: Json) -> int = match getInt(j, "cadence") { Some(c) => c, None => 1 }
pure func concernsOf(j: Json) -> string = match getString(j, "concerns") { Some(c) => c, None => "escalate" }

pure func readRule(j: Json) -> Result[Rule, string] = {
 let kind = str(j, "kind");
 if not contains(["refusal_under_orders", "breakdown", "trust_floor", "major", "argument", "uncovered", "cohort"], kind) then Err("escalation: unknown kind ${kind}")
 else {
  let threshold = match getInt(j, "threshold") { Some(n) => n, None => 0 - 1 };
  let kinds = getStringArrayOrEmpty(j, "kinds");
  if (kind == "breakdown" || kind == "trust_floor") && (threshold < 0 || threshold > 100) then Err("escalation: ${kind} needs threshold 0..100")
  else if kind == "cohort" && (threshold < 0 || threshold > 100 || not contains(["pressure", "division"], str(j, "indicator"))) then Err("escalation: cohort needs indicator pressure or division and threshold 0..100")
  else if kind == "breakdown" && str(j, "indicator") == "" then Err("escalation: breakdown needs an indicator")
  else if kind == "major" && length(kinds) == 0 then Err("escalation: major needs kinds")
  else Ok({ kind: kind, indicator: str(j, "indicator"), threshold: threshold, kinds: kinds })
 }
}

@allow_empty_ok("No rules is a valid escalation set: auto-play never stops early")
export pure func decodeEscalation(body: string) -> Result[[Rule], string] ! {}
ensures { match result { Ok(rs) => length(rs) <= 32, Err(_) => true } } = match decode(body) {
 Err(e) => Err("escalation JSON: ${e}"),
 Ok(j) => if str(j, "schema") != "crew_escalation/1" then Err("escalation: schema must be crew_escalation/1") else match getArray(j, "rules") {
  None => Err("escalation: rules must be a list"),
  Some(xs) => if length(xs) > 32 then Err("escalation: at most 32 rules") else foldl(\acc x. match acc { Err(e) => Err(e), Ok(rs) => match readRule(x) { Err(e) => Err(e), Ok(r) => Ok(rs ++ [r]) } }, Ok([]), xs)
 }
}

-- ------------------------------------------------------------------ helpers

type Run = { session: Session, state: AutoState, log: [Act], escalated: Option[Escalated], halting: bool, noted: [Escalated], salt: string }

pure func indicator(s: Session, actor: string, id: string) -> int = match head(filter(\a. a.id == actor, s.state.actors)) {
 None => 0,
 Some(a) => match head(filter(\v. v.id == id, a.indicators)) { Some(v) => v.value, None => 0 }
}

pure func trustOf(s: Session, actor: string) -> int = match head(filter(\r. r.from == actor && r.to == s.scenario.captain && r.dimension == "trust", s.state.relationships)) {
 Some(r) => r.value, None => 0
}

pure func threshold(s: Session, worker: string) -> int = match head(filter(\r. r.id == "overextended_${worker}", s.scenario.rules)) { Some(r) => r.threshold, None => 101 }

-- An offer whose agreement has fallen due can no longer be answered (long
-- check-in jumps and unanswered concerns leave such offers behind); it no
-- longer occupies the worker and is not asked about again, at every cadence
-- (0.4.1; 0.3.0 kept asking at cadence 1, which archiving turned into a host
-- error every turn). Archiving folds lapsed offers away.
pure func stale(s: Session, t: Task) -> bool = t.status == Offered && (match head(filter(\b. b.task == t.id, s.bindings)) {
 Some(b) => any(\c. c.id == b.agreement && c.due <= s.state.tick, s.state.commitments),
 None => false
})

pure func busy(s: Session, o: Orders, worker: string) -> bool = any(\t. ((t.status == Offered && not stale(s, t)) || t.status == Working) && contains(t.participants, worker), s.state.tasks)

pure func workRecipe(sc: Scenario, worker: string) -> string = match head(filter(\o. o.text == worker && o.id != "rest_${worker}", sc.owners)) {
 Some(o) => o.id, None => "rest_${worker}"
}

-- Every host call goes through the one command entry point (input), the same
-- lines a recording would hold. Fewer call sites into the session module keep
-- a cold compile smaller (ailang#1812).
pure func cmd(s: Session, fields: [{key: string, value: Json}]) -> Result[Output, HostError] = input(s, encode(jo(fields)))
pure func offer(s: Session, worker: string, recipe: string, id: string) -> Result[Output, HostError] = cmd(s, [kv("command", js("offer")), kv("worker", js(worker)), kv("recipe", js(recipe)), kv("id", js(id))])
pure func ask(s: Session, actor: string, task: string, id: string) -> Result[Output, HostError] = cmd(s, [kv("command", js("ask")), kv("actor", js(actor)), kv("task", js(task)), kv("id", js(id))])
pure func complete(s: Session, id: string, body: string, roll: float) -> Result[Output, HostError] = cmd(s, [kv("command", js("answer")), kv("request", js(id)), kv("body", js(body)), kv("roll", jnum(roll))])
pure func startTask(s: Session, id: string) -> Result[Output, HostError] = cmd(s, [kv("command", js("start_task")), kv("task", js(id))])
pure func resolve(s: Session, id: string, release: bool) -> Result[Output, HostError] = cmd(s, [kv("command", js("resolve_relief")), kv("id", js(id)), kv("release", jb(release))])
pure func cancel(s: Session, id: string) -> Result[Output, HostError] = cmd(s, [kv("command", js("cancel_request")), kv("id", js(id))])

pure func act(r: Run, kind: string, actor: string, label: string, detail: string, request: Option[Request], s: Session) -> Run = {
 let logged = {r | log: [{ kind: kind, actor: actor, label: label, detail: detail, request: request, tick: s.state.tick, fatigue: indicator(s, actor, "fatigue"), stress: indicator(s, actor, "stress"), morale: indicator(s, actor, "morale") }] ++ r.log};
 if kind == "error" && stuckAt(logged.log, actor, detail) then escalate(logged, "stuck", actor, "", detail) else logged
}

-- The stuck guard: this host error (actor and text) has now happened exactly
-- three times in the call's log, so it is raised once. A start the engine
-- blocks for lack of resources is a shortage the ship can see (resources,
-- stockouts), like a resource refusal, not a stuck host, so it is not
-- counted. Host error texts carry no per-turn ids (fixed strings, codes or
-- crew ids), so a repeat matches.
export pure func stuckAt(log: [Act], actor: string, detail: string) -> bool ! {}
ensures { not result || length(log) >= 3 } = detail != "start: blocked" && length(filter(\a. a.kind == "error" && a.actor == actor && a.detail == detail, log)) == 3

pure func stopped(r: Run) -> bool = match r.escalated { Some(_) => true, None => false }

pure func escalate(r: Run, rule: string, actor: string, task: string, detail: string) -> Run = {
 let e = { rule: rule, actor: actor, task: task, tick: r.session.state.tick, detail: detail };
 if stopped(r) then r else if r.halting then {r | escalated: Some(e)} else {r | noted: [e] ++ r.noted}
}

pure func ruled(rules: [Rule], kind: string) -> bool = any(\x. x.kind == kind, rules)

-- Ask `actor` about `task`; the response policy chooses the reaction.
pure func hear(r: Run, p: Policy, actor: string, task: string, id: string) -> {run: Run, label: string} = match ask(r.session, actor, task, id) {
 Err(e) => {run: act(r, "error", actor, "", "ask: ${encodeHostError(e)}", None, r.session), label: ""},
 Ok(a) => answerPending({r | session: a.session}, p, actor, task, id)
}

-- Answer the pending request `id` (an ask, or the host's reconsideration
-- after a captain's reply) from the response policy.
pure func answerPending(r: Run, p: Policy, actor: string, task: string, id: string) -> {run: Run, label: string} = {
 match head(filter(\q. q.id == id, r.session.pending)) {
  None => {run: act({r | session: r.session}, "error", actor, "", "ask: no pending request", None, r.session), label: ""},
  Some(request) => match authoredAnswer(p, request, r.state.seed) {
   Err(e) => {run: act({r | session: r.session}, "error", actor, "", "answer: ${e}", None, r.session), label: ""},
   Ok(answer) => {
    let st = r.state;
    match complete(r.session, id, answer.body, answer.roll) {
     Err(e) => {
      let released = match cancel(r.session, id) { Ok(o) => o.session, Err(_) => r.session };
      {run: act({r | session: released, state: {st | seed: answer.seed}}, "error", actor, "", "complete: ${encodeHostError(e)}", None, r.session), label: ""}
     },
     Ok(c) => {
      let agreed = if answer.label == "accept" && not contains(st.agreed, task) then st.agreed ++ [task] else st.agreed;
      {run: act({r | session: c.session, state: {st | seed: answer.seed, agreed: agreed}}, "reply", actor, answer.label, task, Some(request), r.session), label: answer.label}
     }
    }
   }
  }
 }
}

pure func begin(r: Run, task: string, actor: string) -> Run = match startTask(r.session, task) {
 Ok(o) => if o.failed then act({r | session: o.session}, "error", actor, "", "start: blocked", None, r.session) else act({r | session: o.session}, "start", actor, "", task, None, r.session),
 Err(e) => act(r, "refusal", actor, "", encodeHostError(e), None, r.session)
}

-- Start, unless the orders would override a refusal that must go to the player.
pure func decide(r: Run, o: Orders, rules: [Rule], task: string, actor: string, label: string) -> Run =
 if stopped(r) then r
 else if label == "accept" then begin(r, task, actor)
 else if o.start == "always" then (if label != "" && ruled(rules, "refusal_under_orders") && r.halting then escalate(r, "refusal_under_orders", actor, task, label) else begin(if label != "" && ruled(rules, "refusal_under_orders") then escalate(r, "refusal_under_orders", actor, task, label) else r, task, actor))
 else r

pure func persuade(r: Run, p: Policy, o: Orders, rules: [Rule], turn: int, t: Task) -> Run =
 if stopped(r) then r else if contains(r.state.agreed, t.id) then begin(r, t.id, match head(t.participants) { Some(w) => w, None => "" }) else match head(t.participants) {
  None => r,
  Some(worker) => { let h = hear(r, p, worker, t.id, "p${show(turn)}${r.salt}-${t.id}"); decide(h.run, o, rules, t.id, worker, h.label) }
 }

pure func grants(o: Orders, s: Session, worker: string) -> bool =
 if o.relief == "grant" then true else if o.relief == "deny" then false else indicator(s, worker, "stress") >= threshold(s, worker)

-- The host takes no check-in while a concern about the task is open (even
-- one the captain can no longer answer), so those are skipped.
pure func checkIn(r: Run, p: Policy, o: Orders, turn: int, t: Task) -> Run =
 if stopped(r) || any(\i. i.task == t.id && i.status == "open", r.session.chat.issues) then r else match head(t.participants) {
  None => r,
  Some(worker) => if turn % 2 != 0 then r else {
   let rid = "c${show(turn)}${r.salt}-${t.id}";
   let h = hear(r, p, worker, t.id, rid);
   if h.label != "request_relief" then h.run else {
    let asked = act(h.run, "relief_asked", worker, "", t.id, None, h.run.session);
    let go = grants(o, asked.session, worker);
    match resolve(asked.session, "relief-${rid}", go) {
     Err(e) => act(asked, "error", worker, "", "relief: ${encodeHostError(e)}", None, asked.session),
     Ok(x) => act({asked | session: x.session}, "relief_decision", worker, if go then "granted" else "denied", t.id, None, asked.session)
    }
   }
  }
 }

pure func assign(r: Run, p: Policy, o: Orders, rules: [Rule], turn: int, worker: string) -> Run =
 if stopped(r) || busy(r.session, o, worker) then r else {
  let tired = indicator(r.session, worker, "fatigue") >= o.fatigue || indicator(r.session, worker, "stress") >= o.stress;
  let recipe = if tired && o.rest == "tired" then "rest_${worker}" else workRecipe(r.session.scenario, worker);
  let id = "t${show(turn)}${r.salt}-${worker}";
  match offer(r.session, worker, recipe, id) {
   Err(e) => act(r, "error", worker, "", "offer: ${encodeHostError(e)}", None, r.session),
   Ok(x) => {
    let offered = act({r | session: x.session}, "offer", worker, recipe, id, None, r.session);
    let h = hear(offered, p, worker, id, "q-${id}");
    decide(h.run, o, rules, id, worker, h.label)
   }
  }
 }

-- Advance to `turn`, continuing a pending advance (the engine works in
-- budgets of 64 events) until it completes; long check-in jumps need several.
pure func step(r: Run, turn: int) -> Run = stepN(r, turn, 0)

pure func stepN(r: Run, turn: int, tries: int) -> Run = match input(r.session, "{\"command\":\"advance\",\"tick\":${show(turn)},\"budget\":64}") {
 Ok(x) => if x.failed then act({r | session: x.session}, "error", "", "", "advance: blocked", None, r.session)
  else match x.session.state.continuation {
   None => {r | session: x.session},
   Some(_) => if tries >= 1000 then act({r | session: x.session}, "error", "", "", "advance: unfinished", None, r.session) else stepN({r | session: x.session}, turn, tries + 1)
  },
 Err(e) => act(r, "error", "", "", "advance: ${encodeHostError(e)}", None, r.session)
}

-- Forget acceptances of work the host no longer offers or runs.
pure func prune(r: Run) -> Run = { let st = r.state; {r | state: {st | agreed: filter(\id. any(\t. t.id == id && (t.status == Offered || t.status == Working), r.session.state.tasks), st.agreed)}} }

-- After the advance: breakdowns, trust floors, majors and arguments that
-- this turn produced.
-- Once-per-crossing memory, per rule: "<kind>:<indicator>:<threshold>/<who>".
pure func key(rule: Rule, who: string) -> string = "${rule.kind}:${rule.indicator}:${show(rule.threshold)}/${who}"

-- Raise every match of one crossing rule (a halting run stops at the first);
-- re-arm those that are back across the line by the margin, so a value
-- sitting on the line raises once, not on every wobble.
pure func margin() -> int = 10
export pure func below(v: int, line: int) -> bool ! {}
ensures { not result || v < line || line <= 0 } = v + margin() < line || (line <= margin() && v == 0)
export pure func above(v: int, line: int) -> bool ! {}
ensures { not result || v >= line || v == 100 } = v >= line + margin() || (line + margin() > 100 && v == 100)
pure func crossings(acc: Run, rule: Rule, over: string -> bool, rearm: string -> bool, detail: string -> string) -> Run = crossingsOver(acc, rule, acc.session.scenario.workers, \w. w, over, rearm, detail)
pure func crossingsOver(acc: Run, rule: Rule, whos: [string], actor: string -> string, over: string -> bool, rearm: string -> bool, detail: string -> string) -> Run = {
 let fresh = filter(\w. over(w) && not contains(acc.state.raised, key(rule, w)), whos);
 let st = acc.state;
 let kept = filter(\k. not any(\w. k == key(rule, w) && rearm(w), whos), st.raised);
 foldl(\a w. { let st2 = a.state; escalate({a | state: {st2 | raised: st2.raised ++ [key(rule, w)]}}, rule.kind, actor(w), "", detail(w)) }, {acc | state: {st | raised: kept}}, fresh)
}

-- Cohort readouts by id (0 when the cohort is gone or there are none).
pure func cohortsOf(s: Session) -> [Cohort] = match s.population { Some(p) => p.cohorts, None => [] }
pure func cohortValue(s: Session, id: string, indicator: string) -> int = match head(filter(\c. c.id == id, cohortsOf(s))) {
 Some(c) => if indicator == "division" then division(c.mood) else pressure(c),
 None => 0
}
pure func voiceOf(s: Session, id: string) -> string = match head(filter(\c. c.id == id, cohortsOf(s))) { Some(c) => c.voice, None => "" }

pure func newEvidence(s: Session, before: Session, p: string -> bool) -> [string] = map(\e. e.id, filter(\e. p(e.id) && not any(\b. b.id == e.id, before.state.evidence), s.state.evidence))

-- A ship event's major kind comes from the session's event list (scheduled
-- and run-time events both live there), by its evidence id ev-<id>.
pure func majorOf(s: Session, evidence: string) -> string = match head(filter(\e. "ev-${e.id}" == evidence, s.scenario.events)) { Some(e) => e.major, None => "" }

-- After the advance: breakdowns, trust floors, majors and arguments.
-- Concerns open during decisions (a reply), so they are handled there.
pure func watch(r: Run, rules: [Rule], before: Session) -> Run = foldl(\acc rule. if stopped(acc) then acc else {
 let s = acc.session;
 if rule.kind == "breakdown" then crossings(acc, rule, \w. indicator(s, w, rule.indicator) >= rule.threshold, \w. below(indicator(s, w, rule.indicator), rule.threshold), \w. "${rule.indicator} ${show(indicator(s, w, rule.indicator))}")
 else if rule.kind == "trust_floor" then crossings(acc, rule, \w. trustOf(s, w) < rule.threshold, \w. above(trustOf(s, w), rule.threshold), \w. "trust ${show(trustOf(s, w))}")
 else if rule.kind == "argument" then foldl(\a id. escalate(a, "argument", "", "", id), acc, newEvidence(s, before, \id. startsWith(id, "sf-")))
 else if rule.kind == "major" then foldl(\a id. escalate(a, "major", "", "", id), acc, filter(\id. contains(rule.kinds, majorOf(s, id)), newEvidence(s, before, \id. startsWith(id, "ev-"))))
 else if rule.kind == "cohort" then crossingsOver(acc, rule, map(\c. c.id, cohortsOf(s)), \c. voiceOf(s, c), \c. cohortValue(s, c, rule.indicator) >= rule.threshold, \c. below(cohortValue(s, c, rule.indicator), rule.threshold), \c. "cohort:${c} ${rule.indicator} ${show(cohortValue(s, c, rule.indicator))}")
 else acc
}, r, rules)


-- Open concerns (watch-v3) about live offers: the worker waits on the
-- captain. Settled before the turn's other decisions and again after them,
-- so a concern raised this turn is handled this turn.
pure func concernsOpen(s: Session) -> [Issue] = filter(\i. i.status == "open" && not moot(s, i), s.chat.issues)
pure func waiting(s: Session, task: string) -> bool = any(\i. i.task == task, concernsOpen(s))

pure func escalating(o: Orders, rules: [Rule]) -> bool = o.concerns == "escalate" || ruled(rules, "uncovered")

pure func settle(r: Run, p: Policy, o: Orders, rules: [Rule], turn: int) -> Run =
 foldl(\acc i. if stopped(acc) then acc else if escalating(o, rules) then raiseConcern(acc, i) else if i.replyCount == 0 then replyConcern(acc, p, o, rules, turn, i) else acc, r, concernsOpen(r.session))

-- Once per opening: a reopened concern carries a new request id.
pure func raiseConcern(r: Run, i: Issue) -> Run = {
 let k = "uncovered:${i.id}:${i.request}";
 if contains(r.state.raised, k) then r else { let st = r.state; escalate({r | state: {st | raised: st.raised ++ [k]}}, "uncovered", i.worker, i.task, i.id) }
}

-- Reply once with the host's suggested words for the ordered approach (the
-- third suggestion when the kind has no such approach), then hear the
-- worker's reconsideration as for any request.
pure func replyConcern(r: Run, p: Policy, o: Orders, rules: [Rule], turn: int, i: Issue) -> Run = {
 let options = replySuggestions(i, if r.state.seed < 1 then 1 else r.state.seed);
 let chosen = match head(filter(\x. x.approach == o.concerns, options)) { Some(x) => x, None => match head(reverse(options)) { Some(x) => x, None => { id: "", key: "", text: "", approach: "", preview: "" } } };
 let id = "s${show(turn)}${r.salt}-${i.task}";
 match cmd(r.session, [kv("command", js("captain_reply")), kv("id", js(id)), kv("issue", js(i.id)), kv("text", js(chosen.text)), kv("approach", js(chosen.approach)), kv("tick", jint(r.session.state.tick)), kv("revision", jint(r.session.state.revision))]) {
  Err(e) => act(r, "error", i.worker, "", "captain_reply: ${encodeHostError(e)}", None, r.session),
  Ok(x) => {
   let replied = act({r | session: x.session}, "captain_reply", i.worker, chosen.approach, i.task, None, r.session);
   let h = answerPending(replied, p, i.worker, i.task, "reconsider-${id}");
   decide(h.run, o, rules, i.task, i.worker, h.label)
  }
 }
}

pure func decisions(r: Run, p: Policy, o: Orders, rules: [Rule], turn: int) -> Run = {
 let r0 = settle(r, p, o, rules, turn);
 let offered = filter(\t. t.status == Offered && not stale(r0.session, t) && not waiting(r0.session, t.id), r0.session.state.tasks);
 let r1 = foldl(\acc t. persuade(acc, p, o, rules, turn, t), r0, offered);
 let working = filter(\t. t.status == Working, r1.session.state.tasks);
 let r2 = foldl(\acc t. checkIn(acc, p, o, turn, t), r1, working);
 settle(foldl(\acc w. assign(acc, p, o, rules, turn, w), r2, r2.session.scenario.workers), p, o, rules, turn)
}

pure func closing(r: Run, rules: [Rule], turn: int) -> Run = if stopped(r) then r else { let before = r.session; prune(watch(step(r, turn), rules, before)) }

pure func turnOf(r: Run, p: Policy, o: Orders, rules: [Rule], turn: int) -> Run = closing(decisions(r, p, o, rules, turn), rules, turn)

-- Logs are built newest-first (constant-time adds over long skips) and
-- returned oldest-first.
pure func result(r: Run, start: int) -> AutoResult = { session: r.session, state: r.state, turns: r.session.state.tick - start, escalated: r.escalated, log: reverse(r.log), noted: reverse(r.noted) }

-- The two halves of one turn, for callers that look between them (the crew
-- lab measures resources after the decisions). They count escalations
-- (noted) instead of stopping: play goes on as the orders decide. decideTurn makes the turn's
-- decisions; finishTurn advances to `turn` and checks the escalation rules.
export pure func decideTurn(s: Session, st: AutoState, p: Policy, o: Orders, rules: [Rule], turn: int) -> AutoResult ! {}
ensures { result.session.state.tick == s.state.tick } = result(decisions({ session: s, state: st, log: [], escalated: None, halting: false, noted: [], salt: "" }, p, o, rules, turn), s.state.tick)

export pure func finishTurn(a: AutoResult, rules: [Rule], turn: int) -> AutoResult ! {}
ensures { result.session.state.tick >= a.session.state.tick } = {
 let start = a.session.state.tick;
 let r = closing({ session: a.session, state: a.state, log: reverse(a.log), escalated: a.escalated, halting: false, noted: reverse(a.noted), salt: "" }, rules, turn);
 {result(r, start) | turns: a.turns + (r.session.state.tick - start)}
}

-- Run up to n turns from the session's tick under `orders`, stopping at the
-- first escalation. The turn that escalates stops before its advance when a
-- decision is handed over (refusal under orders), or after it (breakdown,
-- trust floor, major, argument).
export pure func advanceAuto(s: Session, st: AutoState, p: Policy, o: Orders, rules: [Rule], n: int) -> Result[AutoResult, HostError] ! {}
ensures { match result { Ok(a) => a.turns <= n && a.session.state.tick >= s.state.tick, Err(_) => true } } =
 if n < 0 || n > 100000 then Err(HostFailure("auto turns must be 0..100000")) else {
  let start = s.state.tick;
  let c = if o.cadence < 1 then 1 else o.cadence;
  let blocks = (n + c - 1) / c;
  let run = foldl(\acc b. if stopped(acc) then acc else { let first = start + b * c + 1; let last = if start + (b + 1) * c > start + n then start + n else start + (b + 1) * c; closing(decisions(acc, p, o, rules, first), rules, last) }, { session: s, state: st, log: [], escalated: None, halting: true, noted: [], salt: if st.calls == 0 then "" else "a${show(st.calls)}" }, range(0, blocks));
  let done = result(run, start);
  let after = done.state;
  Ok({done | state: {after | calls: after.calls + 1}})
 }
