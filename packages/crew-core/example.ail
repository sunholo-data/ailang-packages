module sunholo/crew_core/example
import std/result (Result, Ok, Err)
import ./scenario (Scenario, decodeScenario)

-- Generated by tools/gen-example.sh from examples/crew-lab/data/watch-scenario.json.
-- Do not edit; edit the JSON and regenerate. Five specialists prepare a bubble
-- ship's crew for possible first contact.

export pure func firstContactJson() -> string
ensures { result != "" } = "{\"schema\":\"crew_scenario/1\",\"id\":\"crew-watch-v2\",\"indicators\":[\"fatigue\",\"stress\",\"morale\",\"readiness\",\"observations\",\"trust\"],\"indicator_defaults\":{\"fatigue\":0,\"stress\":0,\"morale\":50,\"readiness\":50,\"observations\":0},\"captain\":{\"id\":\"captain\",\"values\":{\"mission\":80},\"start\":{\"fatigue\":10,\"stress\":35,\"morale\":60}},\"crew\":[{\"id\":\"scientist\",\"role\":\"Scientist\",\"ocean\":{\"openness\":80,\"conscientiousness\":80,\"extraversion\":20,\"agreeableness\":50,\"neuroticism\":50},\"values\":{\"curiosity\":80,\"autonomy\":75},\"start\":{\"fatigue\":45,\"stress\":65,\"morale\":55},\"work\":[{\"id\":\"work_scientist\",\"name\":\"Analyse Spire readings\",\"purpose\":\"Interpret the Spire readings before possible contact.\",\"duration\":4,\"costs\":[{\"resource\":\"archive_compute\",\"reserve\":2,\"consume\":0}],\"effects\":{\"observations\":25,\"fatigue\":20,\"stress\":10,\"morale\":5}}]},{\"id\":\"engineer\",\"role\":\"Engineer\",\"ocean\":{\"openness\":20,\"conscientiousness\":80,\"extraversion\":20,\"agreeableness\":50,\"neuroticism\":20},\"values\":{\"reliability\":85,\"fairness\":70},\"start\":{\"fatigue\":30,\"stress\":50,\"morale\":55},\"work\":[{\"id\":\"work_engineer\",\"name\":\"Service signal equipment\",\"purpose\":\"Prepare reliable equipment for receiving a signal.\",\"duration\":3,\"costs\":[{\"resource\":\"archive_compute\",\"reserve\":1,\"consume\":0},{\"resource\":\"replacement_modules\",\"reserve\":1,\"consume\":1}],\"effects\":{\"readiness\":20,\"fatigue\":15,\"stress\":5,\"morale\":0}}]},{\"id\":\"medic\",\"role\":\"Medic\",\"ocean\":{\"openness\":50,\"conscientiousness\":50,\"extraversion\":50,\"agreeableness\":80,\"neuroticism\":50},\"values\":{\"care\":85,\"fairness\":70},\"start\":{\"fatigue\":40,\"stress\":60,\"morale\":65},\"work\":[{\"id\":\"work_medic\",\"name\":\"Prepare diagnostic supplies\",\"purpose\":\"Organise diagnostic supplies for the coming encounter.\",\"duration\":2,\"costs\":[{\"resource\":\"diagnostic_cartridges\",\"reserve\":1,\"consume\":1}],\"effects\":{\"readiness\":15,\"fatigue\":10,\"stress\":5,\"morale\":5}}]},{\"id\":\"pilot\",\"role\":\"Pilot\",\"ocean\":{\"openness\":20,\"conscientiousness\":20,\"extraversion\":80,\"agreeableness\":50,\"neuroticism\":20},\"values\":{\"safety\":80,\"autonomy\":75},\"start\":{\"fatigue\":25,\"stress\":55,\"morale\":60},\"work\":[{\"id\":\"work_pilot\",\"name\":\"Plan approach observations\",\"purpose\":\"Prepare an observation approach without moving the ship yet.\",\"duration\":2,\"costs\":[{\"resource\":\"archive_compute\",\"reserve\":2,\"consume\":0}],\"effects\":{\"readiness\":15,\"fatigue\":15,\"stress\":10,\"morale\":0}}]},{\"id\":\"diplomat\",\"role\":\"Diplomat\",\"ocean\":{\"openness\":50,\"conscientiousness\":50,\"extraversion\":80,\"agreeableness\":80,\"neuroticism\":20},\"values\":{\"cooperation\":85,\"curiosity\":70},\"start\":{\"fatigue\":35,\"stress\":65,\"morale\":70},\"work\":[{\"id\":\"work_diplomat\",\"name\":\"Rehearse first-contact signals\",\"purpose\":\"Practise signals that may help us begin a conversation.\",\"duration\":3,\"costs\":[{\"resource\":\"archive_compute\",\"reserve\":1,\"consume\":0}],\"effects\":{\"readiness\":15,\"fatigue\":10,\"stress\":10,\"morale\":5}}]}],\"rest\":{\"purpose\":\"Make room to recover before another assignment.\",\"duration\":2,\"effects\":{\"fatigue\":-20,\"stress\":-15,\"morale\":5}},\"overextended\":{\"indicator\":\"stress\",\"threshold\":70,\"recovery\":45,\"duration\":2,\"cooldown\":3},\"trust_in_captain\":50,\"resources\":[{\"id\":\"archive_compute\",\"name\":\"Archive compute slots\",\"initial\":3},{\"id\":\"replacement_modules\",\"name\":\"Replacement modules\",\"initial\":3},{\"id\":\"diagnostic_cartridges\",\"name\":\"Diagnostic cartridges\",\"initial\":4}]}"

export pure func firstContact() -> Result[Scenario, string]
ensures { match result { Ok(s) => s.captain == "captain", Err(_) => true } } = decodeScenario(firstContactJson())

test "first contact example decodes" { match firstContact() { Ok(s) => s.id == "crew-watch-v2", Err(_) => false } }
