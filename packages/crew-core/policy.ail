module sunholo/crew_core/policy
import std/result (Result, Ok, Err)
import std/option (Option, Some, None)
import std/json (Json, decode, encode, get, getArray, getString, getInt, getNumber, keys, jo, kv, js, jint, jnum, ja, asObject, allStrings)
import std/list (map, filter, foldl, length, dedup, contains, any)
import std/string (replace, length as size, charCode, chars, toLower, contains as stringContains, find, substring, startsWith, trim)
import ./session (Request)
import std/crypto (sha256Hex)
import ./codec (object)
import pkg/sunholo/content_library/library (WeightedLabel, Bundle, starterBundle, nextRoll, pickLabel)

-- Authored response policy (crew_response_policy/1): which reactions a crew
-- member may give and how their traits, indicators and relationships weight
-- them. Pure; the draw uses the caller's explicit seed.

export type Influence = { source: string, id: string, to: string, coefficient: int } deriving (Eq)

export type ResponseRule = { label: string, phase: string, recipe: string, base: int, influences: [Influence] } deriving (Eq)

-- strain (optional in crew_response_policy/1; shift 0 = off): while the
-- actor's `indicator` is at or over `threshold` (overextended), accept and
-- continue lose shift% x N/100 of their weight and decline and request_relief
-- gain the same, so strain shows up as refusals and relief requests.
export type Strain = { indicator: string, threshold: int, shift: int } deriving (Eq)
export type Policy = { callLimit: int, rules: [ResponseRule], strain: Strain } deriving (Eq)

pure func noStrain() -> Strain = { indicator: "stress", threshold: 100, shift: 0 }

pure func str(j: Json, k: string) -> string = match getString(j, k) {
  Some(s) => s,
  None => ""
}

pure func num(j: Json, k: string) -> int = match getInt(j, k) {
  Some(n) => n,
  None => 0
}

pure func text(s: string) -> bool =
  size(s) > 0 && size(s) <= 64 && (if any(\c. charCode(c) < 32 || charCode(c) == 127, chars(s)) then false else true)

pure func fields(j: Json, expected: [string]) -> bool = match asObject(j) {
  None => false,
  Some(_) => let ks = keys(j) in
  length(ks) == length(expected) && length(ks) == length(dedup(ks)) && (if any(\k. if contains(ks, k) then false else true, expected) then false else true)
}

pure func integer(j: Json, k: string, lo: int, hi: int) -> bool = match (getNumber(j, k), getInt(j, k)) {
  (Some(n), Some(i)) => n >= intToFloat(lo) && n <= intToFloat(hi) && n == intToFloat(i),
  _ => false
}

pure func influenceOK(i: Influence) -> bool =
  contains(["attribute", "value", "indicator", "relationship"], i.source) && text(i.id) && i.coefficient >= 0 - 100 && i.coefficient <= 100 && (if i.source == "relationship" then text(i.to) else i.to == "")

pure func readInfluence(j: Json) -> Result[Influence, string] =
  let i = { source: str(j, "source"), id: str(j, "id"), to: str(j, "to"), coefficient: num(j, "coefficient") } in
  if fields(j, ["source", "id", "to", "coefficient"]) && integer(j, "coefficient", 0 - 100, 100) && influenceOK(i) && (match getString(j, "to") {
    Some(_) => true,
    _ => false
  }) then Ok(i) else Err("influence_schema")

@allow_empty_ok("Rules may have no influences; bounded by public decoder")
pure func readInfluences(xs: [Json]) -> Result[[Influence], string] = match xs {
  [] => Ok([]),
  x :: rest => match readInfluence(x) {
    Err(e) => Err(e),
    Ok(i) => match readInfluences(rest) {
      Err(e) => Err(e),
      Ok(is) => Ok(i :: is)
    }
  }
}

pure func ruleOK(r: ResponseRule) -> bool =
  text(r.label) && contains(["any", "offered", "working"], r.phase) && text(r.recipe) && r.base >= 0 && r.base <= 1000 && length(r.influences) <= 16 && (if any(\i. if influenceOK(i) then false else true, r.influences) then false else true) && length(dedup(map(\i. "${i.source}/${i.id}/${i.to}", r.influences))) == length(r.influences)

pure func readRule(j: Json) -> Result[ResponseRule, string] =
  if not fields(j, ["label", "phase", "recipe", "base", "influences"]) || not integer(j, "base", 0, 1000) then Err("rule_schema") else match getArray(j, "influences") {
    None => Err("influences"),
    Some(xs) => if length(xs) > 16 then Err("influences_size") else match readInfluences(xs) {
      Err(e) => Err(e),
      Ok(is) => let r = { label: str(j, "label"), phase: str(j, "phase"), recipe: str(j, "recipe"), base: num(j, "base"), influences: is } in
      if ruleOK(r) then Ok(r) else Err("rule_bounds")
    }
  }

@allow_empty_ok("Recursive tail; public decoder requires 1 to 32 rules")
pure func readRules(xs: [Json]) -> Result[[ResponseRule], string] = match xs {
  [] => Ok([]),
  x :: rest => match readRule(x) {
    Err(e) => Err(e),
    Ok(r) => match readRules(rest) {
      Err(e) => Err(e),
      Ok(rs) => Ok(r :: rs)
    }
  }
}

pure func policyOK(p: Policy) -> bool =
  p.callLimit >= 0 && p.callLimit <= 64 && length(p.rules) > 0 && length(p.rules) <= 32 && (if any(\r. if ruleOK(r) then false else true, p.rules) then false else true) && length(dedup(map(\r. "${r.label}/${r.phase}/${r.recipe}", p.rules))) == length(p.rules)

export pure func decodePolicy(body: string) -> Result[Policy, string]
ensures { match result {
  Ok(p) => policyOK(p),
  Err(_) => true
} } = match object(body) {
  Err(e) => Err(e),
  Ok(j) => if not (fields(j, ["schema", "callLimit", "rules"]) || fields(j, ["schema", "callLimit", "rules", "strain"])) || str(j, "schema") != "crew_response_policy/1" || not integer(j, "callLimit", 0, 64) then Err("policy_schema") else match getArray(j, "rules") {
    None => Err("rules"),
    Some(xs) => if length(xs) > 32 then Err("rules_size") else match readRules(xs) {
      Err(e) => Err(e),
      Ok(rs) => match readStrain(j) {
        Err(e) => Err(e),
        Ok(st) => let p = { callLimit: num(j, "callLimit"), rules: rs, strain: st } in
        if policyOK(p) then Ok(p) else Err("policy_bounds")
      }
    }
  }
}

pure func readStrain(j: Json) -> Result[Strain, string] = match get(j, "strain") {
  None => Ok(noStrain()),
  Some(o) => if not fields(o, ["indicator", "threshold", "shift"]) || not integer(o, "threshold", 0, 100) || not integer(o, "shift", 0, 100) || not text(str(o, "indicator")) then Err("strain") else Ok({ indicator: str(o, "indicator"), threshold: num(o, "threshold"), shift: num(o, "shift") })
}

pure func perceived(c: Json, field: string, id: string) -> Option[int] = match getArray(c, field) {
  None => None,
  Some(xs) => match filter(\j. str(j, "id") == id, xs) { [j] => Some(num(j, "value")), _ => None }
}

-- Apply the policy's strain shift to computed weights (1..1000 kept).
pure func strained(p: Policy, c: Json, ws: [WeightedLabel]) -> [WeightedLabel] =
  if p.strain.shift == 0 then ws else match (perceived(c, "indicators", p.strain.indicator), perceived(c, "attributes", "neuroticism")) {
    (Some(v), Some(n)) => if v < p.strain.threshold then ws else {
      let f = p.strain.shift * n / 100;
      let bound = \w. if w < 1 then 1 else if w > 1000 then 1000 else w;
      map(\w. if w.label == "accept" || w.label == "continue" then { w | weight: bound(w.weight * (100 - f) / 100) } else if w.label == "decline" || w.label == "request_relief" then { w | weight: bound(w.weight * (100 + f) / 100) } else w, ws)
    },
    _ => ws
  }

pure func inf(source: string, id: string, to: string, n: int) -> Influence =
  { source: source, id: id, to: to, coefficient: n }

pure func rule(label: string, phase: string, recipe: string, base: int, is: [Influence]) -> ResponseRule =
  { label: label, phase: phase, recipe: recipe, base: base, influences: is }

pure func defaultRules() -> [ResponseRule] =
  [rule("accept", "offered", "*", 400, [inf("attribute", "openness", "", 1), inf("attribute", "conscientiousness", "", 1), inf("attribute", "agreeableness", "", 1), inf("attribute", "neuroticism", "", 0 - 1), inf("indicator", "fatigue", "", 0 - 2), inf("relationship", "trust", "captain", 1)]), rule("accept", "offered", "observations", 100, [inf("value", "curiosity", "", 1)]), rule("accept", "offered", "maintenance", 100, [inf("value", "reliability", "", 1)]), rule("decline", "offered", "*", 120, [inf("indicator", "fatigue", "", 2), inf("relationship", "trust", "captain", 0 - 1)]), rule("concern", "offered", "*", 160, [inf("attribute", "extraversion", "", 1), inf("attribute", "neuroticism", "", 1)]), rule("defer", "any", "*", 80, [inf("indicator", "fatigue", "", 1)]), rule("continue", "working", "*", 400, [inf("attribute", "conscientiousness", "", 1), inf("indicator", "fatigue", "", 0 - 2), inf("relationship", "trust", "captain", 1)]), rule("request_relief", "working", "*", 160, [inf("indicator", "fatigue", "", 3), inf("attribute", "neuroticism", "", 1)])]

pure func influenceJson(i: Influence) -> Json =
  jo([kv("source", js(i.source)), kv("id", js(i.id)), kv("to", js(i.to)), kv("coefficient", jint(i.coefficient))])

pure func ruleJson(r: ResponseRule) -> Json =
  jo([kv("label", js(r.label)), kv("phase", js(r.phase)), kv("recipe", js(r.recipe)), kv("base", jint(r.base)), kv("influences", ja(map(influenceJson, r.influences)))])

export pure func defaultPolicyBody() -> string
ensures { size(result) > 0 && size(result) <= 65536 } =
  encode(jo([kv("schema", js("crew_response_policy/1")), kv("callLimit", jint(2)), kv("rules", ja(map(ruleJson, defaultRules())))]))

export pure func watchPolicyBody() -> string ! {}
ensures { size(result) > 0 && size(result) <= 65536 } = {
  let rs = [rule("accept", "offered", "*", 400, [inf("attribute", "openness", "", 1), inf("attribute", "conscientiousness", "", 1), inf("attribute", "agreeableness", "", 1), inf("attribute", "neuroticism", "", -1), inf("indicator", "fatigue", "", -2), inf("indicator", "stress", "", -2), inf("indicator", "morale", "", 2), inf("relationship", "trust", "captain", 1)]), rule("decline", "offered", "*", 120, [inf("indicator", "fatigue", "", 2), inf("indicator", "stress", "", 2), inf("indicator", "morale", "", -1), inf("relationship", "trust", "captain", -1)]), rule("concern", "offered", "*", 160, [inf("attribute", "extraversion", "", 1), inf("attribute", "neuroticism", "", 1), inf("indicator", "stress", "", 2)]), rule("defer", "any", "*", 80, [inf("indicator", "fatigue", "", 1), inf("indicator", "stress", "", 1)]), rule("continue", "working", "*", 400, [inf("attribute", "conscientiousness", "", 1), inf("indicator", "fatigue", "", -2), inf("indicator", "stress", "", -2), inf("indicator", "morale", "", 2), inf("relationship", "trust", "captain", 1)]), rule("request_relief", "working", "*", 160, [inf("indicator", "fatigue", "", 3), inf("indicator", "stress", "", 2), inf("indicator", "morale", "", -1), inf("attribute", "neuroticism", "", 1)]), rule("accept", "offered", "work_scientist", 100, [inf("value", "curiosity", "", 1)]), rule("accept", "offered", "work_engineer", 100, [inf("value", "reliability", "", 1)]), rule("accept", "offered", "work_medic", 100, [inf("value", "care", "", 1)]), rule("accept", "offered", "work_pilot", 100, [inf("value", "safety", "", 1)]), rule("accept", "offered", "work_diplomat", 100, [inf("value", "cooperation", "", 1)])]
  encode(jo([kv("schema", js("crew_response_policy/1")), kv("callLimit", jint(12)), kv("rules", ja(map(ruleJson, rs)))]))
}

-- Only frozen observer-owned Request.context is read. Missing data is an error.
pure func observed(context: Json, i: Influence) -> Result[int, string] =
  let field = if i.source == "attribute" then "attributes" else if i.source == "value" then "values" else if i.source == "indicator" then "indicators" else "relationships" in
  match getArray(context, field) {
    None => Err("missing_perception_${field}"),
    Some(xs) => if length(xs) > 128 then Err("perception_size") else let found = filter(\j. if i.source == "relationship" then str(j, "dimension") == i.id && str(j, "to") == i.to else str(j, "id") == i.id, xs) in
    match found {
      [j] => if (if i.source == "relationship" then fields(j, ["to", "dimension", "value"]) else fields(j, ["id", "value"])) && integer(j, "value", 0, 100) then Ok(num(j, "value")) else Err("perception_value"),
      _ => Err("missing_or_duplicate_${field}_${i.id}")
    }
  }

pure func contributions(xs: [Influence], context: Json, total: int) -> Result[int, string] = match xs {
  [] => Ok(total),
  i :: rest => match observed(context, i) {
    Err(e) => Err(e),
    Ok(n) => contributions(rest, context, total + i.coefficient * (n - 50))
  }
}

pure func score(rs: [ResponseRule], context: Json, total: int) -> Result[int, string] = match rs {
  [] => Ok(total),
  r :: rest => match contributions(r.influences, context, r.base) {
    Err(e) => Err(e),
    Ok(n) => score(rest, context, total + n)
  }
}

@allow_empty_ok("Recursive legal-label tail; public weights requires nonempty legal labels")
pure func labels(ls: [string], p: Policy, c: Json, phase: string, recipe: string) -> Result[[WeightedLabel], string] =
  match ls {
    [] => Ok([]),
    l :: rest => let rs = filter(\r. r.label == l && (r.phase == "any" || r.phase == phase) && (r.recipe == "*" || r.recipe == recipe), p.rules) in
    if length(rs) == 0 then Err("missing_label_rule_${l}") else match score(rs, c, 0) {
      Err(e) => Err(e),
      Ok(n) => match labels(rest, p, c, phase, recipe) {
        Err(e) => Err(e),
        Ok(xs) => Ok({ label: l, weight: if n < 1 then 1 else if n > 1000 then 1000 else n } :: xs)
      }
    }
  }

export pure func weights(policy: Policy, request: Request) -> Result[[WeightedLabel], string]
ensures { match result {
  Ok(xs) => length(xs) == length(request.legal) && (if any(\x. x.weight < 1 || x.weight > 1000, xs) then false else true),
  Err(_) => true
} } =
  if not policyOK(policy) || length(request.legal) == 0 || length(request.legal) > 8 || length(dedup(request.legal)) != length(request.legal) then Err("weight_inputs") else match object(request.context) {
    Err(e) => Err(e),
    Ok(c) => if not fields(c, ["actor", "task", "recipe", "attributes", "values", "indicators", "relationships", "visible"] ++ (if request.policyId == "crew-conversation-v1" then ["conversation"] else [])) || str(c, "actor") != request.actor || str(c, "task") != request.task || not text(str(c, "recipe")) then Err("perception_binding") else if contains(request.legal, "accept") && contains(request.legal, "continue") then Err("ambiguous_phase") else let phase = if contains(request.legal, "accept") then "offered" else "working" in
    match labels(request.legal, policy, c, phase, str(c, "recipe")) { Err(e) => Err(e), Ok(ws) => Ok(strained(policy, c, ws)) }
  }

-- Preview the existing opinion draw; publication still commits both original
-- rolls only after a valid reply and its journal have been accepted.
export pure func chooseReaction(policy:Policy,request:Request,seed:int)->Result[string,string] ! {}
ensures {match result {Err(_)=>true,Ok(label)=>contains(request.legal,label)}} =
 match (weights(policy,request),nextRoll(seed)) {
  (Ok(ws),Ok(roll))=>pickLabel(ws,roll.roll),
  (Err(e),_)=>Err(e),(_,Err(e))=>Err(e)
 }

-- The authored answer a crew member gives: the decisions-format body for
-- session.complete, choosing exactly `label` with confidence 1.
export pure func fixtureBody(request: Request, label: string) -> string
requires { contains(request.legal, label) }
ensures { size(result) > 0 } =
  encode(jo([kv("model", js("synthetic:library-v1")), kv("id", js("library-${request.id}")), kv("answers", jo([kv("response", jo([kv("type", js("choice")), kv("choice", js(label)), kv("confidence", jnum(1.0)), kv("probabilities", jo(map(\l. kv(l, jnum(if l == label then 1.0 else 0.0)), request.legal)))]))])), kv("usage", jo([kv("input_tokens", jint(0)), kv("output_tokens", jint(0)), kv("cost", jnum(0.0))]))]))

export type Answer = {label: string, body: string, roll: float, seed: int} deriving (Eq)

-- Choose a reaction with the policy's weights and the caller's seed, and build
-- its authored answer. `seed` is the next seed to use; `roll` goes to complete.
export pure func authoredAnswer(policy: Policy, request: Request, seed: int) -> Result[Answer, string]
ensures { match result { Ok(a) => contains(request.legal, a.label), Err(_) => true } } =
 match (weights(policy, request), nextRoll(seed)) {
  (Ok(ws), Ok(r)) => match pickLabel(ws, r.roll) {
   Ok(label) => Ok({label: label, body: fixtureBody(request, label), roll: r.roll, seed: r.seed}),
   Err(e) => Err(e)
  },
  (Err(e), _) => Err(e),
  (_, Err(e)) => Err(e)
 }

pure func strainCtx(stress: int, n: int) -> Json = match decode("{\"attributes\":[{\"id\":\"neuroticism\",\"value\":${show(n)}}],\"indicators\":[{\"id\":\"stress\",\"value\":${show(stress)}}]}") { Ok(j) => j, Err(_) => jo([]) }
pure func strainWs() -> [WeightedLabel] = [{label: "accept", weight: 400}, {label: "decline", weight: 100}, {label: "concern", weight: 200}]
pure func strainPolicy(shift: int) -> Policy = { callLimit: 2, rules: [], strain: { indicator: "stress", threshold: 70, shift: shift } }

test "strain shifts weights from accept to decline only when overextended, scaled by neuroticism" {
 strained(strainPolicy(50), strainCtx(80, 60), strainWs()) == [{label: "accept", weight: 280}, {label: "decline", weight: 130}, {label: "concern", weight: 200}]
 && strained(strainPolicy(50), strainCtx(69, 60), strainWs()) == strainWs()
 && strained(strainPolicy(0), strainCtx(90, 100), strainWs()) == strainWs()
 && strained(strainPolicy(50), strainCtx(90, 0), strainWs()) == strainWs()
}

test "policies without strain decode as before; strain is validated" {
 match (decodePolicy(watchPolicyBody()), decodePolicy(replace(watchPolicyBody(), "\"callLimit\":12", "\"callLimit\":12,\"strain\":{\"indicator\":\"stress\",\"threshold\":70,\"shift\":50}")), decodePolicy(replace(watchPolicyBody(), "\"callLimit\":12", "\"callLimit\":12,\"strain\":{\"indicator\":\"stress\",\"threshold\":170,\"shift\":50}"))) {
  (Ok(p), Ok(q), Err(_)) => p.strain.shift == 0 && q.strain == { indicator: "stress", threshold: 70, shift: 50 },
  _ => false
 }
}
