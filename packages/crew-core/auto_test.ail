module sunholo/crew_core/auto_test
import std/result (Result, Ok, Err)
import std/option (Option, Some, None)
import std/string (startsWith, replace)
import std/list (head, filter, length, any, contains, map, foldl)
import pkg/sunholo/social_dynamics/model (Offered, Working)
import ./scenario (decodeScenario)
import ./example (firstContact)
import ./session (Session, HostError, HostFailure, start, input)
import ./policy (Policy, decodePolicy, watchPolicyBody)
import ./auto (Orders, Rule, AutoResult, Act, advanceAuto, consentOrders, ordersOrders, decodeOrders, decodeEscalation, standDownWait)

pure func ship(policy: string) -> Result[Session, HostError] = match firstContact() {
 Err(e) => Err(HostFailure(e)),
 Ok(sc) => match start(sc, "{\"command\":\"start\",\"policy\":\"${policy}\",\"scenario\":\"watch-v2\"}") { Err(e) => Err(e), Ok(o) => Ok(o.session) }
}

pure func responses() -> Result[Policy, string] = decodePolicy(watchPolicyBody())

pure func run(policy: string, o: Orders, rules: [Rule], n: int) -> Result[AutoResult, HostError] = match (ship(policy), responses()) {
 (Ok(s), Ok(p)) => advanceAuto(s, {seed: 7, agreed: [], raised: [], calls: 0}, p, o, rules, n),
 (Err(e), _) => Err(e),
 (_, Err(e)) => Err(HostFailure(e))
}

pure func rule(kind: string, indicator: string, threshold: int) -> Rule = {kind: kind, indicator: indicator, threshold: threshold, kinds: []}

test "without rules auto-play runs every turn and never escalates" {
 match run("consent", consentOrders(), [], 6) { Ok(a) => a.turns == 6 && a.session.state.tick == 6 && a.escalated == None && length(a.log) > 0, Err(_) => false }
}

test "a refusal under orders stops before the override and leaves the work offered" {
 match run("orders", ordersOrders(), [rule("refusal_under_orders", "", 0)], 40) {
  Ok(a) => match a.escalated {
   Some(e) => e.rule == "refusal_under_orders" && e.detail != "accept" && any(\t. t.id == e.task && t.status == Offered, a.session.state.tasks) && a.turns < 40,
   None => false
  },
  Err(_) => false
 }
}

test "a breakdown threshold escalates once per crossing, not again while it lasts" {
 match (run("orders", ordersOrders(), [rule("breakdown", "stress", 1)], 5), responses()) {
  (Ok(a), Ok(p)) => match a.escalated {
   Some(e) => e.rule == "breakdown" && a.turns == 1 && length(a.state.raised) >= 1 && (match advanceAuto(a.session, a.state, p, ordersOrders(), [rule("breakdown", "stress", 1)], 3) {
     Ok(b) => b.escalated == None || (match b.escalated { Some(x) => not contains(a.state.raised, "breakdown:stress:1/${x.actor}"), None => true }),
     Err(_) => false
   }),
   None => false
  },
  _ => false
 }
}

test "a trust floor escalates when someone's trust falls below it" {
 match run("orders", ordersOrders(), [rule("trust_floor", "", 50)], 60) {
  Ok(a) => match a.escalated { Some(e) => e.rule == "trust_floor" && e.actor != "", None => false },
  Err(_) => false
 }
}

test "standing orders and escalation rules decode and validate" {
 decodeOrders("{\"schema\":\"crew_standing_orders/1\",\"start\":\"always\",\"rest\":\"never\",\"relief\":\"strained\"}") == Ok({start: "always", rest: "never", relief: "strained", fatigue: 70, stress: 75, cadence: 1, concerns: "escalate", standDown: "on"})
 && (match decodeOrders("{\"schema\":\"crew_standing_orders/1\",\"start\":\"maybe\",\"rest\":\"never\",\"relief\":\"deny\"}") { Err(_) => true, Ok(_) => false })
 && (match decodeEscalation("{\"schema\":\"crew_escalation/1\",\"rules\":[{\"kind\":\"breakdown\",\"indicator\":\"stress\",\"threshold\":85},{\"kind\":\"major\",\"kinds\":[\"loss\",\"deep_time\"]},{\"kind\":\"argument\"}]}") { Ok(rs) => length(rs) == 3, Err(_) => false })
 && (match decodeEscalation("{\"schema\":\"crew_escalation/1\",\"rules\":[{\"kind\":\"breakdown\",\"threshold\":85}]}") { Err(_) => true, Ok(_) => false })
 && (match decodeEscalation("{\"schema\":\"crew_escalation/1\",\"rules\":[{\"kind\":\"major\"}]}") { Err(_) => true, Ok(_) => false })
}

-- Two crew hold heat; the forward sky takes some at turn 1: they argue.
pure func heatShip() -> string =
 "{\"schema\":\"crew_scenario/1\",\"id\":\"radiators\",\"indicators\":[\"fatigue\",\"stress\",\"trust\",\"morale\"],\"indicator_defaults\":{\"fatigue\":0,\"stress\":20,\"morale\":50},\"captain\":{\"id\":\"captain\",\"values\":{\"mission\":80},\"start\":{}},\"crew\":[${crew("x")},${crew("y")}],\"rest\":{\"purpose\":\"Recover.\",\"duration\":1,\"effects\":{\"fatigue\":-10}},\"overextended\":{\"indicator\":\"stress\",\"threshold\":70,\"recovery\":40,\"duration\":2,\"cooldown\":3},\"trust_in_captain\":80,\"resources\":[{\"id\":\"heat\",\"name\":\"Heat headroom\",\"initial\":2,\"kind\":\"capacity\"}],\"events\":[{\"id\":\"sky\",\"at\":1,\"text\":\"The forward sky loads the radiators.\",\"transfers\":[{\"resource\":\"heat\",\"delta\":-1}],\"major\":\"deep_time\"}]}"
pure func crew(id: string) -> string = "{\"id\":\"${id}\",\"role\":\"Crew ${id}\",\"ocean\":{\"openness\":50,\"conscientiousness\":50,\"extraversion\":50,\"agreeableness\":50,\"neuroticism\":40},\"values\":{\"duty\":60},\"start\":{},\"work\":[{\"id\":\"work_${id}\",\"name\":\"Cool ${id}\",\"purpose\":\"Hold the line.\",\"duration\":6,\"costs\":[{\"resource\":\"heat\",\"reserve\":1,\"consume\":0}],\"effects\":{\"fatigue\":5}}]}"

pure func heatRun(rules: [Rule]) -> Result[AutoResult, HostError] = match (decodeScenario(heatShip()), responses()) {
 (Ok(sc), Ok(p)) => match start(sc, "{\"command\":\"start\",\"policy\":\"orders\",\"scenario\":\"watch-v2\"}") { Err(e) => Err(e), Ok(o) => advanceAuto(o.session, {seed: 3, agreed: [], raised: [], calls: 0}, p, ordersOrders(), rules, 4) },
 (Err(e), _) => Err(HostFailure(e)),
 (_, Err(e)) => Err(HostFailure(e))
}

test "an argument over lost capacity escalates after the turn it happens" {
 match heatRun([{kind: "argument", indicator: "", threshold: 0, kinds: []}]) {
  Ok(a) => match a.escalated { Some(e) => e.rule == "argument" && e.detail == "sf-sky-0" && a.turns == 1, None => false },
  Err(_) => false
 }
}

test "a major ship event of a listed kind escalates" {
 match (heatRun([{kind: "major", indicator: "", threshold: 0, kinds: ["deep_time"]}]), heatRun([{kind: "major", indicator: "", threshold: 0, kinds: ["loss"]}])) {
  (Ok(a), Ok(b)) => (match a.escalated { Some(e) => e.rule == "major" && e.detail == "ev-sky", None => false }) && b.escalated == None,
  _ => false
 }
}

test "a weekly cadence covers the whole span with far fewer decisions" {
 match (run("consent", {consentOrders() | cadence: 7}, [], 21), run("consent", consentOrders(), [], 21)) {
  (Ok(weekly), Ok(daily)) => weekly.turns == 21 && weekly.session.state.tick == 21 && length(filter(\a. a.kind == "offer", weekly.log)) * 2 < length(filter(\a. a.kind == "offer", daily.log)),
  _ => false
 }
}

test "cadence must be 1..365" {
 (match decodeOrders("{\"schema\":\"crew_standing_orders/1\",\"start\":\"agreed\",\"rest\":\"tired\",\"relief\":\"grant\",\"cadence\":0}") { Err(_) => true, Ok(_) => false })
 && (match decodeOrders("{\"schema\":\"crew_standing_orders/1\",\"start\":\"agreed\",\"rest\":\"tired\",\"relief\":\"grant\",\"cadence\":7}") { Ok(o) => o.cadence == 7, Err(_) => false })
}

-- Resume after a refusal stop: the next call salts its ids, so nothing collides.
pure func resumeTwice() -> Result[{first: AutoResult, second: AutoResult}, HostError] = match (ship("orders"), responses()) {
 (Ok(s), Ok(p)) => match advanceAuto(s, {seed: 7, agreed: [], raised: [], calls: 0}, p, ordersOrders(), [rule("refusal_under_orders", "", 0)], 40) {
  Err(e) => Err(e),
  Ok(a) => match advanceAuto(a.session, a.state, p, ordersOrders(), [rule("refusal_under_orders", "", 0)], 40) { Err(e) => Err(e), Ok(b) => Ok({first: a, second: b}) }
 },
 (Err(e), _) => Err(e),
 (_, Err(e)) => Err(HostFailure(e))
}

test "resuming after a refusal stop reuses no ids and logs no errors" {
 match resumeTwice() {
  Ok(x) => x.first.state.calls == 1 && x.second.state.calls == 2 && not any(\a. a.kind == "error", x.second.log) && any(\a. a.kind == "reply", x.second.log),
  Err(_) => false
 }
}

test "a partial last cadence block still covers the whole span" {
 match run("consent", {consentOrders() | cadence: 4}, [], 10) { Ok(a) => a.turns == 10 && a.session.state.tick == 10, Err(_) => false }
}

-- Stapledon drives auto-run on an absolute schedule: from tick 0 at cadence c,
-- decisions fall on turns 1, 1+c, 1+2c, ..., all odd when c is even (D-76's
-- monthly skip is cadence 30). crew_core 0.5.0 checked in only on even turns,
-- so on that schedule nobody was ever asked about relief. A worker on a
-- 15-day job at stress 95, decided every 10 days (turns 1, 11, 21), must be
-- checked in with on day 10 and ask for relief (0.5.1, found by stapledons-godot
-- sprint R2-INTERLUDE I2).
pure func longWatchShip(days: int) -> string =
 "{\"schema\":\"crew_scenario/1\",\"id\":\"long-watch\",\"indicators\":[\"fatigue\",\"stress\",\"trust\",\"morale\"],\"indicator_defaults\":{\"fatigue\":90,\"stress\":95,\"morale\":50},\"captain\":{\"id\":\"captain\",\"values\":{\"mission\":80},\"start\":{}},\"crew\":[{\"id\":\"w\",\"role\":\"Watch keeper\",\"ocean\":{\"openness\":50,\"conscientiousness\":50,\"extraversion\":50,\"agreeableness\":50,\"neuroticism\":90},\"values\":{\"duty\":60},\"start\":{},\"work\":[{\"id\":\"work_w\",\"name\":\"Keep the long watch\",\"purpose\":\"Hold the course.\",\"duration\":${show(days)},\"costs\":[],\"effects\":{\"fatigue\":5}}]}],\"rest\":{\"purpose\":\"Recover.\",\"duration\":1,\"effects\":{\"fatigue\":-10}},\"overextended\":{\"indicator\":\"stress\",\"threshold\":70,\"recovery\":40,\"duration\":2,\"cooldown\":3},\"trust_in_captain\":80,\"resources\":[{\"id\":\"air\",\"name\":\"Air\",\"initial\":10}]}"

pure func longWatch(days: int, o: Orders, n: int) -> Result[AutoResult, HostError] = longWatchFrom(days, 0, o, n)

-- from: plain days advanced before auto-run starts.
pure func longWatchFrom(days: int, from: int, o: Orders, n: int) -> Result[AutoResult, HostError] = match (decodeScenario(longWatchShip(days)), responses()) {
 (Ok(sc), Ok(p)) => match start(sc, "{\"command\":\"start\",\"policy\":\"orders\",\"scenario\":\"watch-v2\"}") {
  Err(e) => Err(e),
  Ok(s) => match (if from == 0 then Ok(s) else input(s.session, "{\"command\":\"advance\",\"tick\":${show(from)},\"budget\":64}")) { Err(e) => Err(e), Ok(t) => advanceAuto(t.session, {seed: 7, agreed: [], raised: [], calls: 0}, p, o, [], n) }
 },
 (Err(e), _) => Err(HostFailure(e)),
 (_, Err(e)) => Err(HostFailure(e))
}

-- stand_down off (0.6.0): this is about relief at work; with stand-downs on,
-- the strained idle worker would stand down at tick 0 instead of working.
test "decisions on odd turns only still check in, and a stressed worker asks for relief" {
 match longWatch(15, {ordersOrders() | cadence: 10, relief: "grant", standDown: "off"}, 30) {
  Ok(a) => a.session.state.tick == 30 && not any(\x. x.kind == "error", a.log)
   && any(\x. x.kind == "relief_asked" && x.actor == "w" && x.tick == 10, a.log)
   && any(\x. x.kind == "relief_decision" && x.label == "granted" && x.tick == 10, a.log),
  Err(_) => false
 }
}

pure func checkInTicks(a: AutoResult) -> [int] = map(\x. x.tick, filter(\x. x.kind == "reply" && (match x.request { Some(q) => startsWith(q.id, "c"), None => false }), a.log))

-- At a daily cadence check-ins come every other day of the work, counted from
-- its start (its days 1 and 3), whatever the parity of the turn numbers: a
-- 4-day job started on tick 0 is checked in with on ticks 1 and 3, one started
-- on tick 1 on ticks 2 and 4 (0.5.0 gave only tick 3 for the second).
test "a daily cadence checks in on the work's odd days, counted from its start" {
 match (longWatch(4, {ordersOrders() | relief: "deny"}, 4), longWatchFrom(4, 1, {ordersOrders() | relief: "deny"}, 4)) {
  (Ok(a), Ok(b)) => checkInTicks(a) == [1, 3] && checkInTicks(b) == [2, 4],
  _ => false
 }
}

-- A project agreement falls due 20 days after its offer, and the host takes no
-- ask after that, so a monthly decision never checks in on long work: no host
-- error each month either.
test "a monthly cadence does not check in on work whose agreement fell due" {
 match longWatch(64, {ordersOrders() | cadence: 30, relief: "grant"}, 90) {
  Ok(a) => a.session.state.tick == 90 && not any(\x. x.kind == "error", a.log) && not any(\x. x.kind == "relief_asked", a.log),
  Err(_) => false
 }
}

-- ------------------------------------------------- stand down (0.6.0)
-- A response policy whose duty answer is almost always stand_down, so the
-- schedule, not the draw, decides when the worker asks.
pure func standingDown() -> Result[Policy, string] = decodePolicy(replace(watchPolicyBody(), "\"rules\":[", "\"rules\":[{\"label\":\"carry_on\",\"phase\":\"duty\",\"recipe\":\"*\",\"base\":0,\"influences\":[]},{\"label\":\"stand_down\",\"phase\":\"duty\",\"recipe\":\"*\",\"base\":1000,\"influences\":[]},{\"label\":\"defer\",\"phase\":\"duty\",\"recipe\":\"*\",\"base\":0,\"influences\":[{\"source\":\"relationship\",\"id\":\"trust\",\"to\":\"captain\",\"coefficient\":-100},{\"source\":\"indicator\",\"id\":\"fatigue\",\"to\":\"\",\"coefficient\":-100}]},"))

-- The long-watch ship with its indicators and trust swapped in.
pure func watchShip(days: int, fatigue: int, stress: int, trust: int) -> string =
 replace(replace(longWatchShip(days), "\"indicator_defaults\":{\"fatigue\":90,\"stress\":95,", "\"indicator_defaults\":{\"fatigue\":${show(fatigue)},\"stress\":${show(stress)},"), "\"trust_in_captain\":80", "\"trust_in_captain\":${show(trust)}")

-- from: plain days advanced first; prelude: host lines before auto-run.
pure func duty(sc: string, policy: string, from: int, prelude: [string], o: Orders, rules: [Rule], n: int) -> Result[AutoResult, HostError] = match (decodeScenario(sc), standingDown()) {
 (Ok(ship), Ok(p)) => match start(ship, "{\"command\":\"start\",\"policy\":\"${policy}\",\"scenario\":\"watch-v2\"}") {
  Err(e) => Err(e),
  Ok(s) => match foldl(\acc l. match acc { Err(e) => Err(e), Ok(x) => match input(x, l) { Err(e) => Err(e), Ok(y) => Ok(y.session) } }, Ok(s.session), (if from == 0 then [] else ["{\"command\":\"advance\",\"tick\":${show(from)},\"budget\":64}"]) ++ prelude) {
   Err(e) => Err(e),
   Ok(t) => advanceAuto(t, {seed: 1000003, agreed: [], raised: [], calls: 0}, p, o, rules, n)
  }
 },
 (Err(e), _) => Err(HostFailure(e)),
 (_, Err(e)) => Err(HostFailure(e))
}

pure func kinds(a: AutoResult, kind: string) -> [Act] = filter(\x. x.kind == kind, a.log)
pure func dutyTicks(a: AutoResult) -> [int] = map(\x. x.tick, filter(\x. x.kind == "reply" && (match x.request { Some(q) => startsWith(q.id, "d"), None => false }), a.log))
pure func clean(a: AutoResult) -> bool = not any(\x. x.kind == "error", a.log)

test "an idle strained worker is checked in at a monthly cadence, asks, and is still assigned after a denial" {
 match duty(watchShip(64, 90, 95, 80), "orders", 0, [], {ordersOrders() | cadence: 30}, [], 30) {
  Ok(a) => clean(a) && dutyTicks(a) == [0]
   && map(\x. x.tick, kinds(a, "stand_down_asked")) == [0] && map(\x. x.label, kinds(a, "stand_down_decision")) == ["denied"]
   && any(\x. x.kind == "offer" && x.tick == 0 && x.actor == "w", a.log) && any(\x. x.kind == "start" && x.tick == 0, a.log),
  Err(_) => false
 }
}

test "an unstrained worker gets no duty check-in" {
 match duty(watchShip(64, 10, 10, 80), "orders", 0, [], {ordersOrders() | cadence: 30}, [], 90) {
  Ok(a) => clean(a) && dutyTicks(a) == [] && length(kinds(a, "stand_down_asked")) == 0,
  Err(_) => false
 }
}

test "a resting worker gets no duty check-in" {
 match duty(watchShip(64, 90, 95, 80), "orders", 0, ["{\"command\":\"offer\",\"worker\":\"w\",\"recipe\":\"rest_w\",\"id\":\"nap\"}", "{\"command\":\"start_task\",\"task\":\"nap\"}"], {ordersOrders() | cadence: 30}, [], 1) {
  Ok(a) => clean(a) && dutyTicks(a) == [],
  Err(_) => false
 }
}

test "below the cooperation floor no duty check-in is made" {
 match duty(watchShip(64, 90, 95, 10), "orders", 0, [], {ordersOrders() | cadence: 30}, [], 90) {
  Ok(a) => dutyTicks(a) == [] && not any(\x. x.kind == "error" && startsWith(x.detail, "check_in"), a.log),
  Err(_) => false
 }
}

-- OQ4: 90, 180, then 360 days after denials in a row. From tick 1 at a
-- monthly cadence the decisions fall on ticks 1, 31, 61, ... The captain
-- starts only agreed work here: overridden refusals over two years would take
-- the worker's trust below the cooperation floor first (then, rightly, no
-- duty check-in is made at all).
test "denials back off: check-ins on ticks 1, 91, 271 and 631" {
 match duty(watchShip(64, 90, 95, 80), "orders", 1, [], {ordersOrders() | cadence: 30, start: "agreed"}, [], 700) {
  Ok(a) => clean(a) && dutyTicks(a) == [1, 91, 271, 631] && length(kinds(a, "stand_down_decision")) == 4 && not any(\x. x.label != "denied", kinds(a, "stand_down_decision"))
   && map(standDownWait, [0, 1, 2, 3, 9]) == [30, 90, 180, 360, 360],
  Err(_) => false
 }
}

test "after a grant the worker waits 30 days, and a cadence of 1 makes no duty check-ins" {
 match (duty(watchShip(64, 90, 95, 80), "consent", 0, [], {consentOrders() | cadence: 10}, [], 70), duty(watchShip(64, 90, 95, 80), "orders", 0, [], ordersOrders(), [], 40)) {
  (Ok(g), Ok(daily)) => clean(g) && map(\x. x.tick, kinds(g, "stand_down_asked")) == [0, 30, 60] && not any(\x. x.label != "granted", kinds(g, "stand_down_decision"))
   && dutyTicks(daily) == [] && length(kinds(daily, "stand_down_asked")) == 0,
  _ => false
 }
}

test "stand_down off makes no duty check-ins at a monthly cadence" {
 match duty(watchShip(64, 90, 95, 80), "orders", 0, [], {ordersOrders() | cadence: 30, standDown: "off"}, [], 120) {
  Ok(a) => clean(a) && dutyTicks(a) == [] && length(kinds(a, "stand_down_asked")) == 0,
  Err(_) => false
 }
}

-- A running job whose project agreement fell due gets a duty check-in, and a
-- grant halts it.
test "running work past its agreement gets a duty check-in; a grant halts it" {
 match duty(watchShip(64, 40, 40, 80), "orders", 0, ["{\"command\":\"offer\",\"worker\":\"w\",\"recipe\":\"work_w\",\"id\":\"job\"}", "{\"command\":\"start_task\",\"task\":\"job\"}", "{\"command\":\"advance\",\"tick\":29,\"budget\":64}"], {ordersOrders() | cadence: 30, relief: "grant", fatigue: 40}, [], 1) {
  Ok(a) => clean(a) && dutyTicks(a) == [29] && map(\x. x.label, kinds(a, "stand_down_decision")) == ["granted"]
   && any(\t. t.id == "job" && t.status != Working, a.session.state.tasks),
  Err(_) => false
 }
}

test "the opt-in stand_down rule hands the request to the player" {
 match duty(watchShip(64, 90, 95, 80), "orders", 0, [], {ordersOrders() | cadence: 30}, [{kind: "stand_down", indicator: "", threshold: 0, kinds: []}], 60) {
  Ok(a) => match a.escalated {
   Some(e) => e.rule == "stand_down" && e.actor == "w" && e.task == "sd-${e.detail}" && a.turns == 0 && length(kinds(a, "stand_down_decision")) == 0
    && (match input(a.session, "{\"command\":\"resolve_stand_down\",\"id\":\"${e.detail}\",\"release\":true}") { Ok(_) => true, Err(_) => false }),
   None => false
  },
  Err(_) => false
 }
}

test "stand_down orders and the stand_down rule decode" {
 (match decodeOrders("{\"schema\":\"crew_standing_orders/1\",\"start\":\"agreed\",\"rest\":\"tired\",\"relief\":\"grant\",\"stand_down\":\"off\"}") { Ok(o) => o.standDown == "off", Err(_) => false })
 && (match decodeOrders("{\"schema\":\"crew_standing_orders/1\",\"start\":\"agreed\",\"rest\":\"tired\",\"relief\":\"grant\",\"stand_down\":\"maybe\"}") { Err(_) => true, Ok(_) => false })
 && consentOrders().standDown == "on" && ordersOrders().standDown == "on"
 && (match decodeEscalation("{\"schema\":\"crew_escalation/1\",\"rules\":[{\"kind\":\"stand_down\"}]}") { Ok(rs) => length(rs) == 1, Err(_) => false })
}
