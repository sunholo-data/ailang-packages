-- Tests for sunholo/mcp_files/widget: the HTML is one self-contained
-- document with the picker, no external resources, the ext-apps client
-- inlined, config values escaped, and model reporting via
-- ui/update-model-context only. tests/widget_check.sh adds an HTML parse
-- and a JavaScript syntax check (node --check) of both inline scripts.

module sunholo/mcp_files/widget_test
import ./widget (claudeWidgetOrigin, WidgetConfig, defaultWidgetConfig, uploadWidgetHtml, htmlEscape, configJson, widgetCspMeta, widgetMimeType)
import ./extapps_bundle (extAppsBundle, extAppsVersion, extAppsSourceSha256)
import ./widget_assets (widgetCss)
import ./brand (Brand, brandWith, defaultBrand, ailangLogoSvg)
import std/string (contains, startsWith, endsWith, split, length, find, substring)
import std/list (length as listLen)

pure func cfg() -> WidgetConfig = defaultWidgetConfig("https://svc.example/uploads", "uploadViaHost")

pure func html() -> string = uploadWidgetHtml(cfg())

-- In a function: `ailang test` v0.52.3 cuts a test body at an unbalanced
-- brace even inside a string literal.
pure func globalsMarker() -> string = "window.__extApps={"

pure func count(s: string, needle: string) -> int = listLen(split(s, needle)) - 1

-- The widget's own script: everything after the second module <script>.
pure func appScript() -> string {
  let parts = split(html(), "<script type='module'>")
  if listLen(parts) != 3 then "" else match parts {
    [_, _, app] => app,
    _ => ""
  }
}

test "widget is one html document" {
  startsWith(html(), "<!doctype html>") && endsWith(html(), "</html>\n") && count(html(), "<html") == 1
}

test "widget has the file picker" {
  contains(html(), "<input type='file' id='file' disabled>") && contains(html(), "id='status'")
}

-- The picker shows only under a tool result that holds an upload descriptor;
-- any other result gets one quiet line ("No upload needed" / "Done.").
test "widget starts with the picker hidden and no waiting text" {
  contains(html(), "<div id='ready' hidden>") && contains(html(), "Waiting for the upload token") == false && contains(html(), "<p id='status' role='status' aria-live='polite'></p>")
}

test "widget idles on a result without a descriptor" {
  contains(appScript(), "if (d) useDescriptor(d); else idle(") && contains(appScript(), "'No upload needed.'") && contains(appScript(), "'Done.'") && count(appScript(), "ready.hidden = false") == 1
}

test "widget reports the upload with size and the after-upload text" {
  contains(appScript(), "size(rc.sizeBytes) + ') — ' + CFG.afterUpload") && contains(configJson(cfg()), "\"afterUpload\":\"processing")
}

-- In functions for the same reason as globalsMarker (an unbalanced brace).
pure func ticketArg() -> string = "arguments: { ticket: desc.upload.multipart.fields.token,"

pure func tokenArg() -> string = "arguments: { token"

test "widget sends the token to the host tool as ticket" {
  contains(appScript(), ticketArg()) && contains(appScript(), tokenArg()) == false
}

test "widget has exactly two inline scripts" {
  count(html(), "<script") == 2 && count(html(), "</script>") == 2
}

-- The only URL in the widget script is the configured upload URL in CFG.
test "widget loads nothing external" {
  contains(html(), "src=") == false && contains(html(), "<link") == false && contains(html(), "@import") == false && contains(html(), "<iframe") == false && count(appScript(), "http") == 1 && contains(appScript(), "import ") == false
}

test "widget inlines the ext-apps client" {
  contains(html(), extAppsBundle()) && contains(extAppsBundle(), globalsMarker()) && contains(extAppsBundle(), "\"App\":") && contains(extAppsBundle(), "\"PostMessageTransport\":") && extAppsVersion() == "2.0.3" && length(extAppsSourceSha256()) == 64
}

test "widget reports with update-model-context, never ui/message" {
  contains(appScript(), "app.updateModelContext(") && contains(appScript(), "sendMessage") == false && contains(appScript(), "ui/message") == false
}

test "widget posts multipart with the descriptor token" {
  contains(appScript(), "new FormData()") && contains(appScript(), "mp.fields") && contains(appScript(), "method: 'POST'")
}

test "widget falls back to the host tool" {
  contains(appScript(), "app.callServerTool(") && contains(appScript(), "CFG.hostToolName")
}

test "widget refuses oversize before spending the token" {
  contains(appScript(), "f.size > desc.maxBytes")
}

test "widget uses no innerHTML" {
  contains(appScript(), "innerHTML") == false && contains(appScript(), "eval(") == false
}

pure func hostile() -> WidgetConfig =
  { cfg() | title: "<script>alert(1)</script>", nextStep: "</script><script>alert(2)</script>", accept: "'><x" }

test "title is html escaped" {
  contains(uploadWidgetHtml(hostile()), "<script>alert(1)") == false && contains(uploadWidgetHtml(hostile()), "&lt;script&gt;alert(1)")
}

test "config cannot close the script" {
  contains(configJson(hostile()), "</script") == false && contains(uploadWidgetHtml(hostile()), "alert(2)</script>") == false
}

test "accept attribute escaped" {
  contains(uploadWidgetHtml(hostile()), "accept='&#39;&gt;&lt;x'")
}

test "html escape" {
  htmlEscape("<a href=\"x\">'&'</a>") == "&lt;a href=&quot;x&quot;&gt;&#39;&amp;&#39;&lt;/a&gt;"
}

test "csp meta declares connect domains" {
  widgetCspMeta(["https://svc.example"]) == "{\"ui\":{\"csp\":{\"connectDomains\":[\"https://svc.example\"],\"resourceDomains\":[]},\"prefersBorder\":true},\"openai/widgetCSP\":{\"connect_domains\":[\"https://svc.example\"],\"resource_domains\":[]}}"
}

test "mcp app mime type" {
  widgetMimeType() == "text/html;profile=mcp-app"
}

-- sha256("https://svc.example/mcp/") = 9dec637978aa9ef7a891f7d3e41385f3… (computed independently with shasum).
test "claude widget origin" { claudeWidgetOrigin("https://svc.example/mcp/") == "https://9dec637978aa9ef7a891f7d3e41385f3.claudemcpcontent.com" }

-- ---------- branding (0.1.2) ----------

pure func accentRule(a: string, on: string) -> string = ":root{--mf-accent:${a};--mf-on-accent:${on}}"

test "default brand renders" {
  contains(html(), "<span class='logo' aria-hidden='true'>${ailangLogoSvg()}</span>") && contains(html(), "<span class='name'>AILANG</span>") && contains(html(), "<span class='powered'>Powered by AILANG</span>") && contains(html(), accentRule("#d03614", "#ffffff"))
}

pure func parseLogo() -> string = "<svg viewBox='0 0 32 32'><rect width='8' height='2' fill='#2563eb'/></svg>"

pure func parseCfg() -> WidgetConfig =
  { cfg() | brand: brandWith("Parse", parseLogo(), "#2563eb", [{label: "Docs", url: "https://docparse.ailang.sunholo.com/docs"}]) }

test "custom brand renders" {
  contains(uploadWidgetHtml(parseCfg()), "<span class='logo' aria-hidden='true'>${parseLogo()}</span><span class='name'>Parse</span>") && contains(uploadWidgetHtml(parseCfg()), accentRule("#2563eb", "#ffffff")) && contains(uploadWidgetHtml(parseCfg()), "<a href='https://docparse.ailang.sunholo.com/docs' rel='noopener noreferrer' target='_blank'>Docs</a>") && contains(uploadWidgetHtml(parseCfg()), ailangLogoSvg()) == false
}

pure func hostileBrand() -> WidgetConfig =
  { cfg() | brand: brandWith("<b>X</b>", "<svg onload='alert(3)'><rect/></svg>", "red;}body{background:red", [{label: "<img src=x onerror=alert(4)>", url: "https://a.example/?q='><script>"}, {label: "<i>ok</i>", url: "https://a.example/ok"}, {label: "js", url: "javascript:alert(5)"}]) }

test "hostile brand is escaped or replaced" {
  contains(uploadWidgetHtml(hostileBrand()), "alert(3)") == false && contains(uploadWidgetHtml(hostileBrand()), ailangLogoSvg()) && contains(uploadWidgetHtml(hostileBrand()), "<span class='name'>&lt;b&gt;X&lt;/b&gt;</span>") && contains(uploadWidgetHtml(hostileBrand()), accentRule("#d03614", "#ffffff")) && contains(uploadWidgetHtml(hostileBrand()), "background:red") == false
}

test "footer labels escaped, unsafe urls dropped" {
  contains(uploadWidgetHtml(hostileBrand()), ">&lt;i&gt;ok&lt;/i&gt;</a>") && contains(uploadWidgetHtml(hostileBrand()), "alert(4)") == false && contains(uploadWidgetHtml(hostileBrand()), "alert(5)") == false && contains(uploadWidgetHtml(hostileBrand()), "<script>") == false
}

test "powered-by can be turned off" {
  contains(uploadWidgetHtml({ cfg() | brand: { defaultBrand() | poweredBy: false } }), "Powered by AILANG") == false
}

test "brand header and footer start hidden and show with the picker" {
  contains(html(), "<div id='card' hidden>") && contains(html(), "<footer id='foot' hidden>") && contains(appScript(), "card.hidden = false; foot.hidden = false;")
}

-- The accent colours the primary (file picker) button and the focus ring,
-- nothing else; there is no background colour, gradient or font.
pure func buttonRule() -> string = "::file-selector-button{font:inherit;font-weight:var(--font-weight-semibold,600);background:var(--mf-accent)"

pure func transparentRule() -> string = "html,body{background:transparent}"

pure func darkMedia() -> string = "@media (prefers-color-scheme: dark){:root:not([data-theme=light])"

test "accent only on the button and the focus ring" {
  count(widgetCss(), "var(--mf-accent)") == 2 && contains(widgetCss(), buttonRule()) && contains(widgetCss(), "outline:2px solid var(--mf-accent)") && contains(widgetCss(), transparentRule()) && contains(widgetCss(), "-gradient(") == false && contains(widgetCss(), "@font-face") == false
}

test "widget follows the host theme" {
  contains(appScript(), "x.applyDocumentTheme(ctx.theme)") && contains(appScript(), "x.applyHostStyleVariables(ctx.styles.variables)") && contains(appScript(), "x.applyHostFonts(ctx.styles.css.fonts)") && contains(appScript(), "app.addEventListener('hostcontextchanged'") && contains(appScript(), "applyHost(app.getHostContext());") && contains(appScript(), "openai:set_globals")
}

test "widget css falls back to prefers-color-scheme and host variables" {
  contains(widgetCss(), darkMedia()) && contains(widgetCss(), ":root[data-theme=dark]") && contains(widgetCss(), "var(--font-sans,") && contains(widgetCss(), "var(--color-text-primary,")
}

test "chatgpt draws its own logo, so the header hides there" {
  contains(appScript(), "if (window.openai) el('brand').hidden = true;")
}

test "footer links open through the host" {
  contains(appScript(), "app.openLink({ url: url })") && contains(appScript(), "window.openai.openExternal({ href: url })")
}
