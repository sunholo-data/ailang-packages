-- Generates the two string-literal modules widget.ail inlines:
--
--   bundle <app-with-deps.js> <version> <out.ail>
--     extapps_bundle.ail from @modelcontextprotocol/ext-apps' self-contained
--     View bundle (the one the F1 spike inlined). Same transformation as the
--     spike's server.ts: the trailing `export{a as B,...}` statement becomes
--     `window.__extApps={"B":a,...}`; it runs as an inline module <script>.
--   assets <out.ail> <name>=<file> ...
--     widget_assets.ail: one `export pure func <name>() -> string` per file
--     (assets/widget.html, widget.js, widget.css), so the sources stay
--     readable files (ailang fmt rewrites multi-line literals onto one line).
--
-- Text is escaped into an AILANG string literal (\ " and ${). Run it through
-- tools/gen_bundle.sh (pins and checks the ext-apps version and sha256).
module sunholo/mcp_files/tools/gen_bundle

import std/io (println, exit)
import std/env (getArgs)
import std/fs (readFile, writeFile)
import std/string (find, substring, length, split, trim, join, replaceMany, contains)
import std/list (map, mapE)
import std/crypto (sha256Hex)

pure func pairGlobal(p: string) -> string {
  let parts = split(trim(p), " as ");
  match parts {
    [local, exported] => "\"${trim(exported)}\":${trim(local)}",
    [local] => "\"${trim(local)}\":${trim(local)}",
    _ => ""
  }
}

-- The bundle with its trailing export statement turned into a global, or "".
export pure func globalise(src: string) -> string {
  let i = find(src, "export{");
  if i < 0 then ""
  else {
    let rest = substring(src, i + 7, length(src));
    let close = find(rest, "}");
    if close < 0 then ""
    else {
      let globals = join(",", map(pairGlobal, split(substring(rest, 0, close), ",")));
      "${substring(src, 0, i)}\nwindow.__extApps={${globals}};\n"
    }
  }
}

export pure func escapeLiteral(s: string) -> string = replaceMany(s, [("\\", "\\\\"), ("\"", "\\\""), ("\${", "\\\${")])

pure func literalFunc(name: string, text: string) -> string =
  "export pure func ${name}() -> string = \"${escapeLiteral(text)}\"\n"

func bundle(src: string, version: string, out: string) -> () ! {IO, FS} {
  let text = readFile(src);
  let js = globalise(text);
  if js == "" then { println("error: no trailing export{...} statement in ${src}"); exit(1) }
  else if contains(js, "</script") then { println("error: bundle contains </script and cannot be inlined"); exit(1) }
  else {
    let header = join("\n", [
      "-- GENERATED by tools/gen_bundle.sh: DO NOT EDIT.",
      "-- @modelcontextprotocol/ext-apps ${version}, dist/src/app-with-deps.js",
      "-- (https://github.com/modelcontextprotocol/ext-apps; MIT / Apache-2.0, see its LICENSE).",
      "-- Its trailing export statement is rewritten to window.__extApps={...};",
      "-- widget.ail inlines it as a module <script>.",
      "module sunholo/mcp_files/extapps_bundle",
      "",
      "export pure func extAppsVersion() -> string = \"${version}\"",
      "",
      "-- sha256 of the source file this was generated from.",
      "export pure func extAppsSourceSha256() -> string = \"${sha256Hex(text)}\"",
      "",
      ""
    ]);
    writeFile(out, "${header}${literalFunc("extAppsBundle", js)}");
    println("wrote ${out} (${show(length(js))} characters)")
  }
}

func assetFunc(pair: string) -> string ! {IO, FS} =
  match split(pair, "=") {
    [name, path] => "\n-- ${path}\n${literalFunc(name, readFile(path))}",
    _ => { println("error: expected name=path, got ${pair}"); exit(2); "" }
  }

func assets(out: string, pairs: [string]) -> () ! {IO, FS} {
  let header = join("\n", [
    "-- GENERATED by tools/gen_bundle.sh from assets/: DO NOT EDIT. Edit the",
    "-- files under assets/ and regenerate (tests/assets_check.sh checks sync).",
    "module sunholo/mcp_files/widget_assets",
    ""
  ]);
  let body = join("", mapE(assetFunc, pairs));
  writeFile(out, "${header}${body}");
  println("wrote ${out}")
}

export func main() -> () ! {IO, FS, Env} {
  match getArgs() {
    ["bundle", src, version, out] => bundle(src, version, out),
    "assets" :: (out :: pairs) => assets(out, pairs),
    _ => { println("usage: gen_bundle bundle <app-with-deps.js> <version> <out.ail> | assets <out.ail> name=path..."); exit(2) }
  }
}
