-- sunholo/mcp_files/widget: the standard MCP Apps upload widget (design:
-- m-mcp-file-handoff.md "The upload widget"; F1 spike, claude.ai web,
-- 2026-10-07: a picker + fetch to a declared connectDomain works, and a
-- widget-only tools/call carries the bytes through the host without the model).
--
-- uploadWidgetHtml(cfg) returns ONE self-contained HTML document:
--   * the official ext-apps client (@modelcontextprotocol/ext-apps 2.0.3
--     app-with-deps.js, the bundle the spike ran) inlined from the generated
--     module extapps_bundle.ail (tools/gen_bundle.sh; sha256-pinned);
--   * a file picker, shown only when the tool result holds an upload
--     descriptor (any other result gets one quiet line: "No upload needed",
--     or "Done." when the call was given a fileRef); on pick it POSTs
--     multipart {token, file} to the descriptor's upload.url (the token comes
--     from the tool result's structuredContent, or its text content as JSON);
--   * if that fetch cannot leave the iframe (CSP, CORS, network) it falls back
--     to the widget-only tool cfg.hostToolName with {ticket, filename, base64};
--   * it reports the receipt with ui/update-model-context (never the host's
--     message request, which drafts a user message under a caution banner).
--   * after the upload (0.1.3) it can call a server tool itself through the
--     host (cfg.onUploaded: an app-initiated tools/call, ext-apps
--     App.callServerTool), with the fileRef substituted into a JSON argument
--     template, and report the result with ui/update-model-context. A model
--     context update starts no model turn (claude.ai, 2026-10-07: the widget
--     sat on "parsing…" until the user typed), so the work is done first.
--   * a brand (brand.ail, 0.1.2): header logo + name, accent on the primary
--     button and focus ring, footer links; every value checked there. The
--     host's theme, style variables and fonts are applied from the MCP Apps
--     host context (prefers-color-scheme without one).
-- No external script, stylesheet or font. The page, script and styles live in
-- assets/ (readable sources) and reach this module through the generated
-- widget_assets.ail.

module sunholo/mcp_files/widget

import std/string (replaceMany, substring, trim, join, split, length, contains)
import std/json (Json, JString, JArray, JObject, decode)
import std/result (Ok, Err)
import std/crypto (sha256Hex)
import std/json (encode, jo, kv, js, ja, jint, jb)
import std/list (map, length as listLen, foldl)
import ./extapps_bundle (extAppsBundle, extAppsVersion)
import ./widget_assets (widgetHtmlTemplate, widgetJs, widgetCss)
import ./brand (Brand, FooterLink, defaultBrand, brandName, brandLogo, brandAccent, brandLinks, onAccent)

-- title            heading shown above the picker
-- uploadUrl        POST target when the descriptor carries none (normally the same)
-- hostToolName     the widget-only tool for the via-host fallback ("" = no fallback)
-- maxViaHostBytes  largest file sent through the host (the spike proved <= 1 MB)
-- accept           the picker's accept attribute (".docx,.pdf", or "" for any)
-- nextStep         appended to the model-context message, e.g.
--                  "Call mcpParse with this fileRef."
-- afterUpload      shown after "Uploaded <name> (<size>) — ", e.g. "parsing…"
-- brand            header logo + name, accent, footer (brand.ail; 0.1.2)
-- onUploaded       the server tool the widget calls after the upload (0.1.3;
--                  noAutoCall() = report the fileRef only)
-- resultSummary    a card with no upload (a call given a fileRef or a document)
--                  shows one line read from its own result: "✓ Parsed a.docx ·
--                  68 blocks · …", "✗ <code>: <message>", "✓ <tool> done"
--                  (0.1.3; false = the bare "Done.")
-- askNextText      0.1.4: when the widget could not run onUploaded (a timeout,
--                  an error, or a host without serverTools), the card says
--                  "✓ Uploaded <name> (<size>) — <askNextText>"
--                  (default "ask the assistant to continue")
-- successSuffix    0.1.4: appended, whole, to the success line, e.g.
--                  " — ask Claude about it" (default ""; at most 60 chars)
-- autoCallTimeoutMs 0.1.4: how long the card waits for onUploaded (default
--                  10000; <= 0 = the default). The card never waits longer.
export type WidgetConfig = {title: string, uploadUrl: string, hostToolName: string, maxViaHostBytes: int, accept: string, nextStep: string, afterUpload: string, brand: Brand, onUploaded: OnUploaded, resultSummary: bool, askNextText: string, successSuffix: string, autoCallTimeoutMs: int}

-- tool      the server tool to call ("" = none: the 0.1.2 behaviour)
-- argsJson  its arguments as a JSON object template holding the string value
--           "{{fileRef}}" exactly once, e.g.
--           {"fileRef":"{{fileRef}}","outputFormat":"blocks"}. The widget
--           parses it and replaces that whole string value with the fileRef;
--           nothing is spliced into text.
export type OnUploaded = {tool: string, argsJson: string}

export pure func defaultWidgetConfig(uploadUrl: string, hostToolName: string) -> WidgetConfig =
  {title: "Upload a file", uploadUrl: uploadUrl, hostToolName: hostToolName, maxViaHostBytes: 1048576, accept: "",
   nextStep: "Continue the user's request with this fileRef.", afterUpload: "processing…", brand: defaultBrand(),
   onUploaded: noAutoCall(), resultSummary: true, askNextText: "ask the assistant to continue", successSuffix: "",
   autoCallTimeoutMs: defaultAutoCallTimeoutMs()}

-- How long the card waits for its onUploaded tool call before handing the
-- fileRef to the model instead (0.1.4).
export pure func defaultAutoCallTimeoutMs() -> int = 10000

-- No server tool after the upload: the widget only reports the fileRef.
export pure func noAutoCall() -> OnUploaded = {tool: "", argsJson: ""}

-- Call `tool` with `argsJson` (the "{{fileRef}}" template) after the upload.
export pure func callAfterUpload(tool: string, argsJson: string) -> OnUploaded = {tool: tool, argsJson: argsJson}

export pure func fileRefPlaceholder() -> string = "{{fileRef}}"

pure func toolCharOk(c: string) -> bool =
  length(c) == 1 && contains("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", c)

pure func toolCharsFrom(t: string, i: int) -> bool =
  if i >= length(t) then true else toolCharOk(substring(t, i, i + 1)) && toolCharsFrom(t, i + 1)

-- A plausible MCP tool name: [A-Za-z0-9_-]{1,64}.
export pure func toolNameOk(t: string) -> bool =
  length(t) >= 1 && length(t) <= 64 && toolCharsFrom(t, 0)

pure func occurrences(s: string, needle: string) -> int = listLen(split(s, needle)) - 1

pure func sumInts(xs: [int]) -> int = foldl(\a b. a + b, 0, xs)

-- String values exactly equal to the placeholder.
pure func wholePlaceholders(j: Json) -> int = match j {
  JString(s) => if s == fileRefPlaceholder() then 1 else 0,
  JArray(xs) => sumInts(map(wholePlaceholders, xs)),
  JObject(fs) => sumInts(map(\f. wholePlaceholders(f.value), fs)),
  _ => 0
}

-- Keys that mention the placeholder (after JSON unescaping).
pure func placeholderKeys(j: Json) -> int = match j {
  JArray(xs) => sumInts(map(placeholderKeys, xs)),
  JObject(fs) => sumInts(map(\f. (if contains(f.key, fileRefPlaceholder()) then 1 else 0) + placeholderKeys(f.value), fs)),
  _ => 0
}

-- "" when argsJson is a usable template, else what is wrong with it. The raw
-- text must hold the placeholder once and the parsed object must hold it once
-- as a whole string value, so a placeholder in a key, inside a longer string,
-- written twice, or spelled with JSON escapes is refused.
export pure func argsTemplateProblem(t: string) -> string =
  match decode(t) {
    Err(e) => "argsJson is not valid JSON (${e})",
    Ok(j) => match j {
      JObject(_) =>
        if occurrences(t, fileRefPlaceholder()) != 1 then "argsJson must contain \"{{fileRef}}\" exactly once"
        else if placeholderKeys(j) != 0 then "\"{{fileRef}}\" must be a value, not a key"
        else if wholePlaceholders(j) != 1 then "\"{{fileRef}}\" must be a whole string value, not part of a string"
        else "",
      _ => "argsJson must be a JSON object"
    }
  }

-- "" when the after-upload call is usable (or turned off), else the problem.
export pure func onUploadedProblem(o: OnUploaded) -> string =
  if o.tool == "" then ""
  else if toolNameOk(o.tool) == false then "onUploaded.tool must match [A-Za-z0-9_-]{1,64}"
  else argsTemplateProblem(o.argsJson)

-- What the widget receives: the config if it passes, else no call (the widget
-- then reports the fileRef only, and says why in the browser console).
export pure func checkedOnUploaded(o: OnUploaded) -> OnUploaded =
  if o.tool != "" && onUploadedProblem(o) == "" then o else noAutoCall()

-- The MCP Apps resource mime type (ext-apps 2026-01-26).
export pure func widgetMimeType() -> string = "text/html;profile=mcp-app"

-- The resource _meta a host needs to let the widget fetch the upload origin
-- (MCP Apps ui.csp.connectDomains, plus ChatGPT's legacy openai/widgetCSP).
-- serve-api F1c (@mcp_ui_resource) is meant to emit this; until then a
-- service can serve it itself.
export pure func widgetCspMeta(connectDomains: [string]) -> string =
  encode(jo([
    kv("ui", jo([kv("csp", jo([kv("connectDomains", ja(map(js, connectDomains))), kv("resourceDomains", ja([]))])),
                 kv("prefersBorder", jb(true))])),
    kv("openai/widgetCSP", jo([kv("connect_domains", ja(map(js, connectDomains))), kv("resource_domains", ja([]))]))
  ]))

-- The origin claude.ai serves this server's widgets from: "the first 32 hex
-- characters of the SHA-256 of your server URL, followed by
-- .claudemcpcontent.com" (claude.com/docs/connectors/building/mcp-apps/
-- getting-started). serve-api's CORS allowlist is exact-origin, so pass this
-- to --cors-origin for the upload route. mcpServerUrl is the connector URL
-- exactly as users add it (e.g. https://svc.example.com/mcp/connect/); confirm
-- it against the Origin header in your request log.
export pure func claudeWidgetOrigin(mcpServerUrl: string) -> string =
  "https://${substring(sha256Hex(mcpServerUrl), 0, 32)}.claudemcpcontent.com"

export pure func htmlEscape(s: string) -> string =
  replaceMany(s, [("&", "&amp;"), ("<", "&lt;"), (">", "&gt;"), ("\"", "&quot;"), ("'", "&#39;")])

-- cfg as a JS object literal. JSON is valid JS; < and > are escaped so no
-- value can close the <script> element.
export pure func configJson(cfg: WidgetConfig) -> string =
  replaceMany(encode(jo([
    kv("uploadUrl", js(cfg.uploadUrl)),
    kv("hostToolName", js(cfg.hostToolName)),
    kv("maxViaHostBytes", jint(cfg.maxViaHostBytes)),
    kv("nextStep", js(cfg.nextStep)),
    kv("afterUpload", js(cfg.afterUpload)),
    kv("onUploaded", jo([kv("tool", js(checkedOnUploaded(cfg.onUploaded).tool)), kv("argsJson", js(checkedOnUploaded(cfg.onUploaded).argsJson))])),
    kv("onUploadedProblem", js(onUploadedProblem(cfg.onUploaded))),
    kv("resultSummary", jb(cfg.resultSummary)),
    kv("askNextText", js(cfg.askNextText)),
    kv("successSuffix", js(cfg.successSuffix)),
    kv("autoCallTimeoutMs", jint(if cfg.autoCallTimeoutMs > 0 then cfg.autoCallTimeoutMs else defaultAutoCallTimeoutMs())),
    kv("extAppsVersion", js(extAppsVersion()))
  ])), [("<", "\\u003c"), (">", "\\u003e")])

-- The widget header: the checked logo (brand.svgLogoOk) and the escaped name.
export pure func brandHeaderHtml(b: Brand) -> string {
  let logo = brandLogo(b);
  let name = brandName(b);
  let logoHtml = if logo == "" then "" else "<span class='logo' aria-hidden='true'>${logo}</span>";
  let nameHtml = if name == "" then "" else "<span class='name'>${htmlEscape(name)}</span>";
  "${logoHtml}${nameHtml}"
}

-- The footer: https links (brand.linkUrlOk; opened through the host by the
-- widget script) with escaped labels, then "Powered by AILANG".
export pure func brandFooterHtml(b: Brand) -> string {
  let links = map(\l. "<a href='${htmlEscape(l.url)}' rel='noopener noreferrer' target='_blank'>${htmlEscape(trim(l.label))}</a>", brandLinks(b));
  let parts = if b.poweredBy then links ++ ["<span class='powered'>Powered by AILANG</span>"] else links;
  join(" <span aria-hidden='true'>·</span> ", parts)
}

-- The complete widget document: assets/widget.html with its placeholders
-- filled in one pass (inserted text is never re-scanned). The accent and its
-- text colour are checked hex colours (brand.accentOk).
export pure func uploadWidgetHtml(cfg: WidgetConfig) -> string {
  let title = htmlEscape(cfg.title);
  let accept = if cfg.accept == "" then "" else " accept='${htmlEscape(cfg.accept)}'";
  let accent = brandAccent(cfg.brand);
  replaceMany(widgetHtmlTemplate(), [
    ("{{TITLE}}", title),
    ("{{ACCEPT}}", accept),
    ("{{ACCENT}}", accent),
    ("{{ON_ACCENT}}", onAccent(accent)),
    ("{{BRAND}}", brandHeaderHtml(cfg.brand)),
    ("{{FOOTER}}", brandFooterHtml(cfg.brand)),
    ("{{STYLE}}", widgetCss()),
    ("{{EXTAPPS}}", extAppsBundle()),
    ("{{CONFIG}}", configJson(cfg)),
    ("{{SCRIPT}}", widgetJs())
  ])
}
