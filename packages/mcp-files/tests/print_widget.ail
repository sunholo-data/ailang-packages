-- Prints the default upload widget HTML (default brand + a footer link) (tests/widget_check.sh parses it).
module sunholo/mcp_files/tests/print_widget

import std/io (print)
import pkg/sunholo/mcp_files/widget (defaultWidgetConfig, uploadWidgetHtml)
import pkg/sunholo/mcp_files/brand (defaultBrand)

-- The default brand plus one footer link, so the parse covers the footer.
export func main() -> () ! {IO} = print(uploadWidgetHtml({defaultWidgetConfig("https://svc.example/uploads", "uploadViaHost") | accept: ".pdf,.docx",
  brand: {defaultBrand() | footerLinks: [{label: "Docs", url: "https://svc.example/docs"}]}}))
