-- Boot smoke test for sunholo/discord.
--
-- Offline: no network, no credential. Pure-surface checks only — request
-- validation, payload construction, response classification and message codecs.
-- The deep behavioral suite lives in client_test.ail (ailang test --package).

module _smoke

import std/io (println)
import std/json (Json, decode, encode, getString, jo, kv, js, jint)
import std/option (getOrElse)
import std/result (isOk, isErr)
import pkg/sunholo/discord/client (validId, problem, messagePath, messageBody, messageBodyEmbeds, validEmbed, embedJson, responseJson, classifyError, parseMessage, parseChannel, messageJson)

func check(name: string, ok: bool) -> int ! {IO @limit=1} {
  if ok then { println("  ✓ ${name}"); 1 } else { println("  ✗ ${name}"); 0 }
}

pure func isError[a, b](r: Result[a, b]) -> bool
ensures { result == isErr(r) }
= match r { Err(_) => true, Ok(_) => false }

pure func sampleMessage(id: string) -> Json
ensures { getOrElse(getString(result, "id"), "") == id }
= jo([kv("id", js(id)), kv("channel_id", js("300")),
    kv("author", jo([kv("id", js("77")), kv("username", js("alice"))])),
    kv("content", js("hello")), kv("timestamp", js("2026-09-17T00:00:00Z"))])

export func main() -> () ! {IO @limit=17} {
  let a = check("validId accepts a decimal snowflake", validId("18446744073709551615"));
  let b = check("validId rejects an injected path", not validId("123/../456"));
  let c = check("messagePath encodes a bounded query",
    match messagePath("123", {limit: 50, before: "", after: ""}) { Ok(p) => p == "/channels/123/messages?limit=50", Err(_) => false });
  let d = check("messagePath rejects limit 101", isError(messagePath("123", {limit: 101, before: "", after: ""})));
  let e = check("messageBody suppresses pings", isOk(messageBody("Hello", "", "")));
  let f = check("messageBody rejects an empty message", isError(messageBody("   ", "", "")));
  let p = problem("validation", "x");
  let g = check("problem zeroes transport fields", p.status == 0 && p.code == 0 && not p.global);
  let h = check("responseJson classifies rate limits",
    match responseJson(429, [], "{\"retry_after\":1.5,\"code\":0}") { Err(ev) => ev.kind == "rate_limit" && ev.retryAfter == 1.5, Ok(_) => false });
  let i = check("responseJson rejects malformed 2xx bodies", isError(responseJson(200, [], "not json")));
  let j = check("parseMessage accepts a complete payload", isOk(parseMessage(sampleMessage("42"))));
  let k = check("parseMessage rejects an empty payload", isError(parseMessage(jo([]))));
  let l = check("messageJson preserves identity",
    match parseMessage(sampleMessage("42")) { Err(_) => false, Ok(m) => match decode(encode(messageJson(m))) { Ok(j) => getOrElse(getString(j, "id"), "") == "42", Err(_) => false } });
  let ce = classifyError(403, [], "x");
  let m1 = check("classifyError keeps the HTTP status and class",
    ce.status == 403 && ce.kind == "permission" && ce.message == "Discord HTTP 403");
  let n = check("parseChannel accepts a thread channel object",
    match parseChannel(jo([kv("id", js("9")), kv("name", js("thread")), kv("type", jint(0))])) { Err(_) => false, Ok(c) => c.id == "9" });
  let embed = {title: "How to ask me for things", description: "Put what you want in the address and I will not have to guess.", color: 15154199,
    footer: "Forward a thread or send two lines.",
    thumbnail: "https://www.sunholo.com/assets/visuals/service-studies/v2/ailang.webp",
    image: "https://www.sunholo.com/assets/visuals/service-studies/v2/ailang.webp", fields: [
      {name: "daneel+document@", value: "Draft a document from what you send.", inline: false},
      {name: "daneel+summarise@", value: "Read something and summarise it.", inline: true}]};
  let o = check("address-book embed fits Discord limits and encodes", validEmbed(embed) && match decode(encode(embedJson(embed))) { Ok(j) => getOrElse(getString(j, "title"), "") == "How to ask me for things", Err(_) => false });
  let p = check("embed send body requires content or embeds", isError(messageBodyEmbeds("", [], "", "")) && isOk(messageBodyEmbeds("", [embed], "", "")));

  let passed = a + b + c + d + e + f + g + h + i + j + k + l + m1 + n + o;
  if passed == 15 then println("OK: 15/15 checks passed")
  else println("FAIL: ${show(passed)}/15 checks passed")
}