module sunholo/duckdb/query

import std/process (exec)
import std/bytes   (toString)
import std/json    (Json, decode, asArray, keys, get)
import std/list    (map, length, head)
import std/option  (Option, Some, None)
import std/result  (Result, Ok, Err)
import std/string  (trim)
import ./types     (DB, QueryResult)

-- Execute SQL and return full QueryResult.
-- Row values are Json — use std/json helpers (get, asString, asNumber, etc.) to extract fields.
--
-- Opens the database READ-ONLY. DuckDB allows either many readers or one
-- writer, so opening read-write for a SELECT took the exclusive lock and two
-- simultaneous reads of the same file collided — measured 26 Sept 2026 against
-- an 83k-message archive, 3 of 4 concurrent `eparse query` calls failed with
-- "Conflicting lock is held". DuckDB's own error names -readonly as the fix.
-- Anything serving reads concurrently (an MCP server, several shells) hit it.
--
-- Two consequences worth stating, because both change behaviour:
--
--   * A write sent through this READ half is refused by DuckDB rather than
--     performed. Writes belong in ./schema execScript, which still opens
--     read-write.
--   * Querying a path that does not exist is now an error ("Cannot open
--     database ... in read-only mode: database does not exist") instead of
--     silently CREATING an empty database and returning no rows. A caller
--     that meant to create one wants execScript; a caller with a typo wants
--     the error.
--
-- ":memory:" keeps the read-write form — DuckDB refuses to launch an
-- in-memory database read-only, and it has no second process to race.
export func query(db: DB, sql: string) -> Result[QueryResult, string] ! {Process} =
  runDuckdb(readArgs(db.path, sql))

-- The WRITE form: opens read-write, because it has to create and change
-- things. ./schema execScript is the only caller, and routing IT through
-- `query` is what made this split a naming convention rather than a fact —
-- turning `query` read-only briefly turned every write read-only too, and
-- `eparse index` could not create a fresh database at all.
export func execRaw(db: DB, sql: string) -> Result[QueryResult, string] ! {Process} =
  runDuckdb([db.path, "-json", "-c", sql])

func runDuckdb(args: [string]) -> Result[QueryResult, string] ! {Process} =
  match exec("duckdb", args) {
    Err(e)  => Err("duckdb process error: ${show(e)}"),
    Ok(out) =>
      if out.exitCode != 0
      then Err("duckdb error (exit ${show(out.exitCode)}): ${trim(toString(out.stderr))}")
      else parseResult(trim(toString(out.stdout)))
  }

pure func readArgs(path: string, sql: string) -> [string] =
  if path == "" || path == ":memory:"
  then [path, "-json", "-c", sql]
  else ["-readonly", path, "-json", "-c", sql]

-- Execute SQL and return all rows. Each row is a Json (JObject).
export func queryAll(db: DB, sql: string) -> Result[[Json], string] ! {Process} =
  match query(db, sql) {
    Err(e)  => Err(e),
    Ok(qr)  => Ok(qr.rows)
  }

-- Execute SQL and return the first row (a Json), or None if empty.
export func queryOne(db: DB, sql: string) -> Result[Option[Json], string] ! {Process} =
  match query(db, sql) {
    Err(e)   => Err(e),
    Ok(qr)   =>
      match head(qr.rows) {
        None    => Ok(None),
        Some(r) => Ok(Some(r))
      }
  }

-- Execute SQL returning a single scalar value (first column of first row).
export func scalar(db: DB, sql: string) -> Result[Option[Json], string] ! {Process} =
  match queryOne(db, sql) {
    Err(e)        => Err(e),
    Ok(None)      => Ok(None),
    Ok(Some(row)) =>
      match head(keys(row)) {
        None      => Ok(None),
        Some(col) => Ok(get(row, col))
      }
  }

-- ── Internal ──────────────────────────────────────────────────────────────────

-- duckdb -json outputs a JSON array of objects: [{"col": val, ...}, ...]
-- Empty result set outputs "" or "[]".
-- Each Row is a Json (JObject) — callers use std/json.get / asString / asNumber.
@allow_empty_ok("a query matching zero rows is a successful query: duckdb -json prints \"\" or [] for an empty result set, and callers must see Ok with no rows, not Err")
func parseResult(raw: string) -> Result[QueryResult, string] =
  if raw == "" || raw == "[]"
  then Ok({ columns: [], rows: [], rowCount: 0 })
  else
    match decode(raw) {
      Err(e)      => Err("failed to parse duckdb output: ${e}"),
      Ok(json)    =>
        match asArray(json) {
          None        => Err("expected JSON array from duckdb, got: ${raw}"),
          Some([])    => Ok({ columns: [], rows: [], rowCount: 0 }),
          Some(items) => Ok({ columns: colsFromFirst(items), rows: items, rowCount: length(items) })
        }
    }

func colsFromFirst(items: [Json]) -> [string] =
  match head(items) {
    None    => [],
    Some(r) => keys(r)
  }
