-- sunholo/gmail/message — composing an RFC 5322 message, safely.
--
-- The pure half. No network, no credentials, no effects: given strings, produce
-- the bytes Gmail wants. That separation is the point — this is the part where
-- a mistake is a security bug, and it is the part a solver can reason about.
--
-- THE ATTACK THIS EXISTS TO PREVENT
--
-- A header block is terminated by a blank line. A recipient or subject
-- containing CR or LF therefore does not "look odd" — it ends the headers and
-- begins a new section, letting a caller forge Bcc, rewrite the From, or append
-- an entire body of their choosing. If any part of `to` or `subject` comes from
-- a document, an inbound email or a model, that is a live injection path.
--
-- ON THE CONTRACT, AND WHY THERE IS ALSO A RUNTIME CHECK
--
-- `buildMessage` carries `requires` clauses stating exactly that. They are
-- currently SKIPPED by `ailang verify`: string interpolation desugars to `show`,
-- which Z3 cannot encode, so any function that builds a string is unverifiable
-- (reported 2026-09-08 as fb_913ee851c83c0d8c). Since `++` is list-only,
-- interpolation is how strings get built, so this is not avoidable by writing it
-- differently.
--
-- So the contract documents the intent and cannot yet prove it. Shipping that
-- alone would be claiming a guarantee we have not earned. `safeMessage` returns
-- a Result and performs the same check at runtime, and it is what callers should
-- use. When the solver can encode interpolation, the contract becomes the proof
-- and the runtime check becomes redundant belt-and-braces — at which point this
-- comment should be revisited rather than quietly left to rot.

module sunholo/gmail/message

import std/string (contains, concat)
import std/list (map, foldl, length)
import std/bytes (fromString, toBase64URL)
import std/result (Result, Ok, Err)

-- A message before encoding. `body` is deliberately unconstrained: newlines in a
-- body are ordinary and harmless, because the body is everything after the
-- blank line and cannot escape upward.
export type Message = {
  to: string,
  from: string,
  subject: string,
  body: string
}

-- True when a header VALUE cannot break out of its header.
export pure func headerSafe(v: string) -> bool {
  not(contains(v, "\r")) && not(contains(v, "\n"))
}

-- Compose. The contract states the property; `safeMessage` enforces it.
export pure func buildMessage(m: Message) -> string
requires {
  headerSafe(m.to), headerSafe(m.from), headerSafe(m.subject)
}
ensures { contains(result, "\r\n\r\n") }
{
  "To: ${m.to}\r\nFrom: ${m.from}\r\nSubject: ${m.subject}\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=UTF-8\r\n\r\n${m.body}"
}

-- The one callers should use. Refuses rather than composing something dangerous,
-- and names which field was at fault — a rejection nobody can act on gets
-- retried with the same input.
export pure func safeMessage(m: Message) -> Result[string, string] {
  if not(headerSafe(m.to)) then Err("recipient contains CR or LF — header injection")
  else if not(headerSafe(m.from)) then Err("from contains CR or LF — header injection")
  else if not(headerSafe(m.subject)) then Err("subject contains CR or LF — header injection")
  else if m.to == "" then Err("no recipient")
  else Ok(buildMessage(m))
}

-- Gmail's `raw` field is base64url, and rejects standard base64 — the alphabets
-- differ in two characters, so a message containing the wrong one fails at the
-- API with an error that does not mention encoding.
--
-- Needs AILANG >= 0.35.4: std/bytes.toBase64URL did not exist before it, and the
-- workaround (toBase64 then replaceMany) is exactly the kind of thing that gets
-- copied into three packages and subtly wrong in one.
export pure func encodeRaw(rfc5322: string) -> string {
  toBase64URL(fromString(rfc5322))
}

-- Compose and encode in one step, refusing unsafe input.
export pure func safeRaw(m: Message) -> Result[string, string] {
  match safeMessage(m) {
    Ok(s) => Ok(encodeRaw(s)),
    Err(e) => Err(e)
  }
}


-- ---------------------------------------------------------------------------
-- multipart/alternative — added 0.2.0
-- ---------------------------------------------------------------------------
--
-- Motivated by Daneel, which sends scheduled reports a human actually reads.
-- buildMessage hardcodes text/plain, so HTML needed a sibling rather than a
-- flag: the two produce different bytes and have different failure modes, and a
-- boolean parameter would hide that.
--
-- THE ATTACK THIS ADDS A GUARD FOR. A multipart body is delimited by a boundary
-- string. A part whose CONTENT contains that boundary closes its own part early
-- and opens another — forging an attachment, or replacing the visible body with
-- something the composer never wrote. That is CR/LF header injection one layer
-- down, and it matters more here than in most mailers because these bodies carry
-- FORWARDED EMAIL: text a stranger chose.
--
-- The boundary is safe because it is CHECKED, not because it is hard to guess.

export type Alt = {
  to: string,
  from: string,
  subject: string,
  text: string,
  html: string
}

-- Neither part may contain the delimiter that separates them.
export pure func boundarySafe(boundary: string, text: string, html: string) -> bool {
  boundary != "" && not(contains(text, boundary)) && not(contains(html, boundary))
}

-- Part order is not cosmetic. RFC 2046 says the LAST part is the most-preferred
-- representation, so text/plain goes first and text/html second: a client that
-- cannot render HTML shows the plain part, and anything reading the raw message
-- — including another agent — gets a complete text version rather than tag soup.
export pure func buildAlt(m: Alt, boundary: string) -> string
requires {
  headerSafe(m.to), headerSafe(m.from), headerSafe(m.subject),
  boundarySafe(boundary, m.text, m.html)
}
{
  concat([
    "To: ${m.to}\r\nFrom: ${m.from}\r\nSubject: ${m.subject}\r\n",
    "MIME-Version: 1.0\r\n",
    "Content-Type: multipart/alternative; boundary=\"${boundary}\"\r\n\r\n",
    "--${boundary}\r\nContent-Type: text/plain; charset=UTF-8\r\n\r\n${m.text}\r\n",
    "--${boundary}\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n${m.html}\r\n",
    "--${boundary}--\r\n"
  ])
}

-- The one callers should use. Names which field was at fault, because a refusal
-- nobody can act on gets retried with the same input.
export pure func safeAlt(m: Alt, boundary: string) -> Result[string, string] {
  if not(headerSafe(m.to)) then Err("recipient contains CR or LF — header injection")
  else if not(headerSafe(m.from)) then Err("from contains CR or LF — header injection")
  else if not(headerSafe(m.subject)) then Err("subject contains CR or LF — header injection")
  else if m.to == "" then Err("no recipient")
  else if not(boundarySafe(boundary, m.text, m.html)) then Err("a body part contains the MIME boundary — part injection")
  else Ok(buildAlt(m, boundary))
}

export pure func safeAltRaw(m: Alt, boundary: string) -> Result[string, string] {
  match safeAlt(m, boundary) {
    Ok(s) => Ok(encodeRaw(s)),
    Err(e) => Err(e)
  }
}


-- ---------------------------------------------------------------------------
-- The taint gate — 0.2.1
-- ---------------------------------------------------------------------------
--
-- AILANG enforces information-flow labels on FUNCTION PARAMETERS. Measured on
-- v0.36.0, 10 Sept 2026: passing a string<email> to a parameter typed
-- string{not email} is a TYPE ERROR —
--
--   information-flow violation: value labelled <email> reaches parameter "body"
--   which forbids it (string{not email})
--
-- It does NOT enforce on record FIELDS: constructing { body: <email> } where the
-- field is declared string{not email} compiles clean. So annotating Message.body
-- or Alt.text would look like a guarantee and provide none.
--
-- Hence a constructor, whose parameters carry the refinement.
--
-- ⚠️ AND IT DOES NOT YET PROTECT A CALLER IN ANOTHER MODULE. Measured the same
-- day: the refinement is enforced WITHIN a module and LOST across a module
-- boundary, local import or registry package alike. So a caller importing this
-- function can still pass string<email> and compile clean. Filed as issue #1134.
--
-- It is shipped anyway, and the reason is worth stating rather than assuming:
-- the signature is the correct specification, it costs callers nothing, it
-- documents the intended contract at the point of use, and it starts enforcing
-- the moment the boundary bug is fixed — with no caller change. What it must NOT
-- do meanwhile is be described as a guarantee. Until #1134 lands, the protection
-- against a forwarded body reaching the wire is the CALLER's responsibility.
--
-- The direct record literal is still available for callers whose text never came
-- from a mailbox. That is deliberate: a gate nobody can bypass for legitimate
-- reasons gets bypassed for illegitimate ones.
export pure func altFrom(
  to: string,
  from: string,
  subject: string,
  text: string{not email},
  html: string{not email}
) -> Alt {
  { to: to, from: from, subject: subject, text: text, html: html }
}


-- ---------------------------------------------------------------------------
-- multipart/related — inline images, added 0.3.0
-- ---------------------------------------------------------------------------
--
-- An HTML part that references an image needs the image carried WITH it, or the
-- recipient sees a broken box. Remote URLs are the usual answer and the wrong
-- one: most clients block them by default, and a remote fetch tells the sender
-- when a message was opened, which is tracking whether or not it was meant as
-- tracking.
--
-- So the image travels in the message, referenced as cid:<id> from the HTML:
--
--   multipart/related
--     multipart/alternative
--       text/plain          <- complete, not a stub
--       text/html           <- <img src="cid:daneel">
--     image/png             <- Content-ID: <daneel>
--
-- TWO boundaries now, and they must differ from each other as well as being
-- absent from every part. A related-boundary equal to the alternative-boundary
-- closes the wrong section and the message silently loses its body.
--
-- The design rule that survives this: the HTML must remain READABLE WITHOUT THE
-- IMAGE. A layout that depends on the logo loading is a layout that breaks for
-- every recipient whose client blocks it.

export type InlinePart = {
  cid: string,          -- referenced from the HTML as cid:<this>
  mimeType: string,     -- e.g. "image/png"
  filename: string,
  b64: string           -- base64, already line-wrapped
}

export type Related = {
  alt: Alt,
  parts: [InlinePart]
}

-- A part is safe when neither boundary appears in its payload and its
-- content-id cannot break out of the header it is interpolated into.
export pure func partSafe(rel: string, alt: string, p: InlinePart) -> bool {
  not(contains(p.b64, rel)) && not(contains(p.b64, alt)) &&
  not(contains(p.cid, "\r")) && not(contains(p.cid, "\n")) && p.cid != "" &&
  not(contains(p.filename, "\r")) && not(contains(p.filename, "\n"))
}

export pure func relatedSafe(rel: string, alt: string, r: Related) -> bool {
  rel != "" && alt != "" && rel != alt &&
  not(contains(r.alt.text, rel)) && not(contains(r.alt.html, rel)) &&
  foldl(\acc. \p. acc && partSafe(rel, alt, p), true, r.parts)
}

export pure func renderPart(boundary: string, p: InlinePart) -> string {
  concat([
    "--${boundary}\r\n",
    "Content-Type: ${p.mimeType}\r\n",
    "Content-Transfer-Encoding: base64\r\n",
    "Content-ID: <${p.cid}>\r\n",
    "Content-Disposition: inline; filename=\"${p.filename}\"\r\n\r\n",
    "${p.b64}\r\n"
  ])
}

export pure func buildRelated(r: Related, relBoundary: string, altBoundary: string) -> string
requires {
  headerSafe(r.alt.to), headerSafe(r.alt.from), headerSafe(r.alt.subject),
  boundarySafe(altBoundary, r.alt.text, r.alt.html),
  relatedSafe(relBoundary, altBoundary, r)
}
{
  concat([
    "To: ${r.alt.to}\r\nFrom: ${r.alt.from}\r\nSubject: ${r.alt.subject}\r\n",
    "MIME-Version: 1.0\r\n",
    "Content-Type: multipart/related; boundary=\"${relBoundary}\"\r\n\r\n",
    "--${relBoundary}\r\n",
    "Content-Type: multipart/alternative; boundary=\"${altBoundary}\"\r\n\r\n",
    "--${altBoundary}\r\nContent-Type: text/plain; charset=UTF-8\r\n\r\n${r.alt.text}\r\n",
    "--${altBoundary}\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n${r.alt.html}\r\n",
    "--${altBoundary}--\r\n\r\n",
    concat(map(\p. renderPart(relBoundary, p), r.parts)),
    "--${relBoundary}--\r\n"
  ])
}

export pure func safeRelated(r: Related, relBoundary: string, altBoundary: string) -> Result[string, string] {
  if not(headerSafe(r.alt.to)) then Err("recipient contains CR or LF — header injection")
  else if not(headerSafe(r.alt.from)) then Err("from contains CR or LF — header injection")
  else if not(headerSafe(r.alt.subject)) then Err("subject contains CR or LF — header injection")
  else if r.alt.to == "" then Err("no recipient")
  else if not(boundarySafe(altBoundary, r.alt.text, r.alt.html)) then Err("a body part contains the alternative boundary — part injection")
  else if length(r.parts) == 0 then Err("multipart/related with no inline parts — use safeAlt instead")
  else if not(relatedSafe(relBoundary, altBoundary, r)) then Err("the related boundary is empty, equal to the alternative boundary, or present in a part, or a content-id contains CR/LF")
  else Ok(buildRelated(r, relBoundary, altBoundary))
}

export pure func safeRelatedRaw(r: Related, relBoundary: string, altBoundary: string) -> Result[string, string] {
  match safeRelated(r, relBoundary, altBoundary) {
    Ok(s) => Ok(encodeRaw(s)),
    Err(e) => Err(e)
  }
}
