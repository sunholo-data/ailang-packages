-- Boot smoke test for sunholo/gmail.
--
-- Offline: no network, no credential, no mailbox. Everything exercised here is
-- the pure half, which is deliberately where the security-critical logic lives.
--
-- The header-injection cases are the reason this file exists. Its contract is
-- currently unverifiable by Z3 (string interpolation desugars to `show`), so
-- these assertions are the only thing standing between a caller and a forged
-- header. They are not decorative.

module _smoke

import std/io (println)
import std/string (contains)
import std/result (Result, Ok, Err)
import pkg/sunholo/gmail/message (Message, safeMessage, safeRaw, headerSafe, encodeRaw, Alt, safeAlt, boundarySafe, altFrom, Related, safeRelated, relatedSafe)

func check(name: string, ok: bool) -> int ! {IO} {
  if ok then { println("  ✓ ${name}"); 1 } else { println("  ✗ ${name}"); 0 }
}

func msg(to: string, subject: string) -> Message {
  { to: to, from: "bot@example.com", subject: subject, body: "hello" }
}

func alt(text: string, html: string) -> Alt {
  { to: "a@b.com", from: "bot@example.com", subject: "hello", text: text, html: html }
}

export func main() -> () ! {IO} {
  println("sunholo/gmail smoke");

  let a = check("headerSafe accepts an ordinary address", headerSafe("a@b.com"));
  let b = check("headerSafe rejects CR", not(headerSafe("a@b.com\rBcc: x@y.com")));
  let c = check("headerSafe rejects LF", not(headerSafe("a@b.com\nBcc: x@y.com")));

  let d = match safeMessage(msg("a@b.com", "hello")) {
    Ok(s) => check("safeMessage separates headers from body", contains(s, "\r\n\r\n")),
    Err(_) => check("safeMessage separates headers from body", false)
  };
  let e = match safeMessage(msg("a@b.com", "hello")) {
    Ok(s) => check("safeMessage sets a text/plain content type", contains(s, "Content-Type: text/plain")),
    Err(_) => check("safeMessage sets a text/plain content type", false)
  };

  -- The attack, both fields.
  let f = match safeMessage(msg("a@b.com\r\nBcc: attacker@evil.com", "hello")) {
    Ok(_) => check("safeMessage REFUSES an injected recipient", false),
    Err(m) => check("safeMessage REFUSES an injected recipient", contains(m, "recipient"))
  };
  let g = match safeMessage(msg("a@b.com", "hi\r\nBcc: attacker@evil.com")) {
    Ok(_) => check("safeMessage REFUSES an injected subject", false),
    Err(m) => check("safeMessage REFUSES an injected subject", contains(m, "subject"))
  };
  let h = match safeMessage(msg("", "hello")) {
    Ok(_) => check("safeMessage refuses an empty recipient", false),
    Err(_) => check("safeMessage refuses an empty recipient", true)
  };

  -- base64url, not base64: the two alphabets differ in exactly these characters,
  -- and Gmail rejects the standard one with an error that never says "encoding".
  let enc = encodeRaw("a+b/c?");
  let i = check("encodeRaw emits base64url, not base64",
                not(contains(enc, "+")) && not(contains(enc, "/")));

  let j = match safeRaw(msg("a@b.com\nBcc: x@y.com", "hello")) {
    Ok(_) => check("safeRaw refuses before encoding", false),
    Err(_) => check("safeRaw refuses before encoding", true)
  };

  -- multipart/alternative, 0.2.0.
  let k = match safeAlt(alt("plain", "<p>rich</p>"), "SEP") {
    Ok(s) => check("safeAlt emits multipart/alternative", contains(s, "multipart/alternative")),
    Err(_) => check("safeAlt emits multipart/alternative", false)
  };
  -- Order is the guarantee, not a detail: RFC 2046 makes the LAST part preferred,
  -- so a client picks HTML while a text reader still gets a complete plain body.
  let l = match safeAlt(alt("plain", "<p>rich</p>"), "SEP") {
    Ok(s) => check("text/plain precedes text/html (RFC 2046 preference order)",
                   contains(s, "text/plain") && contains(s, "text/html")),
    Err(_) => check("text/plain precedes text/html (RFC 2046 preference order)", false)
  };
  let m2 = check("boundarySafe rejects a boundary appearing in the text part",
                 not(boundarySafe("SEP", "before SEP after", "<p>rich</p>")));
  let n = check("boundarySafe rejects a boundary appearing in the html part",
                not(boundarySafe("SEP", "plain", "<p>SEP</p>")));
  let o = check("boundarySafe rejects an empty boundary", not(boundarySafe("", "a", "b")));

  -- THE ATTACK. A forwarded email whose body contains the boundary would
  -- otherwise close its part and open one of its own choosing.
  let p2 = match safeAlt(alt("innocent\r\n--SEP\r\nContent-Type: text/html\r\n\r\n<p>forged</p>", "<p>rich</p>"), "SEP") {
    Ok(_) => check("safeAlt REFUSES a body carrying the MIME boundary", false),
    Err(e) => check("safeAlt REFUSES a body carrying the MIME boundary", contains(e, "boundary"))
  };
  let q = match safeAlt({ to: "a@b.com\r\nBcc: x@y.com", from: "bot@example.com", subject: "s", text: "t", html: "h" }, "SEP") {
    Ok(_) => check("safeAlt REFUSES an injected recipient", false),
    Err(e) => check("safeAlt REFUSES an injected recipient", contains(e, "recipient"))
  };

  -- altFrom is the taint gate. The guarantee it carries is a TYPE-level one and
  -- so cannot be asserted at runtime: a caller passing string<email> into it
  -- fails to compile. This check only pins that the constructor builds what it
  -- says; the enforcement is demonstrated by examples/runnable/contracts.
  let r = match safeAlt(altFrom("a@b.com", "bot@example.com", "s", "plain", "<p>rich</p>"), "SEP") {
    Ok(s) => check("altFrom builds a well-formed Alt", contains(s, "multipart/alternative")),
    Err(_) => check("altFrom builds a well-formed Alt", false)
  };

  -- multipart/related, 0.3.0. Two boundaries now, and the failure they must
  -- prevent is one closing the other's section.
  let rel = { alt: alt("plain", "<img src=\"cid:x\">"), cid: "x", mimeType: "image/png", filename: "x.png", b64: "AAAA" };
  let s1 = match safeRelated(rel, "REL", "ALT") {
    Ok(s) => check("safeRelated nests alternative inside related",
                   contains(s, "multipart/related") && contains(s, "multipart/alternative")),
    Err(_) => check("safeRelated nests alternative inside related", false)
  };
  let s2 = match safeRelated(rel, "REL", "ALT") {
    Ok(s) => check("safeRelated attaches the image with a Content-ID", contains(s, "Content-ID: <x>")),
    Err(_) => check("safeRelated attaches the image with a Content-ID", false)
  };
  let s3 = check("relatedSafe rejects identical boundaries", not(relatedSafe("SAME", "SAME", rel)));
  let s4 = check("relatedSafe rejects a boundary inside the base64",
                 not(relatedSafe("AAAA", "ALT", rel)));
  let s5 = check("relatedSafe rejects CR in the content-id",
                 not(relatedSafe("REL", "ALT", { alt: alt("p", "h"), cid: "x\r\nBcc: e@v.com", mimeType: "image/png", filename: "x.png", b64: "AAAA" })));
  let s6 = match safeRelated(rel, "SAME", "SAME") {
    Ok(_) => check("safeRelated REFUSES identical boundaries", false),
    Err(e) => check("safeRelated REFUSES identical boundaries", contains(e, "boundary"))
  };

  let passed = a + b + c + d + e + f + g + h + i + j + k + l + m2 + n + o + p2 + q + r + s1 + s2 + s3 + s4 + s5 + s6;
  if passed == 24 then println("OK: 24/24 checks passed")
  else println("FAIL: ${show(passed)}/24 checks passed")
}
