module sunholo/motoko_ext_mcp/register

import std/env (getEnvOr)
import pkg/sunholo/motoko_ext_abi/types (ExtensionHooks)
import pkg/sunholo/motoko_ext_mcp/mcp (read_mcp_config, collect_all_tool_names, make_hooks)

export func register_with_config(_cfg: a) -> ExtensionHooks ! {Env, FS} {
  let profile_dir = getEnvOr("MOTOKO_PROFILE_DIR", ".");
  let cfg        = read_mcp_config(profile_dir);
  let tool_names = collect_all_tool_names(cfg);
  make_hooks(tool_names)
}
